+/* a handled notification outlives the reap: the handler runs after k_waitpid() */
+static void waitpid_chld_handled(void)
+{
+	int id;
+	int ws = 0;
+	struct k_sig_set set;
+	struct k_sig_action action = {.handler = chld_handler};
+	struct sys_clone_args args = {
+		.entry = spawn_entry_exit,
+		.p1 = (void *)(intptr_t)7,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
+	};
