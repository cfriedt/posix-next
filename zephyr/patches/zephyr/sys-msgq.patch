+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/kernel.h>
+#include <zephyr/kernel/signal.h>
+#include <zephyr/sys/fdtable.h>
+#include <zephyr/sys/mqueue.h>
+#include <zephyr/ztest.h>
+
+#define QNAME     "testq"
+#define MSG_SIZE  16
+#define MAX_MSGS  4
+#define TIMEOUT   K_MSEC(100)
+
+static const struct k_msgq_attrs attrs = {
+	.msg_size = MSG_SIZE,
+	.max_msgs = MAX_MSGS,
+};
+
+static ZTEST_BMEM volatile bool notify_fn_ran;
+
+static int open_rdwr(int extra_oflags)
+{
+	return sys_msgq_open(QNAME, ZVFS_O_RDWR | ZVFS_O_CREAT | extra_oflags, 0, &attrs);
+}
+
+static void section_reset(void)
+{
+	(void)sys_msgq_unlink(QNAME);
+}
+
+/* sections of test_sys_msgq_open */
+
+static void open_create_close(void)
+{
+	int fd = open_rdwr(0);
+
+	zassert_true(fd >= 0, "open failed: %d", fd);
+	zassert_ok(zvfs_close(fd));
+	/* the queue persists until unlinked and can be reopened without O_CREAT */
+	fd = sys_msgq_open(QNAME, ZVFS_O_RDWR, 0, NULL);
+	zassert_true(fd >= 0, "reopen failed: %d", fd);
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+static void open_errors(void)
+{
+	char long_name[CONFIG_SYS_MSGQ_NAMELEN_MAX + 2];
+	struct k_msgq_attrs bad = attrs;
+	int fd, fd2;
+
+	/* no O_CREAT and no such queue */
+	zassert_equal(sys_msgq_open(QNAME, ZVFS_O_RDWR, 0, NULL), -ENOENT);
+
+	/* creating requires geometry */
+	zassert_equal(sys_msgq_open(QNAME, ZVFS_O_RDWR | ZVFS_O_CREAT, 0, NULL), -EINVAL);
+	bad.msg_size = 0;
+	zassert_equal(sys_msgq_open(QNAME, ZVFS_O_RDWR | ZVFS_O_CREAT, 0, &bad), -EINVAL);
+
+	/* geometry must fit the per-queue budget */
+	bad.msg_size = CONFIG_SYS_MSGQ_BUF_SIZE * 2;
+	bad.max_msgs = 1;
+	zassert_equal(sys_msgq_open(QNAME, ZVFS_O_RDWR | ZVFS_O_CREAT, 0, &bad), -ENOSPC);
+
+	/* name length is bounded */
+	memset(long_name, 'a', sizeof(long_name) - 1);
+	long_name[sizeof(long_name) - 1] = '\0';
+	zassert_equal(sys_msgq_open(long_name, ZVFS_O_RDWR | ZVFS_O_CREAT, 0, &attrs),
+		      -ENAMETOOLONG);
+
+	/* O_EXCL on an existing queue */
+	fd = open_rdwr(0);
+	zassert_true(fd >= 0);
+	fd2 = open_rdwr(ZVFS_O_EXCL);
+	zassert_equal(fd2, -EEXIST);
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+ZTEST_USER(sys_msgq, test_sys_msgq_open)
+{
+	section_reset();
+	open_create_close();
+	open_errors();
+	section_reset();
+}
+
+/* sections of test_sys_msgq_unlink */
+
+static void unlink_deferred_destroy(void)
+{
+	char buf[MSG_SIZE];
+	int fd = open_rdwr(0);
+
+	zassert_true(fd >= 0);
+	zassert_ok(sys_msgq_unlink(QNAME));
+
+	/* the name is free immediately; the old queue lives until last close */
+	zassert_ok(sys_msgq_send(fd, "still alive", 12, 0, K_NO_WAIT));
+	zassert_equal(sys_msgq_receive(fd, buf, sizeof(buf), NULL, K_NO_WAIT), 12);
+
+	int fd2 = open_rdwr(0);
+
+	zassert_true(fd2 >= 0, "name not reusable after unlink: %d", fd2);
+	zassert_ok(zvfs_close(fd2));
+	zassert_ok(sys_msgq_unlink(QNAME));
+	zassert_ok(zvfs_close(fd));
+}
+
+static void unlink_errors(void)
+{
+	zassert_equal(sys_msgq_unlink(QNAME), -ENOENT);
+	zassert_equal(sys_msgq_unlink("nonexistent"), -ENOENT);
+}
+
+ZTEST_USER(sys_msgq, test_sys_msgq_unlink)
+{
+	section_reset();
+	unlink_deferred_destroy();
+	unlink_errors();
+	section_reset();
+}
+
+/* sections of test_sys_msgq_send */
+
+static void send_and_priority_order(void)
+{
+	char buf[MSG_SIZE];
+	uint32_t prio;
+	int fd = open_rdwr(0);
+
+	zassert_true(fd >= 0);
+	zassert_ok(sys_msgq_send(fd, "low", 4, 1, K_NO_WAIT));
+	zassert_ok(sys_msgq_send(fd, "high A", 7, 5, K_NO_WAIT));
+	zassert_ok(sys_msgq_send(fd, "high B", 7, 5, K_NO_WAIT));
+
+	zassert_equal(sys_msgq_receive(fd, buf, sizeof(buf), &prio, K_NO_WAIT), 7);
+	zassert_equal(prio, 5);
+	zassert_mem_equal(buf, "high A", 7);
+	zassert_equal(sys_msgq_receive(fd, buf, sizeof(buf), &prio, K_NO_WAIT), 7);
+	zassert_mem_equal(buf, "high B", 7);
+	zassert_equal(sys_msgq_receive(fd, buf, sizeof(buf), &prio, K_NO_WAIT), 4);
+	zassert_equal(prio, 1);
+
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+static void send_errors(void)
+{
+	char big[MSG_SIZE + 1] = {0};
+	int fd = open_rdwr(0);
+	int rd = sys_msgq_open(QNAME, ZVFS_O_RDONLY, 0, NULL);
+
+	zassert_true(fd >= 0);
+	zassert_true(rd >= 0);
+
+	/* a read-only descriptor cannot send */
+	zassert_equal(sys_msgq_send(rd, "x", 2, 0, K_NO_WAIT), -EBADF);
+	/* message length is bounded by the queue's message size */
+	zassert_equal(sys_msgq_send(fd, big, sizeof(big), 0, K_NO_WAIT), -EMSGSIZE);
+
+	for (int i = 0; i < MAX_MSGS; i++) {
+		zassert_ok(sys_msgq_send(fd, "fill", 5, 0, K_NO_WAIT));
+	}
+	zassert_equal(sys_msgq_send(fd, "full", 5, 0, K_NO_WAIT), -ENOMSG);
+	zassert_equal(sys_msgq_send(fd, "full", 5, 0, TIMEOUT), -EAGAIN);
+
+	zassert_ok(zvfs_close(rd));
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+static void send_nonblock_fd(void)
+{
+	int fd = open_rdwr(ZVFS_O_NONBLOCK);
+
+	zassert_true(fd >= 0);
+	for (int i = 0; i < MAX_MSGS; i++) {
+		zassert_ok(sys_msgq_send(fd, "fill", 5, 0, K_FOREVER));
+	}
+	/* K_FOREVER is forced to no-wait on a non-blocking descriptor */
+	zassert_equal(sys_msgq_send(fd, "full", 5, 0, K_FOREVER), -ENOMSG);
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+ZTEST_USER(sys_msgq, test_sys_msgq_send)
+{
+	section_reset();
+	send_and_priority_order();
+	send_errors();
+	send_nonblock_fd();
+	section_reset();
+}
+
+/* sections of test_sys_msgq_receive */
+
+static void receive_errors(void)
+{
+	char small[MSG_SIZE - 1];
+	char buf[MSG_SIZE];
+	int fd = open_rdwr(0);
+	int wr = sys_msgq_open(QNAME, ZVFS_O_WRONLY, 0, NULL);
+
+	zassert_true(fd >= 0);
+	zassert_true(wr >= 0);
+
+	zassert_ok(sys_msgq_send(fd, "x", 2, 0, K_NO_WAIT));
+	/* a write-only descriptor cannot receive */
+	zassert_equal(sys_msgq_receive(wr, buf, sizeof(buf), NULL, K_NO_WAIT), -EBADF);
+	/* the receive buffer must hold a maximum-size message */
+	zassert_equal(sys_msgq_receive(fd, small, sizeof(small), NULL, K_NO_WAIT), -EMSGSIZE);
+	zassert_equal(sys_msgq_receive(fd, buf, sizeof(buf), NULL, K_NO_WAIT), 2);
+
+	zassert_equal(sys_msgq_receive(fd, buf, sizeof(buf), NULL, K_NO_WAIT), -ENOMSG);
+	zassert_equal(sys_msgq_receive(fd, buf, sizeof(buf), NULL, TIMEOUT), -EAGAIN);
+
+	zassert_ok(zvfs_close(wr));
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+ZTEST_USER(sys_msgq, test_sys_msgq_receive)
+{
+	section_reset();
+	receive_errors();
+	section_reset();
+}
+
+/* sections of test_sys_msgq_getattr */
+
+static void getattr_reports(void)
+{
+	struct k_msgq_attrs out;
+	int oflags;
+	int fd = open_rdwr(ZVFS_O_NONBLOCK);
+
+	zassert_true(fd >= 0);
+	zassert_ok(sys_msgq_send(fd, "x", 2, 0, K_NO_WAIT));
+
+	zassert_ok(sys_msgq_getattr(fd, &out, &oflags));
+	zassert_equal(out.msg_size, MSG_SIZE);
+	zassert_equal(out.max_msgs, MAX_MSGS);
+	zassert_equal(out.used_msgs, 1);
+	zassert_equal(oflags & ZVFS_O_NONBLOCK, ZVFS_O_NONBLOCK);
+	zassert_equal(oflags & (ZVFS_O_RDONLY | ZVFS_O_WRONLY | ZVFS_O_RDWR), ZVFS_O_RDWR);
+
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+
+	zassert_equal(sys_msgq_getattr(-1, &out, &oflags), -EBADF);
+}
+
+ZTEST_USER(sys_msgq, test_sys_msgq_getattr)
+{
+	section_reset();
+	getattr_reports();
+	section_reset();
+}
+
+/* sections of test_sys_msgq_setflags */
+
+static void setflags_nonblock(void)
+{
+	int oflags;
+	int fd = open_rdwr(0);
+
+	zassert_true(fd >= 0);
+
+	zassert_ok(sys_msgq_setflags(fd, ZVFS_O_NONBLOCK));
+	zassert_ok(sys_msgq_getattr(fd, NULL, &oflags));
+	zassert_equal(oflags & ZVFS_O_NONBLOCK, ZVFS_O_NONBLOCK);
+
+	zassert_ok(sys_msgq_setflags(fd, 0));
+	zassert_ok(sys_msgq_getattr(fd, NULL, &oflags));
+	zassert_equal(oflags & ZVFS_O_NONBLOCK, 0);
+
+	/* only O_NONBLOCK may be changed */
+	zassert_equal(sys_msgq_setflags(fd, ZVFS_O_CREAT), -EINVAL);
+
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+ZTEST_USER(sys_msgq, test_sys_msgq_setflags)
+{
+	section_reset();
+	setflags_nonblock();
+	section_reset();
+}
+
+/* sections of test_sys_msgq_notify */
+
+static void notify_signal_fires(void)
+{
+	struct k_sig_set set;
+	struct k_sig_info info;
+	struct sys_msgq_notify notify = {
+		.target = k_current_get(),
+		.signo = K_SIG_USR1,
+		.value.sival_int = 42,
+	};
+	int fd = open_rdwr(0);
+
+	zassert_true(fd >= 0);
+
+	zassert_ok(k_sig_emptyset(&set));
+	zassert_ok(k_sig_addset(&set, K_SIG_USR1));
+	zassert_ok(k_sig_mask(K_SIG_BLOCK, &set, NULL));
+
+	zassert_ok(sys_msgq_notify(fd, &notify));
+	/* second registration while armed */
+	zassert_equal(sys_msgq_notify(fd, &notify), -EBUSY);
+
+	zassert_ok(sys_msgq_send(fd, "wake", 5, 0, K_NO_WAIT));
+	zassert_equal(k_sig_timedwait(&set, &info, TIMEOUT), K_SIG_USR1);
+	zassert_equal(info.code, K_SI_MSGQ);
+	zassert_equal(info.value.sival_int, 42);
+
+	/* consumed: re-arming succeeds, removing works */
+	zassert_ok(sys_msgq_notify(fd, &notify));
+	zassert_ok(sys_msgq_notify(fd, NULL));
+	/* removing again: nothing armed */
+	zassert_equal(sys_msgq_notify(fd, NULL), -EINVAL);
+
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+static void notify_signal_none(void)
+{
+	struct k_sig_set set;
+	struct sys_msgq_notify notify = {
+		.signo = 0,
+	};
+	int fd = open_rdwr(0);
+
+	zassert_true(fd >= 0);
+
+	zassert_ok(k_sig_emptyset(&set));
+	zassert_ok(k_sig_addset(&set, K_SIG_USR1));
+	zassert_ok(k_sig_mask(K_SIG_BLOCK, &set, NULL));
+
+	/* signo 0 generates nothing but is still consumed by the transition */
+	zassert_ok(sys_msgq_notify(fd, &notify));
+	zassert_ok(sys_msgq_send(fd, "quiet", 6, 0, K_NO_WAIT));
+	zassert_true(k_sig_timedwait(&set, NULL, K_NO_WAIT) < 0);
+	zassert_ok(sys_msgq_notify(fd, &notify));
+	zassert_ok(sys_msgq_notify(fd, NULL));
+
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+static void notify_errors(void)
+{
+	struct sys_msgq_notify notify = {
+		.signo = K_SIG_USR1,
+		.target = NULL,
+	};
+	int fd = open_rdwr(0);
+
+	zassert_true(fd >= 0);
+
+	/* a signal-generating registration needs a target */
+	zassert_equal(sys_msgq_notify(fd, &notify), -EINVAL);
+	zassert_equal(sys_msgq_notify(-1, NULL), -EBADF);
+
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+static void notify_fn(union k_sig_val value)
+{
+	zassert_equal(value.sival_int, 43);
+	notify_fn_ran = true;
+}
+
+static void notify_function_fires(void)
+{
+	struct sys_msgq_notify notify = {
+		.fn = notify_fn,
+		.value.sival_int = 43,
+	};
+	int fd = open_rdwr(0);
+
+	zassert_true(fd >= 0);
+	notify_fn_ran = false;
+
+	zassert_ok(sys_msgq_notify(fd, &notify));
+	zassert_ok(sys_msgq_send(fd, "wake", 5, 0, K_NO_WAIT));
+
+	for (int i = 0; (i < 100) && !notify_fn_ran; i++) {
+		k_msleep(10);
+	}
+	zassert_true(notify_fn_ran, "function notification did not run");
+
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(sys_msgq_unlink(QNAME));
+}
+
+ZTEST_USER(sys_msgq, test_sys_msgq_notify)
+{
+	section_reset();
+	notify_signal_fires();
+	section_reset();
+	notify_signal_none();
+	section_reset();
+	notify_errors();
+	if (IS_ENABLED(CONFIG_SIGNAL) && IS_ENABLED(CONFIG_SYS_THREAD) &&
+	    IS_ENABLED(CONFIG_THREAD_DETACH)) {
+		section_reset();
+		notify_function_fires();
+	}
+	section_reset();
+}
+
+ZTEST_SUITE(sys_msgq, NULL, NULL, NULL, NULL, NULL);
