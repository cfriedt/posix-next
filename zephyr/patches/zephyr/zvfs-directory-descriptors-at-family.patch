+/** @brief zvfs_openat() with ZVFS_AT_FDCWD. */
+static inline int zvfs_open(const char *name, int flags, int mode)
+{
+	return zvfs_openat(ZVFS_AT_FDCWD, name, flags, mode);
+}
+
+/** @brief zvfs_unlinkat() with ZVFS_AT_FDCWD and no flags: remove a file. */
+static inline int zvfs_unlink(const char *path)
+{
+	return zvfs_unlinkat(ZVFS_AT_FDCWD, path, 0);
+}
+
+/** @brief zvfs_unlinkat() with ZVFS_AT_FDCWD and ZVFS_AT_REMOVEDIR: remove an empty directory. */
+static inline int zvfs_rmdir(const char *path)
+{
+	return zvfs_unlinkat(ZVFS_AT_FDCWD, path, ZVFS_AT_REMOVEDIR);
+}
+
+/** @brief Remove a file, or an empty directory, as ISO C remove() requires. */
+static inline int zvfs_remove(const char *path)
+{
+	int ret = zvfs_unlinkat(ZVFS_AT_FDCWD, path, 0);
+
+	if ((ret < 0) && (errno == EISDIR)) {
+		ret = zvfs_unlinkat(ZVFS_AT_FDCWD, path, ZVFS_AT_REMOVEDIR);
+	}
+
+	return ret;
+}
+
+/** @brief zvfs_renameat() with ZVFS_AT_FDCWD for both paths. */
+static inline int zvfs_rename(const char *old, const char *newp)
+{
+	return zvfs_renameat(ZVFS_AT_FDCWD, old, ZVFS_AT_FDCWD, newp);
