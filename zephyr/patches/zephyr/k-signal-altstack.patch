+	zassert_true(on_altstack(altstack_handler_local), "handler stack %p",
+		     (void *)altstack_handler_local);
+	zassert_equal(altstack_handler_flags, K_SIG_SS_ONSTACK);
+	zassert_equal(altstack_handler_set, -EPERM);
+	zassert_equal(altstack_ret[2], 0, "flags %d after the handler", altstack_ret[2]);
+}
+
+static void k_sig_altstack_not_onstack(void)
+{
+	k_sig_altstack_run(ALTSTACK_NOT_ONSTACK);
+	zassert_not_equal(altstack_handler_local, 0, "the handler did not run");
+	zassert_false(on_altstack(altstack_handler_local));
+	zassert_equal(altstack_handler_flags, 0);
+	zassert_ok(altstack_handler_set);
+}
+
+#ifdef CONFIG_SIGNAL_FAULT
+static void k_sig_altstack_bad_sp(void)
