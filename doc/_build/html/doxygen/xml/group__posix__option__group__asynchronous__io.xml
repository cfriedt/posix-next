</simplesect>
<simplesect kind="see"><para><ulink url="https://pubs.opengroup.org/onlinepubs/9699919799/functions/aio_fsync.html">https://pubs.opengroup.org/onlinepubs/9699919799/functions/aio_fsync.html</ulink> </para>
</simplesect>
</para>
