diff --git a/include/zephyr/sys/copy_checked.h b/include/zephyr/sys/copy_checked.h
new file mode 100644
--- /dev/null
+++ b/include/zephyr/sys/copy_checked.h
@@ -0,0 +1,38 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_SYS_COPY_CHECKED_H_
+#define ZEPHYR_INCLUDE_SYS_COPY_CHECKED_H_
+
+#include <stddef.h>
+
+#include <zephyr/toolchain.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Copy between two buffers of the caller, failing instead of faulting
+ *
+ * For a user-mode caller, both buffers are checked against the caller's memory domain first.
+ * A kernel-mode caller gets a plain copy.
+ *
+ * @param dst destination, written by the caller
+ * @param src source, read by the caller
+ * @param size number of bytes
+ *
+ * @retval 0 on success
+ * @retval -EFAULT if a user-mode caller may not read @a src or write @a dst
+ */
+__syscall int sys_copy_checked(void *dst, const void *src, size_t size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <zephyr/syscalls/copy_checked.h>
+
+#endif /* ZEPHYR_INCLUDE_SYS_COPY_CHECKED_H_ */
