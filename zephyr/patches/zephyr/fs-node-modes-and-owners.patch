+static int attr_lookup(struct tmpfs_data *fs, struct fs_mount_t *mountp, const char *name,
+		       bool nofollow, struct tmpfs_node **node)
+{
+	const char *path = fs_impl_strip_prefix(name, mountp);
+	struct tmpfs_lookup l;
+	int rc = lookup(fs, path, nofollow, &l);
+
+	if ((rc == 0) && (l.node == NULL)) {
