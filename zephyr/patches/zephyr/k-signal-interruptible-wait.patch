+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(1)));
+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(1)));
+	zassert_ok(k_kill(child, K_SIG_CONT));
+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(1)));
+	stop_child_release = true;
+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(5)));
+	k_thread_priority_set(k_current_get(), prio);
+	zassert_ok(k_thread_join(&waiter_thread, K_SECONDS(1)));
