diff --git a/include/zephyr/kernel.h b/include/zephyr/kernel.h
--- a/include/zephyr/kernel.h
+++ b/include/zephyr/kernel.h
@@ -8646,6 +8646,18 @@ __syscall int k_clone(const struct k_clone_args *args, k_tid_t *child);
  */
 __syscall int k_process_prune(void);
 
+/**
+ * @brief Accumulated CPU cycles of the calling process and its reaped children
+ *
+ * @param self     filled with this process's cycles (live members plus exited
+ *                 members), or NULL
+ * @param children filled with the cycles of reaped children (and their
+ *                 reaped children), or NULL
+ *
+ * @retval 0 on success
+ */
+__syscall int k_process_cpu_stats(uint64_t *self, uint64_t *children);
+
 /**
  * @brief Initialize a process group from caller-provided memory
  *
diff --git a/include/zephyr/kernel/process.h b/include/zephyr/kernel/process.h
--- a/include/zephyr/kernel/process.h
+++ b/include/zephyr/kernel/process.h
@@ -255,6 +255,12 @@ struct k_process {
 	_wait_q_t waitq;
 	/** Node in the kernel's registry of live process records */
 	sys_dnode_t active_node;
+#ifdef CONFIG_SCHED_THREAD_USAGE
+	/** CPU cycles of this process's exited member threads */
+	uint64_t self_cycles;
+	/** CPU cycles accumulated from reaped children (and their children) */
+	uint64_t child_cycles;
+#endif /* CONFIG_SCHED_THREAD_USAGE */
 #ifdef CONFIG_SIGNAL
 	/** Count of process-scoped pending signals (any member may claim) */
 	atomic_t sig_pending;
diff --git a/kernel/process.c b/kernel/process.c
--- a/kernel/process.c
+++ b/kernel/process.c
@@ -345,6 +345,11 @@ static void process_free_locked(struct k_process *proc, bool sched_locked)
 {
 	k_tid_t leader = proc->leader;
 
+#ifdef CONFIG_SCHED_THREAD_USAGE
+	if (proc->parent != NULL) {
+		proc->parent->child_cycles += proc->self_cycles + proc->child_cycles;
+	}
+#endif /* CONFIG_SCHED_THREAD_USAGE */
 	pgrp_leave_locked(proc);
 	sys_dlist_remove(&proc->active_node);
 #ifdef CONFIG_SIGNAL
@@ -403,6 +408,15 @@ void z_process_exit_thread(struct k_thread *thread)
 		thread->process = NULL;
 		z_thread_id_retire(thread);
 		/* proc->leader stays: the identity until reap, never dereferenced */
+#ifdef CONFIG_SCHED_THREAD_USAGE
+		{
+			k_thread_runtime_stats_t st;
+
+			if (k_thread_runtime_stats_get(thread, &st) == 0) {
+				proc->self_cycles += st.total_cycles;
+			}
+		}
+#endif /* CONFIG_SCHED_THREAD_USAGE */
 		last = sys_dlist_is_empty(&proc->threads);
 		if (!last || (proc == &z_proc_idle) || (proc == &z_proc_init) ||
 		    (proc == &z_proc_kth)) {
@@ -1476,6 +1490,60 @@ static inline int z_vrfy_k_process_prune(void)
 #include <zephyr/syscalls/k_process_prune_mrsh.c>
 #endif /* CONFIG_USERSPACE */
 
+int z_impl_k_process_cpu_stats(uint64_t *self, uint64_t *children)
+{
+#ifdef CONFIG_SCHED_THREAD_USAGE
+	uint64_t s = 0;
+	uint64_t c = 0;
+
+	K_SPINLOCK(&process_lock) {
+		struct k_process *proc = process_self();
+		struct k_thread *t;
+
+		s = proc->self_cycles;
+		c = proc->child_cycles;
+		SYS_DLIST_FOR_EACH_CONTAINER(&proc->threads, t, process_node) {
+			k_thread_runtime_stats_t st;
+
+			if (k_thread_runtime_stats_get(t, &st) == 0) {
+				s += st.total_cycles;
+			}
+		}
+	}
+
+	if (self != NULL) {
+		*self = s;
+	}
+	if (children != NULL) {
+		*children = c;
+	}
+
+	return 0;
+#else
+	if (self != NULL) {
+		*self = 0;
+	}
+	if (children != NULL) {
+		*children = 0;
+	}
+	return 0;
+#endif /* CONFIG_SCHED_THREAD_USAGE */
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_k_process_cpu_stats(uint64_t *self, uint64_t *children)
+{
+	if (self != NULL) {
+		K_OOPS(K_SYSCALL_MEMORY_WRITE(self, sizeof(*self)));
+	}
+	if (children != NULL) {
+		K_OOPS(K_SYSCALL_MEMORY_WRITE(children, sizeof(*children)));
+	}
+	return z_impl_k_process_cpu_stats(self, children);
+}
+#include <zephyr/syscalls/k_process_cpu_stats_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
 #ifdef CONFIG_SIGNAL
 static struct k_process *sigchld_pending_get_locked(void)
 {
