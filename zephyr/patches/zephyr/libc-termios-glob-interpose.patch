diff --git a/lib/libc/newlib/include/stdio.h b/lib/libc/newlib/include/stdio.h
new file mode 100644
--- /dev/null
+++ b/lib/libc/newlib/include/stdio.h
@@ -0,0 +1,27 @@
+/*
+ * Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_STDIO_H_
+#define ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_STDIO_H_
+
+#include_next <stdio.h>
+
+#if defined(_POSIX_C_SOURCE) || defined(_XOPEN_SOURCE)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* the toolchain's stdio.h does not declare ctermid() */
+char *ctermid(char *s);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* defined(_POSIX_C_SOURCE) || defined(_XOPEN_SOURCE) */
+
+#endif /* ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_STDIO_H_ */
