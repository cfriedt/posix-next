+#ifdef CONFIG_SIGNAL_FAULT
+/*
+ * A fault a user thread takes generates a signal for that thread: a handler it can take runs on
+ * it with the fault's code and address and may leave by a non-local jump; a handler that returns
+ * ends the thread's process (here, with a kernel-reserved process, the thread).
+ */
+ZTEST_BMEM static jmp_buf fault_env;
+ZTEST_BMEM static volatile int fault_signo;
+ZTEST_BMEM static volatile int fault_code;
+ZTEST_BMEM static void *volatile fault_addr;
+ZTEST_BMEM static volatile bool fault_jump;
+ZTEST_BMEM static volatile bool fault_resumed;
+
+static void fault_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	ARG_UNUSED(ucontext);
+
+	fault_signo = sig;
+	fault_code = info->code;
+	fault_addr = info->addr;
+	if (fault_jump) {
+		zassert_ok(k_sig_abandon(NULL));
+		longjmp(fault_env, 1);
+	}
+}
+
+static void fault_store(void *addr)
+{
+	*(volatile int *)addr = 1;
+}
+
+#ifdef CONFIG_ARM64
+static void fault_undefined(void *addr)
+{
+	ARG_UNUSED(addr);
+
+	__asm__ volatile(".inst 0x00000000" ::: "memory");
+}
+#endif /* CONFIG_ARM64 */
+
+static void fault_entry(void *arg1, void *arg2, void *arg3)
+{
+	void (*raise)(void *) = arg1;
+	struct k_sig_action action = {.handler = fault_handler};
+
+	zassert_ok(k_sig_action((int)(intptr_t)arg2, &action, NULL));
+	if (setjmp(fault_env) == 0) {
+		raise(arg3);
+		fault_resumed = true;
+	}
+}
+
+static void k_sig_fault_run(void (*raise)(void *), int signo, void *addr, bool jump)
+{
+	fault_signo = 0;
+	fault_code = 0;
+	fault_addr = NULL;
+	fault_jump = jump;
+	fault_resumed = false;
+
+	k_thread_create(&noop_test_thread, noop_test_stack, K_THREAD_STACK_SIZEOF(noop_test_stack),
+			fault_entry, raise, (void *)(intptr_t)signo, addr,
+			K_LOWEST_APPLICATION_THREAD_PRIO, K_USER | K_INHERIT_PERMS, K_NO_WAIT);
+	zassert_ok(k_thread_join(&noop_test_thread, K_FOREVER));
+	zassert_ok(k_sig_action(signo, &(struct k_sig_action){.handler = K_SIG_DFL}, NULL));
+
+	zassert_equal(fault_signo, signo, "signal %d, not %d", fault_signo, signo);
+	zassert_false(fault_resumed, "the faulting code resumed");
+}
+
+static void k_sig_fault_unmapped(void)
+{
+	k_sig_fault_run(fault_store, K_SIG_SEGV, (void *)16, true);
+	zassert_equal(fault_code, K_SEGV_MAPERR, "code %d", fault_code);
+	zassert_equal(fault_addr, (void *)16);
+}
+
+static void k_sig_fault_kernel_memory(void)
+{
+	k_sig_fault_run(fault_store, K_SIG_SEGV, &noop_test_thread, true);
+	zassert_equal(fault_code, K_SEGV_ACCERR, "code %d", fault_code);
+	zassert_equal(fault_addr, (void *)&noop_test_thread);
+}
+
+static void k_sig_fault_handler_returns(void)
+{
+	k_sig_fault_run(fault_store, K_SIG_SEGV, (void *)16, false);
+}
+
+#ifdef CONFIG_ARM64
+static void k_sig_fault_undefined_instruction(void)
+{
+	k_sig_fault_run(fault_undefined, K_SIG_ILL, NULL, true);
+	zassert_equal(fault_code, K_ILL_ILLOPC, "code %d", fault_code);
+	zassert_not_null(fault_addr);
+}
+#endif /* CONFIG_ARM64 */
