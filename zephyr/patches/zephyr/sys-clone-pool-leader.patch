+
+void sys_process_release_gc(void)
+{
+#ifdef CONFIG_SYS_THREAD
+	k_tid_t leader;
+	sys_dnode_t *n;
+
+	while (true) {
+		leader = NULL;
+		K_SPINLOCK(&pool_lock) {
+			n = sys_dlist_get(&leader_release_list);
+			if (n != NULL) {
+				leader = CONTAINER_OF(n, struct k_thread, process_node);
+			}
+		}
+		if (leader == NULL) {
+			break;
+		}
+		(void)sys_thread_destroy(leader);
+	}
+#endif /* CONFIG_SYS_THREAD */
+}
