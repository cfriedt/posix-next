diff --git a/include/zephyr/sys/process.h b/include/zephyr/sys/process.h
new file mode 100644
index 00000000000..ac784fc88d4
--- /dev/null
+++ b/include/zephyr/sys/process.h
@@ -0,0 +1,94 @@
+/*
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_SYS_PROCESS_H_
+#define ZEPHYR_INCLUDE_SYS_PROCESS_H_
+
+#include <zephyr/kernel.h>
+#include <zephyr/sys/thread.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(CONFIG_SYS_PROCESS) || defined(__DOXYGEN__)
+
+/**
+ * @brief System-layer process, process-group, and session numbering
+ * @defgroup sys_process_apis System process numbering APIs
+ *
+ * The kernel identifies processes, process groups, and sessions purely by
+ * handle; integer identities imply a namespace, and namespaces are an
+ * allocation-domain concern, so the number tables live here. Numbers are
+ * assigned lowest-free at creation (the reserved idle, init, and kthread
+ * processes receive 0, 1, and 2 by boot order) and retired with their object;
+ * a group or session is numbered after its creating process.
+ *
+ * @ingroup os_services
+ * @{
+ */
+
+/**
+ * @brief Obtain the numeric ID of a process
+ *
+ * @param pid process handle (or the handle of any live member thread)
+ * @return the numeric process ID, or -ESRCH if @a pid names no process
+ */
+__syscall int sys_process_id(k_pid_t pid);
+
+/**
+ * @brief Look up a process handle by numeric ID
+ *
+ * @param id numeric process ID
+ * @return the process handle, or NULL if no such process exists
+ */
+__syscall k_pid_t sys_process_find(int id);
+
+/**
+ * @brief Obtain the numeric ID of a process group
+ *
+ * @param pgrp process group handle
+ * @return the numeric group ID, or -ESRCH if @a pgrp names no group
+ */
+__syscall int sys_pgrp_id(k_pgrp_t pgrp);
+
+/**
+ * @brief Look up a process group by numeric ID
+ *
+ * @param id numeric process group ID
+ * @return the group handle, or NULL if no such group exists
+ */
+__syscall k_pgrp_t sys_pgrp_find(int id);
+
+/**
+ * @brief Obtain the numeric ID of a session
+ *
+ * @param session session handle
+ * @return the numeric session ID, or -ESRCH if @a session names no session
+ */
+__syscall int sys_session_id(k_session_t session);
+
+/**
+ * @brief Look up a session by numeric ID
+ *
+ * @param id numeric session ID
+ * @return the session handle, or NULL if no such session exists
+ */
+__syscall k_session_t sys_session_find(int id);
+
+/**
+ * @}
+ */
+
+#include <zephyr/syscalls/process.h>
+
+#endif /* defined(CONFIG_SYS_PROCESS) || defined(__DOXYGEN__) */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_SYS_PROCESS_H_ */
diff --git a/kernel/include/kernel_internal.h b/kernel/include/kernel_internal.h
index 87c2ac41e2e..9469218c46b 100644
--- a/kernel/include/kernel_internal.h
+++ b/kernel/include/kernel_internal.h
@@ -128,6 +128,41 @@ void z_process_init_thread(struct k_thread *thread);
 /* Remove a dying thread from its process; zombifies the process on last exit */
 void z_process_exit_thread(struct k_thread *thread);
 
+/*
+ * Release-side providers and the number query, implemented by lib/os. The
+ * kernel never calls an allocator: it hands memory back to the provider that
+ * owns it (the sys_thread_destroy() precedent), and -EINVAL identifies
+ * memory the provider does not own (static or caller-provided; reusable
+ * where it lives). Called
+ * under the process lock; may also run under the scheduler lock and must
+ * defer heap reclamation.
+ */
+#ifdef CONFIG_SYS_PROCESS
+int z_process_record_free(struct k_process *proc);
+int z_pgrp_cell_free(struct k_process_group *grp);
+int z_session_cell_free(struct k_session *session);
+#else
+static inline int z_process_record_free(struct k_process *proc)
+{
+	ARG_UNUSED(proc);
+	return -EINVAL;
+}
+
+static inline int z_pgrp_cell_free(struct k_process_group *grp)
+{
+	ARG_UNUSED(grp);
+	return -EINVAL;
+}
+
+static inline int z_session_cell_free(struct k_session *session)
+{
+	ARG_UNUSED(session);
+	return -EINVAL;
+}
+#endif /* CONFIG_SYS_PROCESS */
+
+/* validate a user-supplied group handle and every member record (under lock) */
+int z_pgrp_validate(k_pgrp_t pgrp);
 #endif /* CONFIG_PROCESS */
 
 
@@ -343,6 +385,11 @@ int z_sig_queue_msgq(k_pid_t pid, int signo, union k_sig_val value);
 int z_sig_queue_aio(k_pid_t pid, int signo, union k_sig_val value);
 #endif /* CONFIG_SYS_AIO && CONFIG_SIGNAL */
 
+#if defined(CONFIG_PROCESS) && defined(CONFIG_SIGNAL)
+/* generation-side plumbing between kernel/process.c and kernel/signal.c (internal) */
+int z_sig_queue_chld(k_tid_t tid, k_pid_t child_pid, int child_status, bool exited);
+#endif /* CONFIG_PROCESS && CONFIG_SIGNAL */
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/kernel/include/ksched.h b/kernel/include/ksched.h
index f7cedb01eb2..1c537abb442 100644
--- a/kernel/include/ksched.h
+++ b/kernel/include/ksched.h
@@ -249,6 +249,15 @@ bool z_sched_wake(_wait_q_t *wait_q, int swap_retval, void *swap_data);
  */
 void z_sched_wake_thread_locked(struct k_thread *thread);
 
+/*
+ * Pend the current thread on @a wait_q under the scheduler lock alone, unless
+ * *gen no longer equals @a expected (returns 1: the condition may have changed,
+ * rescan). For waiters whose wakers run in the thread-halt path and thus
+ * already hold the scheduler lock when taking the condition lock.
+ */
+int z_sched_waitq_pend_if(_wait_q_t *wait_q, k_timeout_t timeout, atomic_t *gen,
+			  atomic_val_t expected);
+
 /**
  * Wake up all threads pending on the provided wait queue
