-#if defined(CONFIG_RISCV)
+#if defined(CONFIG_ARM64) || defined(CONFIG_RISCV)
 #define FAULT_INSTRUCTIONS 1
 
 static void fault_undefined(void *addr)
 {
 	ARG_UNUSED(addr);
 
+#if defined(CONFIG_ARM64)
+	__asm__ volatile(".inst 0x00000000" ::: "memory");
+#elif defined(CONFIG_RISCV)
 	__asm__ volatile("unimp" ::: "memory");
+#endif
 }
 
 static void fault_breakpoint(void *addr)
 {
 	ARG_UNUSED(addr);
 
+#if defined(CONFIG_ARM64)
+	__asm__ volatile("brk #0" ::: "memory");
+#elif defined(CONFIG_RISCV)
 	__asm__ volatile("ebreak" ::: "memory");
+#endif
 }
 #endif
 
