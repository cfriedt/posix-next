diff --git a/lib/libc/newlib/include/stdio.h b/lib/libc/newlib/include/stdio.h
index cbf42614c7e..ee1534ec4d2 100644
--- a/lib/libc/newlib/include/stdio.h
+++ b/lib/libc/newlib/include/stdio.h
@@ -15,7 +15,11 @@
 extern "C" {
 #endif
 
-/* the toolchain's stdio.h does not declare renameat() */
+/* the toolchain's stdio.h has no L_ctermid: the longest pathname of the terminal, "/dev/console" */
