diff --git a/subsys/fs/fs.c b/subsys/fs/fs.c
index ff588f36fe2..5187a81003e 100644
--- a/subsys/fs/fs.c
+++ b/subsys/fs/fs.c
@@ -878,7 +878,8 @@ int fs_statvfs(const char *abs_path, struct fs_statvfs *stat)
