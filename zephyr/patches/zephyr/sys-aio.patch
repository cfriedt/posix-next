+++ b/kernel/signal.c
@@ -239,13 +239,14 @@ static int z_sig_queue_common(k_pid_t pid, int signo, union k_sig_val value, int
 	}
 
 #if defined(CONFIG_USERSPACE) && defined(CONFIG_DYNAMIC_OBJECTS)
-	if ((timer == NULL) && (code != K_SI_MSGQ) &&
+	if ((timer == NULL) && (code != K_SI_MSGQ) && (code != K_SI_ASYNCIO) &&
 	    (k_object_validate(k_object_find(pid), K_OBJ_THREAD, _OBJ_INIT_TRUE) < 0)) {
 		/*
-		 * Only allow signals from threads granted access. Timer- and message-
-		 * arrival-generated signals are kernel-originated - they fire in the
-		 * context of whatever thread sends, not the registrant's - and their
-		 * target was validated when the notification was attached or armed.
+		 * Only allow signals from threads granted access. Timer-, message-
+		 * arrival-, and I/O-completion-generated signals are kernel-originated
+		 * - they fire in the context of whatever thread sends, not the
+		 * registrant's - and their target was validated when the notification
+		 * was attached, armed, or submitted.
 		 */
 		LOG_ERR("tid %lx does not have permissions for tid %lx", POINTER_TO_UINT(_current),
 			POINTER_TO_UINT(pid));
@@ -334,6 +335,13 @@ int z_sig_queue_msgq(k_pid_t pid, int signo, union k_sig_val value)
 }
 #endif /* CONFIG_MSGQ_NOTIFY */
 
+#ifdef CONFIG_SYS_AIO
+int z_sig_queue_aio(k_pid_t pid, int signo, union k_sig_val value)
