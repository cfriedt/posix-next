+# ---------------------------------------------------------------------------------------------
+# Upstreaming support: deps / status / sync / submit
+#
+# The bookkeeping uses the standard merge-pr / merge-status / merge-commit / merge-date keys of
+# the patches.yml schema, plus the schema's free-form "custom" field:
+#
+#     custom:
+#       upstream:
+#         ignore: true | "reason"    # never submit this patch (upstreamable but deferred)
+#         depends-on: [<path>, ...]  # textual dependencies detected by "west patch deps"
+#         manual-depends-on: [...]   # semantic dependencies the tool cannot see
+#         title: "<subject>"         # commit subject / PR title override
+#         branch: <name>             # branch pushed to the fork for the PR
+#
+# A patch is "ready" when it is upstreamable, not ignored, has no PR yet, every dependency is
+# merged upstream, and it applies to the current upstream branch.
+# ---------------------------------------------------------------------------------------------
+
+BRANCH_PREFIX = "patches/"
+SUBJECT_MAX = 75
+BODY_WIDTH = 75
+DANGLING_WORDS = {
+    "a", "an", "and", "as", "by", "for", "from", "in", "into", "is", "now", "of", "on", "or",
+    "so", "that", "the", "to", "when", "which", "with",
+}  # fmt: skip
+STATUS_ORDER = [
+    "ready", "blocked", "needs-rebase", "pr-draft", "pr-open", "pr-closed", "merged",
+    "ignored", "not-upstreamable", "unknown",
+]  # fmt: skip
+
+# (regex on a repo-relative path, subject area prefix); first match wins
+AREA_RULES = [
+    (r"^include/zephyr/net/", "net"),
+    (r"^subsys/net/lib/sockets/", "net: sockets"),
+    (r"^subsys/net/", "net"),
+    (r"^tests/net/", "tests: net"),
+    (r"^samples/net/", "samples: net"),
+    (r"^lib/libc/minimal/", "libc: minimal"),
+    (r"^lib/libc/picolibc/", "libc: picolibc"),
+    (r"^lib/libc/newlib/", "libc: newlib"),
+    (r"^lib/libc/common/", "libc: common"),
+    (r"^lib/libc/", "libc"),
+    (r"^include/zephyr/kernel", "kernel"),
+    (r"^kernel/", "kernel"),
+    (r"^lib/os/", "lib: os"),
+    (r"^lib/([^/]+)/", r"lib: \1"),
+    (r"^include/zephyr/sys/", "sys"),
+    (r"^include/zephyr/arch/([^/]+)/", r"arch: \1"),
+    (r"^arch/([^/]+)/", r"arch: \1"),
+    (r"^drivers/([^/]+)/", r"drivers: \1"),
+    (r"^include/zephyr/drivers/([^/]+)", r"drivers: \1"),
+    (r"^subsys/([^/]+)/([^/]+)/", r"\1: \2"),
+    (r"^subsys/([^/]+)/", r"\1"),
+    (r"^tests/([^/]+)/([^/]+)/", r"tests: \1: \2"),
+    (r"^tests/([^/]+)/", r"tests: \1"),
+    (r"^samples/([^/]+)/", r"samples: \1"),
+    (r"^scripts/west_commands/", "scripts: west_commands"),
+    (r"^doc/", "doc"),
+    (r"^scripts/", "scripts"),
+    (r"^boards/", "boards"),
+    (r"^cmake/", "cmake"),
+    (r"^modules/", "modules"),
+    (r"^soc/", "soc"),
+    (r"^dts/", "dts"),
+    (r"^include/zephyr/([^/]+)/", r"\1"),
+    (r"^include/zephyr/([^/]+)\.h$", r"\1"),
+]
