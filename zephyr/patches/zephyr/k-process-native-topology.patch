+static volatile int unclaimed_seen;
+static K_SEM_DEFINE(unclaimed_ready, 0, 1);
+
+static void unclaimed_exit_leader(void *p1, void *p2, void *p3)
+{
+	struct k_sig_set set;
+
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	/* an eligible target that exits before anything would claim the signal queued to it */
+	k_sig_emptyset(&set);
+	k_sig_addset(&set, K_SIG_USR1);
+	(void)k_sig_mask(K_SIG_UNBLOCK, &set, NULL);
+	k_sem_give(&unclaimed_ready);
+	/* parked here with the signal queued: the killer takes the process down from outside */
+	k_sleep(K_FOREVER);
+}
+
+static void unclaimed_probe_leader(void *p1, void *p2, void *p3)
+{
+	struct k_sig_set set;
+
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	k_sig_emptyset(&set);
+	k_sig_addset(&set, K_SIG_USR1);
+	(void)k_sig_mask(K_SIG_UNBLOCK, &set, NULL);
+	unclaimed_seen = k_sig_timedwait(&set, NULL, K_NO_WAIT);
+	k_exit(0);
+}
+
+/* a signal a child never claimed does not reach the next child drawn on its thread object */
+static void kill_unclaimed_reuse(void)
+{
+	int ws = 1;
+	k_pid_t child = NULL;
+	struct sys_clone_args pool = {
+		.entry = unclaimed_exit_leader,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
+	};
+
+	zassert_ok(sys_clone(&pool, &child));
+	zassert_ok(k_sem_take(&unclaimed_ready, K_SECONDS(5)));
+	zassert_ok(k_kill(child, K_SIG_USR1));
+	k_thread_abort(child);
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_FOREVER));
+
+	unclaimed_seen = 0;
+	pool.entry = unclaimed_probe_leader;
+	zassert_ok(sys_clone(&pool, &child));
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_FOREVER));
+	zassert_equal(unclaimed_seen, -EAGAIN,
+		      "the previous child's signal reached its successor (%d; 0: it was terminated by it)",
+		      unclaimed_seen);
+}
+
