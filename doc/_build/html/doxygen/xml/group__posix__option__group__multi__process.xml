        <type>int</type>
        <definition>int pthread_atfork</definition>
        <argsstring>(void(*prepare)(void), void(*parent)(void), void(*child)(void))</argsstring>
        <name>pthread_atfork</name>
        <param>
          <type>void(*)(void)</type>
          <declname>prepare</declname>
        </param>
        <param>
          <type>void(*)(void)</type>
          <declname>parent</declname>
        </param>
        <param>
          <type>void(*)(void)</type>
          <declname>child</declname>
        </param>
        <briefdescription>
<para>Register fork handlers to be called around <ref refid="group__posix__option__group__multi__process_1gaa4e4714e6e8927c80b2553a40094b6d9" kindref="member">fork()</ref>. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>prepare</parametername>
</parameternamelist>
<parameterdescription>
<para>Handler called in the parent before <ref refid="group__posix__option__group__multi__process_1gaa4e4714e6e8927c80b2553a40094b6d9" kindref="member">fork()</ref>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>parent</parametername>
</parameternamelist>
<parameterdescription>
<para>Handler called in the parent after <ref refid="group__posix__option__group__multi__process_1gaa4e4714e6e8927c80b2553a40094b6d9" kindref="member">fork()</ref>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>child</parametername>
</parameternamelist>
<parameterdescription>
<para>Handler called in the child after <ref refid="group__posix__option__group__multi__process_1gaa4e4714e6e8927c80b2553a40094b6d9" kindref="member">fork()</ref>. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>0 on success, or a positive error number on failure. </para>
</simplesect>
<simplesect kind="see"><para><ulink url="https://pubs.opengroup.org/onlinepubs/9699919799/functions/pthread_atfork.html">https://pubs.opengroup.org/onlinepubs/9699919799/functions/pthread_atfork.html</ulink> </para>
</simplesect>
</para>
