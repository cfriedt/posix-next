+#ifdef CONFIG_ARM64
+#include <zephyr/syscall_list.h>
+
+ZTEST_BMEM static volatile int ctx_handler_ran;
+
+/* leaves every register a handler may change as it likes */
+static void ctx_clobber_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	ARG_UNUSED(sig);
+	ARG_UNUSED(info);
+	ARG_UNUSED(ucontext);
+	ctx_handler_ran++;
+	__asm__ volatile("mov x0, #0x90000000\n"
+			 "msr nzcv, x0\n"
+			 "mov x9, #0xdead\n mov x10, #0xdead\n mov x11, #0xdead\n mov x12, #0xdead\n"
+			 "mov x13, #0xdead\n mov x14, #0xdead\n mov x15, #0xdead\n mov x16, #0xdead\n"
+			 "mov x17, #0xdead\n mov x18, #0xdead\n"
+			 : : : "x0", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "x18",
+			       "cc", "memory");
+}
+
+/*
+ * The handler runs between a syscall and the instruction after it. The callee-saved
+ * registers (x19-x29), the stack pointer, the link register, the flags and the
+ * syscall's return value must be what they were; the compiler keeps nothing else live
+ * across the trap.
+ */
+ZTEST_USER(signal, test_handler_return_restores_context)
+{
+	struct k_sig_action action = {.handler = ctx_clobber_handler, .flags = K_SIG_SA_SIGINFO};
+	uint64_t out[16] = {0}; /* ret, nzcv, sp before, sp after, lr, x19..x29 */
+	struct {
+		uint64_t o, tid, signo, id;
+	} in = {(uint64_t)out, (uint64_t)k_current_get(), K_SIG_USR1, K_SYSCALL_K_SIG_QUEUE};
+
+	zassert_ok(k_sig_action(K_SIG_USR1, &action, NULL));
+	ctx_handler_ran = 0;
+	__asm__ volatile("ldr x0, %[tid]\n"
+			 "ldr x1, %[signo]\n"
+			 "mov x2, #0\n"
+			 "ldr x8, %[id]\n"
+			 "ldr x3, %[o]\n"
+			 "mov x4, sp\n"
+			 "str x4, [x3, #16]\n"
+			 "mov x19, #0x1013\n mov x20, #0x1014\n mov x21, #0x1015\n mov x22, #0x1016\n"
+			 "mov x23, #0x1017\n mov x24, #0x1018\n mov x25, #0x1019\n mov x26, #0x101a\n"
+			 "mov x27, #0x101b\n mov x28, #0x101c\n mov x29, #0x101d\n mov x30, #0x101e\n"
+			 "mov x3, #0x60000000\n"
+			 "msr nzcv, x3\n"
+			 "svc #3\n"
+			 "ldr x1, %[o]\n"
+			 "str x0, [x1, #0]\n"
+			 "mrs x0, nzcv\n"
+			 "str x0, [x1, #8]\n"
+			 "mov x0, sp\n"
+			 "str x0, [x1, #24]\n"
+			 "str x30, [x1, #32]\n"
+			 "stp x19, x20, [x1, #40]\n stp x21, x22, [x1, #56]\n stp x23, x24, [x1, #72]\n"
+			 "stp x25, x26, [x1, #88]\n stp x27, x28, [x1, #104]\n str x29, [x1, #120]\n"
+			 :
+			 : [o] "m"(in.o), [tid] "m"(in.tid), [signo] "m"(in.signo), [id] "m"(in.id)
+			 : "x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12",
+			   "x13", "x14", "x15", "x16", "x17", "x18", "x19", "x20", "x21", "x22", "x23", "x24",
+			   "x25", "x26", "x27", "x28", "x29", "x30", "cc", "memory");
+	zassert_equal(ctx_handler_ran, 1);
+	zassert_equal(out[0], 0, "k_sig_queue() returned %lld", (long long)out[0]);
+	zassert_equal(out[1], 0x60000000, "flags 0x%llx", (unsigned long long)out[1]);
+	zassert_equal(out[2], out[3], "sp moved by %lld", (long long)(out[3] - out[2]));
+	zassert_equal(out[4], 0x101e, "lr 0x%llx", (unsigned long long)out[4]);
+	for (int i = 0; i < 11; i++) {
+		zassert_equal(out[5 + i], 0x1013 + i, "x%d 0x%llx", 19 + i,
+			      (unsigned long long)out[5 + i]);
+	}
+	action.handler = K_SIG_DFL;
+	action.flags = 0;
+	zassert_ok(k_sig_action(K_SIG_USR1, &action, NULL));
+}
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+#include <zephyr/syscall_list.h>
+
+ZTEST_BMEM static volatile int ctx_handler_ran;
+
+/* leaves every register a handler may change as it likes */
+static void ctx_clobber_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	ARG_UNUSED(sig);
+	ARG_UNUSED(info);
+	ARG_UNUSED(ucontext);
+	ctx_handler_ran++;
+	__asm__ volatile("movs r0, #0\n"
+			 "movw r1, #0xdead\n movw r2, #0xdead\n movw r3, #0xdead\n movw ip, #0xdead\n"
+			 : : : "r0", "r1", "r2", "r3", "ip", "cc", "memory");
+}
+
+/*
+ * The handler runs between a syscall and the instruction after it. The callee-saved
+ * registers (r4-r11, less r6 and r8 that the syscall ABI owns and r7 that the test
+ * cannot touch as the frame pointer), the stack pointer, the link register and the
+ * syscall's return value must be what they were; the compiler keeps nothing else live
+ * across the trap, the flags included.
+ */
+ZTEST_USER(signal, test_handler_return_restores_context)
+{
+	struct k_sig_action action = {.handler = ctx_clobber_handler, .flags = K_SIG_SA_SIGINFO};
+	uint32_t out[9] = {0}; /* ret, sp before, sp after, lr, r4, r5, r9..r11 */
+	struct {
+		uint32_t o, tid, signo, id;
+	} in = {(uint32_t)out, (uint32_t)k_current_get(), K_SIG_USR1, K_SYSCALL_K_SIG_QUEUE};
+
+	zassert_ok(k_sig_action(K_SIG_USR1, &action, NULL));
+	ctx_handler_ran = 0;
+	__asm__ volatile("ldr r0, %[tid]\n"
+			 "ldr r1, %[signo]\n"
+			 "movs r2, #0\n"
+			 "ldr r6, %[id]\n"
+			 "ldr r3, %[o]\n"
+			 "mov r4, sp\n"
+			 "str r4, [r3, #4]\n"
+			 "movw r4, #0x1014\n movw r5, #0x1015\n"
+			 "movw r9, #0x1019\n movw r10, #0x101a\n movw r11, #0x101b\n"
+			 "movw lr, #0x101e\n"
+			 "svc #3\n"
+			 "ldr r1, %[o]\n"
+			 "str r0, [r1, #0]\n"
+			 "mov r0, sp\n"
+			 "str r0, [r1, #8]\n"
+			 "str lr, [r1, #12]\n"
+			 "str r4, [r1, #16]\n str r5, [r1, #20]\n"
+			 "str r9, [r1, #24]\n str r10, [r1, #28]\n str r11, [r1, #32]\n"
+			 :
+			 : [o] "m"(in.o), [tid] "m"(in.tid), [signo] "m"(in.signo), [id] "m"(in.id)
+			 : "r0", "r1", "r2", "r3", "r4", "r5", "r6", "r8", "r9", "r10", "r11", "ip", "lr",
+			   "cc", "memory");
+	zassert_equal(ctx_handler_ran, 1);
+	zassert_equal(out[0], 0, "k_sig_queue() returned %d", (int)out[0]);
+	zassert_equal(out[1], out[2], "sp moved by %d", (int)(out[2] - out[1]));
+	zassert_equal(out[3], 0x101e, "lr 0x%x", out[3]);
+	zassert_equal(out[4], 0x1014, "r4 0x%x", out[4]);
+	zassert_equal(out[5], 0x1015, "r5 0x%x", out[5]);
+	for (int i = 0; i < 3; i++) {
+		zassert_equal(out[6 + i], 0x1019 + i, "r%d 0x%x", 9 + i, out[6 + i]);
+	}
+	action.handler = K_SIG_DFL;
+	action.flags = 0;
+	zassert_ok(k_sig_action(K_SIG_USR1, &action, NULL));
+}
+#endif /* CONFIG_ARM64 */
