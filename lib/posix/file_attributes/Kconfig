config POSIX_FILE_ATTRIBUTES
	bool "POSIX file ownership and permissions"
	depends on POSIX_FILE_SYSTEM
	help
	  Select 'y' here and Zephyr will provide implementations of the
	  POSIX_FILE_ATTRIBUTES Option Group: chmod(), chown(), fchmod(),
	  fchown(), and umask(). Zephyr file systems store neither owners
	  nor permission bits, so attribute changes on existing files
	  succeed without effect.
