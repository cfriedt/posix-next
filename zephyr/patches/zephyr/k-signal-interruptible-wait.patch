+
+bool z_sig_pend_end(unsigned long token)
+{
+	struct k_sig_ctx *const ctx = &_current->base.sig;
+
+	ctx->pend_interruptible = false;
+	ctx->pend_interrupted = false;
+
+	return ((unsigned long)atomic_get(&ctx->delivered) != token) || z_sig_interrupts();
