diff --git a/include/zephyr/sys/thread.h b/include/zephyr/sys/thread.h
index c6f2ce485f3..6685a79d058 100644
--- a/include/zephyr/sys/thread.h
+++ b/include/zephyr/sys/thread.h
@@ -237,6 +237,32 @@ __syscall int sys_thread_stack_destroy(k_thread_stack_t *stack);
  */
 __syscall int sys_thread_destroy(struct k_thread *th);
 
+/**
+ * @brief Stage a block at the top of the calling thread's stack
+ *
+ * Reserves @p bytes at the lowest addresses of the calling thread's own
+ * stack for data that must survive sys_thread_restart(): the caller's live
+ * frames occupy the top, and the restarted frame grows down from the top
+ * toward the staged block. Kernel-mode only.
+ *
+ * @return the staged block, or NULL if @p bytes does not clear the calling
+ *         frames or the architecture lacks stack-jump support
+ */
+void *sys_thread_stack_stage(size_t bytes);
+
+/**
+ * @brief Restart the calling thread at the base of its own stack
+ *
+ * Abandons every live frame: the stack pointer is reset to the top of the
+ * calling thread's own stack and @p fn is entered with the staged block as
+ * its argument, never to return - the exec() model with the thread and
+ * stack reused in place. Kernel-mode only.
+ *
+ * @retval -ENOTSUP when the architecture lacks stack-jump support
+ *         (on success this function does not return)
+ */
+int sys_thread_restart(void (*fn)(void *), size_t staged_bytes);
+
 /**
  * INTERNAL_HIDDEN @endcond
  */
diff --git a/kernel/include/kernel_internal.h b/kernel/include/kernel_internal.h
index 08567c96bdf..649a7451cbf 100644
--- a/kernel/include/kernel_internal.h
+++ b/kernel/include/kernel_internal.h
@@ -113,6 +113,11 @@ extern int z_stack_adjust_initialized;
 
 extern struct k_thread z_main_thread;
 
+#ifdef CONFIG_ARCH_HAS_STACK_JUMP
+/* reset SP and enter fn(arg), abandoning every frame below; never returns */
+FUNC_NORETURN void arch_stack_jump(void *sp, void (*fn)(void *), void *arg);
+#endif /* CONFIG_ARCH_HAS_STACK_JUMP */
+
 #ifdef CONFIG_PROCESS
 /* the three kernel-reserved processes: idle, init, and the kthread process */
 extern struct k_process z_proc_idle;
diff --git a/lib/os/thread.c b/lib/os/thread.c
index c77d684be58..afa4c6e9036 100644
--- a/lib/os/thread.c
+++ b/lib/os/thread.c
@@ -8,6 +8,7 @@
 #include <ksched.h>
 
 #include <zephyr/internal/syscall_handler.h>
+#include <kernel_internal.h>
 #include <zephyr/logging/log.h>
 #include <zephyr/kernel.h>
 #include <zephyr/kernel/mm.h>
@@ -1013,3 +1014,64 @@ static void print_stats(const struct ztest_unit_test *test, void *data)
 
 ZTEST_RULE(sys_thread_rule, NULL, print_stats);
 #endif /* CONFIG_ZTEST */
+
+#ifdef CONFIG_ARCH_HAS_STACK_JUMP
+/*
+ * The staged block lives at the BASE of the stack: the caller's live frames
+ * occupy the top, so staging there would clobber the very frames doing the
+ * packing. The restarted frame starts at the top and only reaches the
+ * staged data by exhausting the stack.
+ */
+static uintptr_t stack_stage_base(size_t bytes)
+{
+	char probe;
+	k_tid_t th = k_current_get();
+	/* keep clear of the stack sentinel word at the very base */
+	uintptr_t base = ROUND_UP(th->stack_info.start +
+					  (IS_ENABLED(CONFIG_STACK_SENTINEL) ? 16 : 0),
+				  16);
+
+	/* the packing frames must stay clear of the staged block */
+	if ((uintptr_t)&probe < (base + bytes + 512)) {
+		return 0;
+	}
+
+	return base;
+}
+
+void *sys_thread_stack_stage(size_t bytes)
+{
+	return (void *)stack_stage_base(bytes);
+}
+
+int sys_thread_restart(void (*fn)(void *), size_t staged_bytes)
+{
+	uintptr_t base = stack_stage_base(staged_bytes);
+	k_tid_t th = k_current_get();
+	/* the creation-time initial SP: stack_info.size includes the TLS
+	 * block above it, which the restarted frames must not touch
+	 */
+	uintptr_t top = ROUND_DOWN(
+		th->stack_info.start + th->stack_info.size - th->stack_info.delta, 16);
+
+	if (base == 0) {
+		return -EINVAL;
+	}
+
+	arch_stack_jump((void *)top, fn, (void *)base);
+	CODE_UNREACHABLE;
+}
+#else
+void *sys_thread_stack_stage(size_t bytes)
+{
+	ARG_UNUSED(bytes);
+	return NULL;
+}
+
+int sys_thread_restart(void (*fn)(void *), size_t staged_bytes)
+{
+	ARG_UNUSED(fn);
+	ARG_UNUSED(staged_bytes);
+	return -ENOTSUP;
+}
+#endif /* CONFIG_ARCH_HAS_STACK_JUMP */
