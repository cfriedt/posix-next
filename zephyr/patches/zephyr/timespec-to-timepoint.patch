diff --git a/include/zephyr/sys/timeutil.h b/include/zephyr/sys/timeutil.h
index 5eb23abfdd0..a2abfa5d3fb 100644
--- a/include/zephyr/sys/timeutil.h
+++ b/include/zephyr/sys/timeutil.h
@@ -690,6 +690,69 @@ static inline k_timeout_t timespec_to_timeout(const struct timespec *req, struct
 	return timeout;
 }
 
+/**
+ * @brief Convert an absolute clock timespec to a kernel timepoint
+ *
+ * In contrast to @ref timespec_to_timeout, which operates on relative time durations, this
+ * function converts the absolute time point described by @p abstime to a @ref k_timepoint_t which
+ * is currently specified as a number of ticks relative to system boot.
+ *
+ * @param abstime absolute time to convert
+ * @param clock_id clock by which @p abstime is measured
+ * @return the equivalent kernel time point
+ */
+k_timepoint_t timespec_abs_to_timepoint(uint32_t clock_id, const struct timespec *abstime);
+
+/**
+ * @brief Convert an absolute realtime clock timespec to a kernel timepoint
+ *
+ * In contrast to @ref timespec_to_timeout, which operates on relative time durations, this
+ * function converts the absolute time point described by @p abstime to a @ref k_timepoint_t which
+ * is currently specified as a number of ticks relative to system boot.
+ *
+ * Furthermore, this function assumes that @p abstime is defined with respect to the "wall clock",
+ * @ref SYS_CLOCK_REALTIME, and that it is defined with respect to the epoch, on January 1, 1970
+ * at 00:00:00 UTC.
+ *
+ * @param abstime absolute time to convert
+ * @return the equivalent kernel time point
+ */
+ static inline k_timepoint_t timespec_abs_rt_to_timepoint(const struct timespec *abstime)
+ {
+	return timespec_abs_to_timepoint(SYS_CLOCK_REALTIME, abstime);
+ }
+
+#if defined(CONFIG_TIMEOUT_64BIT) || defined(__DOXYGEN__)
+/**
+ * @brief Convert an absolute clock timespec directly to an absolute kernel timeout
+ *
+ * This function converts the absolute time point described by @p abstime, measured against the
+ * clock @p clock_id, to an absolute @ref k_timeout_t (as generated by `K_TIMEOUT_ABS_TICKS()`).
+ * The result may be passed to any kernel API that accepts a @ref k_timeout_t and expires
+ * immediately after the system uptime reaches the deadline. Deadlines already in the past expire
+ * immediately.
+ *
+ * The conversion is performed coherently, in a single step: @ref SYS_CLOCK_MONOTONIC deadlines
+ * convert directly to uptime ticks without sampling "now" at all, and @ref SYS_CLOCK_REALTIME
+ * deadlines require only one read of the realtime clock offset. Prefer this function for arming
+ * absolute timeouts. In particular, do not convert via @ref timespec_abs_to_timepoint followed by
+ * `sys_timepoint_timeout()` for that purpose - the latter yields a *relative* timeout by
+ * re-sampling the current time, re-introducing conversion variance on every use.
+ *
+ * @note For @ref SYS_CLOCK_REALTIME deadlines, the realtime clock offset is captured at
+ * conversion time; a subsequent `sys_clock_settime()` does not re-target timeouts that were
+ * already armed with the returned value.
+ *
+ * @param clock_id the clock against which @p abstime is measured (@ref SYS_CLOCK_MONOTONIC or
+ * @ref SYS_CLOCK_REALTIME)
+ * @param abstime the absolute time point to convert (must be a valid timespec)
+ * @return the equivalent absolute kernel timeout
+ *
+ * @kconfig_dep{CONFIG_TIMEOUT_64BIT}
+ */
+k_timeout_t timespec_abs_to_timeout(uint32_t clock_id, const struct timespec *abstime);
+#endif /* defined(CONFIG_TIMEOUT_64BIT) || defined(__DOXYGEN__) */
+
 /**
  * @}
  */
diff --git a/lib/utils/timeutil.c b/lib/utils/timeutil.c
index c42d977338f..73c098c49f8 100644
--- a/lib/utils/timeutil.c
+++ b/lib/utils/timeutil.c
@@ -241,3 +241,54 @@ bool timespec_normalize(struct timespec *ts)
 
 	return true;
 }
+
+k_timepoint_t timespec_abs_to_timepoint(uint32_t clock_id, const struct timespec *abstime)
+{
+	struct timespec now;
+	int __maybe_unused rc;
+	struct timespec duration = *abstime;
+
+	rc = sys_clock_gettime(clock_id, &now);
+	__ASSERT(rc == 0, "%s() %s: %d", "sys_clock_gettime", "failed", rc);
+	rc = (int)timespec_sub(&duration, &now);
+	__ASSERT(rc == 1, "%s() %s: %d", "timespec_sub", "overflowed", rc);
+
+	return sys_timepoint_calc(timespec_to_timeout(&duration, NULL));
+}
+
+#ifdef CONFIG_TIMEOUT_64BIT
+k_timeout_t timespec_abs_to_timeout(uint32_t clock_id, const struct timespec *abstime)
+{
+	uint64_t tick;
+	struct timespec mono = *abstime;
+
+	__ASSERT_NO_MSG((abstime != NULL) && timespec_is_valid(abstime));
+
+	if (clock_id == SYS_CLOCK_REALTIME) {
+		struct timespec offset;
+
+		/*
+		 * Rebase the wall-clock deadline onto SYS_CLOCK_MONOTONIC (uptime).
+		 *
+		 * TODO(clock-settime-reactive-waits): the realtime offset is pinned here;
+		 * a later sys_clock_settime() does not re-target timeouts already armed
+		 * with this value.
+		 */
+		sys_clock_getrtoffset(&offset);
+		(void)timespec_sub(&mono, &offset);
+	}
+
+	if (mono.tv_sec < 0) {
+		/* deadline already in the past: expire immediately */
+		tick = 0;
+	} else {
+		/*
+		 * SYS_CLOCK_MONOTONIC is the uptime clock, so the deadline converts to
+		 * ticks directly - no "now" sampling, no absolute/relative round-trip.
+		 */
+		tick = k_sec_to_ticks_ceil64(mono.tv_sec) + k_ns_to_ticks_ceil64(mono.tv_nsec);
+	}
+
+	return Z_TIMEOUT_TICKS(Z_TICK_ABS((k_ticks_t)MIN(tick, (uint64_t)(INT64_MAX - 1))));
+}
+#endif /* CONFIG_TIMEOUT_64BIT */
diff --git a/tests/lib/timespec_util/src/main.c b/tests/lib/timespec_util/src/main.c
index 4f342baedb3..c814d06a554 100644
--- a/tests/lib/timespec_util/src/main.c
+++ b/tests/lib/timespec_util/src/main.c
@@ -550,6 +550,52 @@ ZTEST(timeutil_api, test_timespec_to_timeout)
 #endif
 }
 
+ZTEST(timeutil_api, test_timespec_abs_to_timeout)
+{
+	if (!IS_ENABLED(CONFIG_TIMEOUT_64BIT)) {
+		ztest_test_skip();
+	}
+
+#ifdef CONFIG_TIMEOUT_64BIT
+	uint64_t tick;
+	struct timespec abstime;
+	struct timespec offset;
+	struct timespec step;
+
+	/* monotonic deadlines convert directly to uptime ticks (no "now" sampling) */
+	abstime = SYS_TIMESPEC(2, NSEC_PER_SEC / 2);
+	tick = k_sec_to_ticks_ceil64(2) + k_ns_to_ticks_ceil64(NSEC_PER_SEC / 2);
+	zexpect_true(K_TIMEOUT_EQ(timespec_abs_to_timeout(SYS_CLOCK_MONOTONIC, &abstime),
+				  K_TIMEOUT_ABS_TICKS(tick)),
+		     "monotonic deadline did not convert to the expected absolute tick");
+
+	/* the monotonic epoch (uptime 0) is always in the past: expires immediately */
+	abstime = SYS_TIMESPEC(0, 0);
+	zexpect_true(K_TIMEOUT_EQ(timespec_abs_to_timeout(SYS_CLOCK_MONOTONIC, &abstime),
+				  K_TIMEOUT_ABS_TICKS(0)),
+		     "past monotonic deadline is not an immediate absolute timeout");
+
+	/* realtime deadlines are rebased by exactly the current realtime offset */
+	sys_clock_getrtoffset(&offset);
+	abstime = offset;
+	step = SYS_TIMESPEC(3, 0);
+	zassert_true(timespec_add(&abstime, &step));
+	tick = k_sec_to_ticks_ceil64(3);
+	zexpect_true(K_TIMEOUT_EQ(timespec_abs_to_timeout(SYS_CLOCK_REALTIME, &abstime),
+				  K_TIMEOUT_ABS_TICKS(tick)),
+		     "realtime deadline did not rebase onto the monotonic clock");
+
+	/* realtime deadline that rebases to before boot: expires immediately */
+	sys_clock_getrtoffset(&offset);
+	abstime = offset;
+	step = SYS_TIMESPEC(-1, 0);
+	zassert_true(timespec_add(&abstime, &step));
+	zexpect_true(K_TIMEOUT_EQ(timespec_abs_to_timeout(SYS_CLOCK_REALTIME, &abstime),
+				  K_TIMEOUT_ABS_TICKS(0)),
+		     "pre-boot realtime deadline is not an immediate absolute timeout");
+#endif /* CONFIG_TIMEOUT_64BIT */
+}
+
 static void *setup(void)
 {
 	TC_PRINT("CONFIG_SYS_CLOCK_TICKS_PER_SEC=%d\n", CONFIG_SYS_CLOCK_TICKS_PER_SEC);
