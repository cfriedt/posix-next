+	ctx->pend_interrupted = false;
+	ctx->pend_interruptible = true;
+	*token = (unsigned long)atomic_get(&ctx->delivered);
+	if (z_sig_interrupts()) {
+		ctx->pend_interruptible = false;
+		return false;
+	}
