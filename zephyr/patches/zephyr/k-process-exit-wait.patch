+static void proc_entry_return(void *p1, void *p2, void *p3)
+{
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	static_returns_self = k_getpid();
+	static_returns_parent = k_getppid();
+	k_sem_give(&static_returns_ran);
+}
