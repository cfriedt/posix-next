+                    "path": e.path,
+                    "stem": e.stem,
+                    "index": e.index,
+                    "unblocks": unblocks(e.path),
+                    "fix": bool(self.FIX_WORDS.search(e.comments)),
+                    "size": size,
+                    "files": len(files),
+                    "area": derive_area(files) or "-",
+                    "date": str(e.date),
