--- a/arch/Kconfig
+++ b/arch/Kconfig
@@ -146,6 +146,7 @@ config X86
 
 config RISCV
 	bool
+	select ARCH_HAS_SIGNAL_FAULT if USERSPACE
 	select ARCH_IS_SET
