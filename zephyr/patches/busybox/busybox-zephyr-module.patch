@@ -0,0 +1,11 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+
+config BUSYBOX
+	bool "Build busybox as a linkable loadable extension"
+	depends on LLEXT
+	help
+	  Build the busybox multi-call binary as an llext image that an
+	  application can place in a file system and run via the exec
+	  family. The applet set is selected by zephyr/busybox.frag in
+	  the busybox module.
diff --git a/zephyr/busybox.frag b/zephyr/busybox.frag
new file mode 100644
index 000000000..f286cb360
--- /dev/null
+++ b/zephyr/busybox.frag
@@ -0,0 +1,66 @@
+# SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Kconfig fragment merged over `make allnoconfig` to select the minimal
+# busybox applet set built for Zephyr. Symbols here are busybox Kconfig
+# symbols, not Zephyr ones.
+
+CONFIG_BUSYBOX=y
+CONFIG_SHOW_USAGE=y
+CONFIG_LFS=y
+CONFIG_BASH_IS_NONE=y
+# CONFIG_SH_IS_ASH is not set
+# CONFIG_SHELL_ASH is not set
+
+# the shell: hush, script/-c modes; interactive and job control not yet
+CONFIG_HUSH=y
+CONFIG_SHELL_HUSH=y
+CONFIG_SH_IS_HUSH=y
+# CONFIG_SH_IS_NONE is not set
+CONFIG_HUSH_INTERACTIVE=y
+# CONFIG_HUSH_JOB is not set
+# line editing needs raw-mode console input; the console is line-buffered
+# CONFIG_FEATURE_EDITING is not set
+CONFIG_HUSH_IF=y
+CONFIG_HUSH_LOOPS=y
+CONFIG_HUSH_CASE=y
+CONFIG_HUSH_TICK=y
+# echo as an external applet so it works in pipelines (no fork for builtins)
+# CONFIG_HUSH_ECHO is not set
+CONFIG_HUSH_EXPORT=y
+CONFIG_HUSH_SET=y
+CONFIG_HUSH_UNSET=y
+CONFIG_HUSH_UMASK=y
+CONFIG_HUSH_WAIT=y
+# no getrlimit()/setrlimit() on Zephyr yet
+# CONFIG_HUSH_ULIMIT is not set
+
+# the multi-call dispatch and the /bin symlink farm
+CONFIG_FEATURE_INSTALLER=y
+CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
+
+# applets
+CONFIG_CAT=y
+CONFIG_ECHO=y
+CONFIG_GREP=y
+CONFIG_EGREP=y
+CONFIG_FGREP=y
+CONFIG_FEATURE_GREP_CONTEXT=y
+CONFIG_PING=y
+CONFIG_PING6=y
+CONFIG_FEATURE_FANCY_PING=y
+CONFIG_FEATURE_IPV6=y
+CONFIG_SED=y
+CONFIG_PRINTF=y
+CONFIG_TEST=y
+CONFIG_TEST1=y
+CONFIG_FALSE=y
+CONFIG_LN=y
+CONFIG_LS=y
+CONFIG_MKDIR=y
+CONFIG_PWD=y
+CONFIG_READLINK=y
+CONFIG_RM=y
+CONFIG_RMDIR=y
+CONFIG_TRUE=y
+CONFIG_UNAME=y
diff --git a/zephyr/configure.sh b/zephyr/configure.sh
new file mode 100755
index 000000000..fc41da449
--- /dev/null
+++ b/zephyr/configure.sh
@@ -0,0 +1,44 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+#
+# Configure a minimal busybox in an out-of-tree build directory:
+# allnoconfig, then the zephyr/busybox.frag symbols, settled with oldconfig.
+# Usage: configure.sh <busybox-srcdir> <builddir> [extra-frag...]
+
+set -eu
+
+src="$1"
+build="$2"
+shift 2
+
+mkdir -p "$build"
+make -C "$src" O="$build" allnoconfig >"$build/configure.log" 2>&1
+
+for frag in "$src/zephyr/busybox.frag" "$@"; do
+	while IFS= read -r line; do
+		case "$line" in
+		CONFIG_*=*) sym="${line%%=*}" ;;
+		'# CONFIG_'*' is not set') sym="${line#\# }" sym="${sym%% *}" ;;
+		*) continue ;;
+		esac
+		sed -i -e "/^# $sym is not set\$/d" -e "/^$sym=/d" "$build/.config"
+		printf '%s\n' "$line" >>"$build/.config"
+	done <"$frag"
+done
+
+yes '' | make -C "$src" O="$build" oldconfig >>"$build/configure.log" 2>&1
+
+# every fragment symbol must have survived dependency resolution
+for frag in "$src/zephyr/busybox.frag" "$@"; do
+	while IFS= read -r line; do
+		case "$line" in
+		CONFIG_*=* | '# CONFIG_'*' is not set') ;;
+		*) continue ;;
+		esac
+		if ! grep -q -F -x "$line" "$build/.config"; then
+			echo "busybox configure: '$line' lost after oldconfig" >&2
+			exit 1
+		fi
+	done <"$frag"
+done
