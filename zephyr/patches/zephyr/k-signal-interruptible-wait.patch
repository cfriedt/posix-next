+#ifdef CONFIG_SIGNAL
+static K_THREAD_STACK_DEFINE(reader_stack, 1024 + CONFIG_TEST_EXTRA_STACK_SIZE);
+static struct k_thread reader;
+static int reader_fd;
+static volatile int reader_ret;
+static volatile int reader_errno;
+static volatile bool reader_handled;
+
+static void reader_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	ARG_UNUSED(sig);
+	ARG_UNUSED(info);
+	ARG_UNUSED(ucontext);
+
+	reader_handled = true;
+}
+
+static void reader_entry(void *p1, void *p2, void *p3)
+{
+	struct k_sig_action act = {.handler = reader_handler};
+	struct k_sig_set set;
+	zvfs_eventfd_t value;
+
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	/* kernel threads start with every signal blocked */
+	zassert_ok(k_sig_emptyset(&set));
+	zassert_ok(k_sig_addset(&set, K_SIG_USR1));
+	zassert_ok(k_sig_mask(K_SIG_UNBLOCK, &set, NULL));
+	zassert_ok(k_sig_action(K_SIG_USR1, &act, NULL));
+
+	reader_ret = zvfs_eventfd_read(reader_fd, &value);
+	reader_errno = errno;
+
+	act.handler = K_SIG_DFL;
+	zassert_ok(k_sig_action(K_SIG_USR1, &act, NULL));
+}
+
+/* a signal for a reader blocked on an empty eventfd ends the read with EINTR */
+static void eventfd_read_interrupted(void)
+{
+	reader_fd = zvfs_eventfd(0, 0);
+	zassert_true(reader_fd >= 0, "zvfs_eventfd() failed: %d", errno);
+	reader_handled = false;
+
+	k_thread_create(&reader, reader_stack, K_THREAD_STACK_SIZEOF(reader_stack), reader_entry,
+			NULL, NULL, NULL, K_PRIO_PREEMPT(0), 0, K_NO_WAIT);
+	k_msleep(50);
+	zassert_ok(k_sig_queue((k_pid_t)&reader, K_SIG_USR1, (union k_sig_val){0}));
+	zassert_ok(k_thread_join(&reader, K_SECONDS(5)), "the blocked read was not interrupted");
+
+	zassert_equal(reader_ret, -1, "read returned %d", reader_ret);
+	zassert_equal(reader_errno, EINTR, "errno %d", reader_errno);
+	zassert_true(reader_handled, "the handler did not run");
+	zassert_ok(zvfs_close(reader_fd));
+}
+#endif /* CONFIG_SIGNAL */
+
+ZTEST(zvfs_eventfd, test_zvfs_eventfd_read)
+{
+#ifdef CONFIG_SIGNAL
+	eventfd_read_interrupted();
+#else
+	ztest_test_skip();
+#endif /* CONFIG_SIGNAL */
+}
+
+ZTEST_SUITE(zvfs_eventfd, NULL, NULL, NULL, NULL, NULL);
