+
+#include <errno.h>
+#include <string.h>
+
+#include <zephyr/fs/fs.h>
+#include <zephyr/kernel.h>
+#include <zephyr/ztest.h>
+
+#define MNT "/tmp"
+
+static struct fs_mount_t tmpfs_mnt = {
+	.type = FS_TMPFS,
+	.mnt_point = MNT,
+};
+
+/* the tree's common file system tests that do not expect a mount to persist */
+void test_fs_dirops(void);
+void test_fs_open_flags(void);
+struct fs_mount_t *fs_dirops_test_mp = &tmpfs_mnt;
+char *test_fs_open_flags_file_path = MNT "/open_flags_file";
+
+static void write_all(const char *path, const void *data, size_t len, fs_mode_t flags)
+{
+	struct fs_file_t f;
+
+	fs_file_t_init(&f);
+	zassert_equal(fs_open(&f, path, FS_O_WRITE | FS_O_CREATE | flags), 0, "open %s", path);
+	zassert_equal(fs_write(&f, data, len), (ssize_t)len, "write %s", path);
+	zassert_equal(fs_close(&f), 0);
+}
+
+static ssize_t read_all(const char *path, void *buf, size_t len)
+{
+	struct fs_file_t f;
+	ssize_t n;
+
+	fs_file_t_init(&f);
+	zassert_equal(fs_open(&f, path, FS_O_READ), 0, "open %s", path);
+	n = fs_read(&f, buf, len);
+	zassert_equal(fs_close(&f), 0);
+
+	return n;
+}
+
+ZTEST(tmpfs, test_dirops)
+{
+	test_fs_dirops();
+}
+
+ZTEST(tmpfs, test_open_flags)
+{
+	zassert_equal(fs_mount(&tmpfs_mnt), 0);
+	test_fs_open_flags();
+	zassert_equal(fs_unmount(&tmpfs_mnt), 0);
+}
+
+ZTEST(tmpfs, test_symlink)
+{
+	struct fs_dirent ent;
+	char buf[64];
+
+	zassert_equal(fs_mount(&tmpfs_mnt), 0);
+	zassert_equal(fs_mkdir(MNT "/bin"), 0);
+	write_all(MNT "/bin/toybox", "toybox", 6, 0);
+	/* relative: resolved from the link's directory; absolute: from the root of the mount */
+	zassert_equal(fs_symlink("toybox", MNT "/bin/ls"), 0);
+	zassert_equal(fs_symlink("/bin/ls", MNT "/ls"), 0);
+	zassert_equal(fs_symlink("nowhere", MNT "/dangling"), 0);
+	zassert_equal(fs_symlink("loop2", MNT "/loop1"), 0);
+	zassert_equal(fs_symlink("loop1", MNT "/loop2"), 0);
+
+	zassert_equal(read_all(MNT "/ls", buf, sizeof(buf)), 6, "read through two links");
+	zassert_mem_equal(buf, "toybox", 6);
+	zassert_equal(fs_stat(MNT "/ls", &ent), 0);
+	zassert_equal(ent.type, FS_DIR_ENTRY_FILE, "stat follows");
+	zassert_equal(ent.size, 6);
+	zassert_equal(fs_lstat(MNT "/ls", &ent), 0);
+	zassert_equal(ent.type, FS_DIR_ENTRY_SYMLINK, "lstat does not");
+	zassert_equal(fs_readlink(MNT "/ls", buf, sizeof(buf)), 7);
+	zassert_mem_equal(buf, "/bin/ls", 7);
+	zassert_equal(fs_readlink(MNT "/bin/toybox", buf, sizeof(buf)), -EINVAL, "not a link");
+	zassert_equal(fs_stat(MNT "/dangling", &ent), -ENOENT);
+	zassert_equal(fs_lstat(MNT "/dangling", &ent), 0);
+	zassert_equal(fs_stat(MNT "/loop1", &ent), -ELOOP);
+	/* a link into a directory is walked through */
+	zassert_equal(fs_symlink("bin", MNT "/b"), 0);
+	zassert_equal(read_all(MNT "/b/ls", buf, sizeof(buf)), 6);
+	/* removing a link removes the link */
+	zassert_equal(fs_unlink(MNT "/bin/ls"), 0);
+	zassert_equal(fs_stat(MNT "/bin/toybox", &ent), 0);
+	zassert_equal(fs_stat(MNT "/ls", &ent), -ENOENT);
+	zassert_equal(fs_unmount(&tmpfs_mnt), 0);
+}
+
+ZTEST(tmpfs, test_fifo)
+{
+	struct fs_dirent ent;
+	struct fs_file_t f;
+
+	zassert_equal(fs_mount(&tmpfs_mnt), 0);
+	zassert_equal(fs_mkfifo(MNT "/pipe"), 0);
+	zassert_equal(fs_mkfifo(MNT "/pipe"), -EEXIST);
+	zassert_equal(fs_stat(MNT "/pipe", &ent), 0);
+	zassert_equal(ent.type, FS_DIR_ENTRY_FIFO);
+	zassert_equal(ent.size, 0);
+	/* the node holds no bytes: opening it as a file is refused */
+	fs_file_t_init(&f);
+	zassert_equal(fs_open(&f, MNT "/pipe", FS_O_READ), -ENXIO);
+	zassert_equal(fs_unlink(MNT "/pipe"), 0);
+	zassert_equal(fs_stat(MNT "/pipe", &ent), -ENOENT);
+	zassert_equal(fs_unmount(&tmpfs_mnt), 0);
+}
+
+ZTEST(tmpfs, test_rename)
+{
+	struct fs_dirent ent;
+	char buf[8];
+
+	zassert_equal(fs_mount(&tmpfs_mnt), 0);
+	zassert_equal(fs_mkdir(MNT "/a"), 0);
+	zassert_equal(fs_mkdir(MNT "/a/sub"), 0);
+	zassert_equal(fs_mkdir(MNT "/empty"), 0);
+	write_all(MNT "/one", "1", 1, 0);
+	write_all(MNT "/two", "2", 1, 0);
+	/* a file over an existing file replaces it */
+	zassert_equal(fs_rename(MNT "/one", MNT "/two"), 0);
+	zassert_equal(fs_stat(MNT "/one", &ent), -ENOENT);
+	zassert_equal(read_all(MNT "/two", buf, sizeof(buf)), 1);
+	zassert_equal(buf[0], '1');
+	/* a file over a directory, a directory over a file: refused */
+	zassert_equal(fs_rename(MNT "/two", MNT "/empty"), -EISDIR);
+	zassert_equal(fs_rename(MNT "/empty", MNT "/two"), -ENOTDIR);
+	/* a directory over an empty directory replaces it; a full one is kept */
+	zassert_equal(fs_rename(MNT "/a", MNT "/empty"), 0);
+	zassert_equal(fs_stat(MNT "/empty/sub", &ent), 0);
+	zassert_equal(fs_mkdir(MNT "/other"), 0);
+	zassert_equal(fs_rename(MNT "/other", MNT "/empty"), -ENOTEMPTY);
+	/* never into itself */
+	zassert_equal(fs_rename(MNT "/empty", MNT "/empty/sub/inner"), -EINVAL);
+	/* a move across directories */
+	zassert_equal(fs_rename(MNT "/two", MNT "/empty/sub/two"), 0);
+	zassert_equal(read_all(MNT "/empty/sub/two", buf, sizeof(buf)), 1);
+	zassert_equal(fs_unmount(&tmpfs_mnt), 0);
+}
+
+ZTEST(tmpfs, test_unlink_open)
+{
+	struct fs_file_t f;
+	struct fs_dirent ent;
+	char buf[8];
+
+	zassert_equal(fs_mount(&tmpfs_mnt), 0);
+	write_all(MNT "/gone", "still", 5, 0);
+	fs_file_t_init(&f);
+	zassert_equal(fs_open(&f, MNT "/gone", FS_O_READ), 0);
+	/* the name goes at once, the bytes with the last handle */
+	zassert_equal(fs_unlink(MNT "/gone"), 0);
+	zassert_equal(fs_stat(MNT "/gone", &ent), -ENOENT);
+	zassert_equal(fs_read(&f, buf, sizeof(buf)), 5);
+	zassert_mem_equal(buf, "still", 5);
+	/* the mount is busy while a handle is open */
+	zassert_equal(fs_unmount(&tmpfs_mnt), -EBUSY);
+	zassert_equal(fs_close(&f), 0);
+	zassert_equal(fs_unmount(&tmpfs_mnt), 0);
+}
+
+ZTEST(tmpfs, test_sparse_and_large)
+{
+	const size_t page = CONFIG_TMPFS_PAGE_SIZE;
+	/* past the direct pages and the indirect table, when memory allows */
+	const size_t far = (4 + page / sizeof(void *) + 2) * page;
+	struct fs_file_t f;
+	struct fs_statvfs vfs;
+	uint8_t pattern[64];
+	uint8_t buf[64];
+	size_t written = 0;
+	ssize_t n;
+
+	for (size_t i = 0; i < sizeof(pattern); i++) {
+		pattern[i] = (uint8_t)i;
+	}
+	zassert_equal(fs_mount(&tmpfs_mnt), 0);
+	zassert_equal(fs_statvfs(MNT, &vfs), 0);
+	zassert_equal(vfs.f_bsize, page);
+
+	fs_file_t_init(&f);
+	zassert_equal(fs_open(&f, MNT "/big", FS_O_RDWR | FS_O_CREATE), 0);
+	/* a hole: the size grows, no page is spent, and it reads as zeros */
+	zassert_equal(fs_truncate(&f, 3 * page + 7), 0);
+	zassert_equal(fs_seek(&f, page + 3, FS_SEEK_SET), 0);
+	zassert_equal(fs_read(&f, buf, sizeof(buf)), (ssize_t)sizeof(buf));
+	for (size_t i = 0; i < sizeof(buf); i++) {
+		zassert_equal(buf[i], 0, "a hole reads as zero");
+	}
+	/* one page's worth of pattern, on a page boundary and across one */
+	zassert_equal(fs_seek(&f, 2 * page - 32, FS_SEEK_SET), 0);
+	zassert_equal(fs_write(&f, pattern, sizeof(pattern)), (ssize_t)sizeof(pattern));
+	zassert_equal(fs_seek(&f, 2 * page - 32, FS_SEEK_SET), 0);
+	zassert_equal(fs_read(&f, buf, sizeof(buf)), (ssize_t)sizeof(buf));
+	zassert_mem_equal(buf, pattern, sizeof(buf), "a write across a page boundary");
+
+	/* as far as memory goes, up to the double-indirect range */
+	for (size_t off = 4 * page; off < far; off += page) {
+		zassert_equal(fs_seek(&f, off, FS_SEEK_SET), 0);
+		n = fs_write(&f, pattern, sizeof(pattern));
+		if (n == -ENOSPC) {
+			break;
+		}
+		zassert_equal(n, (ssize_t)sizeof(pattern), "write at %zu", off);
+		written = off;
+	}
+	TC_PRINT("%zu pages of %zu bytes in the file\n", written / page + 1, page);
+	if (written >= 4 * page) {
+		zassert_equal(fs_seek(&f, written, FS_SEEK_SET), 0);
+		zassert_equal(fs_read(&f, buf, sizeof(buf)), (ssize_t)sizeof(buf));
+		zassert_mem_equal(buf, pattern, sizeof(buf), "the last page written");
+	}
+	/* shrinking frees the tail and the tables it no longer needs */
+	zassert_equal(fs_truncate(&f, page + 1), 0);
+	zassert_equal(fs_seek(&f, 0, FS_SEEK_END), 0);
+	zassert_equal(fs_tell(&f), (off_t)(page + 1));
+	zassert_equal(fs_close(&f), 0);
+	zassert_equal(fs_statvfs(MNT, &vfs), 0);
+	zassert_equal(fs_unlink(MNT "/big"), 0);
+	zassert_equal(fs_unmount(&tmpfs_mnt), 0);
+}
+
+ZTEST(tmpfs, test_bounded)
+{
+	struct fs_statvfs vfs;
+	struct fs_file_t f;
+	uint8_t page[CONFIG_TMPFS_PAGE_SIZE > 256 ? 256 : CONFIG_TMPFS_PAGE_SIZE];
+	ssize_t n;
+	size_t total = 0;
+
+	if (CONFIG_TMPFS_MAX_PAGES == 0) {
+		ztest_test_skip();
+	}
+	zassert_equal(fs_mount(&tmpfs_mnt), 0);
+	zassert_equal(fs_statvfs(MNT, &vfs), 0);
+	zassert_equal(vfs.f_blocks, CONFIG_TMPFS_MAX_PAGES);
+	zassert_true(vfs.f_bfree < vfs.f_blocks, "the mount record and the root node count");
+	(void)memset(page, 0xa5, sizeof(page));
+	fs_file_t_init(&f);
+	zassert_equal(fs_open(&f, MNT "/fill", FS_O_WRITE | FS_O_CREATE), 0);
+	do {
+		n = fs_write(&f, page, sizeof(page));
+		if (n > 0) {
+			total += (size_t)n;
+		}
+	} while (n == (ssize_t)sizeof(page));
+	zassert_equal(n, -ENOSPC, "the bound holds: %zd after %zu bytes", n, total);
+	zassert_true(total < (size_t)CONFIG_TMPFS_MAX_PAGES * CONFIG_TMPFS_PAGE_SIZE);
+	zassert_equal(fs_close(&f), 0);
+	zassert_equal(fs_statvfs(MNT, &vfs), 0);
+	zassert_equal(vfs.f_bfree, 0);
+	zassert_equal(fs_unlink(MNT "/fill"), 0);
+	zassert_equal(fs_statvfs(MNT, &vfs), 0);
+	zassert_true(vfs.f_bfree > 0, "unlinking gives the pages back");
+	zassert_equal(fs_unmount(&tmpfs_mnt), 0);
+}
+
+/* a failed test leaves its mount behind: the next one starts unmounted */
+static void after(void *fixture)
+{
+	ARG_UNUSED(fixture);
+	(void)fs_unmount(&tmpfs_mnt);
+}
+
+ZTEST_SUITE(tmpfs, NULL, NULL, NULL, after, NULL);
diff --git a/tests/subsys/fs/tmpfs/testcase.yaml b/tests/subsys/fs/tmpfs/testcase.yaml
new file mode 100644
--- /dev/null
+++ b/tests/subsys/fs/tmpfs/testcase.yaml
@@ -0,0 +1,27 @@
+common:
+  tags:
+    - filesystem
+    - tmpfs
+  platform_allow:
+    - native_sim
+    - native_sim/native/64
+    - qemu_x86
+    - qemu_x86_64
+    - qemu_cortex_a53
+    - qemu_riscv64
+    - qemu_riscv32
+    - qemu_cortex_m3
+  integration_platforms:
+    - native_sim
+    - qemu_x86_64
+tests:
+  filesystem.tmpfs: {}
+  # a bound on the pages a mount may hold, reported and enforced: enough of
+  # them for the directory tests, and a heap above the bound where pages are
+  # heap blocks, so the bound is what stops the fill (cortex_m3 has no room)
+  filesystem.tmpfs.bounded:
+    platform_exclude:
+      - qemu_cortex_m3
+    extra_configs:
+      - CONFIG_TMPFS_MAX_PAGES=40
+      - CONFIG_HEAP_MEM_POOL_SIZE=131072
