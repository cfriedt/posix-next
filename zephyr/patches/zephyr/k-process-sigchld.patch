diff --git a/include/zephyr/kernel/signal.h b/include/zephyr/kernel/signal.h
index 5820602a1fa..378de0d386b 100644
--- a/include/zephyr/kernel/signal.h
+++ b/include/zephyr/kernel/signal.h
@@ -107,10 +107,21 @@ union k_sig_val {
  */
 struct k_timer;
 
+struct k_thread;
+
 struct k_sig_info {
 	int signo; /**< Signal number */
 	int code; /**< Additional signal code */
 	union k_sig_val value; /**< Signal value */
+#ifdef CONFIG_PROCESS
+	/**
+	 * Handle of the child process that changed state (@ref K_SIG_CHLD).
+	 * An identity value (@ref k_pid_t): the child may already be reaped.
+	 */
+	struct k_thread *pid;
+	/** Wait status of the child, in the K_WSTATUS_* encoding (@ref K_SIG_CHLD) */
+	int status;
+#endif /* CONFIG_PROCESS */
 #ifdef CONFIG_TIMER_SIGNAL
 	/**
 	 * Timer that generated this signal (@ref K_SI_TIMER), as an opaque identifier
@@ -219,6 +225,12 @@ struct k_sig_ctx {
 #define K_SI_TIMER (-2) /**< Generated by a kernel timer expiry (see @kconfig{CONFIG_TIMER_SIGNAL}) */
 #define K_SI_MSGQ  (-3) /**< Generated by message arrival (see @kconfig{CONFIG_MSGQ_NOTIFY}) */
 #define K_SI_ASYNCIO (-4) /**< Generated by asynchronous I/O completion (see @kconfig{CONFIG_SYS_AIO}) */
+#define K_SI_CLD_EXITED 1 /**< Child has exited (see @kconfig{CONFIG_PROCESS}) */
+#define K_SI_CLD_KILLED 2 /**< Child was terminated by a signal and did not dump core */
+#define K_SI_CLD_DUMPED 3 /**< Child was terminated by a signal and dumped core */
+#define K_SI_CLD_TRAPPED 4 /**< Traced child has trapped */
+#define K_SI_CLD_STOPPED 5 /**< Child has stopped */
+#define K_SI_CLD_CONTINUED 6 /**< Stopped child has continued */
 /**
  * @}
  */
diff --git a/kernel/signal.c b/kernel/signal.c
index 65586013d9b..bad8040ec9d 100644
--- a/kernel/signal.c
+++ b/kernel/signal.c
@@ -241,7 +241,7 @@ static bool z_sig_match(const struct k_sig_set *match, uint8_t *pos, k_tid_t tid
 }
 
 static int z_sig_queue_common(k_pid_t pid, int signo, union k_sig_val value, int code,
-			      struct k_timer *timer)
+			      struct k_timer *timer, k_pid_t child_pid, int child_status)
 {
 	if ((signo < 0) || (signo > SIGNAL_SET_SIZE)) {
 		LOG_DBG("invalid signo %d", signo);
@@ -317,6 +317,10 @@ static int z_sig_queue_common(k_pid_t pid, int signo, union k_sig_val value, int
 				.signo = signo,
 				.code = code,
 				.value = value,
+#ifdef CONFIG_PROCESS
+				.pid = child_pid,
+				.status = child_status,
+#endif /* CONFIG_PROCESS */
 #ifdef CONFIG_TIMER_SIGNAL
 				/* the generating timer doubles as one-pending/overrun state */
 				.timer = timer,
@@ -347,27 +351,36 @@ static int z_sig_queue_common(k_pid_t pid, int signo, union k_sig_val value, int
 
 int z_impl_k_sig_queue(k_pid_t pid, int signo, union k_sig_val value)
 {
-	return z_sig_queue_common(pid, signo, value, K_SI_QUEUE, NULL);
+	return z_sig_queue_common(pid, signo, value, K_SI_QUEUE, NULL, NULL, 0);
 }
 
+#ifdef CONFIG_PROCESS
+int z_sig_queue_chld(k_tid_t tid, k_pid_t child_pid, int child_status, bool exited)
+{
+	return z_sig_queue_common(tid, K_SIG_CHLD, (union k_sig_val){0},
+				  exited ? K_SI_CLD_EXITED : K_SI_CLD_KILLED, NULL, child_pid,
+				  child_status);
+}
+#endif /* CONFIG_PROCESS */
+
 #ifdef CONFIG_MSGQ_NOTIFY
 int z_sig_queue_msgq(k_pid_t pid, int signo, union k_sig_val value)
 {
-	return z_sig_queue_common(pid, signo, value, K_SI_MSGQ, NULL);
+	return z_sig_queue_common(pid, signo, value, K_SI_MSGQ, NULL, NULL, 0);
 }
 #endif /* CONFIG_MSGQ_NOTIFY */
 
 #ifdef CONFIG_SYS_AIO
 int z_sig_queue_aio(k_pid_t pid, int signo, union k_sig_val value)
 {
-	return z_sig_queue_common(pid, signo, value, K_SI_ASYNCIO, NULL);
+	return z_sig_queue_common(pid, signo, value, K_SI_ASYNCIO, NULL, NULL, 0);
 }
 #endif /* CONFIG_SYS_AIO */
 
 #ifdef CONFIG_TIMER_SIGNAL
 int z_sig_queue_timer(struct k_timer *timer, k_pid_t pid, int signo, union k_sig_val value)
 {
-	return z_sig_queue_common(pid, signo, value, K_SI_TIMER, timer);
+	return z_sig_queue_common(pid, signo, value, K_SI_TIMER, timer, NULL, 0);
 }
 
 void z_sig_purge_timer(struct k_timer *timer)
@@ -525,6 +538,10 @@ int z_impl_k_sig_timedwait(const struct k_sig_set *ZRESTRICT set, struct k_sig_i
 			.signo = ret,
 			.code = k_sig_array[pos].info.code,
 			.value = k_sig_array[pos].info.value,
+#ifdef CONFIG_PROCESS
+			.pid = k_sig_array[pos].info.pid,
+			.status = k_sig_array[pos].info.status,
+#endif /* CONFIG_PROCESS */
 #ifdef CONFIG_TIMER_SIGNAL
 			.timer = k_sig_array[pos].info.timer,
 #endif /* CONFIG_TIMER_SIGNAL */
