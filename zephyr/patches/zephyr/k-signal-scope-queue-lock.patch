+				if (z_sig_queue_process(proc, signo) == 0) {
+					ret = 0;
+				}
+				continue;
+			}
 #else
 			tgt = SYS_DLIST_PEEK_HEAD_CONTAINER(&proc->threads, tgt, process_node);
