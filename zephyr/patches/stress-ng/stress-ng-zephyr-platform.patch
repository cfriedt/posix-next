diff --git a/core-filesystem.c b/core-filesystem.c
--- a/core-filesystem.c
+++ b/core-filesystem.c
@@ -711,6 +711,50 @@ int stress_fs_temp_dir_rm_args(stress_args_t *args)
 	return stress_fs_temp_dir_rm(args->name, args->pid, args->instance);
 }

+/*
+ *  stress_fs_dev_scratch_open()
+ *	open a scratch file in the per-instance temporary directory to stand
+ *	in for a device node (/dev/zero, /dev/null) on systems that have none,
+ *	such as Zephyr; it starts as one page of zeros, and the caller keeps
+ *	it small by rewinding after its reads and writes
+ */
+int stress_fs_dev_scratch_open(stress_args_t *args, const int flags)
+{
+	char filename[PATH_MAX];
+	const size_t page_size = args->page_size;
+	void *zeros;
+	int fd;
+
+	(void)flags;
+
+	if (stress_fs_temp_dir_make_args(args) < 0)
+		return -1;
+	(void)stress_fs_temp_filename_args(args, filename, sizeof(filename), stress_mwc32());
+	fd = open(filename, O_CREAT | O_RDWR | O_TRUNC, S_IRUSR | S_IWUSR);
+	if (fd < 0) {
+		(void)stress_fs_temp_dir_rm_args(args);
+		return -1;
+	}
+	zeros = calloc(1, page_size);
+	if (zeros) {
+		VOID_RET(ssize_t, write(fd, zeros, page_size));
+		free(zeros);
+	}
+	(void)lseek(fd, 0, SEEK_SET);
+	(void)shim_unlink(filename);
+	return fd;
+}
+
+/*
+ *  stress_fs_dev_scratch_close()
+ *	close a scratch file from stress_fs_dev_scratch_open()
+ */
+void stress_fs_dev_scratch_close(stress_args_t *args, const int fd)
+{
+	(void)close(fd);
+	(void)stress_fs_temp_dir_rm_args(args);
+}
