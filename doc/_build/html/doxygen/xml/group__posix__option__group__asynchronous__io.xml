        <briefdescription>
<para>Wait for one or more asynchronous I/O requests to complete. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>list</parametername>
</parameternamelist>
<parameterdescription>
<para>Array of pointers to control blocks to wait on. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>nent</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of entries in <computeroutput>list</computeroutput>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>timeout</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum wait time, or NULL to block indefinitely. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>0 on success, or -1 with errno set on failure. </para>
</simplesect>
<simplesect kind="see"><para><ulink url="https://pubs.opengroup.org/onlinepubs/9699919799/functions/aio_suspend.html">https://pubs.opengroup.org/onlinepubs/9699919799/functions/aio_suspend.html</ulink> </para>
</simplesect>
</para>
