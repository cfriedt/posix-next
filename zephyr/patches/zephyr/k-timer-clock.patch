+
+/* callers hold 'lock' */
+static void z_timer_rt_deregister(struct k_timer *timer)
+{
+	if ((timer->flags & Z_TIMER_FLAG_REALTIME) != 0U) {
+		timer->flags &= (uint8_t)~Z_TIMER_FLAG_REALTIME;
+		(void)sys_slist_find_and_remove(&rt_timer_list, &timer->rt_node);
+	}
