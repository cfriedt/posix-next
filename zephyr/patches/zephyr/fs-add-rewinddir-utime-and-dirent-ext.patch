+int fs_utime(const char *abs_path, const struct timespec times[2])
+{
+	struct fs_mount_t *mp;
+	struct timespec now[2];
+	int rc = -EINVAL;
+
+	if ((abs_path == NULL) || (abs_path[0] != '/') || (abs_path[1] == '\0')) {
+		LOG_ERR("invalid file or dir name!!");
+		return -EINVAL;
+	}
+
+	rc = fs_get_mnt_point(&mp, abs_path, NULL);
+	if (rc < 0) {
+		LOG_ERR("mount point not found!!");
+		return rc;
+	}
+
+	if (mp->flags & FS_MOUNT_FLAG_READ_ONLY) {
+		return -EROFS;
+	}
+
+	CHECKIF(mp->fs->utime == NULL) {
+		return -ENOTSUP;
+	}
+
+	if (times == NULL) {
+		rc = sys_clock_gettime(SYS_CLOCK_REALTIME, &now[0]);
+		if (rc < 0) {
+			return rc;
+		}
+		now[1] = now[0];
+	} else {
+		for (int i = 0; i < 2; i++) {
+			now[i] = times[i];
+			if (times[i].tv_nsec == FS_UTIME_NOW) {
+				rc = sys_clock_gettime(SYS_CLOCK_REALTIME, &now[i]);
+				if (rc < 0) {
+					return rc;
+				}
+			} else if ((times[i].tv_nsec != FS_UTIME_OMIT) &&
+				   ((times[i].tv_nsec < 0) || (times[i].tv_nsec >= NSEC_PER_SEC))) {
+				return -EINVAL;
+			}
+		}
+	}
+
+	rc = mp->fs->utime(mp, abs_path, now);
+	if (rc < 0) {
+		LOG_ERR("failed set file or dir time (%d)", rc);
+	}
+
+	return rc;
+}
