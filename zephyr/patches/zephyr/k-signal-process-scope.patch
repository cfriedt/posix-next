diff --git a/tests/kernel/process/src/main.c b/tests/kernel/process/src/main.c
index 758ff055a5b..1028c3c3ddc 100644
--- a/tests/kernel/process/src/main.c
+++ b/tests/kernel/process/src/main.c
@@ -157,6 +157,10 @@ ZTEST(kernel_process, test_static_process_lifecycle)
