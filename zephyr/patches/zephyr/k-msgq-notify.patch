 #include <zephyr/syscalls/k_msgq_get_prio_mrsh.c>
 #endif /* CONFIG_USERSPACE */
 
+#ifdef CONFIG_MSGQ_NOTIFY
+int k_msgq_notify_arm(struct k_msgq *msgq, k_pid_t target, int signo, union k_sig_val value)
+{
+	struct z_msgq_prio_hdr *hdr;
+	k_spinlock_key_t key;
+	int result = 0;
+
+	if (!msgq_is_prio(msgq)) {
+		return -ENOTSUP;
+	}
+
+	if ((signo != 0) && !IS_ENABLED(CONFIG_SIGNAL)) {
+		return -ENOTSUP;
+	}
+
+	key = k_spin_lock(&msgq->lock);
+
+	hdr = prio_hdr(msgq);
+	if (hdr->notify_armed) {
+		result = -EBUSY;
+	} else {
+		hdr->notify_target = target;
+		hdr->notify_signo = signo;
+		hdr->notify_value = value;
+		hdr->notify_armed = true;
+	}
+
+	k_spin_unlock(&msgq->lock, key);
+
+	return result;
+}
+
+int k_msgq_notify_disarm(struct k_msgq *msgq)
+{
+	struct z_msgq_prio_hdr *hdr;
+	k_spinlock_key_t key;
+	int result = 0;
+
+	if (!msgq_is_prio(msgq)) {
+		return -ENOTSUP;
+	}
+
+	key = k_spin_lock(&msgq->lock);
+
+	hdr = prio_hdr(msgq);
+	if (!hdr->notify_armed) {
+		result = -EINVAL;
+	} else {
+		hdr->notify_armed = false;
+	}
+
+	k_spin_unlock(&msgq->lock, key);
+
+	return result;
+}
+#endif /* CONFIG_MSGQ_NOTIFY */
+
 static void msgq_purge_prio(struct k_msgq *msgq)
 {
 	struct z_msgq_prio_hdr *hdr = prio_hdr(msgq);
