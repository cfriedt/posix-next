diff --git a/tests/net/socket/socketpair/src/dup.c b/tests/net/socket/socketpair/src/dup.c
new file mode 100644
--- /dev/null
+++ b/tests/net/socket/socketpair/src/dup.c
@@ -0,0 +1,24 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/sys/zvfs.h>
+
+#include "_main.h"
+
+/* an end outlives the close of one of its descriptors: the pair is not torn down */
+ZTEST_USER_F(net_socketpair, test_dup_close)
+{
+	char buf[8];
+	int d = zvfs_dup(fixture->sv[0], 0);
+
+	zassert_true(d >= 0, "dup() failed: %d", errno);
+	zassert_ok(zsock_close(fixture->sv[0]), "close() failed: %d", errno);
+	fixture->sv[0] = d;
+
+	zassert_equal(zsock_send(fixture->sv[1], "xx", 2, 0), 2, "send() failed: %d", errno);
+	zassert_equal(zsock_recv(d, buf, sizeof(buf), 0), 2, "recv() failed: %d", errno);
+	zassert_equal(zsock_send(d, "y", 1, 0), 1, "send() failed: %d", errno);
+	zassert_equal(zsock_recv(fixture->sv[1], buf, sizeof(buf), 0), 1, "recv() failed: %d", errno);
+}
