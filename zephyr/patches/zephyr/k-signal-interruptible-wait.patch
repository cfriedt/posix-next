+	return true;
+}
+
+bool z_sig_wait_end(unsigned long token)
+{
+	z_sig_wait_set(NULL);
+
+	/* claimed for delivery on the way back to user mode, or still to be claimed */
+	return ((unsigned long)atomic_get(&_current->base.sig.delivered) != token) ||
+	       z_sig_interrupts();
