diff --git a/soc/common/riscv-privileged/soc_irq.S b/soc/common/riscv-privileged/soc_irq.S
index 21d6bd56f99..5f24d914706 100644
--- a/soc/common/riscv-privileged/soc_irq.S
+++ b/soc/common/riscv-privileged/soc_irq.S
@@ -25,10 +25,27 @@ WTEXT(__soc_handle_irq)
  * Exception number is given as parameter via register a0.
  */
 SECTION_FUNC(exception.other, __soc_handle_irq)
+#ifdef CONFIG_RISCV_S_MODE
+	/*
+	 * In S-mode, sip.STIP is read-only; the timer pending bit is
+	 * cleared by M-mode SBI when sbi_set_timer() is called with the
+	 * next deadline.
+	 *
+	 * sip.SSIP (supervisor software interrupt pending, bit 1) is
+	 * writable from S-mode and must be cleared explicitly here.
+	 */
+	li t1, 1
+	sll t0, t1, a0
+	andi t0, t0, 2		/* only clear the SSIP bit (bit 1) */
+	beqz t0, 1f
+	csrc sip, t0
+1:
+#else
 	/* Clear exception number from CSR mip register */
 	li t1, 1
 	sll t0, t1, a0
 	csrrc t1, mip, t0
+#endif
 
 	/* Return */
 	ret
