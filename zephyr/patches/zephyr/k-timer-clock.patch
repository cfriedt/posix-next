+static void z_timer_rt_register(struct k_timer *timer)
+{
+	if ((timer->flags & Z_TIMER_FLAG_REALTIME) == 0U) {
+		timer->flags |= Z_TIMER_FLAG_REALTIME;
+		sys_slist_append(&rt_timer_list, &timer->rt_node);
+	}
