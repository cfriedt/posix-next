+/* one identity, no supplementary groups: the primary group alone */
+int getgrouplist(const char *user, gid_t group, gid_t *groups, int *ngroups)
+{
+	int n = *ngroups;
+
+	*ngroups = 1;
+	if (n < 1) {
+		return -1;
+	}
+	groups[0] = group;
+
+	return 1;
+}
+
+/* the XSI vector I/O, one transfer per element */
+ssize_t readv(int fd, const struct iovec *iov, int iovcnt)
+{
+	ssize_t total = 0;
+
+	for (int i = 0; i < iovcnt; i++) {
+		ssize_t n = read(fd, iov[i].iov_base, iov[i].iov_len);
+
+		if (n < 0) {
+			return (total > 0) ? total : -1;
+		}
+		total += n;
+		if ((size_t)n < iov[i].iov_len) {
+			break;
+		}
+	}
+
+	return total;
+}
+
+ssize_t writev(int fd, const struct iovec *iov, int iovcnt)
+{
+	ssize_t total = 0;
+
+	for (int i = 0; i < iovcnt; i++) {
+		ssize_t n = write(fd, iov[i].iov_base, iov[i].iov_len);
+
+		if (n < 0) {
+			return (total > 0) ? total : -1;
+		}
+		total += n;
+		if ((size_t)n < iov[i].iov_len) {
+			break;
+		}
+	}
+
+	return total;
+}
+
+/* FIFOs are the only special files the file systems hold */
+int mknod(const char *path, mode_t mode, dev_t dev)
+{
+	if ((mode & S_IFMT) == S_IFIFO) {
+		return mkfifo(path, mode & ~S_IFMT);
+	}
+
+	errno = ((mode & S_IFMT) == 0 || (mode & S_IFMT) == S_IFREG) ? EINVAL : EPERM;
+	return -1;
+}
+
+/* the Linux statfs() shape, filled from statvfs() */
+int statfs(const char *path, struct statfs *buf)
+{
+	struct statvfs vfs;
+
+	if (statvfs(path, &vfs) < 0) {
+		return -1;
+	}
+	memset(buf, 0, sizeof(*buf));
+	buf->f_bsize = vfs.f_bsize;
+	buf->f_frsize = vfs.f_frsize;
+	buf->f_blocks = vfs.f_blocks;
+	buf->f_bfree = vfs.f_bfree;
+	buf->f_bavail = vfs.f_bavail;
+	buf->f_files = vfs.f_files;
+	buf->f_ffree = vfs.f_ffree;
+	buf->f_namelen = vfs.f_namemax;
+	buf->f_flags = vfs.f_flag;
+
+	return 0;
+}
