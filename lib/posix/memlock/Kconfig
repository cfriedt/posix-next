config POSIX_MEMLOCK
	bool "POSIX memory locking"
	depends on POSIX_MAPPED_FILES
	select ZVFS_MLOCK
	imply DEMAND_PAGING
	help
	  Select 'y' here and Zephyr will provide support for mlockall() and munlockall().

	  Note: Locking keeps pages resident under DEMAND_PAGING. Without it every page is
	  resident already and the functions succeed without effect.

