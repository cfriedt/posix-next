+	uint32_t raised;
+
+	if (vector == IV_SIMD_FP) {
+		uint32_t mxcsr;
+
+		__asm__ volatile("stmxcsr %0" : "=m"(mxcsr));
+		raised = mxcsr & ~(mxcsr >> 7) & 0x3fU;
+		mxcsr &= ~0x3fU;
+		__asm__ volatile("ldmxcsr %0" : : "m"(mxcsr));
+	} else {
+		uint16_t cw;
+		uint16_t sw;
+
+		__asm__ volatile("fnstcw %0; fnstsw %1; fnclex" : "=m"(cw), "=m"(sw));
+		raised = sw & ~cw & 0x3fU;
+	}
+
+	if ((raised & BIT(2)) != 0U) {
+		return K_FPE_FLTDIV;
+	} else if ((raised & BIT(3)) != 0U) {
+		return K_FPE_FLTOVF;
+	} else if ((raised & (BIT(1) | BIT(4))) != 0U) {
+		return K_FPE_FLTUND;
+	} else if ((raised & BIT(5)) != 0U) {
+		return K_FPE_FLTRES;
+	}
+
+	return K_FPE_FLTINV;
