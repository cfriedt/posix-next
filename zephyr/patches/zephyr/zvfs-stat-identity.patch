+void zvfs_fs_identity(const char *path, struct zvfs_stat *buf)
+{
+	const char *mnt;
+	size_t best = 0;
+	uint64_t h = 0xcbf29ce484222325ULL;
+
+	buf->dev = 0;
+	for (int i = 0; fs_readmount(&i, &mnt) == 0;) {
+		size_t n = strlen(mnt);
+
+		/* the longest mount point covering the path; i is its index + 1 */
+		if ((n > best) && (strncmp(path, mnt, n) == 0) &&
+		    ((path[n] == '\0') || (path[n] == '/') || (mnt[n - 1] == '/'))) {
+			best = n;
+			buf->dev = (uint32_t)i;
+		}
+	}
+
+	/* FNV-1a */
+	for (const char *s = path; *s != '\0'; s++) {
+		h ^= (uint8_t)*s;
+		h *= 0x100000001b3ULL;
+	}
+	buf->ino = h;
+}
