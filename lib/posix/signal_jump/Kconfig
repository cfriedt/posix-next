config POSIX_SIGNAL_JUMP
	bool "POSIX signal jump support"
	depends on POSIX_SIGNALS
	depends on !MINIMAL_LIBC || TC_PROVIDES_POSIX_SIGNAL_JUMP
	depends on !NATIVE_BUILD || NATIVE_LIBC
	help
	  Select 'y' here to enable the POSIX_SIGNAL_JUMP Option Group; Zephyr
	  will provide implementations of sigsetjmp() and siglongjmp() on top
	  of the C library's setjmp() and longjmp().

	  The minimal C library provides no setjmp() and cannot support this
	  option group. Native builds support it only with the host C library:
	  with any other C library, setjmp() and longjmp() still resolve to
	  the host's symbols, whose jmp_buf is larger than the configured C
	  library's, so setjmp() writes beyond the buffer.

	  For more information, please see
	  https://pubs.opengroup.org/onlinepubs/9699919799/xrat/V4_subprofiles.html
