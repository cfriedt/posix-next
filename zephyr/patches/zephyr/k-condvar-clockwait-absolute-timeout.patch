diff --git a/kernel/Kconfig b/kernel/Kconfig
index 6f425aa5..b47c2377 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -804,6 +804,8 @@ menu "Other Kernel Object Options"
 
 config CONDVAR_OPTIONS
 	bool "Support optional condition variable features"
+	# absolute deadlines are armed as absolute kernel timeouts, in one conversion
+	select TIMEOUT_64BIT
 	help
 	  Say 'Y' here to support condition variable options such as those required for clock-based
 	  waiting.
diff --git a/kernel/condvar.c b/kernel/condvar.c
index c2b5896a..59d68090 100644
--- a/kernel/condvar.c
+++ b/kernel/condvar.c
@@ -187,7 +187,6 @@ int z_impl_k_condvar_clockwait(struct k_condvar *condvar, struct k_mutex *mutex,
 {
 	int ret;
 	k_timeout_t timeout;
-	k_timepoint_t timepoint;
 
 	switch (clock_id) {
 	case SYS_CLOCK_REALTIME:
@@ -198,23 +197,23 @@ int z_impl_k_condvar_clockwait(struct k_condvar *condvar, struct k_mutex *mutex,
 	}
 
 	if (!timespec_is_valid(abstime)) {
-		return EINVAL;
-	}
-
-	timepoint = timespec_abs_to_timepoint(clock_id, abstime);
-	if (sys_timepoint_expired(timepoint)) {
-		return -ETIMEDOUT;
+		return -EINVAL;
 	}
 
-	timeout = sys_timepoint_timeout(timepoint);
+	/*
+	 * A single coherent conversion to an absolute kernel timeout: the deadline
+	 * does not decay across preemption between here and the pend below, and an
+	 * already-past deadline pends and expires immediately.
+	 *
+	 * TODO(clock-settime-reactive-waits): a SYS_CLOCK_REALTIME deadline bakes in
+	 * the realtime offset sampled here; a later sys_clock_settime() does not
+	 * re-target blocked waiters.
+	 */
+	timeout = timespec_abs_to_timeout(clock_id, abstime);
 
 	ret = k_condvar_wait(condvar, mutex, timeout);
-	switch (ret) {
-	case -EAGAIN:
+	if (ret == -EAGAIN) {
 		ret = -ETIMEDOUT;
-		__fallthrough;
-	default:
-		break;
 	}
 
 	return ret;
