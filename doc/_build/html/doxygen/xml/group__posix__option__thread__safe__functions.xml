<doxygen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="compound.xsd" version="1.9.8" xml:lang="en-US">
  <compounddef id="group__posix__option__thread__safe__functions" kind="group">
    <compoundname>posix_option_thread_safe_functions</compoundname>
    <title>_POSIX_THREAD_SAFE_FUNCTIONS</title>
    <briefdescription>
<para>POSIX Thread-Safe Functions option. </para>
    </briefdescription>
    <detaileddescription>
<para>In Zephyr, <computeroutput>_POSIX_THREAD_SAFE_FUNCTIONS</computeroutput> is defined when <computeroutput>CONFIG_POSIX_C_LANG_SUPPORT_R</computeroutput>, <computeroutput>CONFIG_POSIX_FILE_SYSTEM_R</computeroutput>, and <computeroutput>CONFIG_POSIX_FILE_LOCKING</computeroutput> are enabled. </para>
    </detaileddescription>
  </compounddef>
