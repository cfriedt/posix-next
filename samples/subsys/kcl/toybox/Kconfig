mainmenu "toybox for Linux on Zephyr"

config KCL_LINUX_TOYBOX_COMMAND
	string "Command line for the shell"
	default ""
	help
	  Run toysh on this command line (sh -c "...") instead of an
	  interactive shell on the console. The installed /root/demo.sh
	  tours the applets and ends in the interactive shell.

config KCL_LINUX_TOYBOX_PROMPT_LINE
	bool "End the interactive shell's first prompt line"
	help
	  Print a line a few seconds after the shell starts. The console
	  test harness reads whole lines, so the shell's prompt, which
	  ends without a newline, is only seen when something follows it.

source "Kconfig.zephyr"
