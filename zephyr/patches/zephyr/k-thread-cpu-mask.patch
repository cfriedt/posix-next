+static volatile int affinity_cpu;
+static volatile bool affinity_stop;
+
+static void report_cpu(void *arg0, void *arg1, void *arg2)
+{
+	ARG_UNUSED(arg0);
+	ARG_UNUSED(arg1);
+	ARG_UNUSED(arg2);
+
+	while (!affinity_stop) {
+		affinity_cpu = curr_cpu();
+	}
+}
+
 ZTEST(smp, test_smp_affinity)
 {
+	k_tid_t tid;
 	int num_threads = arch_num_cpus();
 
 	for (int i = 0; i < num_threads; ++i) {
@@ -1282,6 +1299,26 @@ ZTEST(smp, test_smp_affinity)
 	for (int i = 0; i < num_threads; i++) {
 		k_thread_join(&tthread[i], K_FOREVER);
 	}
+
+	affinity_stop = false;
+	affinity_cpu = -1;
+	tid = k_thread_create(&tthread[0], tstack[0], STACK_SIZE, report_cpu, NULL, NULL, NULL,
+			      k_thread_priority_get(k_current_get()) + 1, 0, K_NO_WAIT);
+
+	for (int i = 0; i < 2 * num_threads; i++) {
+		int cpu = i % num_threads;
+
+		zassert_ok(k_thread_cpu_pin(tid, cpu));
+		zassert_true(WAIT_FOR(affinity_cpu == cpu, TIMEOUT * USEC_PER_MSEC, k_msleep(1)),
+			     "running thread did not move to CPU %d", cpu);
+		zassert_equal(k_thread_cpu_mask_get(tid), BIT(cpu));
+	}
+
+	zassert_ok(k_thread_cpu_mask_set(tid, BIT_MASK(num_threads)));
+	zassert_equal(k_thread_cpu_mask_get(tid), BIT_MASK(num_threads));
+
+	affinity_stop = true;
+	k_thread_join(tid, K_FOREVER);
 }
 #endif
 
