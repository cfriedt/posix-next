-	if ((obj == NULL) || (obj->type != K_OBJ_FUTEX)) {
-		return NULL;
+	if ((obj != NULL) && (obj->type == K_OBJ_FUTEX)) {
+		return obj->data.futex_data;
 	}
 
-	return obj->data.futex_data;
+	return &futex_hash_buckets[(addr / sizeof(struct k_futex)) % FUTEX_HASH_BUCKETS];
 }
 
