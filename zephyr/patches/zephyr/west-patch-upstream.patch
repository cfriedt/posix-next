+        dependents = {}
+        for e in series:
+            for d in e.deps:
+                dependents.setdefault(d, []).append(e.path)
+
+        def unblocks(path):
+            seen = set()
+            stack = list(dependents.get(path, []))
+            while stack:
+                x = stack.pop()
+                if x not in seen:
+                    seen.add(x)
+                    stack.extend(dependents.get(x, []))
+            return len(seen)
+
+        ranked = []
+        for row in rows:
+            if row["status"] != "ready":
+                continue
+            e = by_path[row["path"]]
+            files = patch_files(db.patch_file(e))
+            if args.path and not any(fnmatch.fnmatch(f, g) for f in files for g in args.path):
+                continue
+            size = 0
