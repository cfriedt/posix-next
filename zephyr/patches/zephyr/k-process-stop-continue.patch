+	zassert_ok(k_kill(child, K_SIG_STOP));
+	zassert_ok(k_waitpid(child, NULL, &ws, K_PROCESS_WUNTRACED, K_SECONDS(5)));
+	zassert_true(K_WIFSTOPPED(ws), "not stopped (0x%x)", ws);
+	zassert_str_equal(k_thread_state_str(&stop_member, state, sizeof(state)), "suspended");
+	zassert_ok(k_kill(child, K_SIG_CONT));
+	zassert_ok(k_waitpid(child, NULL, &ws, K_PROCESS_WCONTINUED, K_SECONDS(5)));
+	zassert_true(K_WIFCONTINUED(ws), "not continued (0x%x)", ws);
+	zassert_str_equal(k_thread_state_str(&stop_member, state, sizeof(state)), "suspended");
+	stop_child_release = true;
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_SECONDS(5)));
+	zassert_true(K_WIFEXITED(ws) && (K_WEXITSTATUS(ws) == 0), "0x%x", ws);
+}
+
+/*
+ * A storm of stops and continues from another CPU lands stops on a child that is in the
+ * middle of taking one; a full queue is fine, the storm only has to keep going.
+ */
+static void kill_stop_storm(void)
+{
+	int ws = 0;
+	int ret;
+	k_pid_t child = &child_a;
+	struct sys_clone_args args = {
+		.entry = stop_child_entry,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
+	};
+
+	stop_child_release = false;
+	zassert_ok(sys_clone(&args, NULL));
+	for (int i = 0; i < 10000; i++) {
+		ret = k_kill(child, K_SIG_STOP);
+		zassert_true((ret == 0) || (ret == -EAGAIN), "STOP: %d", ret);
+		ret = k_kill(child, K_SIG_CONT);
+		zassert_true((ret == 0) || (ret == -EAGAIN), "CONT: %d", ret);
+	}
+	/* the storm's SIGCHLDs may still fill the queue: a continue does not need a slot */
+	ret = k_kill(child, K_SIG_CONT);
+	zassert_true((ret == 0) || (ret == -EAGAIN), "the last CONT: %d", ret);
+	stop_child_release = true;
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_SECONDS(5)));
+	zassert_true(K_WIFEXITED(ws), "0x%x", ws);
+}
+
+static K_THREAD_STACK_DEFINE(waiter_stack, STATIC_PROC_STACK_SIZE);
+static struct k_thread waiter_thread;
+static K_SEM_DEFINE(waiter_ready, 0, 1);
+static K_SEM_DEFINE(waiter_event, 0, 8);
+static int waiter_history[8];
+static volatile int waiter_n;
+static volatile int waiter_chld_handled;
+
+static void waiter_chld_handler(int sig, struct k_sig_info *info, void *context)
+{
+	ARG_UNUSED(sig);
+	ARG_UNUSED(info);
+	ARG_UNUSED(context);
+	waiter_chld_handled++;
+}
+
+/*
+ * In the test process, accepting and handling K_SIG_CHLD: reports every state
+ * change of its child. The handled signal does not hide the state change that
+ * generated it from the wait.
+ */
+static void waiter_entry(void *p1, void *p2, void *p3)
+{
+	struct k_sig_action act = {.handler = waiter_chld_handler, .flags = K_SIG_SA_SIGINFO};
+	struct k_sig_action old;
+	struct k_sig_set set;
+	int ws = 0;
+	int ret;
+
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	(void)k_sig_action(K_SIG_CHLD, &act, &old);
+	k_sig_emptyset(&set);
+	k_sig_addset(&set, K_SIG_CHLD);
+	(void)k_sig_mask(K_SIG_UNBLOCK, &set, NULL);
+	k_sem_give(&waiter_ready);
+	for (;;) {
+		ret = k_waitpid((k_pid_t)p1, NULL, &ws, K_PROCESS_WUNTRACED | K_PROCESS_WCONTINUED,
+				K_SECONDS(5));
+		if (ret == -EINTR) {
+			continue;
+		}
+		if (ret != 0) {
+			break;
+		}
+		(void)k_sig_timedwait(&set, NULL, K_NO_WAIT);
+		if (waiter_n < (int)ARRAY_SIZE(waiter_history)) {
+			waiter_history[waiter_n] = ws;
+		}
+		waiter_n++;
+		k_sem_give(&waiter_event);
+		if (K_WIFEXITED(ws) || K_WIFSIGNALED(ws)) {
+			break;
+		}
+	}
+	(void)k_sig_action(K_SIG_CHLD, &old, NULL);
+}
+
+/*
+ * The sender and the waiter share a priority. A continue wakes the waiter and
+ * the sender does not resume until the waiter has reported it, so a stop the
+ * sender generates right after cannot take the report's place.
+ */
+static void kill_continue_observed(void)
+{
+	k_pid_t child = &child_a;
+	struct sys_clone_args args = {
+		.entry = stop_child_entry,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = 0,
+	};
+	int prio = k_thread_priority_get(k_current_get());
+
+	waiter_n = 0;
+	waiter_chld_handled = 0;
+	stop_child_release = false;
+	zassert_ok(sys_clone(&args, NULL));
+	k_thread_create(&waiter_thread, waiter_stack, STATIC_PROC_STACK_SIZE, waiter_entry, child,
+			NULL, NULL, 0, 0, K_NO_WAIT);
+	zassert_ok(k_sem_take(&waiter_ready, K_SECONDS(1)));
+	k_thread_priority_set(k_current_get(), 0);
+
+	zassert_ok(k_kill(child, K_SIG_STOP));
+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(1)));
+	zassert_ok(k_kill(child, K_SIG_CONT));
+	if (CONFIG_MP_MAX_NUM_CPUS == 1) {
+		zassert_equal(waiter_n, 2, "the sender resumed before the waiter saw the continue");
+	}
+	zassert_ok(k_kill(child, K_SIG_STOP));
+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(1)));
+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(1)));
+	zassert_ok(k_kill(child, K_SIG_CONT));
+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(1)));
+	stop_child_release = true;
+	zassert_ok(k_sem_take(&waiter_event, K_SECONDS(5)));
+	k_thread_priority_set(k_current_get(), prio);
+	zassert_ok(k_thread_join(&waiter_thread, K_SECONDS(1)));
+
+	zassert_equal(waiter_n, 5, "%d reports", waiter_n);
+	zassert_true(waiter_chld_handled > 0, "the waiter's K_SIG_CHLD handler never ran");
+	zassert_true(K_WIFSTOPPED(waiter_history[0]), "0x%x", waiter_history[0]);
+	zassert_true(K_WIFCONTINUED(waiter_history[1]), "0x%x", waiter_history[1]);
+	zassert_true(K_WIFSTOPPED(waiter_history[2]), "0x%x", waiter_history[2]);
+	zassert_true(K_WIFCONTINUED(waiter_history[3]), "0x%x", waiter_history[3]);
+	zassert_true(K_WIFEXITED(waiter_history[4]), "0x%x", waiter_history[4]);
+}
