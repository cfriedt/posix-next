+#ifdef CONFIG_SIGNAL_FAULT
+/* a fault taken in U-mode generates the signal Linux generates for it */
+static bool user_fault_signal(struct arch_esf *esf)
+{
+	unsigned long cause;
+	unsigned long tval;
+	int signo = K_SIG_SEGV;
+	int code = K_SEGV_ACCERR;
+
+#ifdef CONFIG_RISCV_S_MODE
+	cause = csr_read(scause);
+	tval = csr_read(stval);
+#else
+	cause = csr_read(mcause);
+	tval = csr_read(mtval);
+#endif
+	void *addr = (void *)tval;
+
+	switch (cause & CONFIG_RISCV_MCAUSE_EXCEPTION_MASK) {
+	case 0: /* instruction address misaligned */
+	case 4: /* load address misaligned */
+	case 6: /* store address misaligned */
+		signo = K_SIG_BUS;
+		code = K_BUS_ADRALN;
+		break;
+	case 1: /* instruction access fault */
+	case 5: /* load access fault */
+	case 7: /* store access fault */
+		break;
+	case 2: /* illegal instruction */
+		signo = K_SIG_ILL;
+		code = K_ILL_ILLOPC;
+		addr = (void *)esf->mepc;
+		break;
+	case RISCV_EXC_BREAKPOINT:
+		signo = K_SIG_TRAP;
+		code = K_TRAP_BRKPT;
+		addr = (void *)esf->mepc;
+		break;
+#ifdef CONFIG_RISCV_MMU
+	case RISCV_EXC_INST_PAGE_FAULT:
+	case RISCV_EXC_LOAD_PAGE_FAULT:
+	case RISCV_EXC_STORE_PAGE_FAULT: {
+		uintptr_t phys;
+
+		/* mapped for the kernel: a permission the user lacks */
+		code = (arch_page_phys_get(addr, &phys) == 0) ? K_SEGV_ACCERR : K_SEGV_MAPERR;
+		break;
+	}
+#endif /* CONFIG_RISCV_MMU */
+	default:
+		signo = K_SIG_ILL;
+		code = K_ILL_ILLTRP;
+		addr = (void *)esf->mepc;
+		break;
+	}
+
+	if (!z_sig_fault(signo, code, addr)) {
+		return false;
+	}
+	esf->mepc = (unsigned long)z_sig_fault_entry;
+
+	return true;
+}
+#endif /* CONFIG_SIGNAL_FAULT */
+
 void z_riscv_fault(struct arch_esf *esf)
 {
 #ifdef CONFIG_RISCV_MMU
@@ -262,6 +328,12 @@ void z_riscv_fault(struct arch_esf *esf)
