        <type>int</type>
        <definition>int waitid</definition>
        <argsstring>(idtype_t idtype, id_t id, siginfo_t *infop, int options)</argsstring>
        <name>waitid</name>
        <param>
          <type><ref refid="wait_8h_1a7fafc52887ec08ddf681426ce87d7312" kindref="member">idtype_t</ref></type>
          <declname>idtype</declname>
        </param>
        <param>
