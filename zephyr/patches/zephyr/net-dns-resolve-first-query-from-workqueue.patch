+/* The hash a reply's question is matched by: the packed name, lowered in
+ * place, and the two bytes of query type that follow it. The length counts
+ * the terminating zero.
+ */
+static uint16_t dns_question_hash(uint8_t *query_name, uint16_t name_len)
+{
+	for (int i = 0; i < name_len; i++) {
+		query_name[i] = tolower(query_name[i]);
+	}
+
+	return crc16_ansi(query_name, name_len + 2);
+}
+
 /* Length of the query name without the trailing dot of an absolute name */
 static size_t dns_query_name_len(const char *query)
 {
@@ -2314,18 +2327,8 @@ static int dns_write(struct dns_resolve_context *ctx,
 
 	query_name = buf + DNS_MSG_HEADER_SIZE;
 
-	/* Convert the query name to small case so that our
-	 * hash checker can find it later when we get the answer.
-	 */
-	for (int i = 0; i < dns_qname->len; i++) {
-		query_name[i] = tolower(query_name[i]);
-	}
-
-	/* Add \0 and query type (A or AAAA) to the hash. Note that
-	 * the dns_qname->len contains the length of \0
-	 */
 	ctx->queries[query_idx].query_hash =
-		crc16_ansi(query_name, dns_qname->len + 2);
+		dns_question_hash(query_name, dns_qname->len);
 
 	if (hop_limit > 0) {
 		if (IS_ENABLED(CONFIG_NET_IPV6) && family == NET_AF_INET6) {
@@ -2576,6 +2579,10 @@ static void query_timeout(struct k_work *work)
 
 	slot = pending_query - ctx->queries;
 
+	/* A query not yet sent arrives here at once: no server of its is
+	 * awaiting a reply, so the failure handling queries the first eligible
+	 * one. That is its first send, deferred to this work queue.
+	 */
 	dns_query_fail_pending_servers(pending_query);
 	dns_handle_server_failure(ctx, slot, -1, DNS_EAI_CANCELED);
 
@@ -2623,6 +2630,7 @@ int dns_resolve_name_internal(struct dns_resolve_context *ctx,
 	struct net_sockaddr_storage addr = { 0 };
 	struct net_sockaddr *sa = net_sad(&addr);
 	int ret, i = -1;
+	uint16_t len;
 	bool mdns_query = false;
 #ifdef CONFIG_DNS_RESOLVER_CACHE
 	struct dns_addrinfo cached_info[CONFIG_DNS_RESOLVER_AI_MAX_ENTRIES] = {0};
@@ -2882,17 +2890,30 @@ try_resolve:
 		NET_DBG("DNS id will be %u", *dns_id);
 	}
 
-	ret = dns_query_servers(ctx, i, dns_data->data,
-				net_buf_tailroom(dns_data),
-				net_buf_tailroom(dns_data),
-				dns_qname, false);
+	/* The question as it will be sent, for the hash a reply or a
+	 * cancellation by name is matched with: the query is found by its name
+	 * from the moment it is accepted, not from its first send.
+	 */
+	len = net_buf_tailroom(dns_data);
+	ret = dns_msg_pack_query(dns_data->data, &len, net_buf_tailroom(dns_data),
+				 dns_qname->data, dns_qname->len,
+				 ctx->queries[i].id, (enum dns_rr_type)type);
 	if (ret < 0) {
-		ret = -ENOENT;
 		goto quit;
 	}
 
+	ctx->queries[i].query_hash =
+		dns_question_hash(dns_data->data + DNS_MSG_HEADER_SIZE, dns_qname->len);
 	ctx->queries[i].orig_query_hash = ctx->queries[i].query_hash;
 
+	/* The first query goes out from the system work queue, as a retransmit
+	 * does: query_timeout() finds no server tried and sends to the first
+	 * one eligible. Nothing of the resolver's then runs on the caller's
+	 * thread, which may be a user thread in a system call with no right to
+	 * the resolver's sockets.
+	 */
+	(void)k_work_reschedule(&ctx->queries[i].timer, K_NO_WAIT);
+
 	ret = 0;
 
