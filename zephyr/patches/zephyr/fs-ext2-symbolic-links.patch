+static int ext2_symlink(struct fs_mount_t *mountp, const char *target, const char *path)
+{
+	int rc, ret = 0;
+	struct ext2_data *fs = mountp->fs_data;
+	size_t tlen = strlen(target);
+
+	if (tlen == 0) {
+		return -ENOENT;
+	}
+
+	if (tlen > EXT2_FAST_SYMLINK_MAX) {
+		/* only fast symbolic links are supported */
+		return -ENAMETOOLONG;
+	}
+
+	path = fs_impl_strip_prefix(path, mountp);
+
+	struct ext2_lookup_args args = {
+		.path = path,
+		.inode = NULL,
+		.parent = NULL,
+		.flags = LOOKUP_ARG_CREATE | LOOKUP_ARG_NOFOLLOW,
+	};
+
+	rc = ext2_lookup_inode(fs, &args);
+	if (rc < 0) {
+		return rc;
+	}
+
+	if (args.inode != NULL) {
+		ret = -EEXIST;
+		goto out;
+	}
+
+	struct ext2_inode *new_inode;
+
+	rc = ext2_inode_get(fs, 0, &new_inode);
+	if (rc < 0) {
+		ret = rc;
+		goto out;
+	}
+
+	rc = ext2_create_symlink(args.parent, new_inode, &args, target);
+	if (rc < 0) {
+		ext2_inode_drop(new_inode);
+		ret = rc;
+		goto out;
+	}
+
+	rc = ext2_inode_drop(new_inode);
+	if (rc < 0) {
+		ret = rc;
+	}
+out:
+	ext2_inode_drop(args.inode);
+	ext2_inode_drop(args.parent);
+	return ret;
