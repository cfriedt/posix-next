+			targets[n++] = tgt;
 		}
 		k_spin_unlock(&process_lock, key);
 
 		found += n;
 #ifdef CONFIG_SIGNAL
 		for (int i = 0; i < n; i++) {
-			int err = (targets[i] == NULL)
-					  ? z_sig_queue_process(scopes[i], signo)
-					  : k_sig_queue(targets[i], signo, (union k_sig_val){0});
+			int err = k_sig_queue(targets[i], signo, (union k_sig_val){0});
 
 			if (err == -EINVAL) {
 				return -EINVAL;
@@ -897,6 +900,9 @@ static inline int z_vrfy_k_kill_pgrp(k_pgrp_t pgrp, int signo)
 int z_impl_k_kill(k_pid_t pid, int signo)
 {
 	bool found = false;
+	bool live = false;
+	bool pended = false;
+	int ret = 0;
 #ifdef CONFIG_SIGNAL
 	k_tid_t tid = NULL;
 #endif /* CONFIG_SIGNAL */
@@ -904,12 +910,23 @@ int z_impl_k_kill(k_pid_t pid, int signo)
 
 	K_SPINLOCK(&process_lock) {
 		proc = (pid == NULL) ? process_self() : process_ctx_resolve_locked(pid);
-		if (proc != NULL) {
-			found = true;
+		if (proc == NULL) {
+			K_SPINLOCK_BREAK;
+		}
+		found = true;
+		live = !sys_dlist_is_empty(&proc->threads);
 #ifdef CONFIG_SIGNAL
+		if ((signo != 0) && live) {
 			tid = process_sig_target(proc, signo);
-#endif /* CONFIG_SIGNAL */
+			if (tid == NULL) {
+				/* every member masked: pend at process scope,
+				 * under the lock so reap cannot race the queue
+				 */
+				ret = z_sig_queue_process(proc, signo);
+				pended = true;
+			}
 		}
+#endif /* CONFIG_SIGNAL */
 	}
 
 	if (!found) {
@@ -919,16 +936,17 @@ int z_impl_k_kill(k_pid_t pid, int signo)
 		/* existence check only; zombies exist until reaped */
 		return 0;
 	}
-#ifdef CONFIG_SIGNAL
-	if (tid == NULL) {
+	if (!live) {
 		return -ESRCH;
 	}
-	if (tid == NULL) {
-		/* every member has the signal masked: pend at process scope */
-		return z_sig_queue_process(proc, signo);
+#ifdef CONFIG_SIGNAL
+	if (pended) {
+		return ret;
 	}
 	return k_sig_queue(tid, signo, (union k_sig_val){0});
 #else
+	ARG_UNUSED(pended);
+	ARG_UNUSED(ret);
 	return -ENOTSUP;
 #endif /* CONFIG_SIGNAL */
 }
@@ -1281,12 +1299,17 @@ static void sigchld_notifier(void *p1, void *p2, void *p3)
