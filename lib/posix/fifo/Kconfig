config POSIX_FIFO
	bool "POSIX FIFO special files"
	depends on POSIX_FILE_SYSTEM
	select ZVFS_PIPE if !TC_PROVIDES_POSIX_FIFO
	select ZVFS_FIFO if !TC_PROVIDES_POSIX_FIFO
	help
	  Select 'y' here and Zephyr will provide an implementation of the
	  POSIX_FIFO Option Group: mkfifo(). A FIFO is a node the file system
	  stores (ext2 provides it) that open() connects to a pipe; the pipes
	  come from the pool of CONFIG_ZVFS_PIPE_MAX, and the open descriptions
	  from CONFIG_ZVFS_FIFO_OPEN_MAX.
