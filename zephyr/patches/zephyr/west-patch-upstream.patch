+def _git(repo, *args, check=True, env=None, input=None):
+    cmd = ["git", "-C", os.fspath(repo), *args]
+    proc = subprocess.run(cmd, capture_output=True, encoding="utf-8", env=env, input=input)
+    if check and proc.returncode:
+        raise PatchError(f"{' '.join(cmd)} failed:\n{proc.stderr.strip()}")
+    return proc
+
+
+def _gh(*args, check=True):
+    proc = subprocess.run(["gh", *args], capture_output=True, encoding="utf-8")
+    if check and proc.returncode:
+        raise PatchError(f"gh {' '.join(args)} failed:\n{proc.stderr.strip()}")
+    return proc
+
+
+def _gh_json(*args):
+    return json.loads(_gh(*args).stdout or "null")
+
+
+def parse_patch(patch_path):
+    """Return (files, rename pairs) of a unified diff: every repo-relative path it touches, and
+    the (old, new) path pairs of renames/copies."""
+    files = set()
+    pairs = []
+    with open(patch_path, encoding="utf-8", errors="replace") as f:
+        for line in f:
+            if not line.startswith("diff --git "):
+                continue
+            m = re.match(r'^diff --git (?:"?a/(.*?)"?) (?:"?b/(.*?)"?)$', line.rstrip("\n"))
+            if m:
+                a, b = m.groups()
+                files.update((a, b))
+                if a != b:
+                    pairs.append((a, b))
+    return files, pairs
+
+
+def patch_files(patch_path):
+    return parse_patch(patch_path)[0]
+
+
+def derive_area(files):
+    counts = Counter()
+    order = {}
+    for f in sorted(files):
+        for pattern, repl in AREA_RULES:
+            m = re.match(pattern, f)
+            if m:
+                area = m.expand(repl)
+                counts[area] += 1
+                order.setdefault(area, len(order))
+                break
+    if not counts:
+        return None
+    return max(counts, key=lambda a: (counts[a], -order[a]))
+
+
+def derive_summary(comments):
+    text = " ".join(comments.split())
+    if not text:
+        return ""
+    m = re.match(r"(.+?[.!?])(\s|$)", text)
+    summary = m.group(1) if m else text
+    summary = summary.rstrip(".")
+    if len(summary) > 1 and summary[1].islower():
+        summary = summary[0].lower() + summary[1:]
+    return summary
+
+
+def fit_subject(subject, limit=SUBJECT_MAX):
+    """Shorten an over-long subject at a clause boundary, else at a word boundary."""
+    if len(subject) <= limit:
+        return subject
+    cuts = [
+        m.start()
+        for m in re.finditer(r"\s*[(;:,]|\s+-\s", subject)
+        if limit // 2 <= m.start() <= limit
+    ]
+    if cuts:
+        return subject[: max(cuts)].rstrip()
+    words = subject[:limit].rsplit(" ", 1)[0].rstrip(",;:").split(" ")
+    while words and words[-1].lower() in DANGLING_WORDS:
+        words.pop()
+    return " ".join(words)
+
+
+def make_subject(entry, files):
+    if entry.title:
+        return entry.title
+    area = derive_area(files)
+    summary = derive_summary(entry.comments) or entry.stem.replace("-", " ")
+    return fit_subject(f"{area}: {summary}" if area else summary)
+
+
+def make_body(entry):
+    paragraphs = re.split(r"\n\s*\n", entry.comments)
+    return "\n\n".join(textwrap.fill(" ".join(p.split()), BODY_WIDTH) for p in paragraphs if p)
+
