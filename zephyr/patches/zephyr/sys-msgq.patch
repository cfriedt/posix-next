diff --git a/include/zephyr/sys/mqueue.h b/include/zephyr/sys/mqueue.h
new file mode 100644
index 00000000000..f0d6fa6e7a8
--- /dev/null
+++ b/include/zephyr/sys/mqueue.h
@@ -0,0 +1,199 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_SYS_MQUEUE_H_
+#define ZEPHYR_INCLUDE_SYS_MQUEUE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/kernel/signal.h>
+#include <zephyr/sys/fdtable.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @defgroup sys_msgq_apis OS-managed named message queue APIs
+ * @ingroup os_services
+ *
+ * An OS-managed pool of named, priority-mode message queues, opened and
+ * operated on through file descriptors: the substrate for POSIX message
+ * queues (mq_open() and friends). Queues are named, reference counted,
+ * persist until unlinked, and every operation is a system call keyed by the
+ * file descriptor, so no kernel object pointers or object permissions are
+ * exposed to user mode. A descriptor is closed with zvfs_close().
+ * @{
+ */
+
+/**
+ * @brief Notification registration for sys_msgq_notify().
+ *
+ * When @ref fn is NULL, signal @ref signo carrying @ref value is generated
+ * for thread @ref target when a message arrives at the empty queue; a
+ * @ref signo of 0 registers a notification that is consumed without
+ * generating anything (POSIX `SIGEV_NONE`). When @ref fn is non-NULL, a
+ * detached system-pool thread runs `fn(value)` instead (POSIX
+ * `SIGEV_THREAD`); @ref fn_priority and @ref fn_stack_size shape that
+ * thread, which runs in user mode in the registrant's memory domain when the
+ * registration was made from a user thread.
+ */
+struct sys_msgq_notify {
+	/** Thread the signal is generated for (fn == NULL, signo != 0) */
+	k_pid_t target;
+	/** Signal number to generate, or 0 for none */
+	int signo;
+	/** Value carried by the notification */
+	union k_sig_val value;
+	/** Function notification: called as fn(value) from a detached thread */
+	void (*fn)(union k_sig_val value);
+	/** Priority of the function-notification thread */
+	int fn_priority;
+	/** Stack size of the function-notification thread (0 for default) */
+	size_t fn_stack_size;
+};
+
+/** File-mode bit on an @ref ZVFS_MODE_IMSGQ descriptor: opened for reading */
+#define SYS_MSGQ_FMODE_READ  ZVFS_S_IRUSR
+/** File-mode bit on an @ref ZVFS_MODE_IMSGQ descriptor: opened for writing */
+#define SYS_MSGQ_FMODE_WRITE ZVFS_S_IWUSR
+/** File-mode bit on an @ref ZVFS_MODE_IMSGQ descriptor: non-blocking */
+#define SYS_MSGQ_FMODE_NONBLOCK ZVFS_S_IXUSR
+
+/**
+ * @brief Open (and possibly create) a named message queue.
+ *
+ * Opens the queue named @a name, creating it when @a oflags contains
+ * @ref ZVFS_O_CREAT and no queue of that name exists. Creation requires
+ * @a attr with a non-zero @c msg_size and @c max_msgs whose storage fits the
+ * per-queue buffer budget (@kconfig{CONFIG_SYS_MSGQ_BUF_SIZE}). The access
+ * mode and @ref ZVFS_O_NONBLOCK are recorded per descriptor.
+ *
+ * @param name Queue name (no path semantics; at most
+ *             @kconfig{CONFIG_SYS_MSGQ_NAMELEN_MAX} characters).
+ * @param oflags ZVFS_O_* flags: access mode, ZVFS_O_CREAT, ZVFS_O_EXCL,
+ *               ZVFS_O_NONBLOCK.
+ * @param mode Creation mode bits (recorded but not enforced).
+ * @param attr Queue geometry when creating (else may be NULL).
+ *
+ * @return A file descriptor on success, otherwise a negative errno: -EEXIST
+ *         (O_CREAT|O_EXCL and the name exists), -ENOENT (no O_CREAT and the
+ *         name does not exist), -EINVAL (bad name or geometry), -ENOSPC
+ *         (geometry exceeds the buffer budget or the pool is exhausted),
+ *         -ENFILE (no free file descriptors).
+ */
+__syscall int sys_msgq_open(const char *name, int oflags, uint32_t mode,
+			    const struct k_msgq_attrs *attr);
+
+/**
+ * @brief Unlink a named message queue.
+ *
+ * Removes @a name from the registry immediately; the queue itself is
+ * destroyed once its last descriptor is closed.
+ *
+ * @param name Queue name.
+ *
+ * @retval 0 Success.
+ * @retval -ENOENT No queue of that name exists.
+ * @retval -EINVAL Bad name.
+ */
+__syscall int sys_msgq_unlink(const char *name);
+
+/**
+ * @brief Send a message to an open message queue.
+ *
+ * @param fd Descriptor from sys_msgq_open().
+ * @param msg Message contents.
+ * @param len Message length; at most the queue's message size.
+ * @param prio Message priority (higher delivered first).
+ * @param timeout Waiting period, or K_NO_WAIT / K_FOREVER. Forced to
+ *                K_NO_WAIT on a non-blocking descriptor.
+ *
+ * @retval 0 Message sent.
+ * @retval -EBADF @a fd is not a message queue descriptor open for writing.
+ * @retval -EMSGSIZE @a len exceeds the queue's message size.
+ * @retval -ENOMSG Queue full and no waiting was performed.
+ * @retval -EAGAIN Waiting period timed out.
+ */
+__syscall int sys_msgq_send(int fd, const void *msg, size_t len, uint32_t prio,
+			    k_timeout_t timeout);
+
+/**
+ * @brief Receive the highest-priority message from an open message queue.
+ *
+ * @param fd Descriptor from sys_msgq_open().
+ * @param msg Receive buffer.
+ * @param size Receive buffer size; at least the queue's message size.
+ * @param prio Where to store the received message's priority, or NULL.
+ * @param timeout Waiting period, or K_NO_WAIT / K_FOREVER. Forced to
+ *                K_NO_WAIT on a non-blocking descriptor.
+ *
+ * @retval >=0 Length of the received message.
+ * @retval -EBADF @a fd is not a message queue descriptor open for reading.
+ * @retval -EMSGSIZE @a size is smaller than the queue's message size.
+ * @retval -ENOMSG Queue empty and no waiting was performed.
+ * @retval -EAGAIN Waiting period timed out.
+ */
+__syscall int sys_msgq_receive(int fd, void *msg, size_t size, uint32_t *prio,
+			       k_timeout_t timeout);
+
+/**
+ * @brief Retrieve queue attributes and per-descriptor flags.
+ *
+ * @param fd Descriptor from sys_msgq_open().
+ * @param attr Where to store the queue geometry and current fill, or NULL.
+ * @param oflags Where to store the descriptor's ZVFS_O_* flags (access mode
+ *               and ZVFS_O_NONBLOCK), or NULL.
+ *
+ * @retval 0 Success.
+ * @retval -EBADF @a fd is not a message queue descriptor.
+ */
+__syscall int sys_msgq_getattr(int fd, struct k_msgq_attrs *attr, int *oflags);
+
+/**
+ * @brief Update per-descriptor flags.
+ *
+ * Only @ref ZVFS_O_NONBLOCK may be changed.
+ *
+ * @param fd Descriptor from sys_msgq_open().
+ * @param oflags New flags; bits other than ZVFS_O_NONBLOCK must be zero.
+ *
+ * @retval 0 Success.
+ * @retval -EBADF @a fd is not a message queue descriptor.
+ * @retval -EINVAL Unsupported flag bits set.
+ */
+__syscall int sys_msgq_setflags(int fd, int oflags);
+
+/**
+ * @brief Register or remove an empty-to-non-empty notification.
+ *
+ * Registers @a notify on the queue underlying @a fd (see
+ * @ref sys_msgq_notify and k_msgq_notify_arm()); a NULL @a notify removes
+ * the armed registration.
+ *
+ * @param fd Descriptor from sys_msgq_open().
+ * @param notify Registration, or NULL to remove.
+ *
+ * @retval 0 Success.
+ * @retval -EBADF @a fd is not a message queue descriptor.
+ * @retval -EBUSY A registration is already armed.
+ * @retval -EINVAL Removal requested with no registration armed, or invalid
+ *         registration fields.
+ * @retval -ENOTSUP A signal was requested without @kconfig{CONFIG_SIGNAL}.
+ */
+__syscall int sys_msgq_notify(int fd, const struct sys_msgq_notify *notify);
+
+/** @} */
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <zephyr/syscalls/mqueue.h>
+
+#endif /* ZEPHYR_INCLUDE_SYS_MQUEUE_H_ */
