diff --git a/lib/os/Kconfig.sys_aio b/lib/os/Kconfig.sys_aio
new file mode 100644
index 00000000000..8ae9841ba8e
--- /dev/null
+++ b/lib/os/Kconfig.sys_aio
@@ -0,0 +1,106 @@
+# SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+# SPDX-License-Identifier: Apache-2.0
+
+config SYS_AIO
+	bool "Support an OS-managed pool of asynchronous I/O requests"
+	select SYS_ELASTIPOOL
+	select ZVFS
+	select ZVFS_FDTABLE
+	select ZVFS_POLL
+	select POLL
+	# to support heap-based allocation by default, can be disabled
+	imply SYS_HASH_MAP
+	imply SYS_HASH_FUNC32
+	help
+	  Select 'y' here to support an OS-managed pool of asynchronous I/O
+	  requests over file descriptors, submitted and reaped with the
+	  sys_aio_*() system calls and performed by a dedicated kernel
+	  service queue. This is the substrate for POSIX asynchronous I/O
+	  (aio_read() and friends).
+
+if SYS_AIO
+
+config SYS_AIO_MAX
+	int "Maximum size of the asynchronous I/O request pool"
+	default 2147483647
+	help
+	  This value represents the maximum number of asynchronous I/O
+	  requests (and completion groups) that may be allocated from the
+	  pool. The first SYS_AIO_MIN (the sum of CONFIG_SYS_AIO_MIN and all
+	  CONFIG_SYS_AIO_MIN_ADD_* contributions) are statically allocated
+	  and guaranteed; the remainder come from the heap, without
+	  guarantees.
+
+	  The default (INT_MAX) effectively does not limit dynamic
+	  allocation. Set this equal to the accumulated minimum to prohibit
+	  dynamic allocation entirely.
+
+	  CONFIG_SYS_AIO_MAX must be >= the accumulated SYS_AIO_MIN.
+
+config SYS_AIO_MIN
+	int "Minimum size of the asynchronous I/O request pool"
+	default 0
+	help
+	  This value represents the minimum number of asynchronous I/O
+	  requests that are guaranteed to be available from the pool. The
+	  minimum number is guaranteed via static allocation.
+
+	  Applications and libraries contribute additional guaranteed
+	  requests by defining int symbols named CONFIG_SYS_AIO_MIN_ADD_<NAME>;
+	  the build system sums CONFIG_SYS_AIO_MIN with all such
+	  contributions and, for technical reasons, provides the result to
+	  code as the un-prefixed SYS_AIO_MIN compile definition.
+
+config SYS_AIO_PRIORITY
+	bool "Priority-ordered asynchronous I/O request processing"
+	select MIN_HEAP
+	help
+	  Select 'y' here to process ready asynchronous I/O requests in
+	  priority order rather than submission order: each request carries a
+	  thread-style priority (numerically lower executes first) and the
+	  service queue always performs the highest-priority ready request
+	  next, first-in-first-out among requests of equal priority. This is
+	  the substrate for POSIX prioritized I/O (_POSIX_PRIORITIZED_IO,
+	  aiocb aio_reqprio).
+
+config SYS_AIO_WORKQ_STACK_SIZE
+	int "Stack size of the asynchronous I/O service queue thread"
+	default 4096
+	help
+	  Stack size of the dedicated work queue thread that waits for file
+	  descriptor readiness and performs asynchronous I/O operations. The
+	  thread is started on first use. Operations on file system backed
+	  descriptors run the file system driver on this stack, so it must be
+	  sized for the deepest backend in use.
+
+config SYS_AIO_WORKQ_PRIO
+	int "Priority of the asynchronous I/O service queue thread"
+	default 0
+	help
+	  Priority of the asynchronous I/O service queue thread. Operations
+	  execute one at a time - in request-priority order under
+	  SYS_AIO_PRIORITY, in submission-completion order otherwise: a slow
+	  operation (e.g. on a regular file or an offloaded socket) delays
+	  the operations queued behind it.
+
+config SYS_AIO_WAIT_MAX
+	int "Maximum number of requests in one sys_aio_wait() call"
+	default 8
+	range 1 1024
+	help
+	  Upper bound on the number of request handles a single
+	  sys_aio_wait() call (and, through it, POSIX aio_suspend() and
+	  lio_listio(LIO_WAIT)) can wait on at once.
+
+config SYS_AIO_POLL_EVENTS
+	int "Readiness event slots per asynchronous I/O request"
+	default 2
+	range 1 8
+	help
+	  Number of k_poll_event slots each request carries for its
+	  descriptor's readiness condition(s). Backends typically register
+	  one event per requested direction; requests whose backend needs
+	  more slots than this fall back to direct (blocking) execution on
+	  the service queue.
+
+endif # SYS_AIO
diff --git a/lib/os/aio.c b/lib/os/aio.c
new file mode 100644
index 00000000000..2957a8c579d
--- /dev/null
+++ b/lib/os/aio.c
@@ -0,0 +1,1122 @@
+/*
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include <zephyr/internal/syscall_handler.h>
+#include <zephyr/kernel.h>
+#include <kernel_internal.h>
+#include <zephyr/kernel/signal.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/aio.h>
+#include <zephyr/sys/elastipool.h>
+#include <zephyr/sys/fdtable.h>
+#include <zephyr/sys/internal/fdtable_priv.h>
+#include <zephyr/sys/min_heap.h>
+#include <zephyr/sys/thread.h>
+#include <zephyr/sys/zvfs.h>
+#include <zephyr/toolchain.h>
+
+LOG_MODULE_REGISTER(sys_aio, CONFIG_KERNEL_LOG_LEVEL);
+
+#if defined(CONFIG_SYS_THREAD) && defined(CONFIG_THREAD_DETACH)
+#define SYS_AIO_FN_NOTIFY 1
+#else
+#define SYS_AIO_FN_NOTIFY 0
+#endif
+
+/* internal opcode marking a pool slot as a completion group */
+#define SYS_AIO_OP_GROUP 0xff
+
+enum sys_aio_state {
+	SYS_AIO_STATE_QUEUED,  /* work item queued for direct execution */
+	SYS_AIO_STATE_ARMED,   /* k_work_poll armed on fd readiness */
+	SYS_AIO_STATE_READY,   /* on the priority-ordered ready queue */
+	SYS_AIO_STATE_RUNNING, /* executing (or claimed by cancellation) */
+	SYS_AIO_STATE_DONE,    /* complete; awaiting sys_aio_release() */
+	SYS_AIO_STATE_REAPED,  /* released; slot freed once busy refs drain */
+};
+
+struct sys_aio {
+	sys_snode_t node; /* in-flight list link (requests only) */
+	uint8_t op;
+	uint8_t state;
+	uint16_t busy; /* in-flight syscall references */
+	int fd;
+	void *obj; /* fd entry object captured at submit */
+	void *buf;
+	size_t len;
+	size_t offset;
+	bool use_offset;
+	int error; /* EINPROGRESS until completion */
+	ssize_t result;
+	struct sys_aio *grp;  /* completion group joined at submit, or NULL */
+	uint16_t grp_pending; /* groups: submission hold + unfinished members */
+	bool grp_finalized;
+	bool has_notify;
+	struct sys_aio_notify notify;
+	struct zvfs_pollfd pfd;
+	struct k_poll_event events[CONFIG_SYS_AIO_POLL_EVENTS];
+#ifdef CONFIG_SYS_AIO_PRIORITY
+	int prio;
+	uint32_t ready_seq;
+#else
+	struct k_work work;
+#endif
+	struct k_work_poll pwork;
+	struct k_poll_signal done;
+#ifdef CONFIG_USERSPACE
+	struct k_mem_domain *notify_fn_domain;
+	k_tid_t notify_fn_perms_src;
+#endif
+};
+
+/* notification state copied out under the pool lock, fired after it drops */
+struct sys_aio_notify_copy {
+	struct sys_aio_notify notify;
+#ifdef CONFIG_USERSPACE
+	struct k_mem_domain *domain;
+	k_tid_t perms_src;
+#endif
+};
+
+BUILD_ASSERT(SYS_AIO_MIN >= 0);
+BUILD_ASSERT(CONFIG_SYS_AIO_MAX >= SYS_AIO_MIN);
+BUILD_ASSERT(CONFIG_SYS_AIO_POLL_EVENTS >= 1);
+BUILD_ASSERT(CONFIG_SYS_AIO_WAIT_MAX >= 1);
+
+static void *aio_pool_heap_alloc(const void *ptr, size_t size, size_t align, uint32_t flags)
+{
+	ARG_UNUSED(align);
+	ARG_UNUSED(flags);
+
+#if defined(K_HEAP_MEM_POOL_SIZE) && (K_HEAP_MEM_POOL_SIZE > 0)
+	if (size == 0) {
+		k_free((void *)ptr);
+		return NULL;
+	}
+
+	return k_aligned_alloc(__alignof(struct sys_aio), size);
+#else
+	ARG_UNUSED(ptr);
+	ARG_UNUSED(size);
+	return NULL;
+#endif
+}
+
+static struct k_spinlock aio_lock;
+static struct sys_aio aio_pool_slots[MAX(SYS_AIO_MIN, 1)];
+SYS_ELASTIPOOL_DEFINE_ADVANCED(aio_pool, sizeof(struct sys_aio), __alignof(struct sys_aio),
+			       SYS_AIO_MIN, CONFIG_SYS_AIO_MAX, aio_pool_heap_alloc,
+			       aio_pool_slots, static);
+
+/* submitted, not-yet-complete requests, for cancellation by descriptor */
+static sys_slist_t aio_inflight = SYS_SLIST_STATIC_INIT(&aio_inflight);
+
+#ifdef CONFIG_SYS_AIO_PRIORITY
+static int aio_ready_cmp(const void *a, const void *b)
+{
+	const struct sys_aio *const *pa = a;
+	const struct sys_aio *const *pb = b;
+
+	if ((*pa)->prio != (*pb)->prio) {
+		return (*pa)->prio - (*pb)->prio;
+	}
+	/* wraparound-safe: FIFO among equal priorities */
+	return (int32_t)((*pa)->ready_seq - (*pb)->ready_seq);
+}
+
+static bool aio_ready_eq(const void *node, const void *other)
+{
+	return *(struct sys_aio *const *)node == other;
+}
+
+/* ready-to-execute requests, performed in (prio, ready_seq) order */
+static struct sys_aio *aio_ready_static[MAX(SYS_AIO_MIN, 1)];
+static struct min_heap aio_ready = {
+	.storage = aio_ready_static,
+	.capacity = ARRAY_SIZE(aio_ready_static),
+	.elem_size = sizeof(struct sys_aio *),
+	.size = 0,
+	.cmp = aio_ready_cmp,
+};
+static bool aio_ready_alloced; /* storage is heap-allocated (grown) */
+static uint32_t aio_ready_seq;
+static uint32_t aio_outstanding; /* submitted, not-yet-complete requests */
+
+static void aio_drain_work_handler(struct k_work *work);
+static K_WORK_DEFINE(aio_drain_work, aio_drain_work_handler);
+
+static void aio_ready_push_locked(struct sys_aio *aio)
+{
+	int err;
+
+	aio->state = SYS_AIO_STATE_READY;
+	aio->ready_seq = aio_ready_seq++;
+	/* cannot fail: capacity >= outstanding requests (aio_ready_reserve()) */
+	err = min_heap_push(&aio_ready, &aio);
+	__ASSERT_NO_MSG(err == 0);
+	ARG_UNUSED(err);
+}
+
+/*
+ * Count a new outstanding request, growing the ready-queue storage (by
+ * doubling, never shrinking) so that every outstanding request has a
+ * guaranteed slot and pushing at readiness time cannot fail.
+ */
+static int aio_ready_reserve(void)
+{
+	size_t need = 0;
+	size_t newcap;
+	struct sys_aio **buf;
+	void *old;
+
+	for (;;) {
+		bool reserved = false;
+
+		K_SPINLOCK(&aio_lock) {
+			if ((size_t)aio_outstanding < aio_ready.capacity) {
+				aio_outstanding++;
+				reserved = true;
+			} else {
+				need = (size_t)aio_outstanding + 1U;
+			}
+		}
+		if (reserved) {
+			return 0;
+		}
+
+		newcap = MAX(2U * need, ARRAY_SIZE(aio_ready_static));
+		buf = aio_pool_heap_alloc(NULL, newcap * sizeof(*buf), __alignof(*buf), 0);
+		if (buf == NULL) {
+			return -EAGAIN;
+		}
+
+		old = NULL;
+		K_SPINLOCK(&aio_lock) {
+			if (newcap > aio_ready.capacity) {
+				memcpy(buf, aio_ready.storage,
+				       aio_ready.size * sizeof(*buf));
+				old = aio_ready_alloced ? aio_ready.storage : NULL;
+				aio_ready.storage = buf;
+				aio_ready.capacity = newcap;
+				aio_ready_alloced = true;
+				buf = NULL;
+			}
+		}
+
+		/* freed outside the lock; buf non-NULL means we lost a growth race */
+		(void)aio_pool_heap_alloc(old, 0, 0, 0);
+		(void)aio_pool_heap_alloc(buf, 0, 0, 0);
+	}
+}
+#endif /* CONFIG_SYS_AIO_PRIORITY */
+
+/* dedicated service queue: readiness waits arm here, operations execute here */
+static struct k_work_q aio_queue;
+static K_KERNEL_STACK_DEFINE(aio_queue_stack, CONFIG_SYS_AIO_WORKQ_STACK_SIZE);
+static bool aio_queue_running;
+
+static void aio_queue_start(void)
+{
+	K_SPINLOCK(&aio_lock) {
+		if (!aio_queue_running) {
+			k_work_queue_init(&aio_queue);
+			k_work_queue_start(&aio_queue, aio_queue_stack,
+					   K_KERNEL_STACK_SIZEOF(aio_queue_stack),
+					   CONFIG_SYS_AIO_WORKQ_PRIO, NULL);
+			(void)k_thread_name_set(&aio_queue.thread, "sys_aio");
+			aio_queue_running = true;
+		}
+	}
+}
+
+/*
+ * Validate a request handle and take a busy reference that defers slot reuse
+ * until aio_unref(). Stale and foreign pointers fail pool membership; group
+ * handles are rejected here (and request handles in group calls).
+ */
+static struct sys_aio *aio_ref(struct sys_aio *aio)
+{
+	struct sys_aio *ret = NULL;
+
+	if (aio == NULL) {
+		return NULL;
+	}
+
+	K_SPINLOCK(&aio_lock) {
+		if (sys_elastipool_check(&aio_pool, aio) != 0) {
+			K_SPINLOCK_BREAK;
+		}
+		if ((aio->op == SYS_AIO_OP_GROUP) || (aio->state == SYS_AIO_STATE_REAPED)) {
+			K_SPINLOCK_BREAK;
+		}
+		aio->busy++;
+		ret = aio;
+	}
+
+	return ret;
+}
+
+static void aio_maybe_free_locked(struct sys_aio *aio)
+{
+	if ((aio->busy == 0U) && (aio->state == SYS_AIO_STATE_REAPED)) {
+		(void)sys_elastipool_free(&aio_pool, aio);
+	}
+}
+
+static void aio_unref(struct sys_aio *aio)
+{
+	K_SPINLOCK(&aio_lock) {
+		aio->busy--;
+		aio_maybe_free_locked(aio);
+	}
+}
+
+static int aio_notify_validate(const struct sys_aio_notify *notify)
+{
+	if (notify->fn != NULL) {
+#if SYS_AIO_FN_NOTIFY
+		if ((notify->fn_priority > K_LOWEST_APPLICATION_THREAD_PRIO) ||
+		    (notify->fn_priority < K_HIGHEST_APPLICATION_THREAD_PRIO)) {
+			return -EINVAL;
+		}
+		return 0;
+#else
+		/* notification threads are detached system pool threads */
+		return -ENOTSUP;
+#endif
+	}
+
+	if (notify->signo != 0) {
+		if (!IS_ENABLED(CONFIG_SIGNAL)) {
+			return -ENOTSUP;
+		}
+		if ((notify->signo < 0) || (notify->target == NULL)) {
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+#if SYS_AIO_FN_NOTIFY
+static void aio_notify_entry(void *p1, void *p2, void *p3)
+{
+	void (*const fn)(union k_sig_val) = p1;
+	const union k_sig_val value = {
+		.sival_ptr = p2,
+	};
+
+	ARG_UNUSED(p3);
+
+	fn(value);
+}
+#endif /* SYS_AIO_FN_NOTIFY */
+
+/*
+ * Fire a completion notification. Runs in the service queue thread (normal
+ * completion) or in the canceling thread's context, never under the pool
+ * lock. Function notifications spawn one detached system-pool thread, in
+ * user mode in the submitter's memory domain when submitted from user mode.
+ */
+static void aio_notify_fire(const struct sys_aio_notify_copy *nc)
+{
+	const struct sys_aio_notify *notify = &nc->notify;
+
+	if (notify->fn != NULL) {
+#if SYS_AIO_FN_NOTIFY
+		int ret;
+		struct k_thread *th = NULL;
+		uint32_t options = K_INHERIT_PERMS;
+
+#ifdef CONFIG_USERSPACE
+		if (nc->domain != NULL) {
+			options |= K_USER;
+			ret = sys_thread_create_paused(&th, NULL, notify->fn_stack_size, 0,
+						       aio_notify_entry, notify->fn,
+						       notify->value.sival_ptr, NULL,
+						       notify->fn_priority, options);
+			if (ret == 0) {
+				ret = k_mem_domain_add_thread(nc->domain, th);
+				if (ret == 0) {
+					k_thread_perms_inherit(nc->perms_src, th);
+					k_thread_start(th);
+				} else {
+					k_thread_abort(th);
+				}
+			}
+		} else
+#endif /* CONFIG_USERSPACE */
+		{
+			ret = sys_thread_create(&th, NULL, notify->fn_stack_size, 0,
+						aio_notify_entry, notify->fn,
+						notify->value.sival_ptr, NULL,
+						notify->fn_priority, options);
+		}
+
+		if (ret == 0) {
+			(void)k_thread_detach(th);
+		} else {
+			LOG_DBG("function notification dropped (%d)", ret);
+		}
+#endif /* SYS_AIO_FN_NOTIFY */
+	} else if (notify->signo > 0) {
+#ifdef CONFIG_SIGNAL
+		(void)z_sig_queue_aio(notify->target, notify->signo, notify->value);
+#endif /* CONFIG_SIGNAL */
+	}
+}
+
+static void aio_notify_save_locked(const struct sys_aio *aio, struct sys_aio_notify_copy *nc)
+{
+	nc->notify = aio->notify;
+#ifdef CONFIG_USERSPACE
+	nc->domain = aio->notify_fn_domain;
+	nc->perms_src = aio->notify_fn_perms_src;
+#endif
+}
+
+/*
+ * Record a request's completion, wake waiters, leave the completion group,
+ * and fire the request's (and possibly the group's) notification.
+ */
+static void aio_complete(struct sys_aio *aio, int error, ssize_t result)
+{
+	bool fire_req = false;
+	bool fire_grp = false;
+	struct sys_aio_notify_copy req_nc;
+	struct sys_aio_notify_copy grp_nc;
+
+	K_SPINLOCK(&aio_lock) {
+		struct sys_aio *grp = aio->grp;
+
+		aio->error = error;
+		aio->result = result;
+		aio->state = SYS_AIO_STATE_DONE;
+#ifdef CONFIG_SYS_AIO_PRIORITY
+		aio_outstanding--;
+#endif
+		aio->grp = NULL;
+		(void)sys_slist_find_and_remove(&aio_inflight, &aio->node);
+		k_poll_signal_raise(&aio->done, 1);
+
+		if (aio->has_notify) {
+			fire_req = true;
+			aio_notify_save_locked(aio, &req_nc);
+		}
+
+		if (grp != NULL) {
+			grp->grp_pending--;
+			if ((grp->grp_pending == 0U) && grp->grp_finalized) {
+				fire_grp = true;
+				aio_notify_save_locked(grp, &grp_nc);
+				(void)sys_elastipool_free(&aio_pool, grp);
+			}
+		}
+	}
+
+	if (fire_req) {
+		aio_notify_fire(&req_nc);
+	}
+	if (fire_grp) {
+		aio_notify_fire(&grp_nc);
+	}
+}
+
+/* Perform a claimed (RUNNING) request's operation on the service queue thread. */
+static void aio_execute(struct sys_aio *aio)
+{
+	int error;
+	ssize_t ret;
+	struct fd_entry *entry;
+
+	/* the descriptor may have been closed (and recycled) while in flight */
+	entry = zvfs_fd_entry_get(aio->fd);
+	if ((entry == NULL) || (entry->obj != aio->obj)) {
+		aio_complete(aio, EBADF, -1);
+		return;
+	}
+
+	switch (aio->op) {
+	case SYS_AIO_OP_READ:
+		ret = zvfs_read_offset(aio->fd, aio->buf, aio->len,
+				       aio->use_offset ? &aio->offset : NULL);
+		break;
+	case SYS_AIO_OP_WRITE:
+		ret = zvfs_write_offset(aio->fd, aio->buf, aio->len,
+					aio->use_offset ? &aio->offset : NULL);
+		break;
+	case SYS_AIO_OP_FSYNC:
+		ret = zvfs_fsync(aio->fd);
+		break;
+	default:
+		errno = EINVAL;
+		ret = -1;
+		break;
+	}
+
+	/* capture errno before anything else runs on this thread */
+	error = (ret < 0) ? errno : 0;
+
+	aio_complete(aio, error, (ret < 0) ? -1 : ret);
+}
+
+#ifdef CONFIG_SYS_AIO_PRIORITY
+/* Pop and perform ready requests, highest priority first. */
+static void aio_drain(void)
+{
+	for (;;) {
+		struct sys_aio *aio = NULL;
+
+		K_SPINLOCK(&aio_lock) {
+			if (min_heap_pop(&aio_ready, &aio)) {
+				aio->state = SYS_AIO_STATE_RUNNING;
+			}
+		}
+
+		if (aio == NULL) {
+			break;
+		}
+
+		aio_execute(aio);
+	}
+}
+
+static void aio_drain_work_handler(struct k_work *work)
+{
+	ARG_UNUSED(work);
+
+	aio_drain();
+}
+#else
+static void aio_perform(struct sys_aio *aio)
+{
+	bool claimed = false;
+
+	K_SPINLOCK(&aio_lock) {
+		if ((aio->state != SYS_AIO_STATE_QUEUED) && (aio->state != SYS_AIO_STATE_ARMED)) {
+			/* completed by a concurrent cancellation */
+			claimed = true;
+			K_SPINLOCK_BREAK;
+		}
+		aio->state = SYS_AIO_STATE_RUNNING;
+	}
+
+	if (claimed) {
+		return;
+	}
+
+	aio_execute(aio);
+}
+
+static void aio_work_handler(struct k_work *work)
+{
+	aio_perform(CONTAINER_OF(work, struct sys_aio, work));
+}
+#endif /* CONFIG_SYS_AIO_PRIORITY */
+
+static void aio_poll_work_handler(struct k_work *work)
+{
+	struct k_work_poll *pwork = CONTAINER_OF(work, struct k_work_poll, work);
+	struct sys_aio *aio = CONTAINER_OF(pwork, struct sys_aio, pwork);
+
+#ifdef CONFIG_SYS_AIO_PRIORITY
+	bool claimed = false;
+
+	K_SPINLOCK(&aio_lock) {
+		if (aio->state != SYS_AIO_STATE_ARMED) {
+			/* completed by a concurrent cancellation */
+			claimed = true;
+			K_SPINLOCK_BREAK;
+		}
+		aio_ready_push_locked(aio);
+	}
+
+	if (!claimed) {
+		aio_drain();
+	}
+#else
+	aio_perform(aio);
+#endif
+}
+
+int z_impl_sys_aio_submit(const struct sys_aio_req *req, const struct sys_aio_notify *notify,
+			  struct sys_aio_group *grp_handle, struct sys_aio **aio)
+{
+	struct sys_aio *a = NULL;
+	struct sys_aio *grp = (struct sys_aio *)grp_handle;
+	struct fd_entry *entry;
+	int nevents = 0;
+	int prep;
+	int ret = 0;
+
+	if ((req == NULL) || (aio == NULL)) {
+		return -EINVAL;
+	}
+	if ((req->op != SYS_AIO_OP_READ) && (req->op != SYS_AIO_OP_WRITE) &&
+	    (req->op != SYS_AIO_OP_FSYNC)) {
+		return -EINVAL;
+	}
+	if ((req->flags & ~(uint32_t)SYS_AIO_REQ_OFFSET) != 0) {
+		return -EINVAL;
+	}
+	if (notify != NULL) {
+		ret = aio_notify_validate(notify);
+		if (ret < 0) {
+			return ret;
+		}
+	}
+
+	entry = zvfs_fd_entry_get(req->fd);
+	if (entry == NULL) {
+		return -EBADF;
+	}
+
+	aio_queue_start();
+
+	if (sys_elastipool_alloc(&aio_pool, (void **)&a) < 0) {
+		return -EAGAIN;
+	}
+
+#ifdef CONFIG_SYS_AIO_PRIORITY
+	ret = aio_ready_reserve();
+	if (ret < 0) {
+		(void)sys_elastipool_free(&aio_pool, a);
+		return ret;
+	}
+#endif
+
+	memset(a, 0, sizeof(*a));
+	a->op = (uint8_t)req->op;
+	a->fd = req->fd;
+	a->obj = entry->obj;
+	a->buf = req->buf;
+	a->len = req->len;
+	a->offset = req->offset;
+#ifdef CONFIG_SYS_AIO_PRIORITY
+	a->prio = req->prio;
+#endif
+	a->use_offset =
+		((req->flags & SYS_AIO_REQ_OFFSET) != 0) && supports_pread_pwrite(entry->mode);
+	a->error = EINPROGRESS;
+	a->result = -1;
+	if (notify != NULL) {
+		a->has_notify = true;
+		a->notify = *notify;
+#ifdef CONFIG_USERSPACE
+		if ((notify->fn != NULL) && k_is_in_user_syscall()) {
+			a->notify_fn_domain = _current->mem_domain_info.mem_domain;
+			a->notify_fn_perms_src = _current;
+		}
+#endif /* CONFIG_USERSPACE */
+	}
+#ifndef CONFIG_SYS_AIO_PRIORITY
+	k_work_init(&a->work, aio_work_handler);
+#endif
+	k_work_poll_init(&a->pwork, aio_poll_work_handler);
+	k_poll_signal_init(&a->done);
+
+	/*
+	 * Classify: descriptors with a waitable readiness condition are armed
+	 * on it; always-ready descriptors (regular files), already-ready ones,
+	 * and those whose readiness cannot be waited on from here (offloaded
+	 * sockets) are executed directly on the service queue.
+	 */
+	prep = ZVFS_POLL_READY;
+	if (a->op != SYS_AIO_OP_FSYNC) {
+		struct k_poll_event *pev = a->events;
+
+		a->pfd.fd = req->fd;
+		a->pfd.events = (a->op == SYS_AIO_OP_READ) ? ZVFS_POLLIN : ZVFS_POLLOUT;
+		prep = zvfs_poll_prepare_fd(&a->pfd, &pev, a->events + ARRAY_SIZE(a->events));
+		nevents = pev - a->events;
+	}
+
+	/*
+	 * Publish and dispatch in one critical section: cancellation can only
+	 * observe the request with its work item really submitted, so a
+	 * successful k_work(_poll)_cancel() always means the handler will not
+	 * run.
+	 */
+	K_SPINLOCK(&aio_lock) {
+		if (grp != NULL) {
+			if ((sys_elastipool_check(&aio_pool, grp) != 0) ||
+			    (grp->op != SYS_AIO_OP_GROUP) || grp->grp_finalized) {
+				ret = -EINVAL;
+				K_SPINLOCK_BREAK;
+			}
+			grp->grp_pending++;
+			a->grp = grp;
+		}
+
+		sys_slist_append(&aio_inflight, &a->node);
+
+		if ((prep == ZVFS_POLL_PREPARED) && (nevents > 0)) {
+			a->state = SYS_AIO_STATE_ARMED;
+			ret = k_work_poll_submit_to_queue(&aio_queue, &a->pwork, a->events,
+							  nevents, K_FOREVER);
+			if (ret == 0) {
+				K_SPINLOCK_BREAK;
+			}
+			/* fall back to direct execution */
+			ret = 0;
+		}
+
+#ifdef CONFIG_SYS_AIO_PRIORITY
+		aio_ready_push_locked(a);
+		(void)k_work_submit_to_queue(&aio_queue, &aio_drain_work);
+#else
+		a->state = SYS_AIO_STATE_QUEUED;
+		(void)k_work_submit_to_queue(&aio_queue, &a->work);
+#endif
+	}
+
+	if (ret < 0) {
+#ifdef CONFIG_SYS_AIO_PRIORITY
+		K_SPINLOCK(&aio_lock) {
+			aio_outstanding--;
+		}
+#endif
+		(void)sys_elastipool_free(&aio_pool, a);
+		return ret;
+	}
+
+	*aio = a;
+	return 0;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_sys_aio_submit(const struct sys_aio_req *req,
+					const struct sys_aio_notify *notify,
+					struct sys_aio_group *grp, struct sys_aio **aio)
+{
+	struct sys_aio_req kreq;
+	struct sys_aio_notify knotify;
+	const struct sys_aio_notify *np = NULL;
+	struct sys_aio *ka = NULL;
+	int ret;
+
+	if ((req == NULL) || (aio == NULL)) {
+		return -EINVAL;
+	}
+	K_OOPS(k_usermode_from_copy(&kreq, req, sizeof(kreq)));
+
+	if (zvfs_fd_syscall_verify(kreq.fd) == NULL) {
+		return -EBADF;
+	}
+
+	/* the caller must have the rights it is asking the service to exercise */
+	if (kreq.op == SYS_AIO_OP_READ) {
+		K_OOPS(K_SYSCALL_MEMORY_WRITE(kreq.buf, kreq.len));
+	} else if (kreq.op == SYS_AIO_OP_WRITE) {
+		K_OOPS(K_SYSCALL_MEMORY_READ(kreq.buf, kreq.len));
+	}
+
+	if (notify != NULL) {
+		K_OOPS(k_usermode_from_copy(&knotify, notify, sizeof(knotify)));
+		if ((knotify.fn == NULL) && (knotify.signo > 0) && (knotify.target != NULL)) {
+			/* the caller must have been granted access to the target thread */
+			K_OOPS(K_SYSCALL_OBJ(knotify.target, K_OBJ_THREAD));
+		}
+		np = &knotify;
+	}
+
+	ret = z_impl_sys_aio_submit(&kreq, np, grp, &ka);
+	if (ret == 0) {
+		K_OOPS(k_usermode_to_copy(aio, &ka, sizeof(ka)));
+	}
+
+	return ret;
+}
+#include <zephyr/syscalls/sys_aio_submit_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+int z_impl_sys_aio_error(const struct sys_aio *aio)
+{
+	struct sys_aio *a = aio_ref((struct sys_aio *)aio);
+	int ret;
+
+	if (a == NULL) {
+		return -EINVAL;
+	}
+
+	ret = a->error;
+	aio_unref(a);
+
+	return ret;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_sys_aio_error(const struct sys_aio *aio)
+{
+	return z_impl_sys_aio_error(aio);
+}
+#include <zephyr/syscalls/sys_aio_error_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+int z_impl_sys_aio_release(struct sys_aio *aio, int *error, ssize_t *result)
+{
+	int kerr = 0;
+	ssize_t kres = -1;
+	int ret = -EINVAL;
+
+	if (aio == NULL) {
+		return -EINVAL;
+	}
+
+	K_SPINLOCK(&aio_lock) {
+		if ((sys_elastipool_check(&aio_pool, aio) != 0) ||
+		    (aio->op == SYS_AIO_OP_GROUP) || (aio->state == SYS_AIO_STATE_REAPED)) {
+			K_SPINLOCK_BREAK;
+		}
+		if (aio->state != SYS_AIO_STATE_DONE) {
+			ret = -EBUSY;
+			K_SPINLOCK_BREAK;
+		}
+		kerr = aio->error;
+		kres = aio->result;
+		aio->state = SYS_AIO_STATE_REAPED;
+		aio_maybe_free_locked(aio);
+		ret = 0;
+	}
+
+	if (ret == 0) {
+		if (error != NULL) {
+			*error = kerr;
+		}
+		if (result != NULL) {
+			*result = kres;
+		}
+	}
+
+	return ret;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_sys_aio_release(struct sys_aio *aio, int *error, ssize_t *result)
+{
+	int kerr;
+	ssize_t kres;
+	int ret;
+
+	ret = z_impl_sys_aio_release(aio, &kerr, &kres);
+	if (ret == 0) {
+		if (error != NULL) {
+			K_OOPS(k_usermode_to_copy(error, &kerr, sizeof(kerr)));
+		}
+		if (result != NULL) {
+			K_OOPS(k_usermode_to_copy(result, &kres, sizeof(kres)));
+		}
+	}
+
+	return ret;
+}
+#include <zephyr/syscalls/sys_aio_release_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+/*
+ * Try to cancel one request: claim it under the lock when its work item was
+ * removed before execution, then complete it as canceled.
+ */
+static int aio_try_cancel(struct sys_aio *aio)
+{
+	bool cancel = false;
+	int ret = SYS_AIO_NOTCANCELED;
+
+	K_SPINLOCK(&aio_lock) {
+		switch (aio->state) {
+		case SYS_AIO_STATE_ARMED:
+			cancel = (k_work_poll_cancel(&aio->pwork) == 0);
+			break;
+#ifdef CONFIG_SYS_AIO_PRIORITY
+		case SYS_AIO_STATE_READY: {
+			size_t id;
+			struct sys_aio *popped;
+
+			if (min_heap_find(&aio_ready, aio_ready_eq, aio, &id) != NULL) {
+				cancel = min_heap_remove(&aio_ready, id, &popped);
+			}
+			break;
+		}
+#else
+		case SYS_AIO_STATE_QUEUED:
+			cancel = (k_work_cancel(&aio->work) == 0);
+			break;
+#endif
+		case SYS_AIO_STATE_RUNNING:
+			break;
+		default:
+			ret = SYS_AIO_ALLDONE;
+			break;
+		}
+		if (cancel) {
+			/* claimed: the handler will not run for this request */
+			aio->state = SYS_AIO_STATE_RUNNING;
+		}
+	}
+
+	if (cancel) {
+		aio_complete(aio, ECANCELED, -1);
+		ret = SYS_AIO_CANCELED;
+	}
+
+	return ret;
+}
+
+int z_impl_sys_aio_cancel(int fd, struct sys_aio *aio)
+{
+	bool canceled = false;
+	bool notcanceled = false;
+	int ret;
+
+	if (zvfs_fd_entry_get(fd) == NULL) {
+		return -EBADF;
+	}
+
+	if (aio != NULL) {
+		struct sys_aio *a = aio_ref(aio);
+
+		if (a == NULL) {
+			return -EINVAL;
+		}
+		if (a->fd != fd) {
+			aio_unref(a);
+			return -EINVAL;
+		}
+
+		ret = aio_try_cancel(a);
+		aio_unref(a);
+		return ret;
+	}
+
+	/*
+	 * Cancel everything in flight on the descriptor. Requests claimed in
+	 * one pass complete as canceled; requests already executing cannot be
+	 * canceled; completed requests are no longer on the in-flight list.
+	 */
+	for (;;) {
+		struct sys_aio *victim = NULL;
+		struct sys_aio *a;
+
+		K_SPINLOCK(&aio_lock) {
+			SYS_SLIST_FOR_EACH_CONTAINER(&aio_inflight, a, node) {
+				if ((a->fd != fd) || (a->state == SYS_AIO_STATE_RUNNING)) {
+					continue;
+				}
+				a->busy++;
+				victim = a;
+				break;
+			}
+		}
+
+		if (victim == NULL) {
+			break;
+		}
+
+		ret = aio_try_cancel(victim);
+		aio_unref(victim);
+
+		if (ret == SYS_AIO_CANCELED) {
+			canceled = true;
+		} else {
+			notcanceled = true;
+		}
+	}
+
+	/* anything still on the list for this fd is executing */
+	K_SPINLOCK(&aio_lock) {
+		struct sys_aio *a;
+
+		SYS_SLIST_FOR_EACH_CONTAINER(&aio_inflight, a, node) {
+			if (a->fd == fd) {
+				notcanceled = true;
+				break;
+			}
+		}
+	}
+
+	if (notcanceled) {
+		return SYS_AIO_NOTCANCELED;
+	}
+	if (canceled) {
+		return SYS_AIO_CANCELED;
+	}
+	return SYS_AIO_ALLDONE;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_sys_aio_cancel(int fd, struct sys_aio *aio)
+{
+	if (zvfs_fd_syscall_verify(fd) == NULL) {
+		return -EBADF;
+	}
+
+	return z_impl_sys_aio_cancel(fd, aio);
+}
+#include <zephyr/syscalls/sys_aio_cancel_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+int z_impl_sys_aio_wait(struct sys_aio *const *list, size_t nents, k_timeout_t timeout)
+{
+	struct k_poll_event events[CONFIG_SYS_AIO_WAIT_MAX];
+	struct sys_aio *refs[CONFIG_SYS_AIO_WAIT_MAX];
+	size_t n = 0;
+	int ret = 0;
+
+	if ((list == NULL) || (nents == 0U) || (nents > CONFIG_SYS_AIO_WAIT_MAX)) {
+		return -EINVAL;
+	}
+
+	for (size_t i = 0; i < nents; i++) {
+		struct sys_aio *a = list[i];
+
+		if (a == NULL) {
+			continue;
+		}
+
+		a = aio_ref(a);
+		if (a == NULL) {
+			ret = -EINVAL;
+			goto out;
+		}
+		refs[n] = a;
+		k_poll_event_init(&events[n], K_POLL_TYPE_SIGNAL, K_POLL_MODE_NOTIFY_ONLY,
+				  &a->done);
+		n++;
+	}
+
+	if (n == 0U) {
+		return -EINVAL;
+	}
+
+	/* a completed request's signal stays raised: k_poll returns immediately */
+	ret = k_poll(events, n, timeout);
+
+out:
+	for (size_t i = 0; i < n; i++) {
+		aio_unref(refs[i]);
+	}
+
+	return ret;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_sys_aio_wait(struct sys_aio *const *list, size_t nents,
+				      k_timeout_t timeout)
+{
+	struct sys_aio *klist[CONFIG_SYS_AIO_WAIT_MAX];
+
+	if ((list == NULL) || (nents == 0U) || (nents > CONFIG_SYS_AIO_WAIT_MAX)) {
+		return -EINVAL;
+	}
+	K_OOPS(k_usermode_from_copy(klist, list, nents * sizeof(klist[0])));
+
+	return z_impl_sys_aio_wait(klist, nents, timeout);
+}
+#include <zephyr/syscalls/sys_aio_wait_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+int z_impl_sys_aio_group_create(const struct sys_aio_notify *notify, struct sys_aio_group **grp)
+{
+	struct sys_aio *g = NULL;
+	int ret;
+
+	if ((notify == NULL) || (grp == NULL)) {
+		return -EINVAL;
+	}
+	ret = aio_notify_validate(notify);
+	if (ret < 0) {
+		return ret;
+	}
+
+	if (sys_elastipool_alloc(&aio_pool, (void **)&g) < 0) {
+		return -EAGAIN;
+	}
+
+	memset(g, 0, sizeof(*g));
+	g->op = SYS_AIO_OP_GROUP;
+	g->grp_pending = 1U; /* submission hold, dropped by finalize */
+	g->has_notify = true;
+	g->notify = *notify;
+#ifdef CONFIG_USERSPACE
+	if ((notify->fn != NULL) && k_is_in_user_syscall()) {
+		g->notify_fn_domain = _current->mem_domain_info.mem_domain;
+		g->notify_fn_perms_src = _current;
+	}
+#endif /* CONFIG_USERSPACE */
+
+	*grp = (struct sys_aio_group *)g;
+	return 0;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_sys_aio_group_create(const struct sys_aio_notify *notify,
+					      struct sys_aio_group **grp)
+{
+	struct sys_aio_notify knotify;
+	struct sys_aio_group *kg = NULL;
+	int ret;
+
+	if ((notify == NULL) || (grp == NULL)) {
+		return -EINVAL;
+	}
+	K_OOPS(k_usermode_from_copy(&knotify, notify, sizeof(knotify)));
+	if ((knotify.fn == NULL) && (knotify.signo > 0) && (knotify.target != NULL)) {
+		K_OOPS(K_SYSCALL_OBJ(knotify.target, K_OBJ_THREAD));
+	}
+
+	ret = z_impl_sys_aio_group_create(&knotify, &kg);
+	if (ret == 0) {
+		K_OOPS(k_usermode_to_copy(grp, &kg, sizeof(kg)));
+	}
+
+	return ret;
+}
+#include <zephyr/syscalls/sys_aio_group_create_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+int z_impl_sys_aio_group_finalize(struct sys_aio_group *grp)
+{
+	struct sys_aio *g = (struct sys_aio *)grp;
+	bool fire = false;
+	struct sys_aio_notify_copy nc;
+	int ret = 0;
+
+	if (g == NULL) {
+		return -EINVAL;
+	}
+
+	K_SPINLOCK(&aio_lock) {
+		if ((sys_elastipool_check(&aio_pool, g) != 0) || (g->op != SYS_AIO_OP_GROUP) ||
+		    g->grp_finalized) {
+			ret = -EINVAL;
+			K_SPINLOCK_BREAK;
+		}
+		g->grp_finalized = true;
+		g->grp_pending--;
+		if (g->grp_pending == 0U) {
+			fire = true;
+			aio_notify_save_locked(g, &nc);
+			(void)sys_elastipool_free(&aio_pool, g);
+		}
+	}
+
+	if (fire) {
+		aio_notify_fire(&nc);
+	}
+
+	return ret;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_sys_aio_group_finalize(struct sys_aio_group *grp)
+{
+	return z_impl_sys_aio_group_finalize(grp);
+}
+#include <zephyr/syscalls/sys_aio_group_finalize_mrsh.c>
+#endif /* CONFIG_USERSPACE */
