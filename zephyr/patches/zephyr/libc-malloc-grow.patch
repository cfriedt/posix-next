diff --git a/lib/libc/common/source/stdlib/malloc.c b/lib/libc/common/source/stdlib/malloc.c
index 1ce98812fb9..f764065c9ab 100644
--- a/lib/libc/common/source/stdlib/malloc.c
+++ b/lib/libc/common/source/stdlib/malloc.c
@@ -120,6 +120,123 @@ extern char _heap_sentry[];
 
 Z_LIBC_DATA static struct sys_heap z_malloc_heap;
 
+#ifdef CONFIG_COMMON_LIBC_MALLOC_GROW
+#include <zephyr/sys/multi_heap.h>
+#include <zephyr/sys/zvfs.h>
+#include <sys_malloc.h>
+
+Z_LIBC_DATA static struct sys_multi_heap z_malloc_mheap;
+
+/* the first heap with room: the arena, then the regions grown onto it in turn */
+static void *malloc_heap_choice(struct sys_multi_heap *mheap, void *cfg, size_t align,
+				size_t size)
+{
+	ARG_UNUSED(cfg);
+
+	for (unsigned int i = 0; i < mheap->nheaps; i++) {
+		void *ret = sys_heap_aligned_alloc(mheap->heaps[i].heap, align, size);
+
+		if (ret != NULL) {
+			return ret;
+		}
+	}
+
+	return NULL;
+}
+
+/* each heap's record carries its size, so the total is at hand */
+void z_malloc_multi_heap_init(struct sys_multi_heap *mheap, struct sys_heap *first, size_t size)
+{
+	sys_multi_heap_init(mheap, malloc_heap_choice);
+	sys_multi_heap_add_heap(mheap, first, (void *)size);
+}
+
+/* a new anonymous private region of the process, its heap header at its start */
+static bool heap_grow(struct sys_multi_heap *mheap, size_t size)
+{
+	const size_t header = ROUND_UP(sizeof(struct sys_heap), __alignof__(z_max_align_t));
+	struct sys_heap *heap;
+	void *mem;
+	size_t len;
+
+	if ((mheap->nheaps >= MAX_MULTI_HEAPS) ||
+	    size_add_overflow(size, header + CONFIG_MMU_PAGE_SIZE, &len)) {
+		return false;
+	}
+	len = ROUND_UP(MAX(len, (size_t)CONFIG_COMMON_LIBC_MALLOC_GROW_STEP), CONFIG_MMU_PAGE_SIZE);
+	if (CONFIG_COMMON_LIBC_MALLOC_GROW_MAX > 0) {
+		size_t total = len;
+
+		for (unsigned int i = 0; i < mheap->nheaps; i++) {
+			total += (size_t)mheap->heaps[i].user_data;
+		}
+		if (total > (size_t)CONFIG_COMMON_LIBC_MALLOC_GROW_MAX) {
+			return false;
+		}
+	}
+	if (zvfs_mmap(len, ZVFS_PROT_READ | ZVFS_PROT_WRITE, ZVFS_MAP_PRIVATE | ZVFS_MAP_ANONYMOUS,
+		      -1, 0, &mem) != 0) {
+		return false;
+	}
+	heap = mem;
+	sys_heap_init(heap, (uint8_t *)mem + header, len - header);
+	sys_multi_heap_add_heap(mheap, heap, (void *)len);
+
+	return true;
+}
+
+typedef struct sys_multi_heap malloc_heap_t;
+
+static inline bool heap_ready(malloc_heap_t *heap)
+{
+	return heap->nheaps > 0;
+}
+
+static inline void *heap_alloc(malloc_heap_t *heap, size_t align, size_t size)
+{
+	return sys_multi_heap_aligned_alloc(heap, NULL, align, size);
+}
+
+static inline void *heap_realloc(malloc_heap_t *heap, void *ptr, size_t align, size_t size)
+{
+	return sys_multi_heap_aligned_realloc(heap, NULL, ptr, align, size);
+}
+
+static inline void heap_free(malloc_heap_t *heap, void *ptr)
+{
+	sys_multi_heap_free(heap, ptr);
+}
+#else
+typedef struct sys_heap malloc_heap_t;
+
+static inline bool heap_grow(malloc_heap_t *heap, size_t size)
+{
+	ARG_UNUSED(heap);
+	ARG_UNUSED(size);
+	return false;
+}
+
+static inline bool heap_ready(malloc_heap_t *heap)
+{
+	return heap->heap != NULL;
+}
+
+static inline void *heap_alloc(malloc_heap_t *heap, size_t align, size_t size)
+{
+	return sys_heap_aligned_alloc(heap, align, size);
+}
+
+static inline void *heap_realloc(malloc_heap_t *heap, void *ptr, size_t align, size_t size)
+{
+	return sys_heap_aligned_realloc(heap, ptr, align, size);
+}
+
+static inline void heap_free(malloc_heap_t *heap, void *ptr)
+{
+	sys_heap_free(heap, ptr);
+}
+#endif /* CONFIG_COMMON_LIBC_MALLOC_GROW */
+
 #if defined(CONFIG_SYS_HEAP_KASAN_MALLOC) && defined(HEAP_STATIC)
 #include <zephyr/sys/heap_kasan.h>
 SYS_HEAP_KASAN_ENABLE(z_malloc_heap, HEAP_SIZE);
