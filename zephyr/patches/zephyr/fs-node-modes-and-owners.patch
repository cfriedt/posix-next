+static int tmpfs_chmod(struct fs_mount_t *mountp, const char *name, uint32_t mode)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	struct tmpfs_node *node;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = attr_lookup(fs, mountp, name, false, &node);
+	if (rc == 0) {
+		node->mode = mode & FS_MODE_PERM;
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
