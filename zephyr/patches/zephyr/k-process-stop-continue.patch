+/* resume @a thread, suspended by process_member_suspend(), while it is a member of @a proc */
+static void process_member_resume(struct k_process *proc, struct k_thread *thread)
+{
+	bool member = false;
+	k_spinlock_key_t key = z_sched_spinlock_lock();
+
+	K_SPINLOCK(&process_lock) {
+		member = (thread->process == proc);
+	}
+	if (!member || !z_is_thread_suspended(thread)) {
+		z_sched_spinlock_unlock(key);
+		return;
+	}
+	z_mark_thread_as_not_suspended(thread);
+	z_sched_ready_locked(thread);
+	z_reschedule_locked(key);
