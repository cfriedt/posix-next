+static void submit_errors(void)
+{
+	char buf[4];
+	struct sys_aio *aio = NULL;
+	struct sys_aio_req req = {
+		.op = SYS_AIO_OP_READ,
+		.fd = file_fd,
+		.buf = buf,
+		.len = sizeof(buf),
