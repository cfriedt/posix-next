diff --git a/include/zephyr/kernel/signal.h b/include/zephyr/kernel/signal.h
index fb39292e31e..338c6a6c777 100644
--- a/include/zephyr/kernel/signal.h
+++ b/include/zephyr/kernel/signal.h
@@ -129,6 +129,18 @@ struct k_sig_action {
 	void *user_data;
 };
 
+/**
+ * @brief The context a signal handler is entered with
+ *
+ * The signal trampoline builds one on the handler's stack and passes its address as the
+ * handler's third argument. @ref k_sig_return installs @a mask as the thread's signal mask, so a
+ * handler that changes it chooses the mask the interrupted context resumes with; the signals that
+ * cannot be blocked stay unblocked.
+ */
+struct k_sig_ucontext {
+	struct k_sig_set mask; /**< The signal mask in force before delivery */
+};
+
 /** @brief Per-thread signal context */
 struct k_sig_ctx {
 #ifdef CONFIG_SIGNAL
