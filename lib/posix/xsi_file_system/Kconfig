config XSI_FILE_SYSTEM
	bool "X/Open file system"
	depends on XSI
	select FILE_SYSTEM
	select FS_DIRENT_EXT
	select ZVFS
	select ZVFS_FDTABLE
	select ZVFS_FS
	help
	  Select 'y' here to enable the XSI File System option group:
	  basename(), dirname(), ftw(), lockf(), mknod(), nftw(), realpath(),
	  seekdir(), sync(), telldir() and tempnam().

	  mknod() makes FIFOs and regular files; no device special file exists
	  to create, so any other type is refused with EINVAL.

	  For more information, please see
	  https://pubs.opengroup.org/onlinepubs/9699919799/xrat/V4_subprofiles.html
