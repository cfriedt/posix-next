menu "POSIX scheduler options"

config POSIX_PRIORITY_SCHEDULING
	bool "POSIX priority-based process scheduling"
	help
	  This enables POSIX scheduling APIs (_POSIX_PRIORITY_SCHEDULING).

	  Since Zephyr does not yet support processes, the process-scoped functions operate on the
	  calling thread: a pid of 0 and the value returned by getpid() both designate the current
	  thread (as on Linux); any other pid fails with ESRCH.

endmenu
