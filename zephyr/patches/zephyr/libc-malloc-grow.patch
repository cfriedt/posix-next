diff --git a/lib/libc/common/Kconfig b/lib/libc/common/Kconfig
index 25a4d34049a..c0fba25a320 100644
--- a/lib/libc/common/Kconfig
+++ b/lib/libc/common/Kconfig
@@ -89,6 +89,36 @@ config COMMON_LIBC_MALLOC_ARENA_SIZE
 	  16kB and all other systems will default to using all remaining
 	  ram for the malloc heap.
 
+config COMMON_LIBC_MALLOC_GROW
+	bool "Grow the malloc heap with anonymous mappings"
+	depends on COMMON_LIBC_MALLOC && COMMON_LIBC_MALLOC_ARENA_SIZE > 0
+	depends on ZVFS_MMAP && MMU
+	select MULTI_HEAP
+	help
+	  When no heap has room for an allocation, malloc() maps a new anonymous
+	  private region of at least COMMON_LIBC_MALLOC_GROW_STEP bytes and adds
+	  it to the heap, up to seven regions. The arena is then the first heap
+	  rather than the whole of it: a process pays for the memory it uses,
+	  and a fork copies only the regions that exist.
+
+config COMMON_LIBC_MALLOC_GROW_STEP
+	int "Smallest heap growth, in bytes"
+	depends on COMMON_LIBC_MALLOC_GROW
+	default 65536
+	help
+	  A region the heap grows by is at least this large, rounded up to a
+	  page; an allocation larger than that gets a region of its own size
+	  plus a page.
+
+config COMMON_LIBC_MALLOC_GROW_MAX
+	int "Largest heap, arena and grown regions together, in bytes"
+	depends on COMMON_LIBC_MALLOC_GROW
+	default 0
+	help
+	  The heap does not grow past this total; 0 does not bound it. A bound
+	  keeps a program that allocates whatever it is given within the memory
+	  a fixed arena of that size would have offered.
+
 config COMMON_LIBC_CALLOC
 	bool "Common C library calloc"
 	depends on COMMON_LIBC_MALLOC
