diff --git a/lib/libc/newlib/include/utime.h b/lib/libc/newlib/include/utime.h
new file mode 100644
index 00000000000..2f562dd1091
--- /dev/null
+++ b/lib/libc/newlib/include/utime.h
@@ -0,0 +1,25 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_UTIME_H_
+#define ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_UTIME_H_
+
+/* the toolchain <sys/utime.h> uses time_t without including <time.h> */
+#include <time.h>
+
+/* struct utimbuf comes from the toolchain <sys/utime.h>, which omits utime() */
+#include_next <utime.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int utime(const char *path, const struct utimbuf *times);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_UTIME_H_ */
