+config COMMON_LIBC_UNDERSCORE_EXIT
+	bool "Common C library _exit()"
+	default y if PROCESS
+	help
+	  Common implementation of _exit(). With CONFIG_PROCESS it terminates
+	  the calling thread's process via k_exit(); otherwise it reports and
+	  halts, as the per-C-library stubs do. Overrides the weak picolibc and
+	  newlib stubs and replaces the minimal libc stub.
+
 config COMMON_LIBC_EXIT
 	bool "Common C library exit() and atexit()"
 	depends on MINIMAL_LIBC || PICOLIBC
diff --git a/lib/libc/common/source/stdlib/_exit.c b/lib/libc/common/source/stdlib/_exit.c
new file mode 100644
index 00000000000..d3ff8515c64
--- /dev/null
+++ b/lib/libc/common/source/stdlib/_exit.c
@@ -0,0 +1,31 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <stdlib.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/sys/printk.h>
+#include <zephyr/toolchain.h>
+
+/*
+ * Common _exit(): with process support, terminate the calling thread's
+ * process; otherwise there is no process to end, so report and spin as the
+ * per-libc stubs did. This strong definition overrides the weak picolibc and
+ * newlib stubs; the minimal libc's non-weak stub is gated out at build time.
+ */
+FUNC_NORETURN void _exit(int status)
+{
+#ifdef CONFIG_PROCESS
+	k_exit(status);
+#else
+	ARG_UNUSED(status);
+
+	printk("exit\n");
+#endif
+
+	while (1) {
+		Z_SPIN_DELAY(100);
+	}
+}
