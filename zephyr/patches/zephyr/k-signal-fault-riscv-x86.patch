+
+/* a fault taken in ring 3 generates the signal Linux generates for it */
+static bool user_fault_signal(struct arch_esf *esf, uintptr_t vector)
+{
+#ifdef CONFIG_X86_64
+	uintptr_t *ip = (uintptr_t *)&esf->rip;
+#else
+	uintptr_t *ip = (uintptr_t *)&esf->eip;
+#endif
+	void *addr = (void *)*ip;
+	int signo;
+	int code;
