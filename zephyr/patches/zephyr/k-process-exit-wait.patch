+	K_SPINLOCK(&process_lock) {
+		sys_dlist_remove(&tid->process_node);
+		tid->process = NULL;
+	}
+	thread_join_group(&z_proc_init, tid);
+
+	k_thread_start(tid);
+
+	return 0;
