+ZTEST_USER(zvfs_fs, test_zvfs_readmount)
+{
+	struct zvfs_mntent ent;
+	bool saw_fat = false;
+	bool saw_tmp = false;
+	int index = 0;
+	int n = 0;
+
+	errno = 0;
+	while (zvfs_readmount(&index, &ent) == 0) {
+		zassert_equal(index, ++n, "the index moves past the entry read");
+		if (strcmp(ent.mnt_dir, MNT) == 0) {
+			saw_fat = true;
+			zassert_str_equal(ent.mnt_type, "vfat");
+			zassert_equal(ent.mnt_flags & ZVFS_MNT_RDONLY, 0);
+		} else if (strcmp(ent.mnt_dir, AMNT) == 0) {
+			saw_tmp = true;
+			zassert_str_equal(ent.mnt_type, "tmpfs");
+		}
+	}
+	/* the end of the table */
+	zassert_equal(errno, ENOENT);
+	zassert_true(saw_fat, "the FAT mount is not listed");
+	zassert_true(saw_tmp, "the tmpfs mount is not listed");
+
+	errno = 0;
+	index = -1;
+	zassert_equal(zvfs_readmount(&index, &ent), -1);
+	zassert_equal(errno, EINVAL);
+}
