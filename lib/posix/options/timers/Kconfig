menuconfig POSIX_TIMERS
	bool "POSIX high-resolution timers"
	select SYS_TIMER
	select TIMER_REALTIME
	help
	  Select 'y' here and Zephyr will provide implementations of clock_getres(), clock_gettime(),
	  clock_settime(), nanosleep(), timer_create(), timer_delete(), timer_getoverrun(),
	  timer_settime(), and timer_gettime().

	  Timer objects are allocated from the OS-managed system timer pool (CONFIG_SYS_TIMER).
	  Applications and libraries reserve guaranteed, statically-allocated timers by defining
	  int symbols named CONFIG_SYS_TIMER_MIN_ADD_<NAME>; CONFIG_SYS_TIMER_MAX (default INT_MAX)
	  caps dynamic allocation, and setting it equal to the accumulated minimum prohibits
	  dynamic allocation entirely.

	  When the kernel signal subsystem (CONFIG_SIGNAL) is unavailable, a reduced mode remains:
	  SIGEV_NONE timers are fully functional, while SIGEV_SIGNAL, SIGEV_THREAD, and
	  SIGEV_THREAD_ID report ENOTSUP from timer_create().

if POSIX_TIMERS

config POSIX_MONOTONIC_CLOCK
	bool "POSIX Monotonic clock support"
	default y
	help
	  This enables CLOCK_MONOTONIC and the _POSIX_MONOTONIC_CLOCK option.

	  May be enabled directly or via :kconfig:option:`CONFIG_XSI_ADVANCED_REALTIME`.

config POSIX_CPUTIME
	bool "POSIX per-process CPU-time clocks"
	default y
	help
	  This enables CLOCK_PROCESS_CPUTIME_ID and the _POSIX_CPUTIME option.

	  May be enabled directly or via :kconfig:option:`CONFIG_XSI_ADVANCED_REALTIME`.

config POSIX_THREAD_CPUTIME
	bool "POSIX per-thread CPU-time clocks"
	help
	  This enables CLOCK_THREAD_CPUTIME_ID and the _POSIX_THREAD_CPUTIME option.

	  May be enabled directly or via
	  :kconfig:option:`CONFIG_XSI_ADVANCED_REALTIME_THREADS`.

config POSIX_TIMER_MAX
	def_int SYS_TIMER_MAX
	help
	  Maximum number of POSIX timers per process, derived from the system
	  timer pool bound. Not user configurable: size the pool with
	  CONFIG_SYS_TIMER_MAX and reserve guaranteed capacity with the
	  distributed CONFIG_SYS_TIMER_MIN_ADD_<NAME> minimums.

config POSIX_DELAYTIMER_MAX
	int "Maximum count returned my timer_getoverrun() in POSIX application"
	default 32
	help
	  This controls the maximum number of times a timer can overrun before
	  timer_getoverrun() in POSIX compliant application.

config POSIX_TIMEOUTS
	bool "Support for some blocking POSIX services"
	help
	  This option enables support for absolute timeouts for some blocking POSIX services such as
	  mq_timedsend(), mq_timedreceive(), pthread_cond_timedwait(), pthread_mutex_timedlock(),
	  pthread_rwlock_timedrdlock(), pthread_rwlock_timedwrlock(), and sem_timedwait().

config SIGNAL_QUEUE_SIZE_ADD_POSIX_TIMERS
	def_int 4
	depends on SIGNAL
	help
	  Signal queue slots for timer expiry signals. With the one-pending-per-timer
	  kernel semantics (CONFIG_TIMER_SIGNAL), at most one slot is occupied per
	  timer at any time, so this value bounds the number of timers with
	  simultaneously-pending expiry signals rather than a per-expiry backlog.

config SIGNAL_SET_SIZE_MIN_POSIX_TIMERS
	def_int 42
	depends on SIGNAL
	help
	  Ensure the kernel signal set extends one past the highest POSIX-reachable
	  signal (SIGRTMAX = 33 + 8 by default), so that the top-of-set K_SIG_SYS_TIMER
	  slot used by the kernel timer dispatcher (SIGEV_THREAD) is never reachable
	  through the POSIX signal APIs. If CONFIG_POSIX_RTSIG_MAX is raised,
	  CONFIG_SIGNAL_SET_SIZE must be raised accordingly.

module = TIMER
module-str = POSIX Timers
source "subsys/logging/Kconfig.template.log_config"

endif # POSIX_TIMERS
