diff --git a/tests/lib/sys_aio/src/main.c b/tests/lib/sys_aio/src/main.c
new file mode 100644
index 00000000000..3ab46156ba4
--- /dev/null
+++ b/tests/lib/sys_aio/src/main.c
@@ -0,0 +1,844 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <string.h>
+
+#include <ff.h>
+#include <zephyr/fs/fs.h>
+#include <zephyr/kernel.h>
+#include <zephyr/kernel/signal.h>
+#include <zephyr/sys/aio.h>
+#include <zephyr/sys/fdtable.h>
+#include <zephyr/sys/zvfs.h>
+#include <zephyr/sys/zvfs_fs.h>
+#include <zephyr/zvfs/eventfd.h>
+#include <zephyr/ztest.h>
+
+#define TIMEOUT K_MSEC(500)
+
+#define FILE_PATH "/aio.txt"
+
+static const char content[] = "The quick brown fox jumps over the lazy dog";
+#define CONTENT_LEN (sizeof(content) - 1)
+
+static FATFS fat_fs;
+static struct fs_mount_t fs_mnt = {
+	.type = FS_FATFS,
+	.mnt_point = "/",
+	.fs_data = &fat_fs,
+};
+
+/* fds are opened (and access-granted) in kernel mode in before() */
+static ZTEST_BMEM int file_fd = -1;   /* FILE_PATH, read-write, filled with content */
+static ZTEST_BMEM int filero_fd = -1; /* FILE_PATH, read-only */
+static ZTEST_BMEM int efd = -1;       /* eventfd, initially unreadable */
+
+static ZTEST_BMEM volatile bool notify_fn_ran;
+
+static void grant_fd(int fd)
+{
+#ifdef CONFIG_USERSPACE
+	k_object_access_all_grant(zvfs_fd_entry_get(fd));
+#endif
+}
+
+static void *suite_setup(void)
+{
+	zassert_ok(fs_mount(&fs_mnt));
+
+	return NULL;
+}
+
+static void before(void *arg)
+{
+	ARG_UNUSED(arg);
+
+	file_fd = zvfs_open(FILE_PATH, ZVFS_O_RDWR | ZVFS_O_CREAT | ZVFS_O_TRUNC, 0);
+	zassert_true(file_fd >= 0, "open failed: %d", errno);
+	zassert_equal(zvfs_write(file_fd, content, CONTENT_LEN), CONTENT_LEN);
+
+	filero_fd = zvfs_open(FILE_PATH, ZVFS_O_RDONLY, 0);
+	zassert_true(filero_fd >= 0);
+
+	efd = zvfs_eventfd(0, 0);
+	zassert_true(efd >= 0);
+
+	grant_fd(file_fd);
+	grant_fd(filero_fd);
+	grant_fd(efd);
+}
+
+static void after(void *arg)
+{
+	ARG_UNUSED(arg);
+
+	if (efd >= 0) {
+		(void)sys_aio_cancel(efd, NULL);
+		(void)zvfs_close(efd);
+		efd = -1;
+	}
+	if (filero_fd >= 0) {
+		(void)zvfs_close(filero_fd);
+		filero_fd = -1;
+	}
+	if (file_fd >= 0) {
+		(void)zvfs_close(file_fd);
+		file_fd = -1;
+	}
+}
+
+/* helpers */
+
+static struct sys_aio *submit_ok(int op, int fd, void *buf, size_t len, size_t offset,
+				 uint32_t flags)
+{
+	struct sys_aio *aio = NULL;
+	struct sys_aio_req req = {
+		.op = op,
+		.fd = fd,
+		.buf = buf,
+		.len = len,
+		.offset = offset,
+		.flags = flags,
+	};
+
+	zassert_ok(sys_aio_submit(&req, NULL, NULL, &aio));
+	zassert_not_null(aio);
+
+	return aio;
+}
+
+static void await_ok(struct sys_aio *aio)
+{
+	struct sys_aio *const list[] = {aio};
+
+	zassert_ok(sys_aio_wait(list, 1, TIMEOUT));
+}
+
+static ssize_t reap_ok(struct sys_aio *aio)
+{
+	int error = -1;
+	ssize_t result = -1;
+
+	zassert_ok(sys_aio_release(aio, &error, &result));
+	zassert_ok(error, "operation failed: %d", error);
+
+	return result;
+}
+
+static void efd_add(int fd, zvfs_eventfd_t value)
+{
+	zassert_equal(zvfs_write(fd, &value, sizeof(value)), sizeof(value));
+}
+
+static void sig_block(int signo)
+{
+	struct k_sig_set set;
+
+	zassert_ok(k_sig_emptyset(&set));
+	zassert_ok(k_sig_addset(&set, signo));
+	zassert_ok(k_sig_mask(K_SIG_BLOCK, &set, NULL));
+}
+
+static int sig_accept(int signo, struct k_sig_info *info, k_timeout_t timeout)
+{
+	struct k_sig_set set;
+
+	zassert_ok(k_sig_emptyset(&set));
+	zassert_ok(k_sig_addset(&set, signo));
+
+	return k_sig_timedwait(&set, info, timeout);
+}
