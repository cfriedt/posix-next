config TEST_STRESS_NG_TIMEOUT
	int "Run time of each stressor in seconds"
	default 2
	help
	  Every stressor is run once, on its own thread, for this long (the
	  stress-ng --timeout), with verification enabled.

rsource "../Kconfig.test_common"
source "Kconfig.zephyr"
