menuconfig POSIX_SPAWN
	bool "POSIX spawn support"
	select POSIX_MULTI_PROCESS
	select POSIX_SIGNALS
	select POSIX_DEVICE_IO
	select POSIX_FD_MGMT
	select SYS_THREAD
	select COMMON_LIBC_MALLOC
	help
	  Support for the POSIX_SPAWN Option Group: posix_spawn(),
	  posix_spawnp(), spawn attributes, and spawn file actions.

	  Before exec exists, a spawn path names a prelinked executable
	  image resolved through posix_spawn_image_lookup(); the default
	  implementation resolves nothing, and applications or test suites
	  override it with their own registry.

if POSIX_SPAWN

config POSIX_SPAWN_STACK_SIZE
	int "Spawned initial thread stack size (0 = system thread pool default)"
	default 0
	help
	  Stack size for the pool-drawn initial thread of a spawned process.
	  Zero uses the system thread pool's default stack size.

endif # POSIX_SPAWN
