+/*
+ * SPDX-License-Identifier: 0BSD
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * <sys/syscall.h>: Zephyr has no raw Linux syscall numbers; toybox only
+ * needs the header and a syscall() that fails.
+ */
+#ifndef _TOYBOX_ZEPHYR_SYS_SYSCALL_H
+#define _TOYBOX_ZEPHYR_SYS_SYSCALL_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* always fails with ENOSYS; toybox only reaches it on Linux */
+long syscall(long number, ...);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _TOYBOX_ZEPHYR_SYS_SYSCALL_H */
