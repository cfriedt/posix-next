+static volatile int affinity_cpu;
+static volatile bool affinity_stop;
+
+static void report_cpu(void *arg0, void *arg1, void *arg2)
+{
+	ARG_UNUSED(arg0);
+	ARG_UNUSED(arg1);
+	ARG_UNUSED(arg2);
+
+	while (!affinity_stop) {
+		affinity_cpu = curr_cpu();
+	}
+}
+
+/**
+ * @brief Verify that pinning a running thread moves it to the target CPU.
+ *
+ * @ingroup kernel_cpu_mask_tests
+ *
+ * @details
+ * A mask change on a thread that is running on a CPU it may no longer use
+ * must make the scheduler move it. Skipped in PIN_ONLY mode, where a running
+ * thread's mask cannot change.
+ *
+ * Test steps:
+ * - Start a lower-priority thread that keeps publishing the CPU it runs on.
+ * - Pin it to each CPU in turn, twice around, waiting for it to report the
+ *   target CPU, and read its mask back.
+ * - Enable every CPU again, then stop and join it.
+ *
+ * Expected result:
+ * - After every pin the thread reports the pinned CPU and its mask is that
+ *   CPU; the final mask covers every CPU.
+ *
+ * @see k_thread_cpu_pin()
+ * @see k_thread_cpu_mask_set()
+ * @see k_thread_cpu_mask_get()
+ */
+ZTEST(cpu_mask, test_pin_moves_running_thread)
+{
+	if (IS_ENABLED(CONFIG_SCHED_CPU_MASK_PIN_ONLY)) {
+		ztest_test_skip();
+	}
+
+	unsigned int ncpus = arch_num_cpus();
+	k_tid_t tid;
+
+	affinity_stop = false;
+	affinity_cpu = -1;
+	tid = k_thread_create(&worker_threads[0], worker_stacks[0], STACK_SIZE, report_cpu,
+			      NULL, NULL, NULL, k_thread_priority_get(k_current_get()) + 1, 0,
+			      K_NO_WAIT);
+
+	for (unsigned int i = 0U; i < 2 * ncpus; i++) {
+		int cpu = (int)(i % ncpus);
+
+		zassert_ok(k_thread_cpu_pin(tid, cpu));
+		zassert_true(WAIT_FOR(affinity_cpu == cpu, USEC_PER_SEC, k_msleep(1)),
+			     "running thread did not move to CPU %d", cpu);
+		zassert_equal(k_thread_cpu_mask_get(tid), BIT(cpu));
+	}
+
+	zassert_ok(k_thread_cpu_mask_set(tid, BIT_MASK(ncpus)));
+	zassert_equal(k_thread_cpu_mask_get(tid), BIT_MASK(ncpus));
+
+	affinity_stop = true;
+	k_thread_join(tid, K_FOREVER);
+}
+
 ZTEST_SUITE(cpu_mask, NULL, NULL, NULL, NULL, NULL);
