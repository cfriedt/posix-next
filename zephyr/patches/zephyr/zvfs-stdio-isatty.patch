@@ -921,6 +921,11 @@ static ssize_t stdinout_write_vmeth(void *obj, const void *buffer, size_t count)
 
 static int stdinout_ioctl_vmeth(void *obj, unsigned int request, va_list args)
 {
+	if (request == ZFD_IOCTL_ISATTY) {
+		/* the reserved stdio descriptors refer to the console */
+		return 0;
+	}
+
 	errno = EINVAL;
 	return -1;
 }
