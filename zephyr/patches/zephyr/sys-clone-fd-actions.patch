+void z_clone_fd_actions_free(struct sys_clone_fd_action *acts, size_t n)
+{
+	for (size_t i = 0; (acts != NULL) && (i < n); i++) {
+		k_free((void *)acts[i].path);
+	}
+	k_free(acts);
