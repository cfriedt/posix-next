diff --git a/lib/libc/newlib/include/signal.h b/lib/libc/newlib/include/signal.h
index 88982365687..1892a3656fa 100644
--- a/lib/libc/newlib/include/signal.h
+++ b/lib/libc/newlib/include/signal.h
@@ -9,6 +9,66 @@
 
 #include_next <signal.h>
 
+/*
+ * Newlib numbers the signals beyond ISO C's six as Cygwin does (SIGUSR1 is 25). On Zephyr a
+ * signal number means the same thing to the C library, to the POSIX layer and to the kernel, whose
+ * numbering every <signal.h> follows; SIGEMT and SIGLOST, which newlib names and the kernel
+ * does not, are no signals here.
+ */
+#include <zephyr/kernel/signal.h>
+#undef SIGHUP
+#define SIGHUP K_SIG_HUP
+#undef SIGQUIT
+#define SIGQUIT K_SIG_QUIT
+#undef SIGTRAP
+#define SIGTRAP K_SIG_TRAP
+#undef SIGBUS
+#define SIGBUS K_SIG_BUS
+#undef SIGKILL
+#define SIGKILL K_SIG_KILL
+#undef SIGUSR1
+#define SIGUSR1 K_SIG_USR1
+#undef SIGUSR2
+#define SIGUSR2 K_SIG_USR2
+#undef SIGPIPE
+#define SIGPIPE K_SIG_PIPE
+#undef SIGALRM
+#define SIGALRM K_SIG_ALRM
+#undef SIGCHLD
+#define SIGCHLD K_SIG_CHLD
+#undef SIGCONT
+#define SIGCONT K_SIG_CONT
+#undef SIGSTOP
+#define SIGSTOP K_SIG_STOP
+#undef SIGTSTP
+#define SIGTSTP K_SIG_TSTP
+#undef SIGTTIN
+#define SIGTTIN K_SIG_TTIN
+#undef SIGTTOU
+#define SIGTTOU K_SIG_TTOU
+#undef SIGURG
+#define SIGURG K_SIG_URG
+#undef SIGXCPU
+#define SIGXCPU K_SIG_XCPU
+#undef SIGXFSZ
+#define SIGXFSZ K_SIG_XFSZ
+#undef SIGVTALRM
+#define SIGVTALRM K_SIG_VTALRM
+#undef SIGPROF
+#define SIGPROF K_SIG_PROF
+#undef SIGPOLL
+#define SIGPOLL K_SIG_POLL
+#undef SIGSYS
+#define SIGSYS K_SIG_SYS
+#undef SIGIOT
+#define SIGIOT SIGABRT
+#undef SIGCLD
+#define SIGCLD SIGCHLD
+#undef SIGIO
+#define SIGIO SIGPOLL
+#undef SIGEMT
+#undef SIGLOST
+
 #if defined(_POSIX_C_SOURCE) || defined(__DOXYGEN__)
 
