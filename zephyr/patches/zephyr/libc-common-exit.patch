+config COMMON_LIBC_EXIT
+	bool "Common C library exit() and atexit()"
+	depends on MINIMAL_LIBC || PICOLIBC
+	default y
+	help
+	  Common implementation of exit() and atexit(): registered handlers run
+	  in reverse registration order, then _exit() terminates the program.
+	  For picolibc this replaces the prebuilt library's exit path, whose
+	  atexit() registers handlers into a stub, so the ISO C exit sequence
+	  is observable. Deviation from ISO C: open streams are not flushed and
+	  functions registered via the fini-array mechanism do not run.
+
+config COMMON_LIBC_ATEXIT_MAX
+	int "Maximum number of atexit() registrations"
+	depends on COMMON_LIBC_EXIT
+	range 1 4096
+	default 32
+	help
+	  Maximum number of handlers that can be registered with atexit().
+	  ISO C requires support for at least 32 registrations.
+
 config COMMON_LIBC_TMPFILE
 	bool "Common C library tmpfile()/tmpnam()"
 	depends on !SEMIHOST
diff --git a/lib/libc/common/source/stdlib/exit.c b/lib/libc/common/source/stdlib/exit.c
new file mode 100644
index 00000000000..80c8acd0f27
--- /dev/null
+++ b/lib/libc/common/source/stdlib/exit.c
@@ -0,0 +1,52 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <stdlib.h>
+
+#include <zephyr/sys/atomic.h>
+#include <zephyr/sys/libc-hooks.h>
+#include <zephyr/toolchain.h>
+
+/* not declared by every C library's stdlib.h */
+extern FUNC_NORETURN void _exit(int status);
+
+/*
+ * Lock-free and callable from user mode: a slot is reserved by atomically
+ * incrementing the count, then the handler pointer is stored; exit() skips
+ * slots whose store has not yet landed.
+ */
+Z_LIBC_DATA static void (*atexit_handlers[CONFIG_COMMON_LIBC_ATEXIT_MAX])(void);
+Z_LIBC_DATA static atomic_t atexit_count;
+
+int atexit(void (*func)(void))
+{
+	atomic_val_t slot;
+
+	if (func == NULL) {
+		return -1;
+	}
+
+	do {
+		slot = atomic_get(&atexit_count);
+		if (slot >= CONFIG_COMMON_LIBC_ATEXIT_MAX) {
+			return -1;
+		}
+	} while (!atomic_cas(&atexit_count, slot, slot + 1));
+
+	atexit_handlers[slot] = func;
+
+	return 0;
+}
+
+FUNC_NORETURN void exit(int status)
+{
+	for (int i = (int)atomic_get(&atexit_count) - 1; i >= 0; i--) {
+		if (atexit_handlers[i] != NULL) {
+			atexit_handlers[i]();
+		}
+	}
+
+	_exit(status);
+}
