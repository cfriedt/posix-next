+
+#define STACK_SIZE (1024 + CONFIG_TEST_EXTRA_STACK_SIZE)
+
+#ifdef CONFIG_USERSPACE
+#define ZTEST_USER_OR_NOT ZTEST_USER
+#define OTHER_OPTIONS     (K_USER | K_INHERIT_PERMS)
+#else
