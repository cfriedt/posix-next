+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <string.h>
+
+#include <zephyr/fs/fs.h>
+#include <zephyr/ztest.h>
+
+#include "utils.h"
+
+#define ATTR_DIR  "/sml/attr.d"
+#define ATTR_FILE ATTR_DIR "/owned"
+#define ATTR_LINK ATTR_DIR "/link"
+
+ZTEST(ext2tests, test_attributes)
+{
+#ifdef CONFIG_FS_DIRENT_EXT
+	struct fs_file_t file;
+	struct fs_dir_t dir;
+	struct fs_dirent ent;
+	bool seen = false;
+
+	zassert_ok(fs_mount(&testfs_mnt));
+	zassert_ok(fs_mkdir(ATTR_DIR));
+	fs_file_t_init(&file);
+	zassert_ok(fs_open(&file, ATTR_FILE, FS_O_CREATE | FS_O_WRITE));
+	zassert_ok(fs_close(&file));
+	zassert_ok(fs_symlink("owned", ATTR_LINK));
+
+	/* the on-disk defaults, owned by 0:0 */
+	zassert_ok(fs_stat(ATTR_DIR, &ent));
+	zassert_equal(ent.mode, FS_MODE_IFDIR | 0755, "0%o", ent.mode);
+	zassert_ok(fs_stat(ATTR_FILE, &ent));
+	zassert_equal(ent.mode, FS_MODE_IFREG | 0644, "0%o", ent.mode);
+	zassert_equal(ent.uid, 0);
+	zassert_equal(ent.gid, 0);
+	zassert_ok(fs_lstat(ATTR_LINK, &ent));
+	zassert_equal(ent.mode, FS_MODE_IFLNK | 0777, "0%o", ent.mode);
+
+	/* permission bits and owners are stored in the inode */
+	zassert_ok(fs_chmod(ATTR_FILE, 02750));
+	zassert_ok(fs_chown(ATTR_FILE, 1000, 100));
+	zassert_ok(fs_stat(ATTR_FILE, &ent));
+	zassert_equal(ent.mode, FS_MODE_IFREG | 02750, "0%o", ent.mode);
+	zassert_equal(ent.uid, 1000);
+	zassert_equal(ent.gid, 100);
+
+	/* a link's target changes through it; the link itself only through lchown */
+	zassert_ok(fs_chmod(ATTR_LINK, 0600));
+	zassert_ok(fs_stat(ATTR_FILE, &ent));
+	zassert_equal(ent.mode, FS_MODE_IFREG | 0600, "0%o", ent.mode);
+	zassert_ok(fs_lchown(ATTR_LINK, 7, 8));
+	zassert_ok(fs_lstat(ATTR_LINK, &ent));
+	zassert_equal(ent.uid, 7);
+	zassert_equal(ent.gid, 8);
+	zassert_ok(fs_stat(ATTR_FILE, &ent));
+	zassert_equal(ent.uid, 1000, "the target kept its owner");
+
+	/* readdir reports what stat reports, and everything survives a remount */
+	zassert_ok(fs_unmount(&testfs_mnt));
+	zassert_ok(fs_mount(&testfs_mnt));
+	fs_dir_t_init(&dir);
+	zassert_ok(fs_opendir(&dir, ATTR_DIR));
+	while ((fs_readdir(&dir, &ent) == 0) && (ent.name[0] != '\0')) {
+		if (strcmp(ent.name, "owned") == 0) {
+			zassert_equal(ent.mode, FS_MODE_IFREG | 0600, "0%o", ent.mode);
+			zassert_equal(ent.uid, 1000);
+			zassert_equal(ent.gid, 100);
+			seen = true;
+		}
+	}
+	zassert_ok(fs_closedir(&dir));
+	zassert_true(seen, "readdir did not list the file");
+
+	zassert_equal(fs_chmod(ATTR_DIR "/nope", 0600), -ENOENT);
+	zassert_ok(fs_unlink(ATTR_LINK));
+	zassert_ok(fs_unlink(ATTR_FILE));
+	zassert_ok(fs_unlink(ATTR_DIR));
+	zassert_ok(fs_unmount(&testfs_mnt));
+#else
+	ztest_test_skip();
+#endif /* CONFIG_FS_DIRENT_EXT */
+}
