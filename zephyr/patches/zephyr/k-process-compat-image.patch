+#ifdef CONFIG_KCL
+/* the ELF type of an image file, or a negative error */
+static int exec_image_type(const char *path)
+{
+	struct fs_file_t f;
+	elf_ehdr_t ehdr;
+	ssize_t n;
+	int ret;
+
+	fs_file_t_init(&f);
+	ret = fs_open(&f, path, FS_O_READ);
+	if (ret < 0) {
+		return ret;
+	}
+	n = fs_read(&f, &ehdr, sizeof(ehdr));
+	(void)fs_close(&f);
+	if (n != (ssize_t)sizeof(ehdr)) {
+		return -ENOEXEC;
+	}
+	if (memcmp(ehdr.e_ident, "\177ELF", 4) != 0) {
+		return -ENOEXEC;
+	}
+
+	return ehdr.e_type;
+}
+#endif /* CONFIG_KCL */
