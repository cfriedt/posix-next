+# Pin system call IDs: each file lists '<name> <id>' lines (see
+# scripts/build/gen_syscalls.py --reserve). The other system calls take the
+# IDs left over, so a listed ID names the same call in every image that
+# includes it.
+function(zephyr_syscall_reserve)
+  foreach(one_file ${ARGV})
+    if(EXISTS ${one_file})
+      set(reserve_file ${one_file})
+    elseif(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/${one_file})
+      set(reserve_file ${CMAKE_CURRENT_SOURCE_DIR}/${one_file})
+    else()
+      message(FATAL_ERROR "Syscall reservation file not found: ${one_file}")
+    endif()
+
+    set_property(
+      TARGET syscalls_interface
+      APPEND PROPERTY SYSCALL_RESERVE_FILES
+      ${reserve_file}
+    )
+  endforeach()
+endfunction()
+
+function(zephyr_syscall_reserve_ifdef feature_toggle)
+  if(${${feature_toggle}})
+    zephyr_syscall_reserve(${ARGN})
+  endif()
+endfunction()
+
   set(itcm_path          "${snippet_base}/snippets-itcm-section.ld")
   set(dtcm_path          "${snippet_base}/snippets-dtcm-section.ld")
 
