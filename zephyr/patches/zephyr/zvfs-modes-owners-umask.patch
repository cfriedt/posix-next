+	/* every creation withholds the mask's bits from the requested mode */
+	zassert_ok(zvfs_close(attr_create(AFILE, 0666)));
+	zassert_equal(attr_mode(AFILE), ZVFS_MODE_IFREG | 0640, "0%o", attr_mode(AFILE));
+	zassert_ok(zvfs_mkdir(ADIR, 0777));
+	zassert_equal(attr_mode(ADIR), ZVFS_MODE_IFDIR | 0750, "0%o", attr_mode(ADIR));
