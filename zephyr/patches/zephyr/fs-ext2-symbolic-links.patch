+static int ext2_lstat(struct fs_mount_t *mountp, const char *path, struct fs_dirent *entry)
+{
+	int rc;
+	struct ext2_data *fs = mountp->fs_data;
+
+	path = fs_impl_strip_prefix(path, mountp);
+
+	struct ext2_lookup_args args = {
+		.path = path,
+		.parent = NULL,
+		.flags = LOOKUP_ARG_STAT | LOOKUP_ARG_NOFOLLOW,
+	};
+
+	rc = ext2_lookup_inode(fs, &args);
+	if (rc < 0) {
+		return rc;
+	}
+
+	uint32_t offset = args.offset;
+	struct ext2_file dir = {.f_inode = args.parent ? args.parent : args.inode, .f_off = offset};
+
+	rc = ext2_get_direntry(&dir, entry);
+
+	ext2_inode_drop(args.parent);
+	ext2_inode_drop(args.inode);
+	return rc;
