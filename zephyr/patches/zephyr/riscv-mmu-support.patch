+	default 4096
+
+config RISCV_MMU_ASID_BITS
+	int "Number of implemented ASID bits"
+	default 16
+	range 1 16
+	help
+	  Number of ASID bits implemented by the SoC's MMU (ASIDLEN in the
+	  RISC-V privileged spec). The architecture reserves 16 bits for the
+	  ASID field in satp, but an implementation may support fewer;
+	  unimplemented bits are read-only zero in hardware. Override this
+	  for your SoC if it implements fewer than 16 ASID bits, otherwise
