+/* exit at once: the exit sweep closes the inherited descriptors */
+static void shared_exit(void *p1, void *p2, void *p3)
+{
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
