+	zassert_true((probe == 0) || (probe == -ESRCH), "k_kill_all(0) returned %d", probe);
+
+	elig_handler_ran = false;
+	elig_recipient = NULL;
+	zassert_ok(sys_clone(&args, NULL));
+	zassert_ok(k_sem_take(&elig_ready, K_SECONDS(5)));
