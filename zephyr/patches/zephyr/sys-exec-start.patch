+		if (proc->image_next == NULL) {
+			ret = -ENOENT;
+		} else {
+			main_sym = llext_find_sym(&((struct llext *)proc->image_next)->exp_tab,
+						  "main");
+			if (main_sym == NULL) {
+				ret = -ENOEXEC;
+			}
+		}
+#else
+		ret = -ENOENT;
+#endif /* CONFIG_SYS_PROCESS_EXEC */
+	}
+	if (ret == 0) {
+		struct sys_clone_args args = {
+			.entry = entry,
+			.argv = argv,
+			.envp = envp,
