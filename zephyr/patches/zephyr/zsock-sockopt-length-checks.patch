diff --git a/subsys/net/lib/sockets/sockets.c b/subsys/net/lib/sockets/sockets.c
--- a/subsys/net/lib/sockets/sockets.c
+++ b/subsys/net/lib/sockets/sockets.c
@@ -1004,8 +1004,13 @@ int z_vrfy_zsock_getsockopt(int sock, int level, int optname,
 	K_OOPS(k_usermode_from_copy(&kernel_optlen, optlen,
 		sizeof(net_socklen_t)));

+	if ((int)kernel_optlen < 0) {
+		errno = EINVAL;
+		return -1;
+	}
+
 	if (K_SYSCALL_MEMORY_WRITE(optval, kernel_optlen)) {
-		errno = -EPERM;
+		errno = EFAULT;
 		return -1;
 	}

@@ -1049,8 +1054,17 @@ int z_vrfy_zsock_setsockopt(int sock, int level, int optname,
 	void *kernel_optval;
 	int ret;

+	if ((int)optlen < 0) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	K_OOPS(K_SYSCALL_MEMORY_READ(optval, optlen));
 	kernel_optval = k_usermode_alloc_from_copy((const void *)optval, optlen);
-	K_OOPS(!kernel_optval);
+	if (kernel_optval == NULL) {
+		errno = ENOMEM;
+		return -1;
+	}

 	ret = z_impl_zsock_setsockopt(sock, level, optname,
 				      kernel_optval, optlen);
