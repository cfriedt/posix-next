+// Without fork(): spawn argv with the pipe ends xpopen_setup() made, or the
+// caller's descriptors, as its stdin/stdout. The child gets none of the four
+// pipe ends themselves. Returns the pid, or -1 with errno set.
+static pid_t xspawn_pipes(char **argv, int *pipes, int *pp)
+{
+  posix_spawn_file_actions_t fa;
+  pid_t pid;
+  int in = 0, out = 1, swap = -1, err;
+
+  posix_spawn_file_actions_init(&fa);
+  if (pipes) {
+    in = pp[1] ? pp[0] : pipes[0];
+    out = pp[2] ? pp[3] : pipes[1];
+    // If swapping stdin/stdout, dup a filehandle that gets closed before use
+    if (!out) out = swap = dup(0);
+    if (in) posix_spawn_file_actions_adddup2(&fa, in, 0);
+    if (out != 1) posix_spawn_file_actions_adddup2(&fa, out, 1);
+    if (in) posix_spawn_file_actions_addclose(&fa, in);
+    if (out != 1) posix_spawn_file_actions_addclose(&fa, out);
+    if (pp[1]) posix_spawn_file_actions_addclose(&fa, pp[1]);
+    if (pp[2]) posix_spawn_file_actions_addclose(&fa, pp[2]);
+  }
+  err = posix_spawnp(&pid, *argv, &fa, 0, argv, environ);
+  posix_spawn_file_actions_destroy(&fa);
+  if (swap != -1) close(swap);
+  if (err) {
+    errno = err;
+    pid = -1;
+  }
+
+  return pid;
+}
