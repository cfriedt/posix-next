config POSIX_SYMBOLIC_LINKS
	bool "POSIX symbolic links"
	depends on POSIX_FILE_SYSTEM
	imply FILE_SYSTEM_SYMLINKS
	imply FILE_SYSTEM_ATTRIBUTES
	help
	  Select 'y' here and Zephyr will provide implementations of the
	  POSIX_SYMBOLIC_LINKS Option Group: lchown(), lstat(), readlink(),
	  and symlink(). Symbolic links require support from the underlying
	  file system driver, built with FILE_SYSTEM_SYMLINKS; on file systems
	  without it, symlink() fails and lstat() is equivalent to stat().
	  lchown() changes the owner a file system stores for the link itself
	  (FILE_SYSTEM_ATTRIBUTES); without that, it fails with ENOTSUP.
