          <declname>id</declname>
        </param>
        <param>
          <type><ref refid="structsiginfo__t" kindref="compound">siginfo_t</ref> *</type>
          <declname>infop</declname>
        </param>
        <param>
          <type>int</type>
          <declname>options</declname>
        </param>
        <briefdescription>
<para>Wait for a child process matching <emphasis>idtype</emphasis> and <emphasis>id</emphasis> to change state. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>idtype</parametername>
</parameternamelist>
<parameterdescription>
<para>scope of the wait operation (<ref refid="wait_8h_1a116b6ff5d0b67ae43f42f956c705b138a3e3e77552a242f89c892494ef1596758" kindref="member">P_ALL</ref>, <ref refid="wait_8h_1a116b6ff5d0b67ae43f42f956c705b138a670c56bdd326fb6de6112e15dd6c020e" kindref="member">P_PID</ref>, or <ref refid="wait_8h_1a116b6ff5d0b67ae43f42f956c705b138a351482652f992f695740282f8554d156" kindref="member">P_PGID</ref>). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>id</parametername>
</parameternamelist>
<parameterdescription>
<para>process ID or process group ID, according to <emphasis>idtype</emphasis>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">infop</parametername>
</parameternamelist>
<parameterdescription>
<para>location in which to store the child&apos;s status information. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>options</parametername>
</parameternamelist>
<parameterdescription>
<para>bitwise OR of <ref refid="wait_8h_1a004990811e046790b928dbc7787ecfaa" kindref="member">WEXITED</ref>, <ref refid="wait_8h_1afa288d86b242c3005425a9c0f1682544" kindref="member">WNOHANG</ref>, and <ref refid="wait_8h_1a68e8ee6dc7b0115ddc033d974792fa94" kindref="member">WNOWAIT</ref>. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>0 on success, or -1 with errno set on failure. </para>
</simplesect>
<simplesect kind="see"><para><ulink url="https://pubs.opengroup.org/onlinepubs/9699919799/functions/waitid.html">https://pubs.opengroup.org/onlinepubs/9699919799/functions/waitid.html</ulink> </para>
</simplesect>
</para>
