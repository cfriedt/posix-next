+static volatile int chld_seen_id;
+static volatile int chld_seen_status;
+
+static void chld_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	ARG_UNUSED(sig);
+	ARG_UNUSED(ucontext);
+
+	chld_seen_pid = info->pid;
+	chld_seen_id = info->child_id;
+	chld_seen_status = info->status;
