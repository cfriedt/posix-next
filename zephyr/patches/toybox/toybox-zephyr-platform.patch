+// No fork(): run an external command as a spawned process. The caller has
+// already applied the command's redirections to this process's descriptors,
+// which the child inherits, so the spawn needs no file actions. A toybox
+// command runs this binary, which dispatches on argv[0]. Returns the pid, or
+// -1 after reporting the failure.
+static pid_t zephyr_spawn_command(char **argv)
+{
+  char *pp = getvar("PATH") ? : _PATH_DEFPATH, *ss = *argv, **sss = 0;
+  struct string_list *sl = 0;
+  struct sh_vars **vv;
+  struct sh_arg aa;
+  unsigned uu;
+  pid_t pid = -1;
+  int err;
+
+  errno = ENOENT;
+  if (strchr(ss, '/')) {
+    if (access(ss, X_OK)) ss = 0;
+  } else for (sl = find_in_path(pp, toy_find(ss) ? "toybox" : ss);
+              sl || (ss = 0); free(llist_pop(&sl)))
+    if (!access(ss = sl->str, X_OK)) break;
+  if (!ss) {
+    perror_msg("%s", *argv);
+
+    return -1;
+  }
+
+  // the exported variables plus _=path, as sh_exec() builds them
+  vv = visible_vars();
+  aa.v = (void *)vv;
+  for (aa.c = uu = 0; vv[uu]; uu++) {
+    if ((vv[uu]->flags&(VAR_WHITEOUT|VAR_EXPORT))==VAR_EXPORT) {
+      if (*(pp = vv[uu]->str)=='_' && pp[1]=='=') sss = aa.v+aa.c;
+      aa.v[aa.c++] = pp;
+    }
+  }
+  aa.v[aa.c] = 0;
+  if (!sss) {
+    if (aa.c<uu) aa.v[++aa.c] = 0;
+    else arg_add(&aa, 0);
+    sss = aa.v+aa.c-1;
+  }
+  *sss = xmprintf("_=%s", ss);
+
+  err = posix_spawn(&pid, ss, 0, 0, argv, aa.v);
+  if (err) {
+    errno = err;
+    perror_msg("%s", *argv);
+    pid = -1;
+  }
+  free(*sss);
+  free(aa.v);
+  llist_traverse(sl, free);
+
+  return pid;
+}
