diff --git a/subsys/fs/tmpfs/Kconfig b/subsys/fs/tmpfs/Kconfig
new file mode 100644
--- /dev/null
+++ b/subsys/fs/tmpfs/Kconfig
@@ -0,0 +1,47 @@
+# SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+# SPDX-License-Identifier: Apache-2.0
+
+menuconfig FILE_SYSTEM_TMPFS
+	bool "tmpfs: a file system in anonymously mapped pages"
+	depends on FILE_SYSTEM
+	help
+	  A file system that lives entirely in pages mapped on demand: its
+	  nodes, the contents of its files and its own bookkeeping. Nothing is
+	  read from or written to a device, so it is empty at mount and gone at
+	  unmount. Files, directories, symbolic links and FIFO nodes are
+	  supported.
+
+if FILE_SYSTEM_TMPFS
+
+config TMPFS_PAGE_SIZE
+	int "Page size (bytes)"
+	default 4096 if MMU
+	default 1024
+	range 512 65536
+	help
+	  The unit of allocation: the size of a page of file contents or of
+	  nodes. With an MMU the pages come from k_mem_map(), so this is a
+	  multiple of the MMU page size; otherwise they come from the system
+	  heap.
+
+config TMPFS_MAX_PAGES
+	int "Pages a mount may hold"
+	default 0
+	help
+	  Upper bound on the number of pages one mount can allocate, for its
+	  contents and its nodes together; 0 for no bound beyond what the
+	  memory allows. Reported through fs_statvfs().
+
+config TMPFS_MAX_LINK_DEPTH
+	int "Symbolic links followed in one lookup"
+	default 8
+	range 1 40
+	help
+	  A path that goes through more symbolic links than this fails with
+	  ELOOP.
+
+module = TMPFS
+module-str = tmpfs
+source "subsys/logging/Kconfig.template.log_config"
+
+endif # FILE_SYSTEM_TMPFS
diff --git a/subsys/fs/tmpfs/tmpfs.c b/subsys/fs/tmpfs/tmpfs.c
new file mode 100644
--- /dev/null
+++ b/subsys/fs/tmpfs/tmpfs.c
@@ -0,0 +1,1150 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * tmpfs: a file system that lives entirely in pages mapped on demand. Nodes
+ * are carved out of pages, a file's contents are pages reached through a
+ * direct, an indirect and a double-indirect table, and a mount's own record
+ * is a page too, so nothing of it exists before a mount or after an unmount.
+ */
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <zephyr/fs/fs.h>
+#include <zephyr/fs/fs_sys.h>
+#include <zephyr/init.h>
+#include <zephyr/kernel.h>
+#include <zephyr/kernel/mm.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/clock.h>
+#include <zephyr/sys/util.h>
+
+#include "fs_impl.h"
+
+LOG_MODULE_REGISTER(tmpfs, CONFIG_TMPFS_LOG_LEVEL);
+
+#define PAGE_SIZE CONFIG_TMPFS_PAGE_SIZE
+/* page pointers one page holds */
+#define PPP (PAGE_SIZE / sizeof(void *))
+/* pages reached without a table */
+#define NDIRECT 4
+
+struct tmpfs_node {
+	struct tmpfs_node *parent;
+	struct tmpfs_node *next;
+	struct tmpfs_node *children;
+	uint8_t type;
+	uint8_t unlinked;
+	uint16_t opens;
+	size_t size;
+	struct timespec atime;
+	struct timespec mtime;
+	void *direct[NDIRECT];
+	void **indirect;
+	void ***dindirect;
+	char name[MAX_FILE_NAME + 1];
+};
+
+/* an open file or directory: the same size class as a node */
+struct tmpfs_handle {
+	struct tmpfs_node *node;
+	size_t pos;
+	fs_mode_t flags;
+};
+
+union tmpfs_slot {
+	struct tmpfs_node node;
+	struct tmpfs_handle handle;
+	union tmpfs_slot *next_free;
+};
+
+BUILD_ASSERT(sizeof(union tmpfs_slot) <= PAGE_SIZE, "a node must fit a page");
+#ifdef CONFIG_MMU
+BUILD_ASSERT((PAGE_SIZE % CONFIG_MMU_PAGE_SIZE) == 0, "pages are mapped whole");
+#endif
+
+/* a page of slots: the header, then as many slots as fit */
+struct tmpfs_slot_page {
+	struct tmpfs_slot_page *next;
+	union tmpfs_slot slots[];
+};
+
+#define SLOTS_PER_PAGE ((PAGE_SIZE - sizeof(struct tmpfs_slot_page)) / sizeof(union tmpfs_slot))
+
+struct tmpfs_data {
+	struct k_mutex lock;
+	struct tmpfs_node *root;
+	union tmpfs_slot *free_slots;
+	struct tmpfs_slot_page *slot_pages;
+	size_t pages;
+	size_t opens;
+};
+
+BUILD_ASSERT(sizeof(struct tmpfs_data) <= PAGE_SIZE, "the mount record must fit a page");
+
+/* one lookup's outcome: the node, or where it would go */
+struct tmpfs_lookup {
+	struct tmpfs_node *node;
+	struct tmpfs_node *parent;
+	const char *name;
+	size_t name_len;
+};
+
+static void *page_alloc(struct tmpfs_data *fs)
+{
+	void *page;
+
+	if ((CONFIG_TMPFS_MAX_PAGES > 0) && (fs != NULL) && (fs->pages >= CONFIG_TMPFS_MAX_PAGES)) {
+		return NULL;
+	}
+#ifdef CONFIG_MMU
+	/* present from the start: contents are read in any process's context */
+	page = k_mem_map(PAGE_SIZE, K_MEM_PERM_RW | K_MEM_MAP_LOCK);
+#else
+	/* nothing maps these: no alignment beyond the heap's own is needed */
+	page = k_malloc(PAGE_SIZE);
+	if (page != NULL) {
+		(void)memset(page, 0, PAGE_SIZE);
+	}
+#endif
+	if ((page != NULL) && (fs != NULL)) {
+		fs->pages++;
+	}
+
+	return page;
+}
+
+static void page_free(struct tmpfs_data *fs, void *page)
+{
+	if (page == NULL) {
+		return;
+	}
+#ifdef CONFIG_MMU
+	k_mem_unmap(page, PAGE_SIZE);
+#else
+	k_free(page);
+#endif
+	if (fs != NULL) {
+		fs->pages--;
+	}
+}
+
+static union tmpfs_slot *slot_alloc(struct tmpfs_data *fs)
+{
+	union tmpfs_slot *slot = fs->free_slots;
+
+	if (slot == NULL) {
+		struct tmpfs_slot_page *sp = page_alloc(fs);
+
+		if (sp == NULL) {
+			return NULL;
+		}
+		sp->next = fs->slot_pages;
+		fs->slot_pages = sp;
+		for (size_t i = 0; i < SLOTS_PER_PAGE; i++) {
+			sp->slots[i].next_free = fs->free_slots;
+			fs->free_slots = &sp->slots[i];
+		}
+		slot = fs->free_slots;
+	}
+	fs->free_slots = slot->next_free;
+	(void)memset(slot, 0, sizeof(*slot));
+
+	return slot;
+}
+
+static void slot_free(struct tmpfs_data *fs, void *slot)
+{
+	union tmpfs_slot *s = slot;
+
+	s->next_free = fs->free_slots;
+	fs->free_slots = s;
+}
+
+static void now(struct timespec *ts)
+{
+	if (sys_clock_gettime(SYS_CLOCK_REALTIME, ts) != 0) {
+		*ts = (struct timespec){0};
+	}
+}
+
+/* the page holding byte offset off, allocated on demand when asked to */
+static void **page_slot(struct tmpfs_data *fs, struct tmpfs_node *node, size_t index, bool create)
+{
+	if (index < NDIRECT) {
+		return &node->direct[index];
+	}
+	index -= NDIRECT;
+	if (index < PPP) {
+		if (node->indirect == NULL) {
+			if (!create) {
+				return NULL;
+			}
+			node->indirect = page_alloc(fs);
+			if (node->indirect == NULL) {
+				return NULL;
+			}
+		}
+		return &node->indirect[index];
+	}
+	index -= PPP;
+	if (index >= PPP * PPP) {
+		return NULL;
+	}
+	if (node->dindirect == NULL) {
+		if (!create) {
+			return NULL;
+		}
+		node->dindirect = page_alloc(fs);
+		if (node->dindirect == NULL) {
+			return NULL;
+		}
+	}
+	if (node->dindirect[index / PPP] == NULL) {
+		if (!create) {
+			return NULL;
+		}
+		node->dindirect[index / PPP] = page_alloc(fs);
+		if (node->dindirect[index / PPP] == NULL) {
+			return NULL;
+		}
+	}
+	return &node->dindirect[index / PPP][index % PPP];
+}
+
+static void *page_get(struct tmpfs_data *fs, struct tmpfs_node *node, size_t index, bool create)
+{
+	void **slot = page_slot(fs, node, index, create);
+
+	if (slot == NULL) {
+		return NULL;
+	}
+	if ((*slot == NULL) && create) {
+		*slot = page_alloc(fs);
+	}
+	return *slot;
+}
+
+/* drop the pages from byte offset from on; tables that empty go too */
+static void pages_drop(struct tmpfs_data *fs, struct tmpfs_node *node, size_t from)
+{
+	size_t first = DIV_ROUND_UP(from, PAGE_SIZE);
+	size_t last = DIV_ROUND_UP(node->size, PAGE_SIZE);
+
+	for (size_t i = first; i < last; i++) {
+		void **slot = page_slot(fs, node, i, false);
+
+		if ((slot != NULL) && (*slot != NULL)) {
+			page_free(fs, *slot);
+			*slot = NULL;
+		}
+	}
+	if (first <= NDIRECT) {
+		if (node->indirect != NULL) {
+			page_free(fs, node->indirect);
+			node->indirect = NULL;
+		}
+	}
+	if (node->dindirect != NULL) {
+		size_t keep = (first > NDIRECT + PPP) ? DIV_ROUND_UP(first - NDIRECT - PPP, PPP) : 0;
+
+		for (size_t i = keep; i < PPP; i++) {
+			if (node->dindirect[i] != NULL) {
+				page_free(fs, node->dindirect[i]);
+				node->dindirect[i] = NULL;
+			}
+		}
+		if (keep == 0) {
+			page_free(fs, node->dindirect);
+			node->dindirect = NULL;
+		}
+	}
+}
+
+static void node_release(struct tmpfs_data *fs, struct tmpfs_node *node)
+{
+	pages_drop(fs, node, 0);
+	slot_free(fs, node);
+}
+
+static struct tmpfs_node *node_new(struct tmpfs_data *fs, struct tmpfs_node *parent,
+				   const char *name, size_t len, uint8_t type)
+{
+	struct tmpfs_node *node;
+
+	if (len > MAX_FILE_NAME) {
+		return NULL;
+	}
+	node = (struct tmpfs_node *)slot_alloc(fs);
+	if (node == NULL) {
+		return NULL;
+	}
+	(void)memcpy(node->name, name, len);
+	node->name[len] = '\0';
+	node->type = type;
+	now(&node->mtime);
+	node->atime = node->mtime;
+	node->parent = parent;
+	node->next = parent->children;
+	parent->children = node;
+	parent->mtime = node->mtime;
+
+	return node;
+}
+
+static void node_detach(struct tmpfs_node *node)
+{
+	struct tmpfs_node **pp = &node->parent->children;
+
+	while (*pp != node) {
+		pp = &(*pp)->next;
+	}
+	*pp = node->next;
+	now(&node->parent->mtime);
+	node->parent = NULL;
+	node->next = NULL;
+}
+
+static struct tmpfs_node *dir_find(struct tmpfs_node *dir, const char *name, size_t len)
+{
+	for (struct tmpfs_node *n = dir->children; n != NULL; n = n->next) {
+		if ((strlen(n->name) == len) && (memcmp(n->name, name, len) == 0)) {
+			return n;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * Walk path from start. Every symbolic link on the way is followed, the last
+ * component too unless nofollow; a link's target is walked from the link's
+ * directory, or from the root when absolute. Missing components other than
+ * the last one fail; a missing last one leaves node NULL with the parent and
+ * the name filled in, for creation.
+ */
+static int lookup_from(struct tmpfs_data *fs, struct tmpfs_node *start, const char *path,
+		       bool nofollow, struct tmpfs_lookup *out, int depth)
+{
+	struct tmpfs_node *dir = start;
+	struct tmpfs_node *node = start;
+
+	out->node = NULL;
+	if (path[0] == '/') {
+		dir = fs->root;
+		node = dir;
+	}
+	while (*path == '/') {
+		path++;
+	}
+	out->name = NULL;
+	out->name_len = 0;
+	out->parent = dir->parent;
+	while (*path != '\0') {
+		const char *end = strchr(path, '/');
+		size_t len = (end != NULL) ? (size_t)(end - path) : strlen(path);
+		const char *rest = (end != NULL) ? end + 1 : path + len;
+
+		while (*rest == '/') {
+			rest++;
+		}
+		if (len > MAX_FILE_NAME) {
+			return -ENAMETOOLONG;
+		}
+		if (dir->type != FS_DIR_ENTRY_DIR) {
+			return -ENOTDIR;
+		}
+		if ((len == 1) && (path[0] == '.')) {
+			node = dir;
+		} else if ((len == 2) && (path[0] == '.') && (path[1] == '.')) {
+			node = (dir->parent != NULL) ? dir->parent : dir;
+		} else {
+			node = dir_find(dir, path, len);
+		}
+		out->parent = dir;
+		out->name = path;
+		out->name_len = len;
+		if (node == NULL) {
+			return (*rest == '\0') ? 0 : -ENOENT;
+		}
+		if ((node->type == FS_DIR_ENTRY_SYMLINK) && (!nofollow || (*rest != '\0'))) {
+			/* the target sits in the link's first page, terminated by the zero fill */
+			const char *target = page_get(fs, node, 0, false);
+			struct tmpfs_lookup via;
+			int rc;
+
+			if (depth >= CONFIG_TMPFS_MAX_LINK_DEPTH) {
+				return -ELOOP;
+			}
+			if (target == NULL) {
+				return -ENOENT;
+			}
+			rc = lookup_from(fs, dir, target, nofollow && (*rest == '\0'), &via,
+					 depth + 1);
+			if (rc < 0) {
+				return rc;
+			}
+			if (via.node == NULL) {
+				/* a dangling link: creatable through it, not beyond it */
+				if (*rest != '\0') {
+					return -ENOENT;
+				}
+				*out = via;
+				return 0;
+			}
+			node = via.node;
+			out->parent = via.parent;
+			out->name = via.name;
+			out->name_len = via.name_len;
+		}
+		dir = node;
+		path = rest;
+	}
+	out->node = node;
+
+	return 0;
+}
+
+static int lookup(struct tmpfs_data *fs, const char *path, bool nofollow, struct tmpfs_lookup *out)
+{
+	return lookup_from(fs, fs->root, path, nofollow, out, 0);
+}
+
+static ssize_t node_read(struct tmpfs_data *fs, struct tmpfs_node *node, size_t off, void *buf,
+			 size_t len)
+{
+	size_t done = 0;
+
+	if (off >= node->size) {
+		return 0;
+	}
+	len = MIN(len, node->size - off);
+	while (done < len) {
+		size_t in_page = (off + done) % PAGE_SIZE;
+		size_t chunk = MIN(len - done, PAGE_SIZE - in_page);
+		const uint8_t *page = page_get(fs, node, (off + done) / PAGE_SIZE, false);
+
+		if (page != NULL) {
+			(void)memcpy((uint8_t *)buf + done, page + in_page, chunk);
+		} else {
+			(void)memset((uint8_t *)buf + done, 0, chunk);
+		}
+		done += chunk;
+	}
+	return (ssize_t)done;
+}
+
+static ssize_t node_write(struct tmpfs_data *fs, struct tmpfs_node *node, size_t off,
+			  const void *buf, size_t len)
+{
+	size_t done = 0;
+
+	while (done < len) {
+		size_t in_page = (off + done) % PAGE_SIZE;
+		size_t chunk = MIN(len - done, PAGE_SIZE - in_page);
+		uint8_t *page = page_get(fs, node, (off + done) / PAGE_SIZE, true);
+
+		if (page == NULL) {
+			break;
+		}
+		(void)memcpy(page + in_page, (const uint8_t *)buf + done, chunk);
+		done += chunk;
+		if (off + done > node->size) {
+			node->size = off + done;
+		}
+	}
+	if ((done == 0) && (len > 0)) {
+		return -ENOSPC;
+	}
+	now(&node->mtime);
+
+	return (ssize_t)done;
+}
+
+static int node_truncate(struct tmpfs_data *fs, struct tmpfs_node *node, size_t length)
+{
+	if (length < node->size) {
+		size_t tail = length % PAGE_SIZE;
+
+		pages_drop(fs, node, length);
+		if (tail != 0) {
+			uint8_t *page = page_get(fs, node, length / PAGE_SIZE, false);
+
+			if (page != NULL) {
+				(void)memset(page + tail, 0, PAGE_SIZE - tail);
+			}
+		}
+	}
+	/* growing leaves holes, read as zeros until written */
+	node->size = length;
+	now(&node->mtime);
+
+	return 0;
+}
+
+static inline struct tmpfs_data *fs_of(const struct fs_mount_t *mp)
+{
+	return mp->fs_data;
+}
+
+static void fill_dirent(const struct tmpfs_node *node, struct fs_dirent *entry)
+{
+	entry->type = node->type;
+	entry->size = (node->type == FS_DIR_ENTRY_DIR) ? 0 : node->size;
+	strncpy(entry->name, node->name, sizeof(entry->name) - 1);
+	entry->name[sizeof(entry->name) - 1] = '\0';
+#ifdef CONFIG_FS_DIRENT_EXT
+	entry->atime = node->atime;
+	entry->mtime = node->mtime;
+#endif
+}
+
+static int tmpfs_open(struct fs_file_t *filp, const char *fs_path, fs_mode_t flags)
+{
+	struct tmpfs_data *fs = fs_of(filp->mp);
+	const char *path = fs_impl_strip_prefix(fs_path, filp->mp);
+	struct tmpfs_lookup l;
+	struct tmpfs_handle *h;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = lookup(fs, path, false, &l);
+	if (rc < 0) {
+		goto out;
+	}
+	if (l.node == NULL) {
+		if ((flags & FS_O_CREATE) == 0) {
+			rc = -ENOENT;
+			goto out;
+		}
+		l.node = node_new(fs, l.parent, l.name, l.name_len, FS_DIR_ENTRY_FILE);
+		if (l.node == NULL) {
+			rc = -ENOSPC;
+			goto out;
+		}
+	} else if (l.node->type == FS_DIR_ENTRY_DIR) {
+		rc = -EISDIR;
+		goto out;
+	} else if (l.node->type != FS_DIR_ENTRY_FILE) {
+		/* a FIFO's bytes live in whatever opens it by name above this layer */
+		rc = -ENXIO;
+		goto out;
+	}
+	h = (struct tmpfs_handle *)slot_alloc(fs);
+	if (h == NULL) {
+		rc = -ENOMEM;
+		goto out;
+	}
+	h->node = l.node;
+	h->flags = flags;
+	/* an append handle reports position 0 until it writes, which goes to the end */
+	h->pos = 0;
+	l.node->opens++;
+	fs->opens++;
+	filp->filep = h;
+	rc = 0;
+out:
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_close(struct fs_file_t *filp)
+{
+	struct tmpfs_data *fs = fs_of(filp->mp);
+	struct tmpfs_handle *h = filp->filep;
+	struct tmpfs_node *node = h->node;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	node->opens--;
+	fs->opens--;
+	if ((node->opens == 0) && node->unlinked) {
+		node_release(fs, node);
+	}
+	slot_free(fs, h);
+	filp->filep = NULL;
+	k_mutex_unlock(&fs->lock);
+
+	return 0;
+}
+
+static ssize_t tmpfs_read(struct fs_file_t *filp, void *dest, size_t nbytes)
+{
+	struct tmpfs_data *fs = fs_of(filp->mp);
+	struct tmpfs_handle *h = filp->filep;
+	ssize_t rc;
+
+	if ((h->flags & FS_O_READ) == 0) {
+		return -EACCES;
+	}
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = node_read(fs, h->node, h->pos, dest, nbytes);
+	if (rc > 0) {
+		h->pos += (size_t)rc;
+		now(&h->node->atime);
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static ssize_t tmpfs_write(struct fs_file_t *filp, const void *src, size_t nbytes)
+{
+	struct tmpfs_data *fs = fs_of(filp->mp);
+	struct tmpfs_handle *h = filp->filep;
+	ssize_t rc;
+
+	if ((h->flags & FS_O_WRITE) == 0) {
+		return -EACCES;
+	}
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	if ((h->flags & FS_O_APPEND) != 0) {
+		h->pos = h->node->size;
+	}
+	rc = node_write(fs, h->node, h->pos, src, nbytes);
+	if (rc > 0) {
+		h->pos += (size_t)rc;
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_lseek(struct fs_file_t *filp, off_t off, int whence)
+{
+	struct tmpfs_data *fs = fs_of(filp->mp);
+	struct tmpfs_handle *h = filp->filep;
+	off_t base;
+	int rc = 0;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	switch (whence) {
+	case FS_SEEK_SET:
+		base = 0;
+		break;
+	case FS_SEEK_CUR:
+		base = (off_t)h->pos;
+		break;
+	case FS_SEEK_END:
+		base = (off_t)h->node->size;
+		break;
+	default:
+		rc = -EINVAL;
+		goto out;
+	}
+	/* beyond the end is allowed: a write there leaves a hole behind it */
+	if (base + off < 0) {
+		rc = -EINVAL;
+		goto out;
+	}
+	h->pos = (size_t)(base + off);
+out:
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static off_t tmpfs_tell(struct fs_file_t *filp)
+{
+	struct tmpfs_handle *h = filp->filep;
+
+	return (off_t)h->pos;
+}
+
+static int tmpfs_truncate(struct fs_file_t *filp, off_t length)
+{
+	struct tmpfs_data *fs = fs_of(filp->mp);
+	struct tmpfs_handle *h = filp->filep;
+	int rc;
+
+	if ((h->flags & FS_O_WRITE) == 0) {
+		return -EACCES;
+	}
+	if (length < 0) {
+		return -EINVAL;
+	}
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = node_truncate(fs, h->node, (size_t)length);
+	if (h->pos > h->node->size) {
+		h->pos = h->node->size;
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_sync(struct fs_file_t *filp)
+{
+	ARG_UNUSED(filp);
+	return 0;
+}
+
+static int tmpfs_opendir(struct fs_dir_t *dirp, const char *fs_path)
+{
+	struct tmpfs_data *fs = fs_of(dirp->mp);
+	const char *path = fs_impl_strip_prefix(fs_path, dirp->mp);
+	struct tmpfs_lookup l;
+	struct tmpfs_handle *h;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = lookup(fs, path, false, &l);
+	if (rc < 0) {
+		goto out;
+	}
+	if (l.node == NULL) {
+		rc = -ENOENT;
+		goto out;
+	}
+	if (l.node->type != FS_DIR_ENTRY_DIR) {
+		rc = -ENOTDIR;
+		goto out;
+	}
+	h = (struct tmpfs_handle *)slot_alloc(fs);
+	if (h == NULL) {
+		rc = -ENOMEM;
+		goto out;
+	}
+	h->node = l.node;
+	l.node->opens++;
+	fs->opens++;
+	dirp->dirp = h;
+	rc = 0;
+out:
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_readdir(struct fs_dir_t *dirp, struct fs_dirent *entry)
+{
+	struct tmpfs_data *fs = fs_of(dirp->mp);
+	struct tmpfs_handle *h = dirp->dirp;
+	struct tmpfs_node *n = h->node->children;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	/* the position counts entries: an entry removed meanwhile skips one */
+	for (size_t i = 0; (n != NULL) && (i < h->pos); i++) {
+		n = n->next;
+	}
+	if (n == NULL) {
+		entry->name[0] = '\0';
+		entry->type = FS_DIR_ENTRY_FILE;
+		entry->size = 0;
+	} else {
+		fill_dirent(n, entry);
+		h->pos++;
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return 0;
+}
+
+static int tmpfs_rewinddir(struct fs_dir_t *dirp)
+{
+	struct tmpfs_handle *h = dirp->dirp;
+
+	h->pos = 0;
+
+	return 0;
+}
+
+static int tmpfs_closedir(struct fs_dir_t *dirp)
+{
+	struct tmpfs_data *fs = fs_of(dirp->mp);
+	struct tmpfs_handle *h = dirp->dirp;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	h->node->opens--;
+	fs->opens--;
+	slot_free(fs, h);
+	dirp->dirp = NULL;
+	k_mutex_unlock(&fs->lock);
+
+	return 0;
+}
+
+static int tmpfs_mount(struct fs_mount_t *mountp)
+{
+	struct tmpfs_data *fs;
+
+	if ((mountp->flags & FS_MOUNT_FLAG_NO_FORMAT) != 0) {
+		/* nothing survives an unmount: there is nothing to find */
+		return -ENOENT;
+	}
+	fs = page_alloc(NULL);
+	if (fs == NULL) {
+		return -ENOMEM;
+	}
+	fs->pages = 1;
+	k_mutex_init(&fs->lock);
+	fs->root = (struct tmpfs_node *)slot_alloc(fs);
+	if (fs->root == NULL) {
+		page_free(NULL, fs);
+		return -ENOMEM;
+	}
+	fs->root->type = FS_DIR_ENTRY_DIR;
+	now(&fs->root->mtime);
+	fs->root->atime = fs->root->mtime;
+	mountp->fs_data = fs;
+
+	return 0;
+}
+
+static void tree_release(struct tmpfs_data *fs, struct tmpfs_node *dir)
+{
+	struct tmpfs_node *n = dir->children;
+
+	while (n != NULL) {
+		struct tmpfs_node *next = n->next;
+
+		if (n->type == FS_DIR_ENTRY_DIR) {
+			tree_release(fs, n);
+		}
+		pages_drop(fs, n, 0);
+		n = next;
+	}
+}
+
+static int tmpfs_unmount(struct fs_mount_t *mountp)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	struct tmpfs_slot_page *sp;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	if (fs->opens > 0) {
+		k_mutex_unlock(&fs->lock);
+		return -EBUSY;
+	}
+	tree_release(fs, fs->root);
+	sp = fs->slot_pages;
+	while (sp != NULL) {
+		struct tmpfs_slot_page *next = sp->next;
+
+		page_free(fs, sp);
+		sp = next;
+	}
+	k_mutex_unlock(&fs->lock);
+	mountp->fs_data = NULL;
+	page_free(NULL, fs);
+
+	return 0;
+}
+
+static int tmpfs_unlink(struct fs_mount_t *mountp, const char *name)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	const char *path = fs_impl_strip_prefix(name, mountp);
+	struct tmpfs_lookup l;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = lookup(fs, path, true, &l);
+	if (rc < 0) {
+		goto out;
+	}
+	if (l.node == NULL) {
+		rc = -ENOENT;
+		goto out;
+	}
+	if (l.node == fs->root) {
+		rc = -EPERM;
+		goto out;
+	}
+	if (l.node->type == FS_DIR_ENTRY_DIR) {
+		if (l.node->children != NULL) {
+			rc = -ENOTEMPTY;
+			goto out;
+		}
+		if (l.node->opens > 0) {
+			rc = -EBUSY;
+			goto out;
+		}
+	}
+	node_detach(l.node);
+	if (l.node->opens > 0) {
+		/* its bytes stay for the open handles, and go with the last */
+		l.node->unlinked = 1U;
+	} else {
+		node_release(fs, l.node);
+	}
+	rc = 0;
+out:
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_rename(struct fs_mount_t *mountp, const char *from, const char *to)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	const char *path_from = fs_impl_strip_prefix(from, mountp);
+	const char *path_to = fs_impl_strip_prefix(to, mountp);
+	struct tmpfs_lookup src;
+	struct tmpfs_lookup dst;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = lookup(fs, path_from, true, &src);
+	if (rc < 0) {
+		goto out;
+	}
+	if ((src.node == NULL) || (src.node == fs->root)) {
+		rc = (src.node == NULL) ? -ENOENT : -EPERM;
+		goto out;
+	}
+	rc = lookup(fs, path_to, true, &dst);
+	if (rc < 0) {
+		goto out;
+	}
+	if (dst.node == src.node) {
+		rc = 0;
+		goto out;
+	}
+	if (dst.name_len > MAX_FILE_NAME) {
+		rc = -ENAMETOOLONG;
+		goto out;
+	}
+	/* a directory never moves into itself */
+	for (struct tmpfs_node *d = dst.parent; d != NULL; d = d->parent) {
+		if (d == src.node) {
+			rc = -EINVAL;
+			goto out;
+		}
+	}
+	if (dst.node != NULL) {
+		if (dst.node->type == FS_DIR_ENTRY_DIR) {
+			if (src.node->type != FS_DIR_ENTRY_DIR) {
+				rc = -EISDIR;
+				goto out;
+			}
+			if (dst.node->children != NULL) {
+				rc = -ENOTEMPTY;
+				goto out;
+			}
+		} else if (src.node->type == FS_DIR_ENTRY_DIR) {
+			rc = -ENOTDIR;
+			goto out;
+		}
+		if (dst.node->opens > 0) {
+			rc = -EBUSY;
+			goto out;
+		}
+		node_detach(dst.node);
+		node_release(fs, dst.node);
+	}
+	node_detach(src.node);
+	(void)memcpy(src.node->name, dst.name, dst.name_len);
+	src.node->name[dst.name_len] = '\0';
+	src.node->parent = dst.parent;
+	src.node->next = dst.parent->children;
+	dst.parent->children = src.node;
+	now(&dst.parent->mtime);
+	rc = 0;
+out:
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int node_create(struct fs_mount_t *mountp, const char *name, uint8_t type,
+		       const char *target)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	const char *path = fs_impl_strip_prefix(name, mountp);
+	struct tmpfs_lookup l;
+	struct tmpfs_node *node;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = lookup(fs, path, true, &l);
+	if (rc < 0) {
+		goto out;
+	}
+	if (l.node != NULL) {
+		rc = -EEXIST;
+		goto out;
+	}
+	if (l.name == NULL) {
+		rc = -EINVAL;
+		goto out;
+	}
+	node = node_new(fs, l.parent, l.name, l.name_len, type);
+	if (node == NULL) {
+		rc = -ENOSPC;
+		goto out;
+	}
+	if (target != NULL) {
+		rc = (int)node_write(fs, node, 0, target, strlen(target));
+		if (rc < 0) {
+			node_detach(node);
+			node_release(fs, node);
+			goto out;
+		}
+	}
+	rc = 0;
+out:
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_mkdir(struct fs_mount_t *mountp, const char *name)
+{
+	return node_create(mountp, name, FS_DIR_ENTRY_DIR, NULL);
+}
+
+static int tmpfs_symlink(struct fs_mount_t *mountp, const char *target, const char *path)
+{
+	if ((target == NULL) || (target[0] == '\0') || (strlen(target) > MAX_FILE_NAME)) {
+		return -EINVAL;
+	}
+	return node_create(mountp, path, FS_DIR_ENTRY_SYMLINK, target);
+}
+
+static int tmpfs_mkfifo(struct fs_mount_t *mountp, const char *path)
+{
+	return node_create(mountp, path, FS_DIR_ENTRY_FIFO, NULL);
+}
+
+static int stat_common(struct fs_mount_t *mountp, const char *path, struct fs_dirent *entry,
+		       bool nofollow)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	struct tmpfs_lookup l;
+	int rc;
+
+	path = fs_impl_strip_prefix(path, mountp);
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = lookup(fs, path, nofollow, &l);
+	if ((rc == 0) && (l.node == NULL)) {
+		rc = -ENOENT;
+	}
+	if (rc == 0) {
+		fill_dirent(l.node, entry);
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_stat(struct fs_mount_t *mountp, const char *path, struct fs_dirent *entry)
+{
+	return stat_common(mountp, path, entry, false);
+}
+
+static int tmpfs_lstat(struct fs_mount_t *mountp, const char *path, struct fs_dirent *entry)
+{
+	return stat_common(mountp, path, entry, true);
+}
+
+static ssize_t tmpfs_readlink(struct fs_mount_t *mountp, const char *path, char *buf, size_t size)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	struct tmpfs_lookup l;
+	ssize_t rc;
+
+	path = fs_impl_strip_prefix(path, mountp);
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = lookup(fs, path, true, &l);
+	if ((rc == 0) && (l.node == NULL)) {
+		rc = -ENOENT;
+	}
+	if ((rc == 0) && (l.node->type != FS_DIR_ENTRY_SYMLINK)) {
+		rc = -EINVAL;
+	}
+	if (rc == 0) {
+		rc = node_read(fs, l.node, 0, buf, size);
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_statvfs(struct fs_mount_t *mountp, const char *path, struct fs_statvfs *stat)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+
+	ARG_UNUSED(path);
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	stat->f_bsize = PAGE_SIZE;
+	stat->f_frsize = PAGE_SIZE;
+	if (CONFIG_TMPFS_MAX_PAGES > 0) {
+		stat->f_blocks = CONFIG_TMPFS_MAX_PAGES;
+		stat->f_bfree = CONFIG_TMPFS_MAX_PAGES - fs->pages;
+	} else {
+#ifdef CONFIG_MMU
+		stat->f_blocks = fs->pages + (k_mem_free_get() / PAGE_SIZE);
+		stat->f_bfree = k_mem_free_get() / PAGE_SIZE;
+#else
+		stat->f_blocks = fs->pages;
+		stat->f_bfree = 0;
+#endif
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return 0;
+}
+
+static int tmpfs_utime(struct fs_mount_t *mountp, const char *name, const struct timespec times[2])
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	const char *path = fs_impl_strip_prefix(name, mountp);
+	struct tmpfs_lookup l;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = lookup(fs, path, false, &l);
+	if ((rc == 0) && (l.node == NULL)) {
+		rc = -ENOENT;
+	}
+	if (rc == 0) {
+		if (times == NULL) {
+			now(&l.node->mtime);
+			l.node->atime = l.node->mtime;
+		} else {
+			l.node->atime = times[0];
+			l.node->mtime = times[1];
+		}
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static const struct fs_file_system_t tmpfs_fs = {
+	.open = tmpfs_open,
+	.close = tmpfs_close,
+	.read = tmpfs_read,
+	.write = tmpfs_write,
+	.lseek = tmpfs_lseek,
+	.tell = tmpfs_tell,
+	.truncate = tmpfs_truncate,
+	.sync = tmpfs_sync,
+	.opendir = tmpfs_opendir,
+	.readdir = tmpfs_readdir,
+	.closedir = tmpfs_closedir,
+	.rewinddir = tmpfs_rewinddir,
+	.mount = tmpfs_mount,
+	.unmount = tmpfs_unmount,
+	.unlink = tmpfs_unlink,
+	.rename = tmpfs_rename,
+	.mkdir = tmpfs_mkdir,
+	.stat = tmpfs_stat,
+	.lstat = tmpfs_lstat,
+	.symlink = tmpfs_symlink,
+	.readlink = tmpfs_readlink,
+	.mkfifo = tmpfs_mkfifo,
+	.statvfs = tmpfs_statvfs,
+	.utime = tmpfs_utime,
+};
+
+static int tmpfs_init(void)
+{
+	return fs_register(FS_TMPFS, &tmpfs_fs);
+}
+
+SYS_INIT(tmpfs_init, POST_KERNEL, CONFIG_FILE_SYSTEM_INIT_PRIORITY);
