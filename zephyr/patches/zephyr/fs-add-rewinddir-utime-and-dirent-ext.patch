+/**
+ * @brief Set file or directory timestamps
+ *
+ * Sets the access and modification times of the file or directory named by
+ * @p path. A timestamp whose nanoseconds are @ref FS_UTIME_NOW is set to the
+ * current time as reported by @ref SYS_CLOCK_REALTIME, and one whose
+ * nanoseconds are @ref FS_UTIME_OMIT is left as it is: the file system skips it
+ * under its own lock, so a concurrent update of that timestamp is not undone.
+ *
+ * @param path Path to the file or directory
+ * @param times Access time in <tt>times[0]</tt> and modification time in
+ * <tt>times[1]</tt>, or NULL to set both to the current time.
+ *
+ * @retval 0 on success;
+ * @retval -EINVAL when a bad file name or a nanoseconds value that is neither
+ * a marker nor below one second is given;
+ * @retval -ENOENT when no such file or directory is found;
+ * @retval -EROFS when the file system is read-only;
+ * @retval -ENOTSUP when not implemented by underlying file system driver;
+ * @retval <0 a negative errno code on error.
+ */
+int fs_utime(const char *path, const struct timespec times[2]);
