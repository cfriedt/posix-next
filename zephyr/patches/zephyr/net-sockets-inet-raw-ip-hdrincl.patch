+static void test_raw_sock_hdrincl_option(net_sa_family_t family)
+{
+	int level = (family == NET_AF_INET) ? NET_IPPROTO_IP : NET_IPPROTO_IPV6;
+	int optname = (family == NET_AF_INET) ? ZSOCK_IP_HDRINCL : ZSOCK_IPV6_HDRINCL;
+	net_socklen_t optlen = sizeof(int);
+	int optval = -1;
+	int ret;
+
+	prepare_raw_sock_common(&raw_sock, family, NET_IPPROTO_UDP, false);
+
+	ret = zsock_getsockopt(raw_sock, level, optname, &optval, &optlen);
+	zassert_ok(ret, "getsockopt failed (%d)", errno);
+	zassert_equal(optval, 0, "IP_HDRINCL must default to off");
+
+	set_hdrincl(raw_sock, family, 1);
+
+	ret = zsock_getsockopt(raw_sock, level, optname, &optval, &optlen);
+	zassert_ok(ret, "getsockopt failed (%d)", errno);
+	zassert_equal(optval, 1, "IP_HDRINCL not set");
+
+	prepare_udp_sock_common(&udp_sock, family, &src_addr);
+	ret = zsock_setsockopt(udp_sock, level, optname, &optval, sizeof(optval));
+	zassert_equal(ret, -1, "IP_HDRINCL accepted on a non-raw socket");
+	zassert_equal(errno, ENOPROTOOPT, "Unexpected errno %d", errno);
+}
