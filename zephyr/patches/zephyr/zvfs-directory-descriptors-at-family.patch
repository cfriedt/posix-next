+/* without a caller buffer the directory is opened by itself, then the name within it */
+static int exe_open_in(const char *dir, size_t dirlen, const char *exe)
+{
+	char path[CONFIG_ZVFS_PATH_MAX];
+	int dirfd;
+	int fd;
+
+	if (dirlen >= sizeof(path)) {
+		errno = ERANGE;
+		return -1;
+	}
+	memcpy(path, dir, dirlen);
+	path[dirlen] = '\0';
+	dirfd = zvfs_open(path, ZVFS_O_RDONLY | ZVFS_O_DIRECTORY, 0);
+	if (dirfd < 0) {
+		return -1;
+	}
+	fd = zvfs_openat(dirfd, exe, ZVFS_O_RDONLY, 0);
+	if (fd < 0) {
+		int err = errno;
+
+		(void)zvfs_close(dirfd);
+		errno = err;
+		return -1;
+	}
+	(void)zvfs_close(dirfd);
+
+	return fd;
+}
