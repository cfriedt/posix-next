diff --git a/zephyr/CMakeLists.txt b/zephyr/CMakeLists.txt
new file mode 100644
index 000000000..f53e39aa6
--- /dev/null
+++ b/zephyr/CMakeLists.txt
@@ -0,0 +1,161 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+#
+# Build busybox as a linkable loadable extension (llext).
+#
+# Busybox's own kbuild runs once, host-side, at configure time: it settles the
+# busybox configuration (zephyr/busybox.frag over allnoconfig), generates the
+# derived headers (autoconf.h, applet_tables.h, usage_compressed.h, ...), and
+# its V=1 log names exactly the sources the configuration compiles. Those
+# sources are then rebuilt with the Zephyr target flags into a static archive,
+# and a partial link seeded by the exported main() pulls in only the members
+# the enabled applets actually reach.
+
+if(CONFIG_BUSYBOX)
+
+set(bb_src_dir ${ZEPHYR_CURRENT_MODULE_DIR})
+set(bb_host_dir ${PROJECT_BINARY_DIR}/busybox/host)
+set(bb_log ${bb_host_dir}/zephyr-host-build.log)
+set(bb_frag ${bb_src_dir}/zephyr/busybox.frag)
+
+set(bb_stamp ${bb_host_dir}/busybox_unstripped)
+if((NOT EXISTS ${bb_stamp}) OR (${bb_frag} IS_NEWER_THAN ${bb_stamp}))
+  message(STATUS "busybox: host configure + header generation in ${bb_host_dir}")
+  execute_process(
+    COMMAND sh ${bb_src_dir}/zephyr/configure.sh ${bb_src_dir} ${bb_host_dir}
+    RESULT_VARIABLE bb_ret
+    COMMAND_ECHO STDOUT
+  )
+  if(bb_ret)
+    message(FATAL_ERROR "busybox: configure failed, see ${bb_host_dir}/configure.log")
+  endif()
+  execute_process(
+    COMMAND make -C ${bb_src_dir} O=${bb_host_dir} -j8 busybox_unstripped
+    RESULT_VARIABLE bb_ret
+    COMMAND_ECHO STDOUT
+  )
+  if(bb_ret)
+    file(REMOVE ${bb_stamp})
+    message(FATAL_ERROR "busybox: host build failed")
+  endif()
+endif()
+
+# every object the host build produced names a source the configuration
+# compiles (the V=1 log cannot be parsed for this: parallel make interleaves
+# its lines)
+file(GLOB_RECURSE bb_host_objs RELATIVE ${bb_host_dir} ${bb_host_dir}/*.o)
+set(bb_sources "")
+foreach(bb_obj ${bb_host_objs})
+  if(bb_obj MATCHES "^scripts/" OR bb_obj MATCHES "built-in\\.o$" OR
+     bb_obj MATCHES "usage_pod\\.o$")
+    continue()
+  endif()
+  string(REGEX REPLACE "\\.o$" ".c" bb_src "${bb_obj}")
+  if(EXISTS ${bb_src_dir}/${bb_src})
+    list(APPEND bb_sources ${bb_src_dir}/${bb_src})
+  endif()
+endforeach()
+list(REMOVE_DUPLICATES bb_sources)
+list(LENGTH bb_sources bb_count)
+message(STATUS "busybox: ${bb_count} sources from host build log")
+
+# sources that cannot build against Zephyr headers (grown as needed)
+set(bb_excludes
+  libbb/alloc_affinity\\.c
+  libbb/herror_msg\\.c
+  libbb/inet_common\\.c
+  libbb/xgethostbyname\\.c
+  ${BUSYBOX_EXCLUDE_SOURCES}
+)
+foreach(bb_x ${bb_excludes})
+  list(FILTER bb_sources EXCLUDE REGEX "${bb_x}")
+endforeach()
+
+# busybox's version string, normally passed by its kbuild
+file(STRINGS ${bb_src_dir}/Makefile bb_ver_lines REGEX "^(VERSION|PATCHLEVEL|SUBLEVEL|EXTRAVERSION) *=")
+set(bb_VERSION "")
+set(bb_PATCHLEVEL "")
+set(bb_SUBLEVEL "")
+set(bb_EXTRAVERSION "")
+foreach(line ${bb_ver_lines})
+  string(REGEX MATCH "^([A-Z]+) *= *(.*)$" _ "${line}")
+  set(bb_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
+endforeach()
+set(bb_ver "${bb_VERSION}.${bb_PATCHLEVEL}.${bb_SUBLEVEL}${bb_EXTRAVERSION}")
+
+# inline flag filter, as add_llext_target() does it since zephyr 4.5
+list(TRANSFORM LLEXT_REMOVE_FLAGS
+     REPLACE "(.+)" "^\\1$"
+     OUTPUT_VARIABLE llext_remove_flags_regexp
+)
+list(JOIN llext_remove_flags_regexp "|" llext_remove_flags_regexp)
+if("${llext_remove_flags_regexp}" STREQUAL "")
+  set(llext_remove_flags_regexp "^$")
+endif()
+set(zephyr_flags "$<TARGET_PROPERTY:zephyr_interface,INTERFACE_COMPILE_OPTIONS>")
+set(zephyr_filtered_flags "$<FILTER:${zephyr_flags},EXCLUDE,${llext_remove_flags_regexp}>")
+
+add_library(busybox_lib STATIC EXCLUDE_FROM_ALL ${bb_sources})
+
+# the seed object: exports busybox's main() as the extension entry point
+add_library(busybox_main OBJECT EXCLUDE_FROM_ALL ${bb_src_dir}/zephyr/llext_main.c)
+
+foreach(bb_tgt busybox_lib busybox_main)
+  target_compile_definitions(${bb_tgt} PRIVATE
+    $<TARGET_PROPERTY:zephyr_interface,INTERFACE_COMPILE_DEFINITIONS>
+    LL_EXTENSION_BUILD
+    NDEBUG
+    BB_VER="${bb_ver}"
+  )
+  target_compile_options(${bb_tgt} PRIVATE
+    ${zephyr_filtered_flags}
+    ${LLEXT_APPEND_FLAGS}
+    -U_POSIX_C_SOURCE -D_POSIX_C_SOURCE=200809L
+    -U_XOPEN_SOURCE -D_XOPEN_SOURCE=700
+    -D_GNU_SOURCE
+    -std=gnu17
+    -include ${bb_host_dir}/include/autoconf.h
+    -funsigned-char
+    -fno-builtin-printf
+    -fno-builtin-strlen
+    -Wno-shadow
+    -Wno-undef
+    -Wno-pointer-arith
+    -Wno-double-promotion
+    -Wno-deprecated-declarations
+    -Wno-uninitialized
+  )
+  target_include_directories(${bb_tgt} PRIVATE
+    ${bb_src_dir}/zephyr/include
+    ${bb_host_dir}/include
+    ${bb_src_dir}/include
+    ${bb_src_dir}/libbb
+    $<TARGET_PROPERTY:zephyr_interface,INTERFACE_INCLUDE_DIRECTORIES>
+  )
+  target_include_directories(${bb_tgt} SYSTEM PRIVATE
+    $<TARGET_PROPERTY:zephyr_interface,INTERFACE_SYSTEM_INCLUDE_DIRECTORIES>
+  )
+  add_dependencies(${bb_tgt} zephyr_interface zephyr_generated_headers)
+endforeach()
+
+# partial link: the exported main() pulls the reachable archive members
+set(bb_llext ${PROJECT_BINARY_DIR}/busybox/busybox.llext)
+add_custom_command(
+  OUTPUT ${bb_llext}
+  COMMAND ${CMAKE_C_COMPILER}
+    "$<TARGET_PROPERTY:linker,partial_linking>"
+    ${LLEXT_APPEND_FLAGS}
+    -nostdlib -nodefaultlibs
+    $<TARGET_OBJECTS:busybox_main>
+    # group: a member pulled late may need one the single pass already skipped
+    -Wl,--start-group $<TARGET_FILE:busybox_lib> -Wl,--end-group
+    -o ${bb_llext}
+  COMMAND ${CMAKE_OBJCOPY} --strip-debug ${bb_llext}
+  DEPENDS busybox_main busybox_lib $<TARGET_OBJECTS:busybox_main> $<TARGET_FILE:busybox_lib>
+  COMMAND_EXPAND_LISTS
+)
+add_custom_target(busybox_llext DEPENDS ${bb_llext})
+
+set(BUSYBOX_LLEXT_FILE ${bb_llext} CACHE INTERNAL "path to the busybox llext binary")
+
+endif()
