+#ifdef CONFIG_SIGNAL_FAULT
+bool z_sig_fault(int signo, int code, void *addr)
+{
+	k_tid_t const tid = _current;
+	struct k_sig_ctx *const ctx = &tid->base.sig;
+	struct k_sig_action act;
+
+	if (k_is_pre_kernel() || ((tid->base.user_options & K_USER) == 0U) ||
+	    (ctx->fault != K_SIG_FAULT_NONE)) {
+		/* a fault on the way to the signal: nothing more can run in user mode */
+		return false;
+	}
+
+	(void)z_sig_action(signo, NULL, &act, tid);
+	if (!ctx->handling && (act.handler != K_SIG_DFL) && (act.handler != K_SIG_IGN) &&
+	    (k_sig_ismember(&ctx->mask, signo) == 0)) {
+		ctx->info = (struct k_sig_info){.signo = signo, .code = code, .addr = addr};
+		ctx->fault = K_SIG_FAULT_PENDING;
+	} else if (!z_process_self_is_reserved()) {
+		/* blocked, ignored or inside a handler: the default action, as on Linux */
+		ctx->fault = K_SIG_FAULT_FORCED;
+	} else {
+		return false;
+	}
+	ctx->fault_signo = (uint8_t)signo;
+
+	return true;
+}
+
+int z_sig_fault_claim(struct k_thread *tid)
+{
+	struct k_sig_ctx *const ctx = &tid->base.sig;
+
+	if (ctx->fault != K_SIG_FAULT_PENDING) {
+		return 0;
+	}
+	ctx->fault = K_SIG_FAULT_DELIVERED;
+
+	(void)z_sig_action(ctx->info.signo, NULL, &ctx->action, tid);
+	if ((ctx->action.handler == K_SIG_DFL) || (ctx->action.handler == K_SIG_IGN)) {
+		/* another member reset the disposition since the fault */
+		z_process_exit_signaled(ctx->info.signo);
+	}
+
+	ctx->restore = ctx->mask;
+	if ((ctx->action.flags & K_SIG_SA_NODEFER) == 0) {
+		k_sig_addset(&ctx->mask, ctx->info.signo);
+	}
+	z_sig_orset(&ctx->mask, &ctx->action.mask);
+
+	return 1;
+}
+
+void z_impl_k_sig_fault(void)
+{
+	struct k_sig_ctx *const ctx = &_current->base.sig;
+
+	if (ctx->fault == K_SIG_FAULT_PENDING) {
+		/* the return from this call runs the handler */
+		return;
+	}
+
+	/* the default action, or the handler returned (undefined for a fault: POSIX) */
+	ctx->fault = K_SIG_FAULT_NONE;
+	z_process_exit_signaled((ctx->fault_signo != 0U) ? ctx->fault_signo : K_SIG_SEGV);
+}
+
+static inline void z_vrfy_k_sig_fault(void)
+{
+	z_impl_k_sig_fault();
+}
