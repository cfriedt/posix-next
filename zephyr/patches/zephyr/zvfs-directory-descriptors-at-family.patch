 	return 0;
 }
 
+/* like zvfs_resolve_path(), but a relative path is taken against dirfd */
+int zvfs_resolve_at(int dirfd, const char *in, char *out, size_t outsz)
+{
+	struct fd_entry *entry;
+	struct zvfs_fs_desc *desc;
+	char joined[CONFIG_ZVFS_PATH_MAX];
+
+	if (in == NULL) {
+		return -EFAULT;
+	}
+
+	if (in[0] == '/' || dirfd == ZVFS_AT_FDCWD) {
+		return zvfs_resolve_path(in, out, outsz);
+	}
+
+	if (in[0] == '\0') {
+		return -ENOENT;
+	}
+
+	entry = zvfs_fd_entry_get(dirfd);
+	if (entry == NULL) {
+		return -EBADF;
+	}
+
+	if ((entry->mode & ZVFS_MODE_IFMT) != ZVFS_MODE_IFDIR) {
+		return -ENOTDIR;
+	}
+
+	desc = entry->obj;
+	if (desc == NULL || desc->path[0] == '\0') {
+		return -EBADF;
+	}
+
+	if (snprintf(joined, sizeof(joined), "%s/%s", desc->path, in) >= (int)sizeof(joined)) {
+		return -ENAMETOOLONG;
+	}
+
+	return zvfs_resolve_path(joined, out, outsz);
+}
+
+#ifdef CONFIG_USERSPACE
+/* ZVFS_AT_FDCWD names no descriptor; anything else must be accessible */
+int zvfs_dirfd_syscall_verify(int dirfd)
+{
+	if (dirfd == ZVFS_AT_FDCWD) {
+		return 0;
+	}
+
+	return (zvfs_fd_syscall_verify(dirfd) == NULL) ? -1 : 0;
+}
+#endif /* CONFIG_USERSPACE */
