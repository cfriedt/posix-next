config SAMPLE_TOYBOX_TOUR
	bool "Run the command tour before the shell"
	default y
	help
	  Run a scripted sequence of toybox commands and shell scripts before
	  starting the interactive shell. Without it the sample sets up the file
	  system and drops straight into the shell, as the in-browser demo does.

source "Kconfig.zephyr"
