+	k_sig_altstack_errors();
+	k_sig_altstack_onstack();
+	k_sig_altstack_not_onstack();
+#ifdef CONFIG_SIGNAL_FAULT
+	k_sig_altstack_bad_sp();
+#endif /* CONFIG_SIGNAL_FAULT */
+}
