+#define CLD_EXITED    K_SI_CLD_EXITED
+#define CLD_KILLED    K_SI_CLD_KILLED
+#define CLD_DUMPED    K_SI_CLD_DUMPED
+#define CLD_TRAPPED   K_SI_CLD_TRAPPED
+#define CLD_STOPPED   K_SI_CLD_STOPPED
