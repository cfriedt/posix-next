+/* sections of test_sys_aio_cancel */
+
+static void cancel_armed_request(void)
+{
+	zvfs_eventfd_t value;
+	int error = 0;
+	ssize_t result = 0;
+	struct sys_aio *aio;
+
+	aio = submit_ok(SYS_AIO_OP_READ, efd, &value, sizeof(value), 0, 0);
+
+	zassert_equal(sys_aio_cancel(efd, aio), SYS_AIO_CANCELED);
+	zassert_equal(sys_aio_error(aio), ECANCELED);
+
+	/* cancellation completes the request: waiters wake immediately */
+	await_ok(aio);
+
+	zassert_ok(sys_aio_release(aio, &error, &result));
+	zassert_equal(error, ECANCELED);
+	zassert_equal(result, -1);
+}
+
+static void cancel_completed_request(void)
+{
+	char buf[4];
+	struct sys_aio *aio;
+
+	aio = submit_ok(SYS_AIO_OP_READ, file_fd, buf, sizeof(buf), 0, SYS_AIO_REQ_OFFSET);
+	await_ok(aio);
+
+	zassert_equal(sys_aio_cancel(file_fd, aio), SYS_AIO_ALLDONE);
+	zassert_equal(reap_ok(aio), sizeof(buf));
+}
+
+static void cancel_all_on_fd(void)
+{
+	zvfs_eventfd_t v1;
+	zvfs_eventfd_t v2;
+	struct sys_aio *aio1;
+	struct sys_aio *aio2;
+
+	aio1 = submit_ok(SYS_AIO_OP_READ, efd, &v1, sizeof(v1), 0, 0);
+	aio2 = submit_ok(SYS_AIO_OP_READ, efd, &v2, sizeof(v2), 0, 0);
+
+	zassert_equal(sys_aio_cancel(efd, NULL), SYS_AIO_CANCELED);
+	zassert_equal(sys_aio_error(aio1), ECANCELED);
+	zassert_equal(sys_aio_error(aio2), ECANCELED);
+	zassert_ok(sys_aio_release(aio1, NULL, NULL));
+	zassert_ok(sys_aio_release(aio2, NULL, NULL));
+
+	/* nothing in flight: all done */
+	zassert_equal(sys_aio_cancel(efd, NULL), SYS_AIO_ALLDONE);
+}
+
+static void cancel_errors(void)
+{
+	zvfs_eventfd_t value;
+	struct sys_aio *aio;
+
+	zassert_equal(sys_aio_cancel(-1, NULL), -EBADF);
+
+	aio = submit_ok(SYS_AIO_OP_READ, efd, &value, sizeof(value), 0, 0);
+
+	/* the request does not belong to that descriptor */
+	zassert_equal(sys_aio_cancel(file_fd, aio), -EINVAL);
+
+	zassert_equal(sys_aio_cancel(efd, aio), SYS_AIO_CANCELED);
+	zassert_ok(sys_aio_release(aio, NULL, NULL));
+
+	/* stale handle */
+	zassert_equal(sys_aio_cancel(efd, aio), -EINVAL);
+}
