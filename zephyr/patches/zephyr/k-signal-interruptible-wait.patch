+
+static void interrupt_wait_entry(void *arg1, void *arg2, void *arg3)
+{
+	struct k_sig_set mask;
+	struct k_sig_action action = {
+		.handler = interrupt_handler,
+	};
+	const struct timespec ten_s = {.tv_sec = 10};
+	unsigned long token;
+
+	ARG_UNUSED(arg1);
+	ARG_UNUSED(arg2);
+	ARG_UNUSED(arg3);
+
+	zassert_ok(k_sig_emptyset(&mask));
+	zassert_ok(k_sig_addset(&mask, K_SIG_USR1));
+	zassert_ok(k_sig_mask(K_SIG_UNBLOCK, &mask, NULL));
+	zassert_ok(k_sig_action(K_SIG_USR1, &action, NULL));
+
+	/* a signal ends a sleep early, with the time left */
+	interrupt_sleep_ret = sys_clock_nanosleep(SYS_CLOCK_MONOTONIC, 0, &ten_s, &interrupt_rem);
+
+	/* and returns a pend marked interruptible -EINTR */
+	if (z_sig_pend_begin(&token)) {
+		interrupt_take_ret = k_sem_take(&interrupt_sem, K_SECONDS(10));
+		(void)z_sig_pend_end(token);
+	}
