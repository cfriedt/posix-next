@@ -0,0 +1,44 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_ZEPHYR_ZVFS_PIPE_H_
+#define ZEPHYR_INCLUDE_ZEPHYR_ZVFS_PIPE_H_
+
+#include <zephyr/kernel.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Create a unidirectional ZVFS pipe
+ *
+ * On success, @a fildes[0] refers to the read end of the pipe and @a fildes[1]
+ * refers to the write end. Data written to the write end is buffered (up to
+ * @kconfig{CONFIG_ZVFS_PIPE_BUF_SIZE} bytes) until read from the read end.
+ * Both file descriptors support read/write, poll, and fcntl-style status
+ * flags through the ZVFS layer.
+ *
+ * Writes of at most @kconfig{CONFIG_ZVFS_PIPE_BUF_SIZE} bytes are atomic.
+ * Reading from an empty pipe whose write end has been closed returns
+ * end-of-file; writing to a pipe whose read end has been closed fails with
+ * EPIPE.
+ *
+ * @param fildes Array of two ints in which the file descriptors are returned
+ * @param flags 0, or a combination of ZVFS_O_NONBLOCK and ZVFS_O_CLOEXEC to
+ *              apply to both file descriptors
+ *
+ * @return 0 on success, -1 on error with errno set
+ */
+__syscall int zvfs_pipe(int *fildes, int flags);
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <zephyr/syscalls/pipe.h>
+
+#endif /* ZEPHYR_INCLUDE_ZEPHYR_ZVFS_PIPE_H_ */
