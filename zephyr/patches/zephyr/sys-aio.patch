+
+static void submit_notify_signal(void)
+{
+	char buf[4];
+	struct k_sig_info info;
+	struct sys_aio *aio = NULL;
+	struct sys_aio_req req = {
+		.op = SYS_AIO_OP_READ,
+		.fd = file_fd,
+		.buf = buf,
+		.len = sizeof(buf),
+		.flags = SYS_AIO_REQ_OFFSET,
+	};
+	struct sys_aio_notify notify = {
+		.target = k_current_get(),
+		.signo = K_SIG_USR1,
+		.value.sival_int = 42,
+	};
+
+	sig_block(K_SIG_USR1);
+
+	zassert_ok(sys_aio_submit(&req, &notify, NULL, &aio));
+
+	zassert_equal(sig_accept(K_SIG_USR1, &info, TIMEOUT), K_SIG_USR1);
+	zassert_equal(info.code, K_SI_ASYNCIO);
+	zassert_equal(info.value.sival_int, 42);
+
+	zassert_equal(reap_ok(aio), sizeof(buf));
+}
+
+static void submit_notify_fn(union k_sig_val value)
+{
+	zassert_equal(value.sival_int, 43);
+	notify_fn_ran = true;
+}
+
+static void submit_notify_function(void)
+{
+	char buf[4];
+	struct sys_aio *aio = NULL;
+	struct sys_aio_req req = {
+		.op = SYS_AIO_OP_READ,
+		.fd = file_fd,
+		.buf = buf,
+		.len = sizeof(buf),
+		.flags = SYS_AIO_REQ_OFFSET,
+	};
+	struct sys_aio_notify notify = {
+		.fn = submit_notify_fn,
+		.value.sival_int = 43,
+	};
+
+	notify_fn_ran = false;
+
+	zassert_ok(sys_aio_submit(&req, &notify, NULL, &aio));
+
+	for (int i = 0; (i < 100) && !notify_fn_ran; i++) {
+		k_msleep(10);
+	}
+	zassert_true(notify_fn_ran, "function notification did not run");
+
+	zassert_equal(reap_ok(aio), sizeof(buf));
+}
+
+/* only exercised when the pool is small enough to exhaust (static_only) */
+#define POOL_EXHAUST_LIMIT 64
+
+static void submit_pool_exhausted(void)
+{
+	zvfs_eventfd_t value;
+	struct sys_aio *held[POOL_EXHAUST_LIMIT + 1];
+	struct sys_aio_req req = {
+		.op = SYS_AIO_OP_READ,
+		.fd = efd,
+		.buf = &value,
+		.len = sizeof(value),
+	};
+	int n = 0;
+	int ret;
+
+	for (n = 0; n <= POOL_EXHAUST_LIMIT; n++) {
+		ret = sys_aio_submit(&req, NULL, NULL, &held[n]);
+		if (ret == -EAGAIN) {
+			break;
+		}
+		zassert_ok(ret);
+	}
+	zassert_equal(ret, -EAGAIN, "pool did not exhaust: %d", ret);
+
+	zassert_equal(sys_aio_cancel(efd, NULL), SYS_AIO_CANCELED);
+	for (int i = 0; i < n; i++) {
+		zassert_ok(sys_aio_release(held[i], NULL, NULL));
+	}
+}
+
+static void submit_prioritized(void)
+{
+	char check[4] = {0};
+	int error = 0;
+	ssize_t result = 0;
+	struct sys_aio *low = NULL;
+	struct sys_aio *high = NULL;
+	struct sys_aio *cxl = NULL;
+	struct sys_aio *rd;
+	struct sys_aio_req lreq = {
+		.op = SYS_AIO_OP_WRITE,
+		.fd = file_fd,
+		.buf = "loww",
+		.len = 4,
+		.offset = 0,
+		.flags = SYS_AIO_REQ_OFFSET,
+		.prio = 1,
+	};
+	struct sys_aio_req hreq = {
+		.op = SYS_AIO_OP_WRITE,
+		.fd = file_fd,
+		.buf = "high",
+		.len = 4,
+		.offset = 0,
+		.flags = SYS_AIO_REQ_OFFSET,
+		.prio = 0,
+	};
+	struct sys_aio_req creq = {
+		.op = SYS_AIO_OP_WRITE,
+		.fd = file_fd,
+		.buf = "cncl",
+		.len = 4,
+		.offset = 0,
+		.flags = SYS_AIO_REQ_OFFSET,
+		.prio = 2,
+	};
+
+	/*
+	 * With the scheduler locked all three requests join the ready queue
+	 * before the service thread may run: the ready (not yet running)
+	 * request can be canceled, and the remaining two execute in priority
+	 * order - the lower-priority write lands last - rather than in
+	 * submission order.
+	 */
+	k_sched_lock();
+	zassert_ok(sys_aio_submit(&lreq, NULL, NULL, &low));
+	zassert_ok(sys_aio_submit(&hreq, NULL, NULL, &high));
+	zassert_ok(sys_aio_submit(&creq, NULL, NULL, &cxl));
+	zassert_equal(sys_aio_cancel(file_fd, cxl), SYS_AIO_CANCELED);
+	k_sched_unlock();
+
+	zassert_ok(sys_aio_release(cxl, &error, &result));
+	zassert_equal(error, ECANCELED);
+	zassert_equal(result, -1);
+
+	await_ok(low);
+	await_ok(high);
+	zassert_equal(reap_ok(low), 4);
+	zassert_equal(reap_ok(high), 4);
+
+	rd = submit_ok(SYS_AIO_OP_READ, file_fd, check, sizeof(check), 0, SYS_AIO_REQ_OFFSET);
+	await_ok(rd);
+	zassert_equal(reap_ok(rd), 4);
+	zassert_mem_equal(check, "loww", 4);
+}
+
+ZTEST_USER(sys_aio, test_sys_aio_submit)
+{
+	submit_file_read();
+	submit_file_write();
+	submit_file_fsync();
+	submit_eventfd_read();
+	submit_errors();
+	if (IS_ENABLED(CONFIG_SYS_AIO_PRIORITY) && !IS_ENABLED(CONFIG_SMP) &&
+	    !k_is_user_context()) {
+		submit_prioritized();
+	}
+	if (IS_ENABLED(CONFIG_SIGNAL)) {
+		submit_notify_signal();
+	}
+	if (IS_ENABLED(CONFIG_SIGNAL) && IS_ENABLED(CONFIG_SYS_THREAD) &&
+	    IS_ENABLED(CONFIG_THREAD_DETACH)) {
+		submit_notify_function();
+	}
+	if (CONFIG_SYS_AIO_MAX <= POOL_EXHAUST_LIMIT) {
+		/* static_only variant: the pool is small enough to exhaust */
+		submit_pool_exhausted();
+	}
+}
+
