+int z_impl_k_msgq_get_prio(struct k_msgq *msgq, void *data, size_t size, uint32_t *prio,
+			   k_timeout_t timeout)
+{
+	__ASSERT(!arch_is_in_isr() || K_TIMEOUT_EQ(timeout, K_NO_WAIT), "");
+
+	struct z_msgq_prio_slot *slot;
+	struct k_thread *pending_thread;
+	k_timepoint_t end;
+	k_spinlock_key_t key;
+	bool resched = false;
+	bool waited = false;
+	int result;
+
+	if (!msgq_is_prio(msgq)) {
+		return -ENOTSUP;
+	}
+
+	if (size < msgq->msg_size) {
+		return -EMSGSIZE;
+	}
+
+	end = sys_timepoint_calc(timeout);
+	key = k_spin_lock(&msgq->lock);
+
+	SYS_PORT_TRACING_OBJ_FUNC_ENTER(k_msgq, get, msgq, timeout);
+
+	while (msgq->used_msgs == 0U) {
+		if (K_TIMEOUT_EQ(timeout, K_NO_WAIT)) {
+			/* first pass: don't wait; later passes: deadline expired */
+			result = waited ? -EAGAIN : -ENOMSG;
+			SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_msgq, get, msgq, timeout, result);
+			k_spin_unlock(&msgq->lock, key);
+			return result;
+		}
+
+		SYS_PORT_TRACING_OBJ_FUNC_BLOCKING(k_msgq, get, msgq, timeout);
+
+		/* woken with 0 to retry when a message may be available */
+		result = z_pend_curr(&msgq->lock, key, &msgq->wait_q, timeout);
+		if (result != 0) {
+			SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_msgq, get, msgq, timeout, result);
+			return result;
+		}
+
+		waited = true;
+		timeout = sys_timepoint_timeout(end);
+		key = k_spin_lock(&msgq->lock);
+	}
+
+	slot = prio_slot_of(sys_slist_get_not_empty(&msgq->used_q));
+	(void)memcpy(data, (void *)&slot[1], slot->len);
+	if (prio != NULL) {
+		*prio = slot->prio;
+	}
+	result = (int)slot->len;
+	sys_slist_prepend(&prio_hdr(msgq)->free_q, &slot->node);
+	msgq->used_msgs--;
+
+	/* wake up one thread waiting to write */
+	pending_thread = z_unpend_first_thread(&prio_hdr(msgq)->send_q);
+	if (pending_thread != NULL) {
+		arch_thread_return_value_set(pending_thread, 0);
+		z_ready_thread(pending_thread);
+		resched = true;
+	}
+
+	SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_msgq, get, msgq, timeout, result);
+
+	if (resched) {
+		z_reschedule(&msgq->lock, key);
+	} else {
+		k_spin_unlock(&msgq->lock, key);
+	}
+
+	return result;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_k_msgq_get_prio(struct k_msgq *msgq, void *data, size_t size,
+					 uint32_t *prio, k_timeout_t timeout)
+{
+	K_OOPS(K_SYSCALL_OBJ(msgq, K_OBJ_MSGQ));
+
+	if (size < msgq->msg_size) {
+		return -EMSGSIZE;
+	}
+	K_OOPS(K_SYSCALL_MEMORY_WRITE(data, msgq->msg_size));
+	if (prio != NULL) {
+		K_OOPS(K_SYSCALL_MEMORY_WRITE(prio, sizeof(uint32_t)));
+	}
+
+	return z_impl_k_msgq_get_prio(msgq, data, size, prio, timeout);
+}
+#include <zephyr/syscalls/k_msgq_get_prio_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+static void msgq_purge_prio(struct k_msgq *msgq)
+{
+	struct z_msgq_prio_hdr *hdr = prio_hdr(msgq);
+	struct k_thread *pending_thread;
+	k_spinlock_key_t key;
+	sys_snode_t *node;
+	bool resched = false;
+
+	key = k_spin_lock(&msgq->lock);
+
+	SYS_PORT_TRACING_OBJ_FUNC(k_msgq, purge, msgq);
+
+	/* wake up any threads that are waiting to write */
+	for (pending_thread = z_unpend_first_thread(&hdr->send_q);
+	     pending_thread != NULL;
+	     pending_thread = z_unpend_first_thread(&hdr->send_q)) {
+		arch_thread_return_value_set(pending_thread, -ENOMSG);
+		z_ready_thread(pending_thread);
+		resched = true;
+	}
+
+	while ((node = sys_slist_get(&msgq->used_q)) != NULL) {
+		sys_slist_prepend(&hdr->free_q, node);
+	}
+	msgq->used_msgs = 0;
+
+	if (resched) {
+		z_reschedule(&msgq->lock, key);
+	} else {
+		k_spin_unlock(&msgq->lock, key);
+	}
+}
+#endif /* CONFIG_MSGQ_PRIO */
+
 void z_impl_k_msgq_purge(struct k_msgq *msgq)
 {
 	k_spinlock_key_t key;
 	struct k_thread *pending_thread;
 	bool resched = false;
 
+#ifdef CONFIG_MSGQ_PRIO
+	if (msgq_is_prio(msgq)) {
+		msgq_purge_prio(msgq);
+		return;
+	}
+#endif /* CONFIG_MSGQ_PRIO */
+
 	key = k_spin_lock(&msgq->lock);
 
 	SYS_PORT_TRACING_OBJ_FUNC(k_msgq, purge, msgq);
