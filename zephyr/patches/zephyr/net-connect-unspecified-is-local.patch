+static void test_connect_unspecified_common(int family)
+{
+	/* The unspecified address names the local host, as on Linux. */
+	int c_sock;
+	int s_sock;
+	int new_sock;
+	struct net_sockaddr_in c_saddr;
+	struct net_sockaddr_in s_saddr;
+	struct net_sockaddr_in6 c_saddr6;
+	struct net_sockaddr_in6 s_saddr6;
+	struct net_sockaddr_storage any_saddr;
+	struct net_sockaddr *s_addr;
+	net_socklen_t s_addrlen;
+	struct net_sockaddr addr;
+	net_socklen_t addrlen = sizeof(addr);
+
+	if (family == NET_AF_INET) {
+		prepare_sock_tcp_v4(MY_IPV4_ADDR, ANY_PORT, &c_sock, &c_saddr);
+		prepare_sock_tcp_v4(MY_IPV4_ADDR, SERVER_PORT, &s_sock, &s_saddr);
+		s_addr = (struct net_sockaddr *)&s_saddr;
+		s_addrlen = sizeof(s_saddr);
+	} else {
+		prepare_sock_tcp_v6(MY_IPV6_ADDR, ANY_PORT, &c_sock, &c_saddr6);
+		prepare_sock_tcp_v6(MY_IPV6_ADDR, SERVER_PORT, &s_sock, &s_saddr6);
+		s_addr = (struct net_sockaddr *)&s_saddr6;
+		s_addrlen = sizeof(s_saddr6);
+	}
+
+	/* the server's address with the host part left unspecified */
+	memset(&any_saddr, 0, sizeof(any_saddr));
+	memcpy(&any_saddr, s_addr, s_addrlen);
+	if (family == NET_AF_INET) {
+		net_sin((struct net_sockaddr *)&any_saddr)->sin_addr.s_addr = 0;
+	} else {
+		net_ipaddr_copy(&net_sin6((struct net_sockaddr *)&any_saddr)->sin6_addr,
+				&net_in6addr_any);
+	}
+
+	test_bind(s_sock, s_addr, s_addrlen);
+	test_listen(s_sock);
+
+	test_connect(c_sock, (struct net_sockaddr *)&any_saddr, s_addrlen);
+	test_accept(s_sock, &new_sock, &addr, &addrlen);
+
+	test_close(c_sock);
+	test_eof(new_sock);
+
+	test_close(new_sock);
+	test_close(s_sock);
+
+	k_sleep(TCP_TEARDOWN_TIMEOUT);
+}
+
+ZTEST_USER(net_socket_tcp, test_v4_connect_unspecified)
+{
+	test_connect_unspecified_common(NET_AF_INET);
+}
+
+ZTEST_USER(net_socket_tcp, test_v6_connect_unspecified)
+{
+	test_connect_unspecified_common(NET_AF_INET6);
+}
