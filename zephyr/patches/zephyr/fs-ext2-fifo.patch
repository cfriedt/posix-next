+int fs_mkfifo(const char *abs_path)
+{
+	struct fs_mount_t *mp;
+	int rc = -EINVAL;
+	size_t mp_len;
+
+	if ((abs_path == NULL) || (abs_path[0] != '/') || (abs_path[1] == '\0')) {
+		LOG_ERR("invalid file or dir name!!");
+		return -EINVAL;
+	}
+
+	rc = fs_get_mnt_point(&mp, abs_path, &mp_len);
+	if (rc < 0) {
+		LOG_ERR("mount point not found!!");
+		return rc;
+	}
+
+	if (mp->flags & FS_MOUNT_FLAG_READ_ONLY) {
+		return -EROFS;
+	}
+
+	CHECKIF(mp->fs->mkfifo == NULL) {
+		return -ENOTSUP;
+	}
+
+	rc = mp->fs->mkfifo(mp, abs_path);
+	if (rc < 0) {
+		LOG_ERR("failed to create fifo (%d)", rc);
+	}
+	return rc;
+}
