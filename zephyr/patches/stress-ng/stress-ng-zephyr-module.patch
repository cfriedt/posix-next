diff --git a/zephyr/include/stress_ng.h b/zephyr/include/stress_ng.h
new file mode 100644
--- /dev/null
+++ b/zephyr/include/stress_ng.h
@@ -0,0 +1,64 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ */
+
+#ifndef STRESS_NG_ZEPHYR_STRESS_NG_H_
+#define STRESS_NG_ZEPHYR_STRESS_NG_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Exit statuses of stress_ng_run(), as the stress-ng driver reports them */
+enum stress_ng_exit {
+	STRESS_NG_EXIT_SUCCESS = 0,
+	STRESS_NG_EXIT_FAILURE = 1,
+	STRESS_NG_EXIT_NOT_SUCCESS = 2,
+	STRESS_NG_EXIT_NO_RESOURCE = 3,
+	STRESS_NG_EXIT_NOT_IMPLEMENTED = 4,
+	STRESS_NG_EXIT_SIGNALED = 5,
+	STRESS_NG_EXIT_BY_SYS_EXIT = 6,
+	STRESS_NG_EXIT_METRICS_UNTRUSTWORTHY = 7,
+};
+
+struct stress_ng_opts {
+	/** run time in seconds, 0 for CONFIG_STRESS_NG_DEFAULT_TIMEOUT */
+	uint32_t timeout_s;
+	/** stop after this many bogo operations, 0 for no limit */
+	uint64_t max_ops;
+};
+
+/**
+ * Run one instance of a stressor in the calling thread
+ *
+ * @param name stressor name as the command line driver spells it, e.g. "nanosleep"
+ * @param opts run options, or NULL for the defaults
+ * @return an @ref stress_ng_exit status
+ */
+int stress_ng_run(const char *name, const struct stress_ng_opts *opts);
+
+/**
+ * Release the runner after a thread stuck in stress_ng_run() was aborted
+ *
+ * For test harnesses that run stressors in a thread with a watchdog.
+ */
+void stress_ng_reset(void);
+
+/** Describe an @ref stress_ng_exit status */
+const char *stress_ng_strexit(int status);
+
+/** Number of stressors built in */
+size_t stress_ng_stressor_count(void);
+
+/** Name of the i-th stressor built in, or NULL */
+const char *stress_ng_stressor_name(size_t i);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* STRESS_NG_ZEPHYR_STRESS_NG_H_ */
