diff --git a/lib/libc/newlib/include/stdio.h b/lib/libc/newlib/include/stdio.h
--- a/lib/libc/newlib/include/stdio.h
+++ b/lib/libc/newlib/include/stdio.h
@@ -17,6 +17,10 @@ extern "C" {
 
 /* the toolchain's stdio.h declares neither ctermid() nor renameat() */
 char *ctermid(char *s);
+
+/* the shell and utilities functions, which the toolchain library lacks entirely */
+FILE *popen(const char *command, const char *mode);
+int pclose(FILE *stream);
 int renameat(int olddirfd, const char *oldpath, int newdirfd, const char *newpath);
 
 #ifdef __cplusplus
