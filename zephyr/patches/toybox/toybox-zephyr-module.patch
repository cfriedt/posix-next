diff --git a/zephyr/configure.sh b/zephyr/configure.sh
new file mode 100755
index 00000000..e10b338c
--- /dev/null
+++ b/zephyr/configure.sh
@@ -0,0 +1,49 @@
+#!/bin/sh
+# SPDX-License-Identifier: 0BSD
+# Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+#
+# Configure toybox out of tree and generate its derived headers:
+# allnoconfig seeded with zephyr/toybox.frag, then scripts/make.sh with
+# NOBUILD=1 (headers and build.sh only, no compile).
+# Usage: configure.sh <toybox-srcdir> <builddir>
+
+set -eu
+
+src="$1"
+build="$2"
+
+# toybox's scripts generate into ./generated of the tree they run in, so run
+# them in a mirror of the source tree made of symlinks: the source tree stays
+# untouched and the generated headers land in <builddir>/src/generated
+mirror="$build/src"
+rm -rf "$mirror"
+mkdir -p "$mirror"
+for f in Config.in configure kconfig lib main.c Makefile scripts toys toys.h; do
+	ln -s "$src/$f" "$mirror/$f"
+done
+cd "$mirror"
+
+export KCONFIG_CONFIG="$build/.config"
+export CC="${HOSTCC:-cc}" HOSTCC="${HOSTCC:-cc}"
+unset CROSS_COMPILE CFLAGS LDFLAGS OPTIMIZE GENDIR UNSTRIPPED
+
+KCONFIG_ALLCONFIG="$src/zephyr/toybox.frag" scripts/genconfig.sh -n \
+	>"$build/configure.log" 2>&1
+
+# every fragment symbol must have survived dependency resolution
+while IFS= read -r line; do
+	case "$line" in
+	CONFIG_*=* | '# CONFIG_'*' is not set') ;;
+	*) continue ;;
+	esac
+	if ! grep -q -F -x "$line" "$KCONFIG_CONFIG"; then
+		echo "toybox configure: '$line' lost after allnoconfig" >&2
+		exit 1
+	fi
+done <"$src/zephyr/toybox.frag"
+
+NOBUILD=1 scripts/make.sh >>"$build/configure.log" 2>&1
+
+# the sources this configuration compiles, one per line
+sed -n '/^FILES="/,/^"/p' "$mirror/generated/build.sh" | sed -e 's/^FILES="//' -e '/^"$/d' |
+	tr ' ' '\n' | sed '/^$/d' >"$build/sources.txt"
