+/*
+ * In the test process, accepting and handling K_SIG_CHLD: reports every state
+ * change of its child. The handled signal does not hide the state change that
+ * generated it from the wait.
+ */
+static void waiter_entry(void *p1, void *p2, void *p3)
+{
+	struct k_sig_action act = {.handler = waiter_chld_handler, .flags = K_SIG_SA_SIGINFO};
+	struct k_sig_action old;
+	struct k_sig_set set;
+	int ws = 0;
+	int ret;
+
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	(void)k_sig_action(K_SIG_CHLD, &act, &old);
+	k_sig_emptyset(&set);
+	k_sig_addset(&set, K_SIG_CHLD);
+	(void)k_sig_mask(K_SIG_UNBLOCK, &set, NULL);
+	k_sem_give(&waiter_ready);
+	for (;;) {
+		ret = k_waitpid((k_pid_t)p1, NULL, &ws, K_PROCESS_WUNTRACED | K_PROCESS_WCONTINUED,
+				K_SECONDS(5));
+		if (ret == -EINTR) {
+			continue;
+		}
+		if (ret != 0) {
+			break;
+		}
+		(void)k_sig_timedwait(&set, NULL, K_NO_WAIT);
+		if (waiter_n < (int)ARRAY_SIZE(waiter_history)) {
+			waiter_history[waiter_n] = ws;
+		}
+		waiter_n++;
+		k_sem_give(&waiter_event);
+		if (K_WIFEXITED(ws) || K_WIFSIGNALED(ws)) {
+			break;
+		}
