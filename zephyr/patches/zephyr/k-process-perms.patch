 		if (ko->perms[i] != 0U) {
 			goto out;
 		}
@@ -792,12 +839,17 @@ static void clear_perms_sched_locked_cb(struct k_object *ko, void *ctx_ptr)
 
 void k_thread_perms_all_clear(struct k_thread *thread)
 {
+#ifdef CONFIG_PROCESS
+	/* permissions belong to the process and are swept at reap */
+	ARG_UNUSED(thread);
+#else
 	uintptr_t index = thread_index_get(thread);
 
 	if ((int)index != -1) {
 		k_object_wordlist_foreach(clear_perms_sched_locked_cb,
 					 (void *)index);
 	}
+#endif /* CONFIG_PROCESS */
 }
 
