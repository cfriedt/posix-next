# When thread stacks cannot come from anonymously mapped pages (k_mem_map()),
# dynamic user thread stacks are carved out of the kernel heap: power-of-two
# MPU/PMP alignment plus a privileged stack inflate each allocation to several
# times the nominal stack size (~10 KiB per 2 KiB stack on 64-bit).
config HEAP_MEM_POOL_ADD_SIZE_TESTS_POSIX_THREAD_STACKS
	int
	default 32768 if USERSPACE && !SYS_THREAD_STACK_ALLOC_ANON && 64BIT
	default 16384 if USERSPACE && !SYS_THREAD_STACK_ALLOC_ANON
	default 0

config SYS_THREAD_CONDVAR_MIN_ADD_TEST
	int "Number of condition variables guaranteed to be available for POSIX tests"
	default 0
	help
	  This option is mainly intended to allow us to verify that the specified minimum number
	  of condition variables are in fact statically allocated and available to the application.
	  CMake (rather than Kconfig) outputs the guaranteed minimum value as SYS_THREAD_CONDVAR_MIN
	  (rather than CONFIG_SYS_THREAD_CONDVAR_MIN) for technical reasons.

config SYS_THREAD_MUTEX_MIN_ADD_TEST
	int "Number of mutexes guaranteed to be available for POSIX tests"
	default 0
	help
	  This option is mainly intended to allow us to verify that the specified minimum number
	  of mutexes are in fact statically allocated and available to the application.
	  CMake (rather than Kconfig) outputs the guaranteed minimum value as SYS_THREAD_MUTEX_MIN
	  (rather than CONFIG_SYS_THREAD_MUTEX_MIN) for technical reasons.

config SYS_TIMER_MIN_ADD_TEST
	int "Number of system timers guaranteed to be available for POSIX tests"
	default 0
	help
	  This option is mainly intended to allow us to verify that the specified minimum number
	  of timers are in fact statically allocated and available to the application.
	  CMake (rather than Kconfig) outputs the guaranteed minimum value as SYS_TIMER_MIN
	  (rather than CONFIG_SYS_TIMER_MIN) for technical reasons.

config SYS_MSGQ_MIN_ADD_TEST
	int "Number of system message queues guaranteed to be available for POSIX tests"
	default 0
	help
	  This option is mainly intended to allow us to verify that the specified minimum number
	  of message queues are in fact statically allocated and available to the application.
	  CMake (rather than Kconfig) outputs the guaranteed minimum value as SYS_MSGQ_MIN
	  (rather than CONFIG_SYS_MSGQ_MIN) for technical reasons.

config SYS_AIO_MIN_ADD_TEST
	int "Number of asynchronous I/O requests guaranteed to be available for POSIX tests"
	default 0
	help
	  This option is mainly intended to allow us to verify that the specified minimum number
	  of asynchronous I/O requests are in fact statically allocated and available to the
	  application. CMake (rather than Kconfig) outputs the guaranteed minimum value as
	  SYS_AIO_MIN (rather than CONFIG_SYS_AIO_MIN) for technical reasons.

config SYS_THREAD_STACK_MIN_ADD_TEST
	int "Number of thread stacks guaranteed to be available for POSIX tests"
	default 0
	help
	  This option is mainly intended to allow us to verify that the specified minimum number
	  of stacks are in fact statically allocated and available to the application.
	  CMake (rather than Kconfig) outputs the guaranteed minimum value as SYS_THREAD_STACK_MIN
	  (rather than CONFIG_SYS_THREAD_STACK_MIN) for technical reasons.

config SYS_THREAD_THREAD_MIN_ADD_TEST
	int "Number of threads guaranteed to be available for POSIX tests"
	default 0
	help
	  This option is mainly intended to allow us to verify that the specified minimum number
	  of threads are in fact statically allocated and available to the application.
	  CMake (rather than Kconfig) outputs the guaranteed minimum value as SYS_THREAD_THREAD_MIN
	  (rather than CONFIG_SYS_THREAD_THREAD_MIN) for technical reasons.

