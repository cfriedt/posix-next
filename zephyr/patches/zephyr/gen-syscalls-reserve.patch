@@ -572,6 +572,51 @@ def analyze_fn(match_group, fn, userspace_only):
     return (handler, invocation, marshaller, sys_id, table_entry)
 
 
+def read_reservations(paths):
+    """Return {K_SYSCALL_<NAME>: id} from '<name> <id>' files ('#' starts a comment)."""
+    reserved = {}
+    by_id = {}
+
+    for path in paths or []:
+        with open(path) as fp:
+            for lineno, line in enumerate(fp, 1):
+                line = line.split("#", 1)[0].strip()
+                if not line:
+                    continue
+                fields = line.split()
+                if len(fields) != 2:
+                    sys.exit(f"{path}:{lineno}: expected '<name> <id>'")
+                name = "K_SYSCALL_" + fields[0].upper()
+                sys_id = int(fields[1], 0)
+                if by_id.get(sys_id, name) != name or reserved.get(name, sys_id) != sys_id:
+                    sys.exit(f"{path}:{lineno}: conflicting reservation for {fields[0]}")
+                reserved[name] = sys_id
+                by_id[sys_id] = name
+
+    return reserved
+
+
+def assign_ids(names, reserved):
+    """Give each emitted system call an ID: reserved ones as pinned, the rest packed
+    in order into the IDs left over. Returns ({name: id}, K_SYSCALL_BAD).
+    """
+    pinned = {name: reserved[name] for name in names if name in reserved}
+    taken = set(pinned.values())
+    ids = {}
+    next_free = 0
+
+    for name in names:
+        if name in pinned:
+            ids[name] = pinned[name]
+            continue
+        while next_free in taken:
+            next_free += 1
+        ids[name] = next_free
+        next_free += 1
+
+    return ids, (max(ids.values(), default=-1) + 1)
+
