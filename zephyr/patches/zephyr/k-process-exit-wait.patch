+static void proc_entry_exit_code(void *p1, void *p2, void *p3)
+{
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	static_exits_self = k_getpid();
+	static_exits_parent = k_getppid();
+	k_sem_give(&static_exits_ran);
+
+	k_exit(EXIT_CODE);
+}
