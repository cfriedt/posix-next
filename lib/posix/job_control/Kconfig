config POSIX_JOB_CONTROL
	bool "POSIX job control"
	depends on POSIX_MULTI_PROCESS && POSIX_SIGNALS
	select PROCESS_STOP
	help
	  Select 'y' here and Zephyr will provide implementations of the
	  POSIX_JOB_CONTROL Option Group: tcgetpgrp(), tcsetpgrp(), and
	  tcgetsid() over the console terminal, together with the kernel's
	  stop and continue semantics: the stop signals suspend a process,
	  SIGCONT resumes it, and waitpid() reports the transitions via
	  WUNTRACED and WCONTINUED.
