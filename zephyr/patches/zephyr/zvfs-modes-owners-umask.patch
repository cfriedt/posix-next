+ZTEST_USER(zvfs_fs, test_zvfs_chownat)
+{
+	struct zvfs_stat st;
+
+	zassert_ok(zvfs_close(attr_create(AFILE, 0666)));
+	zassert_ok(zvfs_stat(AFILE, &st));
+	zassert_equal(st.uid, 0);
+	zassert_equal(st.gid, 0);
+
+	zassert_ok(zvfs_chown(AFILE, 1000, 100));
+	zassert_ok(zvfs_stat(AFILE, &st));
+	zassert_equal(st.uid, 1000);
+	zassert_equal(st.gid, 100);
+	/* UINT32_MAX keeps an ID */
+	zassert_ok(zvfs_chownat(ZVFS_AT_FDCWD, AFILE, UINT32_MAX, 5, 0));
+	zassert_ok(zvfs_stat(AFILE, &st));
+	zassert_equal(st.uid, 1000);
+	zassert_equal(st.gid, 5);
+
+	/* through a link the target; with the flag the link itself */
+	zassert_ok(zvfs_symlink("a.txt", ALINK));
+	zassert_ok(zvfs_chownat(ZVFS_AT_FDCWD, ALINK, 7, UINT32_MAX, 0));
+	zassert_ok(zvfs_stat(AFILE, &st));
+	zassert_equal(st.uid, 7);
+	zassert_equal(st.gid, 5);
+	zassert_ok(zvfs_chownat(ZVFS_AT_FDCWD, ALINK, 8, 9, ZVFS_AT_SYMLINK_NOFOLLOW));
+	zassert_ok(zvfs_lstat(ALINK, &st));
+	zassert_equal(st.uid, 8);
+	zassert_equal(st.gid, 9);
+	zassert_ok(zvfs_stat(AFILE, &st));
+	zassert_equal(st.uid, 7, "the target kept its owner");
