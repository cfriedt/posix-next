config XSI_SIGNALS
	bool "X/Open signals"
	depends on XSI
	select SIGNAL
	help
	  Select 'y' here to enable the XSI Signals option group.

	  When this option is enabled, the following functions are available:
	  killpg(), sigaltstack(), sighold(), sigignore(), siginterrupt(),
	  sigpause(), sigrelse(), sigset().

	  sigaltstack() names a stack for user threads only, and only where the
	  kernel supports alternate signal stacks (CONFIG_SIGNAL_ALTSTACK);
	  otherwise it fails with ENOTSUP.

	  For more information, please see
	  https://pubs.opengroup.org/onlinepubs/9699919799/xrat/V4_subprofiles.html

if XSI_SIGNALS

config SIGNAL_SET_SIZE_MIN_XSI_SIGNALS
	def_int 32
	help
	  The number of signals the XSI signals option group names.

config SIGNAL_QUEUE_SIZE_ADD_XSI_SIGNALS
	def_int 4
	help
	  Number of signal queue entries for the signals killpg() generates.

config SIGNAL_ACTION_DB_SIZE_MIN_XSI_SIGNALS
	def_int 8
	depends on !PROCESS
	help
	  Number of signal action database entries, so that sigset() and sigignore() can
	  install dispositions without SIGNAL_ACTION_DB_SIZE having to be configured by hand.

endif # XSI_SIGNALS
