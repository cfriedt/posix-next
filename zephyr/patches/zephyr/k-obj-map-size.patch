+#define DYN_OBJ_DATA_ALIGN_K_THREAD_STACK Z_THREAD_STACK_OBJ_ALIGN(CONFIG_SYS_THREAD_STACK_SIZE)
 #else
 #define DYN_OBJ_DATA_ALIGN_K_THREAD_STACK \
