+/*
+ * A storm of stops and continues from another CPU lands stops on a child that is in the
+ * middle of taking one; a full queue is fine, the storm only has to keep going.
+ */
+static void kill_stop_storm(void)
+{
+	int ws = 0;
+	int ret;
+	k_pid_t child = &child_a;
+	struct sys_clone_args args = {
+		.entry = stop_child_entry,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
+	};
+
+	stop_child_release = false;
+	zassert_ok(sys_clone(&args, NULL));
+	for (int i = 0; i < 10000; i++) {
+		ret = k_kill(child, K_SIG_STOP);
+		zassert_true((ret == 0) || (ret == -EAGAIN), "STOP: %d", ret);
+		ret = k_kill(child, K_SIG_CONT);
+		zassert_true((ret == 0) || (ret == -EAGAIN), "CONT: %d", ret);
+	}
+	/* the storm's SIGCHLDs may still fill the queue: a continue does not need a slot */
+	ret = k_kill(child, K_SIG_CONT);
+	zassert_true((ret == 0) || (ret == -EAGAIN), "the last CONT: %d", ret);
+	stop_child_release = true;
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_SECONDS(5)));
+	zassert_true(K_WIFEXITED(ws), "0x%x", ws);
+}
