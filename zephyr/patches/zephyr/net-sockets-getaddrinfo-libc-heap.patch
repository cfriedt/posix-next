diff --git a/subsys/net/lib/sockets/getaddrinfo.c b/subsys/net/lib/sockets/getaddrinfo.c
index 2ace7f95fab..c5a3fa238d9 100644
--- a/subsys/net/lib/sockets/getaddrinfo.c
+++ b/subsys/net/lib/sockets/getaddrinfo.c
@@ -452,7 +452,8 @@ int zsock_getaddrinfo(const char *host, const char *service,
 	int ret = DNS_EAI_FAIL;
 
 #if defined(ANY_RESOLVER)
-	*res = k_calloc(AI_ARR_MAX, sizeof(struct zsock_addrinfo));
+	/* the caller's list, from the caller's heap */
+	*res = calloc(AI_ARR_MAX, sizeof(struct zsock_addrinfo));
 	if (!(*res)) {
 		return DNS_EAI_MEMORY;
 	}
@@ -473,7 +474,7 @@ int zsock_getaddrinfo(const char *host, const char *service,
 
 #if defined(ANY_RESOLVER)
 	if (ret) {
-		k_free(*res);
+		free(*res);
 		*res = NULL;
 	}
 #endif
@@ -488,7 +489,7 @@ void zsock_freeaddrinfo(struct zsock_addrinfo *ai)
 		return;
 	}
 
-	k_free(ai);
+	free(ai);
 }
 
 #define ERR(e) case DNS_ ## e: return #e
