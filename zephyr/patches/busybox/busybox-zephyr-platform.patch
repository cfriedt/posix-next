+#if defined(__ZEPHYR__)
+/* Zephyr has posix_spawn() but no fork(): run external pipe members by
+ * spawning them, with the pipe and redirect wiring expressed as file
+ * actions. Returns the pid, 0 when the member is not a plain external
+ * command (the caller falls back to fork() and its error message), or -1
+ * after reporting a spawn failure. */
+static pid_t zephyr_spawn_pipe_member(struct command *command, char **argv_expanded,
+		int infd, struct fd_pair *outpipe)
+{
+	char path[64];
+	char **argv = argv_expanded ? argv_expanded : command->argv;
+	posix_spawn_file_actions_t fa;
+	struct redir_struct *redir;
+	pid_t pid;
+	int ret;
+
+	if (!argv || !argv[0] || command->group)
+		return 0;
+	if (command->cmd_type != CMD_NORMAL)
+		return 0;
+	if (find_builtin(argv[0]))
+		return 0;
+# if ENABLE_HUSH_FUNCTIONS
+	if (find_function(argv[0]))
+		return 0;
+# endif
+
+	if (strchr(argv[0], '/')) {
+		safe_strncpy(path, argv[0], sizeof(path));
+	} else if (sprintf(path, "/bin/%.*s", (int)sizeof(path) - 8, argv[0]) < 0) {
+		return 0;
+	}
+
+	posix_spawn_file_actions_init(&fa);
+	if (infd > 0)
+		posix_spawn_file_actions_adddup2(&fa, infd, 0);
+	if (outpipe) {
+		posix_spawn_file_actions_adddup2(&fa, outpipe->wr, 1);
+		posix_spawn_file_actions_addclose(&fa, outpipe->rd);
+		posix_spawn_file_actions_addclose(&fa, outpipe->wr);
+	}
+	if (infd > 0)
+		posix_spawn_file_actions_addclose(&fa, infd);
+
+	for (redir = command->redirects; redir; redir = redir->next) {
+		if (redir->rd_type == REDIRECT_HEREDOC
+		 || redir->rd_type == REDIRECT_HEREDOC2
+		 || redir->rd_type == REDIRECT_HERESTRING
+		) {
+			bb_simple_error_msg("heredocs need fork support");
+			goto err;
+		}
+		if (redir->rd_dup == REDIRFD_CLOSE) {
+			posix_spawn_file_actions_addclose(&fa, redir->rd_fd);
+			continue;
+		}
+		if (redir->rd_dup != REDIRFD_TO_FILE) {
+			posix_spawn_file_actions_adddup2(&fa, redir->rd_dup, redir->rd_fd);
+			continue;
+		}
+		if (redir->rd_filename == NULL) {
+			syntax_error("invalid redirect");
+			goto err;
+		}
+		{
+			char *p = expand_string_to_string(redir->rd_filename,
+					EXP_FLAG_GLOBPROTECT_CHARS, /*unbackslash:*/ 1);
+			ret = posix_spawn_file_actions_addopen(&fa, redir->rd_fd, p,
+					redir_table[redir->rd_type].mode, 0666);
+			free(p);
+			if (ret != 0)
+				goto err;
+		}
+	}
+
+	ret = posix_spawn(&pid, path, &fa, NULL, argv, environ);
+	posix_spawn_file_actions_destroy(&fa);
+	if (ret != 0) {
+		errno = ret;
+		bb_perror_msg("can't execute '%s'", argv[0]);
+		return -1;
+	}
+	return pid;
+ err:
+	posix_spawn_file_actions_destroy(&fa);
+	return -1;
+}
+#endif /* __ZEPHYR__ */
