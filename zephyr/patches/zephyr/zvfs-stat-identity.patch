+/* the same file behind two objects: the same device and serial number */
+static bool mapping_same_file(const struct zvfs_mapping *a, const struct zvfs_mapping *b)
+{
+	struct zvfs_stat sa, sb;
+
+	if (a->obj == b->obj) {
+		return true;
+	}
+	if ((a->obj == NULL) || (b->obj == NULL) ||
