+int z_impl_k_kill_all(int signo)
+{
+	int ret = -ESRCH;
+	struct k_process *proc;
+	struct k_process *self;
+	k_spinlock_key_t key = k_spin_lock(&process_lock);
+
+	self = process_self();
+
+	/*
+	 * Broadcast: every registered process except the reserved system
+	 * records and the caller's own process, resolved and queued under the
+	 * lock exactly as k_kill_pgrp() treats group members.
+	 */
+	SYS_DLIST_FOR_EACH_CONTAINER(&process_active, proc, active_node) {
+		int err;
+		k_tid_t tgt;
+
+		if (process_is_reserved(proc) || (proc == self) ||
+		    (proc->state == K_PROCESS_UNUSED) ||
+		    sys_dlist_is_empty(&proc->threads)) {
+			continue;
+		}
+		if (signo == 0) {
+			/* existence check only */
+			ret = 0;
+			continue;
+		}
+#ifdef CONFIG_SIGNAL
+		tgt = process_sig_target(proc, signo);
+		/* NULL target: every member masked, pend at process scope */
+		err = (tgt == NULL) ? z_sig_queue_process(proc, signo, (union k_sig_val){0})
+				    : z_sig_queue_thread(tgt, signo, (union k_sig_val){0});
+		if (err == -EINVAL) {
+			k_spin_unlock(&process_lock, key);
+			return -EINVAL;
+		}
+		if (err == 0) {
+			ret = 0;
+		}
+#else
+		ARG_UNUSED(err);
+		ARG_UNUSED(tgt);
+		ret = -ENOTSUP;
+#endif /* CONFIG_SIGNAL */
+	}
+	k_spin_unlock(&process_lock, key);
+
+	return ret;
+}
+
+#ifdef CONFIG_USERSPACE
