+static volatile bool stop_child_release;
+
+/* a kernel thread that accepts the job-control signals: a delivery point every millisecond */
+static void stop_child_entry(void *p1, void *p2, void *p3)
+{
+	struct k_sig_set set;
+	int64_t deadline = k_uptime_get() + 5000;
+
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	k_sig_emptyset(&set);
+	k_sig_addset(&set, K_SIG_STOP);
+	k_sig_addset(&set, K_SIG_CONT);
+	(void)k_sig_mask(K_SIG_UNBLOCK, &set, NULL);
+
+	while (!stop_child_release && (k_uptime_get() < deadline)) {
+		k_msleep(1);
+	}
+	k_exit(0);
+}
+
+/* a stop and a continue, each reported once to the waiter asking for it */
+static void kill_stop_continue(void)
+{
+	int ws = 0;
+	k_pid_t child = &child_a;
+	struct sys_clone_args args = {
+		.entry = stop_child_entry,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
+	};
+
+	stop_child_release = false;
+	zassert_ok(sys_clone(&args, NULL));
+	zassert_ok(k_kill(child, K_SIG_STOP));
+	zassert_ok(k_waitpid(child, NULL, &ws, K_PROCESS_WUNTRACED, K_SECONDS(5)));
+	zassert_true(K_WIFSTOPPED(ws), "not stopped (0x%x)", ws);
+	zassert_equal(K_WSTOPSIG(ws), K_SIG_STOP);
+	zassert_ok(k_kill(child, K_SIG_CONT));
+	zassert_ok(k_waitpid(child, NULL, &ws, K_PROCESS_WCONTINUED, K_SECONDS(5)));
+	zassert_true(K_WIFCONTINUED(ws), "not continued (0x%x)", ws);
+	stop_child_release = true;
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_SECONDS(5)));
+	zassert_true(K_WIFEXITED(ws) && (K_WEXITSTATUS(ws) == 0), "0x%x", ws);
+}
+
+/*
+ * The child runs only once the test thread blocks: the signals are generated
+ * before it reaches its first delivery point. CONT discards the pending stop
+ * signals, and KILL ends a stopped process.
+ */
+static void kill_stop_discard(void)
+{
+	int ws = 0;
+	k_pid_t child = &child_a;
+	struct sys_clone_args args = {
+		.entry = stop_child_entry,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
+	};
+
+	stop_child_release = true;
+	zassert_ok(sys_clone(&args, NULL));
+	zassert_ok(k_kill(child, K_SIG_STOP));
+	zassert_ok(k_kill(child, K_SIG_CONT));
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_SECONDS(5)),
+		   "the stop pending when CONT was generated was not discarded");
+	zassert_true(K_WIFEXITED(ws), "0x%x", ws);
+
+	stop_child_release = false;
+	zassert_ok(sys_clone(&args, NULL));
+	zassert_ok(k_kill(child, K_SIG_CONT));
+	zassert_ok(k_kill(child, K_SIG_STOP));
+	zassert_ok(k_waitpid(child, NULL, &ws, K_PROCESS_WUNTRACED, K_SECONDS(5)));
+	zassert_true(K_WIFSTOPPED(ws), "not stopped (0x%x)", ws);
+	zassert_ok(k_kill(child, K_SIG_KILL));
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_SECONDS(5)),
+		   "KILL did not end the stopped process");
+	zassert_true(K_WIFSIGNALED(ws) && (K_WTERMSIG(ws) == K_SIG_KILL), "0x%x", ws);
+}
