+#ifdef CONFIG_SIGNAL_ALTSTACK
+/*
+ * A user thread names an alternate stack: a handler installed with K_SIG_SA_ONSTACK runs on it,
+ * one without does not, and the stack cannot be changed while a handler runs on it.
+ */
+enum altstack_case {
+	ALTSTACK_ERRORS,
+	ALTSTACK_ONSTACK,
+	ALTSTACK_NOT_ONSTACK,
+	ALTSTACK_BAD_SP,
+};
+
+ZTEST_BMEM static uint8_t __aligned(16) altstack_buf[2 * K_SIG_MINSTKSZ];
+ZTEST_BMEM static volatile int altstack_ret[3];
+ZTEST_BMEM static volatile int altstack_handler_flags;
+ZTEST_BMEM static volatile int altstack_handler_set;
+ZTEST_BMEM static volatile uintptr_t altstack_handler_local;
+ZTEST_BMEM static jmp_buf altstack_env;
+
+static bool on_altstack(uintptr_t addr)
+{
+	return (addr >= (uintptr_t)altstack_buf) && (addr < (uintptr_t)altstack_buf + sizeof(altstack_buf));
+}
+
+static void altstack_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	volatile int local;
+	struct k_sig_stack old;
+	const struct k_sig_stack ss = {.sp = altstack_buf, .size = sizeof(altstack_buf)};
+
+	ARG_UNUSED(info);
+	ARG_UNUSED(ucontext);
+
+	altstack_handler_local = (uintptr_t)&local;
+	altstack_handler_flags = (k_sig_altstack(NULL, &old) == 0) ? old.flags : -1;
+	altstack_handler_set = k_sig_altstack(&ss, NULL);
+	if (sig == K_SIG_SEGV) {
+		(void)k_sig_abandon(NULL);
+		longjmp(altstack_env, 1);
+	}
+}
+
+#ifdef CONFIG_SIGNAL_FAULT
+/* a store through a stack pointer that points nowhere: no handler frame fits there */
+static void altstack_bad_sp(void)
+{
+#if defined(CONFIG_ARM64)
+	__asm__ volatile("mov x9, #16; mov sp, x9; str xzr, [sp]" ::: "x9", "memory");
+#elif defined(CONFIG_RISCV)
+	__asm__ volatile("li sp, 16; sw zero, 0(sp)" ::: "memory");
+#elif defined(CONFIG_X86_64)
+	__asm__ volatile("mov $16, %%rsp; movq $0, (%%rsp)" ::: "memory");
+#else
+	__asm__ volatile("mov $16, %%esp; movl $0, (%%esp)" ::: "memory");
+#endif
+}
+#endif /* CONFIG_SIGNAL_FAULT */
+
+static void altstack_entry(void *arg1, void *arg2, void *arg3)
+{
+	enum altstack_case const which = (enum altstack_case)(intptr_t)arg1;
+	struct k_sig_stack ss = {.sp = altstack_buf, .size = sizeof(altstack_buf)};
+	struct k_sig_stack old;
+	struct k_sig_action action = {
+		.handler = altstack_handler,
+		.flags = (which == ALTSTACK_NOT_ONSTACK) ? 0 : K_SIG_SA_ONSTACK,
+	};
+	int const signo = (which == ALTSTACK_BAD_SP) ? K_SIG_SEGV : K_SIG_USR1;
+
+	ARG_UNUSED(arg2);
+	ARG_UNUSED(arg3);
+
+	if (which == ALTSTACK_ERRORS) {
+		altstack_ret[0] = k_sig_altstack(&(struct k_sig_stack){.flags = BIT(5)}, NULL);
+		altstack_ret[1] = k_sig_altstack(
+			&(struct k_sig_stack){.sp = altstack_buf, .size = K_SIG_MINSTKSZ - 1}, NULL);
+		altstack_ret[2] = (k_sig_altstack(NULL, &old) == 0) ? old.flags : -1;
+		return;
+	}
+
+	altstack_ret[0] = k_sig_altstack(&ss, NULL);
+	altstack_ret[1] = k_sig_action(signo, &action, NULL);
+	if (which == ALTSTACK_BAD_SP) {
+#ifdef CONFIG_SIGNAL_FAULT
+		if (setjmp(altstack_env) == 0) {
+			altstack_bad_sp();
+		}
+#endif /* CONFIG_SIGNAL_FAULT */
+	} else {
+		(void)k_sig_queue((k_pid_t)k_current_get(), signo, (union k_sig_val){0});
+	}
+	altstack_ret[2] = (k_sig_altstack(NULL, &old) == 0) ? old.flags : -1;
+	(void)k_sig_action(signo, &(struct k_sig_action){.handler = K_SIG_DFL}, NULL);
+}
+
+static void k_sig_altstack_run(enum altstack_case which)
+{
+	memset((void *)altstack_ret, 0x7f, sizeof(altstack_ret));
+	altstack_handler_flags = -1;
+	altstack_handler_set = 0;
+	altstack_handler_local = 0;
+
+	k_thread_create(&noop_test_thread, noop_test_stack, K_THREAD_STACK_SIZEOF(noop_test_stack),
+			altstack_entry, (void *)(intptr_t)which, NULL, NULL,
+			K_LOWEST_APPLICATION_THREAD_PRIO, K_USER | K_INHERIT_PERMS, K_NO_WAIT);
+	zassert_ok(k_thread_join(&noop_test_thread, K_FOREVER));
+}
+
+static void k_sig_altstack_errors(void)
+{
+	struct k_sig_stack old;
+
+	/* a kernel thread takes its signals where it runs */
+	zassert_equal(k_sig_altstack(NULL, &old), -ENOTSUP);
+
+	k_sig_altstack_run(ALTSTACK_ERRORS);
+	zassert_equal(altstack_ret[0], -EINVAL);
+	zassert_equal(altstack_ret[1], -ENOMEM);
+	zassert_equal(altstack_ret[2], K_SIG_SS_DISABLE);
+}
