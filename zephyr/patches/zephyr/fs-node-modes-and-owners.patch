+ZTEST(tmpfs, test_attributes)
+{
+	struct fs_dirent ent;
+	struct fs_dir_t dir;
+	bool seen = false;
+
+	zassert_equal(fs_mount(&tmpfs_mnt), 0);
+	zassert_equal(fs_mkdir(MNT "/d"), 0);
+	write_all(MNT "/d/f", "x", 1, 0);
+	zassert_equal(fs_symlink("f", MNT "/d/l"), 0);
+	zassert_equal(fs_mkfifo(MNT "/d/p"), 0);
+
+	/* a new node is open to everyone and belongs to 0:0 */
+	zassert_equal(fs_stat(MNT "/d", &ent), 0);
+	zassert_equal(ent.mode, FS_MODE_IFDIR | 0777, "0%o", ent.mode);
+	zassert_equal(fs_stat(MNT "/d/f", &ent), 0);
+	zassert_equal(ent.mode, FS_MODE_IFREG | 0666, "0%o", ent.mode);
+	zassert_equal(ent.uid, 0);
+	zassert_equal(ent.gid, 0);
+	zassert_equal(fs_lstat(MNT "/d/l", &ent), 0);
+	zassert_equal(ent.mode, FS_MODE_IFLNK | 0777, "0%o", ent.mode);
+	zassert_equal(fs_stat(MNT "/d/p", &ent), 0);
+	zassert_equal(ent.mode, FS_MODE_IFIFO | 0666, "0%o", ent.mode);
+
+	/* the permission bits change, the type does not; stat and readdir agree */
+	zassert_equal(fs_chmod(MNT "/d/f", FS_MODE_IFDIR | 04640), 0);
+	zassert_equal(fs_stat(MNT "/d/f", &ent), 0);
+	zassert_equal(ent.mode, FS_MODE_IFREG | 04640, "0%o", ent.mode);
+	zassert_equal(fs_chown(MNT "/d/f", 1000, 100), 0);
+	zassert_equal(fs_stat(MNT "/d/f", &ent), 0);
+	zassert_equal(ent.uid, 1000);
+	zassert_equal(ent.gid, 100);
+	fs_dir_t_init(&dir);
+	zassert_equal(fs_opendir(&dir, MNT "/d"), 0);
+	while ((fs_readdir(&dir, &ent) == 0) && (ent.name[0] != '\0')) {
+		if (strcmp(ent.name, "f") == 0) {
+			zassert_equal(ent.mode, FS_MODE_IFREG | 04640, "0%o", ent.mode);
+			zassert_equal(ent.uid, 1000);
+			seen = true;
+		}
+	}
+	zassert_equal(fs_closedir(&dir), 0);
+	zassert_true(seen, "readdir did not list the file");
+
+	/* through a link the target changes; lchown changes the link itself */
+	zassert_equal(fs_chmod(MNT "/d/l", 0600), 0);
+	zassert_equal(fs_stat(MNT "/d/f", &ent), 0);
+	zassert_equal(ent.mode, FS_MODE_IFREG | 0600, "0%o", ent.mode);
+	zassert_equal(fs_lstat(MNT "/d/l", &ent), 0);
+	zassert_equal(ent.mode, FS_MODE_IFLNK | 0777, "0%o", ent.mode);
+	zassert_equal(fs_lchown(MNT "/d/l", 7, 8), 0);
+	zassert_equal(fs_lstat(MNT "/d/l", &ent), 0);
+	zassert_equal(ent.uid, 7);
+	zassert_equal(fs_stat(MNT "/d/f", &ent), 0);
+	zassert_equal(ent.uid, 1000, "the target kept its owner");
+
+	zassert_equal(fs_chmod(MNT "/d/nope", 0600), -ENOENT);
+	zassert_equal(fs_chown(MNT "/d/nope", 0, 0), -ENOENT);
+	zassert_equal(fs_unmount(&tmpfs_mnt), 0);
+}
