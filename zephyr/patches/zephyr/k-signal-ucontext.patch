diff --git a/tests/kernel/signal/src/main.c b/tests/kernel/signal/src/main.c
index 106ef515c5c..e1e8aaea4ec 100644
--- a/tests/kernel/signal/src/main.c
+++ b/tests/kernel/signal/src/main.c
@@ -526,3 +526,74 @@ static void before(void *arg)
 }
 
 ZTEST_SUITE(signal, NULL, setup, before, NULL, NULL);
+
+/*
+ * The handler's third argument is the context it was entered with: the mask k_sig_return()
+ * installs, which the handler may change, and the stack it runs on.
+ */
+ZTEST_BMEM static struct k_sig_set ucontext_before;
+ZTEST_BMEM static volatile bool ucontext_mask_matched;
+
+static void ucontext_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	struct k_sig_ucontext *const uc = ucontext;
+
+	ARG_UNUSED(sig);
+	ARG_UNUSED(info);
+
+	ucontext_mask_matched = memcmp(&uc->mask, &ucontext_before, sizeof(uc->mask)) == 0;
+	/* resume with K_SIG_USR2 blocked; K_SIG_KILL cannot be blocked this way either */
+	zassert_ok(k_sig_addset(&uc->mask, K_SIG_USR2));
+	zassert_ok(k_sig_addset(&uc->mask, K_SIG_KILL));
+}
+
+static void test_k_sig_ucontext_entry(void *arg1, void *arg2, void *arg3)
+{
+	struct k_sig_set set, after;
+	struct k_sig_action act = {.handler = ucontext_handler};
+
+	ARG_UNUSED(arg1);
+	ARG_UNUSED(arg2);
+	ARG_UNUSED(arg3);
+
+	zassert_ok(k_sig_emptyset(&set));
+	zassert_ok(k_sig_addset(&set, K_SIG_USR1));
+	zassert_ok(k_sig_addset(&set, K_SIG_USR2));
+	zassert_ok(k_sig_mask(K_SIG_UNBLOCK, &set, NULL));
+	zassert_ok(k_sig_mask(K_SIG_SETMASK, NULL, &ucontext_before));
+	zassert_ok(k_sig_action(K_SIG_USR1, &act, NULL));
+
+	ucontext_mask_matched = false;
+	zassert_ok(k_sig_queue((k_pid_t)k_current_get(), K_SIG_USR1, (union k_sig_val){0}));
+	k_msleep(0);
+	k_msleep(0);
+
+	zassert_true(ucontext_mask_matched, "the context did not carry the interrupted mask");
+	zassert_ok(k_sig_mask(K_SIG_SETMASK, NULL, &after));
+	zassert_equal(k_sig_ismember(&after, K_SIG_USR2), 1, "the mask the handler set was not installed");
+	if (k_is_user_context()) {
+		zassert_equal(k_sig_ismember(&after, K_SIG_KILL), 0, "K_SIG_KILL blocked through the context");
+	}
+
+	act.handler = K_SIG_DFL;
+	zassert_ok(k_sig_action(K_SIG_USR1, &act, NULL));
+	zassert_ok(k_sig_mask(K_SIG_SETMASK, &ucontext_before, NULL));
+}
+
+static void k_sig_ucontext_run(uint32_t options)
+{
+	k_thread_create(&noop_test_thread, noop_test_stack, K_THREAD_STACK_SIZEOF(noop_test_stack),
+			test_k_sig_ucontext_entry, NULL, NULL, NULL, K_LOWEST_APPLICATION_THREAD_PRIO,
+			options, K_NO_WAIT);
+	zassert_ok(k_thread_join(&noop_test_thread, K_FOREVER));
+}
+
+ZTEST(signal, test_k_sig_ucontext)
+{
+	k_sig_ucontext_run(0);
+#ifdef CONFIG_USERSPACE
+	if (!IS_ENABLED(CONFIG_COVERAGE)) {
+		k_sig_ucontext_run(K_USER | K_INHERIT_PERMS);
+	}
+#endif
+}
