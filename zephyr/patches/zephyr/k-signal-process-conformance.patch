+#ifdef CONFIG_SIGNAL
+static void disp_noop_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	ARG_UNUSED(sig);
+	ARG_UNUSED(info);
+	ARG_UNUSED(ucontext);
+}
+
+static void disp_child_entry(void *p1, void *p2, void *p3)
+{
+	int code = 0;
+	struct k_sig_action oact;
+
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	/* a fresh process inherits ignored dispositions, and only those */
+	if ((k_sig_action(K_SIG_USR2, NULL, &oact) != 0) || (oact.handler != K_SIG_IGN)) {
+		code |= 1;
+	}
+	if ((k_sig_action(K_SIG_USR1, NULL, &oact) != 0) || (oact.handler != K_SIG_DFL)) {
+		code |= 2;
+	}
+	/* its own change: the inherited copy is the child's, not the parent's */
+	oact = (struct k_sig_action){.handler = K_SIG_DFL};
+	if (k_sig_action(K_SIG_USR2, &oact, NULL) != 0) {
+		code |= 4;
+	}
+	k_exit(code);
+}
+
+static void disp_member_entry(void *p1, void *p2, void *p3)
+{
+	struct k_sig_action *oact = p1;
+
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
+	/* the disposition another member installed is in force for this one */
+	(void)k_sig_action(K_SIG_USR1, NULL, oact);
+}
+
+static void spawn_dispositions(void)
+{
+	int ws = -1;
+	k_tid_t tid;
+	k_pid_t child = &child_a;
+	struct k_sig_action oact;
+	struct k_sig_action act = {.handler = K_SIG_IGN};
+	struct sys_clone_args args = {
+		.entry = disp_child_entry,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
+	};
+
+	zassert_ok(k_sig_emptyset(&act.mask));
+	zassert_ok(k_sig_action(K_SIG_USR2, &act, NULL));
+	act.handler = disp_noop_handler;
+	zassert_ok(k_sig_action(K_SIG_USR1, &act, NULL));
+
+	zassert_ok(sys_clone(&args, NULL));
+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_FOREVER));
+	zassert_true(K_WIFEXITED(ws) && (K_WEXITSTATUS(ws) == 0),
+		     "dispositions not inherited as a fresh image requires (code=%d)",
+		     K_WEXITSTATUS(ws));
+	zassert_ok(k_sig_action(K_SIG_USR2, NULL, &oact));
+	zassert_equal(oact.handler, K_SIG_IGN, "the child's change leaked into the parent");
+
+	oact.handler = K_SIG_DFL;
+	tid = k_thread_create(&child_a, child_stack_a, STATIC_PROC_STACK_SIZE, disp_member_entry,
+			      &oact, NULL, NULL, K_LOWEST_APPLICATION_THREAD_PRIO, 0, K_NO_WAIT);
+	zassert_ok(k_thread_join(tid, K_SECONDS(5)));
+	zassert_equal(oact.handler, disp_noop_handler, "the disposition is process-wide");
+
+	act.handler = K_SIG_DFL;
+	zassert_ok(k_sig_action(K_SIG_USR1, &act, NULL));
+	zassert_ok(k_sig_action(K_SIG_USR2, &act, NULL));
+}
+#endif /* CONFIG_SIGNAL */
