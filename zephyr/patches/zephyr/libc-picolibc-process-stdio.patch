+#ifndef CONFIG_PICOLIBC_USE_MODULE
+/*
+ * The toolchain's tinystdio dereferences a null stream. It keeps no list of
+ * open streams, so flushing them all is flushing the standard output streams,
+ * which is what the module build's tinystdio-fflush-null.patch does.
+ */
+int fflush(FILE *stream)
+{
+	if (stream == NULL) {
+		return ((fflush(stdout) != 0) || (fflush(stderr) != 0)) ? EOF : 0;
+	}
+
+	return (stream->flush != NULL) ? stream->flush(stream) : 0;
+}
+#endif /* CONFIG_PICOLIBC_USE_MODULE */
