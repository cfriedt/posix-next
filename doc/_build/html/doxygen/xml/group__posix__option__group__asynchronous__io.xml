        <briefdescription>
<para>Cancel an outstanding asynchronous I/O request. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>fildes</parametername>
</parameternamelist>
