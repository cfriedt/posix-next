diff --git a/kernel/process.c b/kernel/process.c
index dd12b57111c..49fe11a34df 100644
--- a/kernel/process.c
+++ b/kernel/process.c
@@ -805,7 +805,6 @@ int z_impl_k_kill_pgrp(k_pgrp_t pgrp, int signo)
 	size_t skip = 0;
 	bool done = false;
 	struct k_thread *targets[8];
-	struct k_process *scopes[8];
 
 	/*
 	 * Resolve deliverable threads (one per member process) under the lock
@@ -844,22 +843,26 @@ int z_impl_k_kill_pgrp(k_pgrp_t pgrp, int signo)
 			}
 #ifdef CONFIG_SIGNAL
 			tgt = process_sig_target(proc, signo);
+			if (tgt == NULL) {
+				/* every member masked: pend at process scope,
+				 * under the lock so reap cannot race the queue
