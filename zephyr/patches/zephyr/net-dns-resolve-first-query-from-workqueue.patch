+/* A lookup started while a reply from its server waits to be dispatched must
+ * not deadlock. The dispatch holds the dispatcher's lock and waits for the
+ * resolver lock, which the thread starting the lookup holds. The lookup's
+ * first send is deferred to the work queue, which takes the resolver lock once
+ * the dispatch is over, so nothing waits on the dispatch and the query leaves
+ * from a renewed port like any other.
  */
 static K_THREAD_STACK_DEFINE(renew_stack, 2048);
 static struct k_thread renew_thread;
 static volatile int renew_ret;
+static uint16_t renew_dns_id;
 
