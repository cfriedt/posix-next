+    def build_branch(self, db, repo, branch, unit, subjects):
+        """Commit ``unit`` on top of upstream in a temporary index; returns the tip commit."""
+        index = TmpIndex(repo.repo)
+        try:
+            index.reset(repo.main_tree())
+            parent = repo.main_tree()
+            name, email = repo.committer()
+            for e, subject in zip(unit, subjects, strict=True):
+                if not index.apply(db.patch_file(e)):
+                    raise PatchError(f"{e.stem} does not apply on top of {parent[:12]}")
+                message = f"{subject}\n\n{make_body(e)}\n\nSigned-off-by: {name} <{email}>\n"
+                env = dict(os.environ, GIT_AUTHOR_NAME=e.author, GIT_AUTHOR_EMAIL=e.email)
+                if e.date:
+                    env["GIT_AUTHOR_DATE"] = f"{e.date}T12:00:00"
+                parent = _git(
+                    repo.repo, "commit-tree", index.write_tree(), "-p", parent, "-F", "-",
+                    env=env, input=message,
+                ).stdout.strip()  # fmt: skip
+                self.inf(f"  {parent[:12]} {subject}")
+        finally:
+            index.close()
+        _git(repo.repo, "update-ref", f"refs/heads/{branch}", parent)
+        return parent
