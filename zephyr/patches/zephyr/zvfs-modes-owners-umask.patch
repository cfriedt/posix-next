diff --git a/lib/os/zvfs/zvfs_attr.c b/lib/os/zvfs/zvfs_attr.c
new file mode 100644
--- /dev/null
+++ b/lib/os/zvfs/zvfs_attr.c
@@ -0,0 +1,228 @@
+/*
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#include <zephyr/fs/fs.h>
+#include <zephyr/kernel.h>
+#include <zephyr/internal/syscall_handler.h>
+#include <zephyr/sys/fdtable.h>
+#include <zephyr/sys/internal/fdtable_priv.h>
+#include <zephyr/sys/zvfs_fs.h>
+
+#include "zvfs_fs_priv.h"
+
+/* threads that belong to no process share the boot mask, as they share the boot directory */
+static uint32_t zvfs_boot_umask = 022;
+
+static uint32_t *umask_ptr(void)
+{
+	uint32_t *mask = z_zvfs_proc_umask();
+
+	return (mask != NULL) ? mask : &zvfs_boot_umask;
+}
+
+uint32_t z_zvfs_umask_get(void)
+{
+	return *umask_ptr();
+}
+
+uint32_t z_impl_zvfs_umask(uint32_t mask)
+{
+	uint32_t *p = umask_ptr();
+	uint32_t prev = *p;
+
+	*p = mask & FS_MODE_PERM;
+
+	return prev;
+}
+
+#ifdef CONFIG_USERSPACE
+static uint32_t z_vrfy_zvfs_umask(uint32_t mask)
+{
+	return z_impl_zvfs_umask(mask);
+}
+#include <zephyr/syscalls/zvfs_umask_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+static int attr_err(int res)
+{
+	if (res < 0) {
+		errno = -res;
+		return -1;
+	}
+
+	return 0;
+}
+
+static int attr_resolve(int dirfd, const char *path, int flags, char *r, size_t size)
+{
+	if ((flags & ~ZVFS_AT_SYMLINK_NOFOLLOW) != 0) {
+		return -EINVAL;
+	}
+
+	return zvfs_resolve_at(dirfd, path, r, size);
+}
+
+int z_impl_zvfs_chmodat(int dirfd, const char *path, uint32_t mode, int flags)
+{
+	struct fs_dirent entry;
+	char r[CONFIG_ZVFS_PATH_MAX];
+	int rc = attr_resolve(dirfd, path, flags, r, sizeof(r));
+
+	if (rc < 0) {
+		return attr_err(rc);
+	}
+
+	if ((flags & ZVFS_AT_SYMLINK_NOFOLLOW) != 0) {
+		rc = fs_lstat(r, &entry);
+		if (rc < 0) {
+			return attr_err(rc);
+		}
+		if (entry.type == FS_DIR_ENTRY_SYMLINK) {
+			/* a symbolic link has no permissions of its own */
+			return attr_err(-EOPNOTSUPP);
+		}
+	}
+
+	return attr_err(fs_chmod(r, mode));
+}
+
+#ifdef CONFIG_USERSPACE
+static int z_vrfy_zvfs_chmodat(int dirfd, const char *path, uint32_t mode, int flags)
+{
+	char kpath[CONFIG_ZVFS_PATH_MAX];
+
+	if (zvfs_dirfd_syscall_verify(dirfd) < 0 || zvfs_copy_user_path(kpath, path) < 0) {
+		return -1;
+	}
+
+	return z_impl_zvfs_chmodat(dirfd, kpath, mode, flags);
+}
+#include <zephyr/syscalls/zvfs_chmodat_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+/* an ID of UINT32_MAX keeps the one on record */
+static int attr_fill_ids(const struct zvfs_stat *st, uint32_t *uid, uint32_t *gid)
+{
+	if (*uid == UINT32_MAX) {
+		*uid = st->uid;
+	}
+	if (*gid == UINT32_MAX) {
+		*gid = st->gid;
+	}
+
+	return 0;
+}
+
+int z_impl_zvfs_chownat(int dirfd, const char *path, uint32_t uid, uint32_t gid, int flags)
+{
+	struct zvfs_stat st;
+	char r[CONFIG_ZVFS_PATH_MAX];
+	int rc = attr_resolve(dirfd, path, flags, r, sizeof(r));
+
+	if (rc < 0) {
+		return attr_err(rc);
+	}
+
+	if ((uid == UINT32_MAX) || (gid == UINT32_MAX)) {
+		if (z_impl_zvfs_statat(ZVFS_AT_FDCWD, r, &st, flags) < 0) {
+			return -1;
+		}
+		(void)attr_fill_ids(&st, &uid, &gid);
+	}
+
+	if ((flags & ZVFS_AT_SYMLINK_NOFOLLOW) != 0) {
+		return attr_err(fs_lchown(r, uid, gid));
+	}
+
+	return attr_err(fs_chown(r, uid, gid));
+}
+
+#ifdef CONFIG_USERSPACE
+static int z_vrfy_zvfs_chownat(int dirfd, const char *path, uint32_t uid, uint32_t gid,
+			       int flags)
+{
+	char kpath[CONFIG_ZVFS_PATH_MAX];
+
+	if (zvfs_dirfd_syscall_verify(dirfd) < 0 || zvfs_copy_user_path(kpath, path) < 0) {
+		return -1;
+	}
+
+	return z_impl_zvfs_chownat(dirfd, kpath, uid, gid, flags);
+}
+#include <zephyr/syscalls/zvfs_chownat_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+static int attr_ioctl(struct fd_entry *entry, int cmd, ...)
+{
+	int res;
+	va_list args;
+
+	(void)k_mutex_lock(&entry->lock, K_FOREVER);
+	va_start(args, cmd);
+	res = entry->vtable->ioctl(entry->obj, cmd, args);
+	va_end(args);
+	k_mutex_unlock(&entry->lock);
+
+	return res;
+}
+
+int z_impl_zvfs_fchmod(int fd, uint32_t mode)
+{
+	struct fd_entry *entry = zvfs_fd_entry_get(fd);
+
+	if (entry == NULL) {
+		return -1;
+	}
+
+	return attr_ioctl(entry, ZFD_IOCTL_CHMOD, mode);
+}
+
+#ifdef CONFIG_USERSPACE
+static int z_vrfy_zvfs_fchmod(int fd, uint32_t mode)
+{
+	if (zvfs_fd_syscall_verify(fd) == NULL) {
+		return -1;
+	}
+
+	return z_impl_zvfs_fchmod(fd, mode);
+}
+#include <zephyr/syscalls/zvfs_fchmod_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+int z_impl_zvfs_fchown(int fd, uint32_t uid, uint32_t gid)
+{
+	struct fd_entry *entry = zvfs_fd_entry_get(fd);
+	struct zvfs_stat st;
+
+	if (entry == NULL) {
+		return -1;
+	}
+
+	if ((uid == UINT32_MAX) || (gid == UINT32_MAX)) {
+		if (zvfs_fstat(fd, &st) < 0) {
+			return -1;
+		}
+		(void)attr_fill_ids(&st, &uid, &gid);
+	}
+
+	return attr_ioctl(entry, ZFD_IOCTL_CHOWN, uid, gid);
+}
+
+#ifdef CONFIG_USERSPACE
+static int z_vrfy_zvfs_fchown(int fd, uint32_t uid, uint32_t gid)
+{
+	if (zvfs_fd_syscall_verify(fd) == NULL) {
+		return -1;
+	}
+
+	return z_impl_zvfs_fchown(fd, uid, gid);
+}
+#include <zephyr/syscalls/zvfs_fchown_mrsh.c>
+#endif /* CONFIG_USERSPACE */
