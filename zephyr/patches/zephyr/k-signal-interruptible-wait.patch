+static K_SEM_DEFINE(interrupt_sem, 0, 1);
+ZTEST_BMEM static volatile int interrupt_sleep_ret;
+ZTEST_BMEM static volatile int interrupt_take_ret;
+ZTEST_BMEM static volatile int interrupt_wait_ret;
+ZTEST_BMEM static struct timespec interrupt_rem;
+
+static void interrupt_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	ARG_UNUSED(sig);
+	ARG_UNUSED(info);
+	ARG_UNUSED(ucontext);
+}
+
+static void interrupt_wait_entry(void *arg1, void *arg2, void *arg3)
+{
+	struct k_sig_set mask;
+	struct k_sig_action action = {
+		.handler = interrupt_handler,
+	};
+	const struct timespec ten_s = {.tv_sec = 10};
+	unsigned long token;
+
+	ARG_UNUSED(arg1);
+	ARG_UNUSED(arg2);
+	ARG_UNUSED(arg3);
+
+	zassert_ok(k_sig_emptyset(&mask));
+	zassert_ok(k_sig_addset(&mask, K_SIG_USR1));
+	zassert_ok(k_sig_mask(K_SIG_UNBLOCK, &mask, NULL));
+	zassert_ok(k_sig_action(K_SIG_USR1, &action, NULL));
+
+	/* a signal ends a sleep early, with the time left */
+	interrupt_sleep_ret = sys_clock_nanosleep(SYS_CLOCK_MONOTONIC, 0, &ten_s, &interrupt_rem);
+	/* a kernel thread may still hold the signal pending: it is not the next wait's */
+	(void)k_sig_timedwait(&mask, NULL, K_NO_WAIT);
+
+	/* and returns a pend marked interruptible -EINTR */
+	if (z_sig_pend_begin(&token)) {
+		interrupt_take_ret = k_sem_take(&interrupt_sem, K_SECONDS(10));
+		(void)z_sig_pend_end(token);
+	}
+	(void)k_sig_timedwait(&mask, NULL, K_NO_WAIT);
+
+	/* and ends a wait for other signals with -EINTR */
+	zassert_ok(k_sig_emptyset(&mask));
+	zassert_ok(k_sig_addset(&mask, K_SIG_USR2));
+	interrupt_wait_ret = k_sig_timedwait(&mask, NULL, K_SECONDS(10));
+
+	action.handler = K_SIG_DFL;
+	zassert_ok(k_sig_action(K_SIG_USR1, &action, NULL));
+}
+
+ZTEST(signal, test_k_sig_interrupts_wait)
+{
+	const uint32_t start = k_uptime_get_32();
+
+	interrupt_sleep_ret = 0;
+	interrupt_take_ret = 0;
+	interrupt_wait_ret = 0;
+	k_thread_create(&noop_test_thread, noop_test_stack, K_THREAD_STACK_SIZEOF(noop_test_stack),
+			interrupt_wait_entry, NULL, NULL, NULL, K_LOWEST_APPLICATION_THREAD_PRIO, 0,
+			K_NO_WAIT);
+	for (int i = 0; i < 3; i++) {
+		int rc;
+
+		k_msleep(100);
+		rc = k_sig_queue((k_pid_t)&noop_test_thread, K_SIG_USR1, (union k_sig_val){0});
+		zassert_equal(rc, 0, "k_sig_queue() %d: %d", i, rc);
+	}
+	zassert_ok(k_thread_join(&noop_test_thread, K_FOREVER));
+
+	zassert_true((k_uptime_get_32() - start) < 5000U, "the waits were not interrupted");
+	zassert_equal(interrupt_sleep_ret, -EINTR);
+	zassert_true(interrupt_rem.tv_sec >= 9, "time left %lld", (long long)interrupt_rem.tv_sec);
+	zassert_equal(interrupt_take_ret, -EINTR);
+	zassert_equal(interrupt_wait_ret, -EINTR);
+}
+
 
