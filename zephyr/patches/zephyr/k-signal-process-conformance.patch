+	zassert_ok(k_waitpid(child, NULL, &ws, 0, K_FOREVER));
+	zassert_true(K_WIFEXITED(ws) && (K_WEXITSTATUS(ws) == 0),
+		     "broadcast did not reach the eligible non-leader thread (code=%d)",
+		     K_WEXITSTATUS(ws));
