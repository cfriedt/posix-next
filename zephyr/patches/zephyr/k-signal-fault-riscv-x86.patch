+		code = K_ILL_ILLOPN;
+		break;
+	case IV_OVERFLOW:
+	case IV_BOUND_RANGE:
+	case IV_INVALID_TSS:
+	case IV_CTRL_PROTECTION_EXCEPTION:
+		signo = K_SIG_SEGV;
+		code = K_SEGV_ACCERR;
+		addr = NULL;
+		break;
+	case IV_GENERAL_PROTECTION:
+		signo = K_SIG_SEGV;
+		code = K_SEGV_ACCERR;
+		addr = NULL;
+		break;
+	case IV_SEGMENT_NOT_PRESENT:
+	case IV_STACK_FAULT:
+		signo = K_SIG_BUS;
+		code = K_BUS_ADRERR;
+		addr = NULL;
