diff --git a/lib/os/zvfs/Kconfig b/lib/os/zvfs/Kconfig
--- a/lib/os/zvfs/Kconfig
+++ b/lib/os/zvfs/Kconfig
@@ -156,6 +156,17 @@ config ZVFS_RESERVE_STDIO_FDS
 	  Pre-reserve fd slots 0, 1, and 2 for stdin, stdout, and stderr in the ZVFS fd
 	  table so dynamically allocated descriptors start at fd 3.
 
+config ZVFS_STDIN_CONSOLE
+	bool "Read the reserved stdin descriptor from the console"
+	depends on UART_CONSOLE
+	help
+	  read() on the reserved stdin descriptor polls the console UART with
+	  a minimal line discipline: input is line-buffered with echo,
+	  backspace editing, CR-to-NL translation, and Ctrl-D at the start of
+	  a line reporting end-of-file. Without this option such reads return
+	  0 (end-of-file). Interrupt characters are not yet routed to the
+	  foreground process group.
+
 config ZVFS_OPEN_ADD_SIZE_STDIO
 	int
 	default 3 if ZVFS_RESERVE_STDIO_FDS
