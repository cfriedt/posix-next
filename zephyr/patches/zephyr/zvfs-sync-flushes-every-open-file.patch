--- a/lib/os/zvfs/zvfs_fdtable.c
+++ b/lib/os/zvfs/zvfs_fdtable.c
@@ -309,6 +309,24 @@ int zvfs_fd_obj_refcount(void *obj)
 	return count;
 }
 
+void zvfs_fd_entry_foreach(uint32_t ifmt, void (*fn)(struct fd_entry *entry, void *arg), void *arg)
+{
+	for (int i = 0; i < ARRAY_SIZE(fdtable); i++) {
+		struct fd_entry *entry = &fdtable[i];
+
+		if ((atomic_get(&entry->refcount) == 0) || ((entry->mode & ZVFS_MODE_IFMT) != ifmt)) {
+			continue;
+		}
+
+		/* as zvfs_close(): the lock orders fn against the object's close */
+		(void)k_mutex_lock(&entry->lock, K_FOREVER);
+		if ((entry->vtable != NULL) && (entry->obj != NULL)) {
+			fn(entry, arg);
+		}
+		k_mutex_unlock(&entry->lock);
+	}
+}
