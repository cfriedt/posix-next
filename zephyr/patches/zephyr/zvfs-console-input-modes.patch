+static const struct device *const cons = DEVICE_DT_GET(DT_CHOSEN(zephyr_console));
+/* readers take turns; a read may hold this for as long as it blocks */
+static K_MUTEX_DEFINE(cons_lock);
+/* one byte taken from the UART on behalf of poll(), handed to the next read */
+static struct k_spinlock cons_byte_lock;
+static int cons_pending = -1;
+static struct k_poll_signal cons_ready = K_POLL_SIGNAL_INITIALIZER(cons_ready);
+
+/* the next input byte: what poll() took, else the UART; -1 when none is there */
+static int cons_getc(void)
+{
+	k_spinlock_key_t key = k_spin_lock(&cons_byte_lock);
+	unsigned char c;
+	int ret = cons_pending;
+
+	if (ret >= 0) {
+		cons_pending = -1;
+		k_poll_signal_reset(&cons_ready);
+	} else if (uart_poll_in(cons, &c) == 0) {
+		ret = c;
+	}
+	k_spin_unlock(&cons_byte_lock, key);
+
+	return ret;
+}
+
+/* poll() support: read the UART until a byte arrives, then flag it */
+static void cons_poller(struct k_work *work)
+{
+	struct k_work_delayable *dwork = k_work_delayable_from_work(work);
+	k_spinlock_key_t key = k_spin_lock(&cons_byte_lock);
+	unsigned char c;
+	bool ready;
+
+	if ((cons_pending < 0) && (uart_poll_in(cons, &c) == 0)) {
+		cons_pending = c;
+	}
+	ready = cons_pending >= 0;
+	k_spin_unlock(&cons_byte_lock, key);
+
+	if (ready) {
+		k_poll_signal_raise(&cons_ready, 0);
+	} else {
+		(void)k_work_reschedule(dwork, K_MSEC(10));
+	}
+}
+
+static K_WORK_DELAYABLE_DEFINE(cons_poll_work, cons_poller);
