diff --git a/lib/libc/picolibc/include/regex.h b/lib/libc/picolibc/include/regex.h
new file mode 100644
--- /dev/null
+++ b/lib/libc/picolibc/include/regex.h
@@ -0,0 +1,21 @@
+/*
+ * Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * Picolibc's own <regex.h> is not usable as shipped: the toolchain copy is
+ * not self-contained (it uses size_t without requesting it from <stddef.h>)
+ * and its regcomp() has a use-after-free, and the toolchain build cannot be
+ * patched. Redirect to the posix-next owning header, which the module's regex
+ * engine backs. (The minimal libc needs no such shim because the module's
+ * include/zephyr/posix is on its search path; Newlib uses its own working
+ * regex via TC_PROVIDES_POSIX_REGEXP.)
+ */
+#ifndef ZEPHYR_LIB_LIBC_PICOLIBC_INCLUDE_REGEX_H_
+#define ZEPHYR_LIB_LIBC_PICOLIBC_INCLUDE_REGEX_H_
+
+#include <zephyr/posix/regex.h>
+
+#endif /* ZEPHYR_LIB_LIBC_PICOLIBC_INCLUDE_REGEX_H_ */
