+int ext2_create_fifo(struct ext2_inode *parent, struct ext2_inode *new_inode,
+		struct ext2_lookup_args *args)
+{
+	int rc, ret = 0;
+	struct ext2_direntry *entry;
+	struct ext2_data *fs = parent->i_fs;
