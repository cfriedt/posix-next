diff --git a/tests/kernel/msgq/msgq_api/src/test_msgq_prio.c b/tests/kernel/msgq/msgq_api/src/test_msgq_prio.c
new file mode 100644
index 00000000000..24fa4075986
--- /dev/null
+++ b/tests/kernel/msgq/msgq_api/src/test_msgq_prio.c
@@ -0,0 +1,322 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "test_msgq.h"
+
+#ifdef CONFIG_MSGQ_PRIO
+
+#define PRIO_MSG_SIZE  16
+#define PRIO_MSGQ_LEN  4
+
+extern struct k_msgq prio_msgq;
+extern struct k_msgq prio_alloc_msgq;
+extern struct k_msgq msgq;
+extern struct k_sem end_sema;
+extern struct k_thread tdata;
+extern k_tid_t tids[2];
+K_THREAD_STACK_DECLARE(tstack, STACK_SIZE);
+
+static ZTEST_BMEM char child_buf[PRIO_MSG_SIZE];
+static ZTEST_BMEM uint32_t child_prio;
+static ZTEST_BMEM int child_ret;
+
+static void section_reset(void)
+{
+	k_msgq_purge(&prio_msgq);
+	k_sem_reset(&end_sema);
+}
+
+static void fill_queue(uint32_t prio)
+{
+	char msg[PRIO_MSG_SIZE] = "fill";
+
+	for (uint32_t i = k_msgq_num_used_get(&prio_msgq); i < PRIO_MSGQ_LEN; i++) {
+		zassert_ok(k_msgq_put_prio(&prio_msgq, msg, sizeof(msg), prio, K_NO_WAIT));
+	}
+}
+
+static void blocked_sender_entry(void *p1, void *p2, void *p3)
+{
+	static const char msg[PRIO_MSG_SIZE] = "blocked sender";
+
+	child_ret = k_msgq_put_prio(&prio_msgq, msg, sizeof(msg), 7, K_FOREVER);
+	k_sem_give(&end_sema);
+}
+
+static void blocked_receiver_entry(void *p1, void *p2, void *p3)
+{
+	child_ret = k_msgq_get_prio(&prio_msgq, child_buf, sizeof(child_buf), &child_prio,
+				    K_FOREVER);
+	k_sem_give(&end_sema);
+}
+
+static k_tid_t spawn_child(k_thread_entry_t entry)
+{
+	tids[0] = k_thread_create(&tdata, tstack, STACK_SIZE, entry, NULL, NULL, NULL,
+				  k_thread_priority_get(k_current_get()),
+				  K_USER | K_INHERIT_PERMS, K_NO_WAIT);
+	return tids[0];
+}
+
+static void put_prio_isr_entry(const void *param)
+{
+	char msg[PRIO_MSG_SIZE] = "from isr";
+
+	zassert_ok(k_msgq_put_prio((struct k_msgq *)param, msg, sizeof(msg), 5, K_NO_WAIT));
+}
+
+/* sections of test_k_msgq_put_prio */
+
+static void put_prio_ordering(void)
+{
+	char buf[PRIO_MSG_SIZE];
+	uint32_t prio;
+
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "low", 4, 1, K_NO_WAIT));
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "high A", 7, 3, K_NO_WAIT));
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "mid", 4, 2, K_NO_WAIT));
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "high B", 7, 3, K_NO_WAIT));
+
+	/* descending priority; FIFO among equal priorities */
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), &prio, K_NO_WAIT), 7);
+	zassert_equal(prio, 3);
+	zassert_mem_equal(buf, "high A", 7);
+
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), &prio, K_NO_WAIT), 7);
+	zassert_equal(prio, 3);
+	zassert_mem_equal(buf, "high B", 7);
+
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), &prio, K_NO_WAIT), 4);
+	zassert_equal(prio, 2);
+	zassert_mem_equal(buf, "mid", 4);
+
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), &prio, K_NO_WAIT), 4);
+	zassert_equal(prio, 1);
+	zassert_mem_equal(buf, "low", 4);
+}
+
+static void put_prio_varlen(void)
+{
+	char buf[PRIO_MSG_SIZE];
+
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "", 0, 0, K_NO_WAIT));
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "1234567", 8, 0, K_NO_WAIT));
+
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), NULL, K_NO_WAIT), 0);
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), NULL, K_NO_WAIT), 8);
+	zassert_mem_equal(buf, "1234567", 8);
+}
+
+static void put_prio_errors(void)
+{
+	char big[PRIO_MSG_SIZE + 1] = {0};
+
+	zassert_equal(k_msgq_put_prio(&prio_msgq, big, sizeof(big), 0, K_NO_WAIT), -EMSGSIZE);
+
+	fill_queue(0);
+	zassert_equal(k_msgq_put_prio(&prio_msgq, big, PRIO_MSG_SIZE, 0, K_NO_WAIT), -ENOMSG);
+	zassert_equal(k_msgq_put_prio(&prio_msgq, big, PRIO_MSG_SIZE, 0, TIMEOUT), -EAGAIN);
+}
+
+static void put_prio_blocked_sender(void)
+{
+	char buf[PRIO_MSG_SIZE];
+	uint32_t prio;
+
+	fill_queue(0);
+	spawn_child(blocked_sender_entry);
+	/* let the child block on the full queue */
+	k_msleep(TIMEOUT_MS);
+	zassert_equal(k_sem_take(&end_sema, K_NO_WAIT), -EBUSY);
+
+	/* freeing a slot unblocks the sender; its message lands with its priority */
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), &prio, K_NO_WAIT),
+		      PRIO_MSG_SIZE);
+	zassert_ok(k_sem_take(&end_sema, TIMEOUT));
+	zassert_ok(child_ret);
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), &prio, K_NO_WAIT),
+		      PRIO_MSG_SIZE);
+	zassert_equal(prio, 7);
+	zassert_mem_equal(buf, "blocked sender", sizeof("blocked sender"));
+	k_thread_join(tids[0], K_FOREVER);
+	tids[0] = NULL;
+}
+
+static void put_prio_purge_wakes_sender(void)
+{
+	fill_queue(0);
+	spawn_child(blocked_sender_entry);
+	/* let the child block on the full queue */
+	k_msleep(TIMEOUT_MS);
+
+	k_msgq_purge(&prio_msgq);
+	zassert_ok(k_sem_take(&end_sema, TIMEOUT));
+	zassert_equal(child_ret, -ENOMSG);
+	zassert_equal(k_msgq_num_used_get(&prio_msgq), 0);
+	k_thread_join(tids[0], K_FOREVER);
+	tids[0] = NULL;
+}
+
+static void put_prio_isr(void)
+{
+	char buf[PRIO_MSG_SIZE];
+	uint32_t prio;
+
+	irq_offload(put_prio_isr_entry, &prio_msgq);
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), &prio, K_NO_WAIT),
+		      PRIO_MSG_SIZE);
+	zassert_equal(prio, 5);
+	zassert_mem_equal(buf, "from isr", sizeof("from isr"));
+}
+
+ZTEST_USER(msgq_api, test_k_msgq_put_prio)
+{
+	section_reset();
+	put_prio_ordering();
+	section_reset();
+	put_prio_varlen();
+	section_reset();
+	put_prio_errors();
+	section_reset();
+	put_prio_blocked_sender();
+	section_reset();
+	put_prio_purge_wakes_sender();
+	if (!k_is_user_context()) {
+		section_reset();
+		put_prio_isr();
+	}
+	section_reset();
+}
+
+/* sections of test_k_msgq_get_prio */
+
+static void get_prio_null_prio(void)
+{
+	char buf[PRIO_MSG_SIZE];
+
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "no prio out", 12, 4, K_NO_WAIT));
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), NULL, K_NO_WAIT), 12);
+	zassert_mem_equal(buf, "no prio out", 12);
+}
+
+static void get_prio_errors(void)
+{
+	char small[PRIO_MSG_SIZE - 1];
+	char buf[PRIO_MSG_SIZE];
+
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "x", 2, 0, K_NO_WAIT));
+	zassert_equal(k_msgq_get_prio(&prio_msgq, small, sizeof(small), NULL, K_NO_WAIT),
+		      -EMSGSIZE);
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), NULL, K_NO_WAIT), 2);
+
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), NULL, K_NO_WAIT), -ENOMSG);
+	zassert_equal(k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), NULL, TIMEOUT), -EAGAIN);
+}
+
+static void get_prio_blocked_receiver(void)
+{
+	spawn_child(blocked_receiver_entry);
+	/* let the child block on the empty queue */
+	k_msleep(TIMEOUT_MS);
+	zassert_equal(k_sem_take(&end_sema, K_NO_WAIT), -EBUSY);
+
+	zassert_ok(k_msgq_put_prio(&prio_msgq, "wake up", 8, 6, K_NO_WAIT));
+	zassert_ok(k_sem_take(&end_sema, TIMEOUT));
+	zassert_equal(child_ret, 8);
+	zassert_equal(child_prio, 6);
+	zassert_mem_equal(child_buf, "wake up", 8);
+	k_thread_join(tids[0], K_FOREVER);
+	tids[0] = NULL;
+}
+
+ZTEST_USER(msgq_api, test_k_msgq_get_prio)
+{
+	section_reset();
+	get_prio_null_prio();
+	section_reset();
+	get_prio_errors();
+	section_reset();
+	get_prio_blocked_receiver();
+	section_reset();
+}
+
+/* sections of test_k_msgq_init_prio */
+
+static void init_prio_attrs(void)
+{
+	struct k_msgq_attrs attrs;
+
+	k_msgq_get_attrs(&prio_msgq, &attrs);
+	zassert_equal(attrs.msg_size, PRIO_MSG_SIZE);
+	zassert_equal(attrs.max_msgs, PRIO_MSGQ_LEN);
+	zassert_equal(attrs.used_msgs, 0);
+	zassert_equal(k_msgq_num_free_get(&prio_msgq), PRIO_MSGQ_LEN);
+	zassert_equal(k_msgq_num_used_get(&prio_msgq), 0);
+}
+
+static void init_prio_classic_ops_enotsup(void)
+{
+	char buf[PRIO_MSG_SIZE] = {0};
+
+	zassert_equal(k_msgq_put(&prio_msgq, buf, K_NO_WAIT), -ENOTSUP);
+	zassert_equal(k_msgq_put_front(&prio_msgq, buf), -ENOTSUP);
+	zassert_equal(k_msgq_get(&prio_msgq, buf, K_NO_WAIT), -ENOTSUP);
+	zassert_equal(k_msgq_peek(&prio_msgq, buf), -ENOTSUP);
+	zassert_equal(k_msgq_peek_at(&prio_msgq, buf, 0), -ENOTSUP);
+}
+
+static void init_prio_ops_on_classic_enotsup(void)
+{
+	static char classic_buf[MSG_SIZE * MSGQ_LEN];
+	char buf[MSG_SIZE] = {0};
+	struct k_msgq classic;
+
+	k_msgq_init(&classic, classic_buf, MSG_SIZE, MSGQ_LEN);
+	zassert_equal(k_msgq_put_prio(&classic, buf, sizeof(buf), 0, K_NO_WAIT), -ENOTSUP);
+	zassert_equal(k_msgq_get_prio(&classic, buf, sizeof(buf), NULL, K_NO_WAIT), -ENOTSUP);
+}
+
+ZTEST(msgq_api, test_k_msgq_init_prio)
+{
+	section_reset();
+	init_prio_attrs();
+	init_prio_classic_ops_enotsup();
+	init_prio_ops_on_classic_enotsup();
+	section_reset();
+}
+
+/* sections of test_k_msgq_alloc_init_prio */
+
+static void alloc_init_prio_errors(void)
+{
+	zassert_equal(k_msgq_alloc_init_prio(&prio_alloc_msgq, PRIO_MSG_SIZE, 0), -EINVAL);
+	zassert_equal(k_msgq_alloc_init_prio(&prio_alloc_msgq, OVERFLOW_SIZE_MSG, 2), -EINVAL);
+	zassert_equal(k_msgq_alloc_init_prio(&prio_alloc_msgq, 1U << 24, 2), -ENOMEM);
+}
+
+static void alloc_init_prio_use(void)
+{
+	char buf[PRIO_MSG_SIZE];
+	uint32_t prio;
+
+	zassert_ok(k_msgq_alloc_init_prio(&prio_alloc_msgq, PRIO_MSG_SIZE, 2));
+	zassert_ok(k_msgq_put_prio(&prio_alloc_msgq, "alloc", 6, 2, K_NO_WAIT));
+	zassert_equal(k_msgq_get_prio(&prio_alloc_msgq, buf, sizeof(buf), &prio, K_NO_WAIT), 6);
+	zassert_equal(prio, 2);
+	zassert_mem_equal(buf, "alloc", 6);
+
+	if (!k_is_user_context()) {
+		zassert_ok(k_msgq_cleanup(&prio_alloc_msgq));
+	}
+}
+
+ZTEST_USER(msgq_api, test_k_msgq_alloc_init_prio)
+{
+	alloc_init_prio_errors();
+	alloc_init_prio_use();
+}
+
+#endif /* CONFIG_MSGQ_PRIO */
