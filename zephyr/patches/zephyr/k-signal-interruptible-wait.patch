+/* a deliverable signal is pending for the current thread: unblocked, not ignored */
+static bool z_sig_interrupts(void)
+{
+	struct k_sig_set pend;
+	struct k_sig_action action;
+
+	K_SPINLOCK(k_sig_lock) {
+		z_sig_pending_unlocked(&pend, _current);
+	}
+	z_sig_unset(&pend, &_current->base.sig.mask);
+
+	for (int signo = 1; signo <= SIGNAL_SET_SIZE; signo++) {
+		if (k_sig_ismember(&pend, signo) != 1) {
+			continue;
+		}
+		if (z_sig_action(signo, NULL, &action, _current) < 0) {
+			return true;
+		}
+		if (action.handler == K_SIG_DFL) {
+			action.handler = z_sig_resolve(signo);
+		}
+		if (action.handler != K_SIG_IGN) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
+static void z_sig_wait_set(struct k_poll_signal *sig)
+{
+	K_SPINLOCK(k_sig_lock) {
+		_current->base.sig.wait_sig = sig;
+	}
+}
+
+bool z_sig_wait_begin(struct k_poll_signal *sig, unsigned long *token)
+{
+	z_sig_wait_set(sig);
+	*token = (unsigned long)atomic_get(&_current->base.sig.delivered);
+	if (z_sig_interrupts()) {
+		z_sig_wait_set(NULL);
+		return false;
+	}
+
+	return true;
+}
+
+bool z_sig_wait_end(unsigned long token)
+{
+	z_sig_wait_set(NULL);
+
+	/* claimed for delivery on the way back to user mode, or still to be claimed */
+	return ((unsigned long)atomic_get(&_current->base.sig.delivered) != token) ||
+	       z_sig_interrupts();
+}
+
