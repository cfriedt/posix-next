+	struct sys_aio_group *grp = NULL;
+	struct sys_aio_req req = {
+		.op = SYS_AIO_OP_READ,
+		.fd = file_fd,
+		.buf = buf,
+		.len = sizeof(buf),
+		.flags = SYS_AIO_REQ_OFFSET,
+	};
+	struct sys_aio_notify notify = {
+		.target = k_current_get(),
+		.signo = K_SIG_USR1,
+	};
+
+	zassert_equal(sys_aio_group_create(NULL, &grp), -EINVAL);
+	zassert_equal(sys_aio_group_create(&notify, NULL), -EINVAL);
+
+	/* a request handle is not a group */
+	aio = submit_ok(SYS_AIO_OP_READ, file_fd, buf, sizeof(buf), 0, SYS_AIO_REQ_OFFSET);
+	await_ok(aio);
+	zassert_equal(sys_aio_submit(&req, NULL, (struct sys_aio_group *)aio, &aio),
+		      -EINVAL);
+	/* a group handle is not a request */
+	zassert_ok(sys_aio_group_create(&notify, &grp));
+	zassert_equal(sys_aio_error((struct sys_aio *)grp), -EINVAL);
+	zassert_equal(sys_aio_release((struct sys_aio *)grp, NULL, NULL), -EINVAL);
+	zassert_ok(sys_aio_group_finalize(grp));
+
+	sig_block(K_SIG_USR1);
+	(void)sig_accept(K_SIG_USR1, NULL, K_NO_WAIT);
+	zassert_equal(reap_ok(aio), sizeof(buf));
+}
+
+ZTEST_USER(sys_aio, test_sys_aio_group_create)
+{
+	if (!IS_ENABLED(CONFIG_SIGNAL)) {
+		ztest_test_skip();
+		return;
+	}
+	group_notifies_once_when_drained();
+	group_create_errors();
+}
+
+/* sections of test_sys_aio_group_finalize */
+
+static void group_finalize_empty_fires(void)
+{
+	struct k_sig_info info;
+	struct sys_aio_group *grp = NULL;
+	struct sys_aio_notify notify = {
+		.target = k_current_get(),
+		.signo = K_SIG_USR1,
+		.value.sival_int = 78,
+	};
+
+	sig_block(K_SIG_USR1);
+
+	zassert_ok(sys_aio_group_create(&notify, &grp));
+	zassert_ok(sys_aio_group_finalize(grp));
+
+	zassert_equal(sig_accept(K_SIG_USR1, &info, TIMEOUT), K_SIG_USR1);
+	zassert_equal(info.value.sival_int, 78);
+
+	/* the group destroyed itself when the notification fired */
+	zassert_equal(sys_aio_group_finalize(grp), -EINVAL);
+}
+
+static void group_finalize_waits_for_members(void)
+{
+	zvfs_eventfd_t value;
+	struct k_sig_info info;
+	struct sys_aio_group *grp = NULL;
+	struct sys_aio *aio = NULL;
+	struct sys_aio_req req = {
+		.op = SYS_AIO_OP_READ,
+		.fd = efd,
+		.buf = &value,
+		.len = sizeof(value),
+	};
+	struct sys_aio_notify notify = {
+		.target = k_current_get(),
+		.signo = K_SIG_USR1,
+		.value.sival_int = 79,
+	};
+
+	sig_block(K_SIG_USR1);
+
+	zassert_ok(sys_aio_group_create(&notify, &grp));
+	zassert_ok(sys_aio_submit(&req, NULL, grp, &aio));
+	zassert_ok(sys_aio_group_finalize(grp));
+
+	/* the member is still armed: no notification yet */
+	zassert_true(sig_accept(K_SIG_USR1, NULL, K_NO_WAIT) < 0);
+	/* finalizing again: already finalized */
+	zassert_equal(sys_aio_group_finalize(grp), -EINVAL);
+
+	efd_add(efd, 1);
+	zassert_equal(sig_accept(K_SIG_USR1, &info, TIMEOUT), K_SIG_USR1);
+	zassert_equal(info.value.sival_int, 79);
+
+	zassert_equal(reap_ok(aio), sizeof(value));
+}
+
+static void group_finalize_errors(void)
+{
+	zassert_equal(sys_aio_group_finalize(NULL), -EINVAL);
+}
+
+ZTEST_USER(sys_aio, test_sys_aio_group_finalize)
+{
+	if (!IS_ENABLED(CONFIG_SIGNAL)) {
+		ztest_test_skip();
+		return;
+	}
+	group_finalize_empty_fires();
+	group_finalize_waits_for_members();
+	group_finalize_errors();
+}
+
+ZTEST_SUITE(sys_aio, NULL, suite_setup, before, after, NULL);
