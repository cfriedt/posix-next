+/* a member the application suspended itself is not resumed by the continue */
+static void kill_stop_suspended_member(void)
+{
+	int ws = 0;
+	char state[32];
+	k_pid_t child = &child_a;
+	struct sys_clone_args args = {
+		.entry = stop_leader_entry,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
