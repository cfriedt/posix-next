+/* the leader suspends a member of its own before it takes the stop */
+static void stop_leader_entry(void *p1, void *p2, void *p3)
+{
+	k_tid_t member = k_thread_create(&stop_member, stop_member_stack, STATIC_PROC_STACK_SIZE,
+					 stop_member_entry, NULL, NULL, NULL,
+					 K_LOWEST_APPLICATION_THREAD_PRIO, 0, K_NO_WAIT);
+
+	k_thread_suspend(member);
