diff --git a/arch/x86/core/intel64/user_thread_pointer.h b/arch/x86/core/intel64/user_thread_pointer.h
new file mode 100644
--- /dev/null
+++ b/arch/x86/core/intel64/user_thread_pointer.h
@@ -0,0 +1,47 @@
+/*
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * A thread that owns its thread-pointer register (CONFIG_USER_THREAD_POINTER)
+ * runs user mode on its own FS base and the kernel on the thread's TLS base:
+ * the register is switched on every entry from and exit to user mode of such
+ * a thread. \thread holds the k_thread; rax, rcx and rdx are clobbered.
+ */
+
+#ifndef ZEPHYR_ARCH_X86_CORE_INTEL64_USER_THREAD_POINTER_H_
+#define ZEPHYR_ARCH_X86_CORE_INTEL64_USER_THREAD_POINTER_H_
+
+#include <zephyr/arch/x86/msr.h>
+#include <zephyr/arch/x86/intel64/thread.h>
+#include <offsets_short.h>
+
+.macro X86_FS_BASE_KERNEL thread
+#ifdef CONFIG_USER_THREAD_POINTER
+	testb $X86_THREAD_FLAG_USER_FS, _thread_offset_to_flags(\thread)
+	jz 8f
+	movl $X86_FS_BASE, %ecx
+	movq _thread_offset_to_tls(\thread), %rax
+	movq %rax, %rdx
+	shrq $32, %rdx
+	wrmsr
+8:
+#endif /* CONFIG_USER_THREAD_POINTER */
+.endm
+
+.macro X86_FS_BASE_USER thread
+#ifdef CONFIG_USER_THREAD_POINTER
+	testb $X86_THREAD_FLAG_USER_FS, _thread_offset_to_flags(\thread)
+	jz 8f
+	movl $X86_FS_BASE, %ecx
+	movq _thread_offset_to_user_fs(\thread), %rax
+	movq %rax, %rdx
+	shrq $32, %rdx
+	wrmsr
+8:
+#endif /* CONFIG_USER_THREAD_POINTER */
+.endm
+
+#endif /* ZEPHYR_ARCH_X86_CORE_INTEL64_USER_THREAD_POINTER_H_ */
diff --git a/arch/x86/core/intel64/userspace.S b/arch/x86/core/intel64/userspace.S
--- a/arch/x86/core/intel64/userspace.S
+++ b/arch/x86/core/intel64/userspace.S
@@ -9,6 +9,7 @@
 #include <offsets_short.h>
 #include <zephyr/syscall.h>
 #include <zephyr/kernel/mm.h>
+#include "user_thread_pointer.h"
 
 /* Imports */
 #if defined(CONFIG_SIGNAL)
@@ -158,6 +159,16 @@ _id_ok:
 	pushq	%r10
 	pushq	%r11	/* RFLAGS */
 	pushq	%rcx	/* Return address stored by 'syscall' */
+#ifdef CONFIG_USER_THREAD_POINTER
+	/* the kernel's TLS base for a thread that runs user mode on its own */
+	pushq	%rax
+	pushq	%rdx
+	movq	%gs:__x86_tss64_t_cpu_OFFSET, %r11
+	movq	___cpu_t_current_OFFSET(%r11), %r11
+	X86_FS_BASE_KERNEL %r11
+	popq	%rdx
+	popq	%rax
+#endif /* CONFIG_USER_THREAD_POINTER */
 	pushq	%rsp	/* SSF parameter */
 
 	/* All other args are in the right registers, except arg4 which
@@ -247,6 +258,13 @@ _skip_z_sig_handle:
 	 */
 .global z_x86_syscall_exit
 z_x86_syscall_exit:
+#ifdef CONFIG_USER_THREAD_POINTER
+	pushq	%rax
+	movq	%gs:__x86_tss64_t_cpu_OFFSET, %rdi
+	movq	___cpu_t_current_OFFSET(%rdi), %rdi
+	X86_FS_BASE_USER %rdi
+	popq	%rax
+#endif /* CONFIG_USER_THREAD_POINTER */
 	popq	%rcx	/* Restore return address for 'sysretq' */
 	popq	%r11	/* Restore RFLAGS for 'sysretq' */
 	popq	%r10
diff --git a/arch/x86/core/offsets/intel64_offsets.c b/arch/x86/core/offsets/intel64_offsets.c
--- a/arch/x86/core/offsets/intel64_offsets.c
+++ b/arch/x86/core/offsets/intel64_offsets.c
@@ -32,6 +32,10 @@ GEN_OFFSET_SYM(_thread_arch_t, cs);
 GEN_OFFSET_SYM(_thread_arch_t, psp);
 #ifndef CONFIG_X86_COMMON_PAGE_TABLE
 GEN_OFFSET_SYM(_thread_arch_t, ptables);
+#ifdef CONFIG_USER_THREAD_POINTER
+GEN_OFFSET_SYM(_thread_arch_t, user_fs);
+GEN_OFFSET_STRUCT(arch_esf, cs);
+#endif
 #endif
 #endif /* CONFIG_USERSPACE */
 #ifdef CONFIG_HW_SHADOW_STACK
diff --git a/arch/x86/core/userspace.c b/arch/x86/core/userspace.c
--- a/arch/x86/core/userspace.c
+++ b/arch/x86/core/userspace.c
@@ -176,3 +176,17 @@ int arch_thread_priv_stack_space_get(const struct k_thread *thread, size_t *stac
 				 sizeof(hdr_stack_obj->privilege_stack),
 				 unused_ptr);
 }
+
+#ifdef CONFIG_USER_THREAD_POINTER
+void arch_user_thread_pointer_set(struct k_thread *thread, uintptr_t tp)
+{
+	thread->arch.user_fs = tp;
+	thread->arch.flags |= X86_THREAD_FLAG_USER_FS;
+}
+
+uintptr_t arch_user_thread_pointer_get(struct k_thread *thread)
+{
+	return ((thread->arch.flags & X86_THREAD_FLAG_USER_FS) != 0U) ? thread->arch.user_fs
+								      : thread->tls;
+}
+#endif /* CONFIG_USER_THREAD_POINTER */
