+/*
+ * Children that exit the moment they run while their parent signals them: on
+ * two CPUs the exit's halt and the signal's wake-up meet, each holding one of
+ * the scheduler lock and process_lock.
+ */
+static void kill_exit_storm(void)
+{
+	k_pid_t child = &child_a;
+	struct sys_clone_args args = {
+		.entry = storm_child_entry,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = 0,
+	};
+	int prio = k_thread_priority_get(k_current_get());
+
+	k_thread_priority_set(k_current_get(), 0);
+	for (int i = 0; i < 64; i++) {
+		zassert_ok(sys_clone(&args, NULL));
+		(void)k_kill(child, K_SIG_CONT);
+		(void)k_kill(child, K_SIG_STOP);
+		(void)k_kill(child, K_SIG_CONT);
+		zassert_ok(k_waitpid(child, NULL, NULL, 0, K_SECONDS(5)), "round %d", i);
+	}
+	k_thread_priority_set(k_current_get(), prio);
+}
