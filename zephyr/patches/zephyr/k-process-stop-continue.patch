+/* suspend @a thread while it is a running member of @a proc; true if this did */
+static bool process_member_suspend(struct k_process *proc, struct k_thread *thread)
+{
+	bool member = false;
+	k_spinlock_key_t key = z_sched_spinlock_lock();
+
+	K_SPINLOCK(&process_lock) {
+		member = (thread->process == proc);
+	}
+	if (!member || z_is_thread_suspended(thread)) {
+		z_sched_spinlock_unlock(key);
+		return false;
+	}
+	z_thread_halt(thread, key, false);
+
+	return true;
