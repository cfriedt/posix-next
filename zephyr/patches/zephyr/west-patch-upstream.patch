+    def sync(self, args, db, repo, series):
+        changed = []
+        listed = {}
+        for pr in repo.my_prs():
+            listed.setdefault(pr["headRefName"], pr)
+        for e in series:
+            if e.merged:
+                continue
+            if not e.merge_pr:
+                pr = listed.get(e.branch)
+                if pr is None:
+                    continue
+                e.set("merge-pr", pr["url"])
+                e.set_custom("branch", pr["headRefName"])
+                changed.append(f"{e.stem}: found PR {pr['url']}")
+            info = repo.pr_info(e.merge_pr)
+            if info is None:
+                continue
+            if info["state"] == "MERGED":
+                e.set("merge-status", True)
+                oid = (info.get("mergeCommit") or {}).get("oid")
+                if oid:
+                    e.set("merge-commit", oid)
+                if info.get("mergedAt"):
+                    e.set("merge-date", datetime.date.fromisoformat(info["mergedAt"][:10]))
+                changed.append(f"{e.stem}: merged as {oid or '?'}")
+            elif info["state"] == "CLOSED":
+                self.wrn(f"{e.stem}: PR {e.merge_pr} was closed without merging")
+
+        for line in changed:
+            self.inf(line)
