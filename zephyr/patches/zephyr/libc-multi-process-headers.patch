diff --git a/lib/libc/newlib/include/sys/wait.h b/lib/libc/newlib/include/sys/wait.h
new file mode 100644
index 00000000000..2db12040a83
--- /dev/null
+++ b/lib/libc/newlib/include/sys/wait.h
@@ -0,0 +1,27 @@
+/*
+ * Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_SYS_WAIT_H_
+#define ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_SYS_WAIT_H_
+
+/*
+ * <stdlib.h> pulls in <sys/_wait.h>, which defines a subset of these with its own
+ * encoding. Claim its guard and drop anything it already defined, so the values the
+ * wait wrappers hand to k_waitpid() are the kernel's.
+ */
+#define _SYS__WAIT_H
+#undef WEXITSTATUS
+#undef WIFEXITED
+#undef WIFSIGNALED
+#undef WIFSTOPPED
+#undef WNOHANG
+#undef WSTOPSIG
+#undef WTERMSIG
+#undef WUNTRACED
+
+#include <zephyr/posix/sys/wait.h>
+
+#endif /* ZEPHYR_LIB_LIBC_NEWLIB_INCLUDE_SYS_WAIT_H_ */
