+static const char *zvfs_fs_type_name(int type)
+{
+	switch (type) {
+	case FS_FATFS:
+		return "vfat";
+	case FS_LITTLEFS:
+		return "littlefs";
+	case FS_EXT2:
+		return "ext2";
+	case FS_VIRTIOFS:
+		return "virtiofs";
+	case FS_RPMSGFS:
+		return "rpmsgfs";
+	case FS_NATIVE_MOUNT:
+		return "native";
+	case FS_TMPFS:
+		return "tmpfs";
+	default:
+		return NULL;
+	}
+}
+
+int z_impl_zvfs_readmount(int *index, struct zvfs_mntent *ent)
+{
+	const char *name;
+	const char *type_name;
+	uint8_t flags = 0;
+	int type = 0;
+	int rc;
+
+	if (*index < 0) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	rc = fs_readmount(index, &name);
+	if (rc < 0) {
+		return zvfs_err(rc);
+	}
+	(void)fs_mount_flags(name, &flags);
+	(void)fs_mount_type(name, &type);
+
+	strncpy(ent->mnt_dir, name, sizeof(ent->mnt_dir) - 1);
+	ent->mnt_dir[sizeof(ent->mnt_dir) - 1] = '\0';
+	type_name = zvfs_fs_type_name(type);
+	if (type_name != NULL) {
+		strncpy(ent->mnt_type, type_name, sizeof(ent->mnt_type) - 1);
+		ent->mnt_type[sizeof(ent->mnt_type) - 1] = '\0';
+	} else {
+		snprintf(ent->mnt_type, sizeof(ent->mnt_type), "fs%d", type);
+	}
+	ent->mnt_flags = ((flags & FS_MOUNT_FLAG_READ_ONLY) != 0) ? ZVFS_MNT_RDONLY : 0;
+
+	return 0;
+}
+
+#ifdef CONFIG_USERSPACE
+static int z_vrfy_zvfs_readmount(int *index, struct zvfs_mntent *ent)
+{
+	int idx;
+	int ret;
+
+	K_OOPS(k_usermode_from_copy(&idx, index, sizeof(idx)));
+	K_OOPS(K_SYSCALL_MEMORY_WRITE(ent, sizeof(*ent)));
+
+	ret = z_impl_zvfs_readmount(&idx, ent);
+	K_OOPS(k_usermode_to_copy(index, &idx, sizeof(idx)));
+
+	return ret;
+}
