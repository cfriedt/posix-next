+#define K_SIG_FAULT_NONE      0
+#define K_SIG_FAULT_PENDING   1 /* a handler is to run */
+#define K_SIG_FAULT_DELIVERED 2 /* the handler runs; its return ends the process */
+#define K_SIG_FAULT_FORCED    3 /* the default action ends the process */
+/*
+ * From the arch fault handler, interrupts locked: turn a user-mode fault of the current thread
+ * into a signal. True when the arch is to resume the thread in z_sig_fault_entry().
+ */
+bool z_sig_fault(int signo, int code, void *addr);
+/* a pending fault signal becomes the action being handled; 1 when claimed */
+int z_sig_fault_claim(struct k_thread *tid);
+/* user-mode code a faulting thread resumes in: k_sig_fault(), forever */
+FUNC_NORETURN void z_sig_fault_entry(void);
+#endif /* CONFIG_SIGNAL_FAULT */
 /* a signal may be deliverable to tid (its own or its process's) */
