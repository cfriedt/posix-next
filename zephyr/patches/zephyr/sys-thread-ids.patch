+ZTEST(kernel_process, test_thread_id)
+{
+	k_tid_t self = k_current_get();
+	int tid = sys_thread_id(self);
+	k_pid_t child = &child_a;
+	struct sys_clone_args args = {
+		.entry = spawn_entry_exit,
+		.p1 = (void *)(intptr_t)0,
+		.thread = &child_a,
+		.stack = child_stack_a,
+		.stack_size = STATIC_PROC_STACK_SIZE,
+		.prio = K_LOWEST_APPLICATION_THREAD_PRIO,
+	};
+
+	zassert_equal(sys_thread_id(NULL), -ESRCH);
+
+	/* a member thread numbers in the shared space, distinct from its pid */
+	zassert_true(tid >= 3, "tid=%d pid=%d", tid, sys_process_id(k_getpid()));
+	zassert_true(tid != sys_process_id(k_getpid()));
+
+	/* a leader's thread ID is its process ID */
+	zassert_ok(sys_clone(&args, NULL));
+	zassert_equal(sys_thread_id(child), sys_process_id(child));
+	zassert_ok(k_waitpid(child, NULL, NULL, 0, K_FOREVER));
+
+	/* reaping retires the leader's number */
+	zassert_equal(sys_thread_id(child), -ESRCH);
+}
