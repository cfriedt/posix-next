        <type>int</type>
        <definition>int rand_r</definition>
        <argsstring>(unsigned int *seed)</argsstring>
        <name>rand_r</name>
        <param>
          <type>unsigned int *</type>
          <declname>seed</declname>
        </param>
        <briefdescription>
<para>Generate a pseudo-random number (reentrant). </para>
        </briefdescription>
        <detaileddescription>
<para>Updates <computeroutput>seed</computeroutput> and returns the next value in the same sequence as <computeroutput>rand()</computeroutput> after <computeroutput>srand</computeroutput>(<computeroutput>seed</computeroutput>).</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>seed</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the seed value; updated on return. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A pseudo-random integer in the range [0, <computeroutput>RAND_MAX</computeroutput>]. </para>
</simplesect>
<simplesect kind="see"><para><ulink url="https://pubs.opengroup.org/onlinepubs/9699919799/functions/rand_r.html">https://pubs.opengroup.org/onlinepubs/9699919799/functions/rand_r.html</ulink> </para>
</simplesect>
</para>
        </detaileddescription>
