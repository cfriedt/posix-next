diff --git a/include/zephyr/sys/aio.h b/include/zephyr/sys/aio.h
new file mode 100644
index 00000000000..8862c95bf9c
--- /dev/null
+++ b/include/zephyr/sys/aio.h
@@ -0,0 +1,266 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_SYS_AIO_H_
+#define ZEPHYR_INCLUDE_SYS_AIO_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/kernel/signal.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @defgroup sys_aio_apis OS-managed asynchronous I/O APIs
+ * @ingroup os_services
+ *
+ * An OS-managed pool of asynchronous I/O requests over file descriptors: the
+ * substrate for POSIX asynchronous I/O (aio_read() and friends), following
+ * the sys_timer/sys_thread/sys_msgq pool pattern.
+ *
+ * A request submitted with sys_aio_submit() is performed by a dedicated
+ * kernel service queue: descriptors with a waitable readiness condition
+ * (e.g. sockets, eventfds) are armed on ZVFS_POLLIN/ZVFS_POLLOUT readiness
+ * and performed once ready; descriptors that are always ready (e.g. regular
+ * files) are performed directly. With @kconfig{CONFIG_SYS_AIO_PRIORITY},
+ * ready requests are performed in request-priority order rather than
+ * submission order. Completion is observed with
+ * sys_aio_error()/sys_aio_wait(), optionally announced by a completion
+ * notification, and the request slot is returned to the pool with
+ * sys_aio_release(). Handles are pool object pointers validated on every
+ * call: a stale or foreign handle fails with -EINVAL rather than faulting.
+ *
+ * The buffer named by a request must remain valid and accessible until the
+ * request is released.
+ * @{
+ */
+
+/** @brief Opaque asynchronous I/O request handle. */
+struct sys_aio;
+
+/** @brief Opaque completion-group handle (see sys_aio_group_create()). */
+struct sys_aio_group;
+
+/** @brief sys_aio_req operation: read into @c buf, possibly at @c offset. */
+#define SYS_AIO_OP_READ  0
+/** @brief sys_aio_req operation: write from @c buf, possibly at @c offset. */
+#define SYS_AIO_OP_WRITE 1
+/** @brief sys_aio_req operation: synchronize the descriptor's backing store. */
+#define SYS_AIO_OP_FSYNC 2
+
+/** @brief sys_aio_req flag: @c offset is explicit (pread/pwrite style). */
+#define SYS_AIO_REQ_OFFSET BIT(0)
+
+/**
+ * @brief Asynchronous I/O request description for sys_aio_submit().
+ *
+ * When @ref SYS_AIO_REQ_OFFSET is set and the descriptor supports positioned
+ * I/O (regular files and shared memory), the transfer occurs at @ref offset
+ * without moving the descriptor's file offset; otherwise the descriptor's
+ * own position is used and @ref offset is ignored.
+ */
+struct sys_aio_req {
+	/** Operation, one of @c SYS_AIO_OP_READ/WRITE/FSYNC */
+	int op;
+	/** File descriptor the operation applies to */
+	int fd;
+	/** Data buffer (ignored for @c SYS_AIO_OP_FSYNC) */
+	void *buf;
+	/** Transfer length in bytes (ignored for @c SYS_AIO_OP_FSYNC) */
+	size_t len;
+	/** Explicit offset, used when @ref SYS_AIO_REQ_OFFSET is set */
+	size_t offset;
+	/** @c SYS_AIO_REQ_* flags */
+	uint32_t flags;
+	/**
+	 * Request priority, in the thread priority convention (numerically
+	 * lower executes first). Ready requests are performed in priority
+	 * order - first-in-first-out among equals - when
+	 * @kconfig{CONFIG_SYS_AIO_PRIORITY} is enabled; ignored otherwise.
+	 */
+	int prio;
+};
+
+/**
+ * @brief Completion notification for sys_aio_submit() / sys_aio_group_create().
+ *
+ * When @ref fn is NULL, signal @ref signo carrying @ref value is generated
+ * for thread @ref target on completion; a @ref signo of 0 requests no
+ * notification (POSIX `SIGEV_NONE`). When @ref fn is non-NULL, a detached
+ * system-pool thread runs `fn(value)` instead (POSIX `SIGEV_THREAD`);
+ * @ref fn_priority and @ref fn_stack_size shape that thread, which runs in
+ * user mode in the submitter's memory domain when the request was submitted
+ * from a user thread.
+ */
+struct sys_aio_notify {
+	/** Thread the signal is generated for (fn == NULL, signo != 0) */
+	k_pid_t target;
+	/** Signal number to generate, or 0 for none */
+	int signo;
+	/** Value carried by the notification */
+	union k_sig_val value;
+	/** Function notification: called as fn(value) from a detached thread */
+	void (*fn)(union k_sig_val value);
+	/** Priority of the function-notification thread */
+	int fn_priority;
+	/** Stack size of the function-notification thread (0 for default) */
+	size_t fn_stack_size;
+};
+
+/** @brief sys_aio_cancel() result: every selected request was canceled. */
+#define SYS_AIO_CANCELED    0
+/** @brief sys_aio_cancel() result: at least one selected request could not be canceled. */
+#define SYS_AIO_NOTCANCELED 1
+/** @brief sys_aio_cancel() result: every selected request had already completed. */
+#define SYS_AIO_ALLDONE     2
+
+/**
+ * @brief Submit an asynchronous I/O request.
+ *
+ * Validates @a req->fd, allocates a request from the pool, and dispatches
+ * the operation to the asynchronous I/O service queue. On success `*aio`
+ * names the request; the slot stays allocated - even after completion,
+ * failure, or cancellation - until sys_aio_release(). The buffer must
+ * remain valid and accessible until then.
+ *
+ * A completed request holds the operation's result (byte count, or the
+ * operation's errno) for sys_aio_error()/sys_aio_release() to report.
+ * Closing the descriptor with a request in flight completes the request
+ * with `EBADF`; cancel requests before closing.
+ *
+ * @param req Operation description.
+ * @param notify Completion notification, or NULL for none.
+ * @param grp Completion group the request joins, or NULL (see
+ *            sys_aio_group_create()).
+ * @param aio Where to store the request handle.
+ *
+ * @retval 0 Request submitted (and possibly already complete).
+ * @retval -EBADF @a req->fd is not an open file descriptor.
+ * @retval -EINVAL Bad operation, flags, notification fields, or @a grp.
+ * @retval -EAGAIN The request pool is exhausted.
+ * @retval -ENOTSUP The notification kind is not supported by this
+ *         configuration (signals need @kconfig{CONFIG_SIGNAL}; function
+ *         notification needs @kconfig{CONFIG_SYS_THREAD} and
+ *         @kconfig{CONFIG_THREAD_DETACH}).
+ */
+__syscall int sys_aio_submit(const struct sys_aio_req *req, const struct sys_aio_notify *notify,
+			     struct sys_aio_group *grp, struct sys_aio **aio);
+
+/**
+ * @brief Query the completion status of a request.
+ *
+ * @param aio Request handle from sys_aio_submit().
+ *
+ * @retval EINPROGRESS The operation has not yet completed.
+ * @retval 0 The operation completed successfully.
+ * @retval >0 The errno of the failed operation (`ECANCELED` when canceled).
+ * @retval -EINVAL Stale or foreign handle.
+ */
+__syscall int sys_aio_error(const struct sys_aio *aio);
+
+/**
+ * @brief Reap a completed request, returning its slot to the pool.
+ *
+ * @param aio Request handle from sys_aio_submit().
+ * @param error Where to store the final status (as sys_aio_error()), or NULL.
+ * @param result Where to store the bytes transferred (0 for fsync), or -1
+ *               when the operation failed or was canceled; may be NULL.
+ *
+ * @retval 0 Request reaped; the handle is stale from now on.
+ * @retval -EBUSY The operation has not yet completed.
+ * @retval -EINVAL Stale or foreign handle.
+ */
+__syscall int sys_aio_release(struct sys_aio *aio, int *error, ssize_t *result);
+
+/**
+ * @brief Cancel one request, or every in-flight request on a descriptor.
+ *
+ * A request that is armed or queued but not yet executing is canceled: it
+ * completes with `ECANCELED`, wakes sys_aio_wait() waiters, fires its
+ * completion notification, and still requires sys_aio_release(). A request
+ * already executing is not canceled.
+ *
+ * @param fd File descriptor the request(s) belong to.
+ * @param aio Request handle to cancel, or NULL to cancel all on @a fd.
+ *
+ * @retval SYS_AIO_CANCELED Every selected request was canceled.
+ * @retval SYS_AIO_NOTCANCELED At least one selected request is executing.
+ * @retval SYS_AIO_ALLDONE Every selected request had already completed.
+ * @retval -EBADF @a fd is not an open file descriptor.
+ * @retval -EINVAL Stale or foreign handle, or @a aio does not belong to @a fd.
+ */
+__syscall int sys_aio_cancel(int fd, struct sys_aio *aio);
+
+/**
+ * @brief Wait until at least one listed request has completed.
+ *
+ * Returns immediately when any listed request has already completed
+ * (including by cancellation).
+ *
+ * @param list Array of request handles; NULL entries are ignored.
+ * @param nents Number of entries in @a list, at most
+ *              @kconfig{CONFIG_SYS_AIO_WAIT_MAX}.
+ * @param timeout Waiting period, or K_NO_WAIT / K_FOREVER.
+ *
+ * @retval 0 At least one listed request has completed.
+ * @retval -EAGAIN The waiting period timed out.
+ * @retval -EINVAL Stale or foreign handle, @a nents out of range, or no
+ *         non-NULL entries.
+ */
+__syscall int sys_aio_wait(struct sys_aio *const *list, size_t nents, k_timeout_t timeout);
+
+/**
+ * @brief Create a completion group.
+ *
+ * A completion group announces - with a single notification - the moment
+ * when every request submitted into it has completed (the substrate for
+ * POSIX `lio_listio(LIO_NOWAIT)` list notification). Submit members with
+ * sys_aio_submit()'s @c grp parameter, then arm the group with
+ * sys_aio_group_finalize(). The group is destroyed automatically after its
+ * notification fires; there is nothing to release.
+ *
+ * @param notify Notification fired when the finalized group's last member
+ *               completes.
+ * @param grp Where to store the group handle.
+ *
+ * @retval 0 Group created.
+ * @retval -EINVAL Bad notification fields.
+ * @retval -EAGAIN The request pool is exhausted.
+ * @retval -ENOTSUP The notification kind is not supported by this
+ *         configuration.
+ */
+__syscall int sys_aio_group_create(const struct sys_aio_notify *notify,
+				   struct sys_aio_group **grp);
+
+/**
+ * @brief Finalize a completion group.
+ *
+ * Declares that no further requests will be submitted into @a grp. The
+ * group notification fires once every member has completed - immediately,
+ * when they already have (or the group is empty) - and the group is then
+ * destroyed. The handle is stale once the notification has fired.
+ *
+ * @param grp Group handle from sys_aio_group_create().
+ *
+ * @retval 0 Group finalized.
+ * @retval -EINVAL Stale or foreign handle, or already finalized.
+ */
+__syscall int sys_aio_group_finalize(struct sys_aio_group *grp);
+
+/** @} */
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <zephyr/syscalls/aio.h>
+
+#endif /* ZEPHYR_INCLUDE_SYS_AIO_H_ */
