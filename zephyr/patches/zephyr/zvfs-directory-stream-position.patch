+/**
+ * @brief Report the position of a directory stream.
+ *
+ * The position is the count of entries read since the stream was opened or
+ * last rewound.
+ *
+ * @param fd Directory file descriptor.
+ *
+ * @return The position, or -1 with errno set on error.
+ */
+__syscall long zvfs_telldir(int fd);
+
+/**
+ * @brief Return a directory stream to a position zvfs_telldir() reported.
+ *
+ * @param fd Directory file descriptor.
+ * @param pos The position.
+ *
+ * @return 0 on success, -1 with errno set on error.
+ */
+__syscall int zvfs_seekdir(int fd, long pos);
+
 /**
  * @brief Open a path on a mounted Zephyr file system and return an fd.
  *
diff --git a/lib/os/zvfs/zvfs_dirent.c b/lib/os/zvfs/zvfs_dirent.c
--- a/lib/os/zvfs/zvfs_dirent.c
+++ b/lib/os/zvfs/zvfs_dirent.c
@@ -177,3 +177,48 @@ static int z_vrfy_zvfs_rewinddir(int fd)
 }
 #include <zephyr/syscalls/zvfs_rewinddir_mrsh.c>
 #endif /* CONFIG_USERSPACE */
+
+long z_impl_zvfs_telldir(int fd)
+{
+	long pos;
+
+	if (zvfs_dir_fd_ioctl(fd, ZFD_IOCTL_TELLDIR, &pos) < 0) {
+		return -1;
+	}
+
+	return pos;
+}
+
+#ifdef CONFIG_USERSPACE
+static long z_vrfy_zvfs_telldir(int fd)
+{
+	if (zvfs_fd_syscall_verify(fd) == NULL) {
+		return -1;
+	}
+
+	return z_impl_zvfs_telldir(fd);
+}
+#include <zephyr/syscalls/zvfs_telldir_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
+int z_impl_zvfs_seekdir(int fd, long pos)
+{
+	if (pos < 0) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	return zvfs_dir_fd_ioctl(fd, ZFD_IOCTL_SEEKDIR, &pos);
+}
+
+#ifdef CONFIG_USERSPACE
+static int z_vrfy_zvfs_seekdir(int fd, long pos)
+{
+	if (zvfs_fd_syscall_verify(fd) == NULL) {
+		return -1;
+	}
+
+	return z_impl_zvfs_seekdir(fd, pos);
+}
+#include <zephyr/syscalls/zvfs_seekdir_mrsh.c>
+#endif /* CONFIG_USERSPACE */
