+
+static void wait_any_of_two(void)
+{
+	char buf[4];
+	zvfs_eventfd_t value;
+	struct sys_aio *pending;
+	struct sys_aio *quick;
+	struct sys_aio *const list[] = {
+		pending = submit_ok(SYS_AIO_OP_READ, efd, &value, sizeof(value), 0, 0),
+		quick = submit_ok(SYS_AIO_OP_READ, file_fd, buf, sizeof(buf), 0,
+				  SYS_AIO_REQ_OFFSET),
+	};
+
+	/* the file read completes; the eventfd read stays armed */
+	zassert_ok(sys_aio_wait(list, ARRAY_SIZE(list), TIMEOUT));
+	zassert_equal(reap_ok(quick), sizeof(buf));
+
+	zassert_equal(sys_aio_cancel(efd, pending), SYS_AIO_CANCELED);
+	zassert_ok(sys_aio_release(pending, NULL, NULL));
+}
+
+static void wait_errors(void)
+{
+	char buf[4];
+	struct sys_aio *aio;
+	struct sys_aio *list[CONFIG_SYS_AIO_WAIT_MAX + 1] = {NULL};
+
+	zassert_equal(sys_aio_wait(list, 0, K_NO_WAIT), -EINVAL);
+	zassert_equal(sys_aio_wait(list, ARRAY_SIZE(list), K_NO_WAIT), -EINVAL);
+	/* NULL entries are ignored; a list of nothing but NULL is an error */
+	zassert_equal(sys_aio_wait(list, 2, K_NO_WAIT), -EINVAL);
+
+	/* a stale handle is detected */
+	aio = submit_ok(SYS_AIO_OP_READ, file_fd, buf, sizeof(buf), 0, SYS_AIO_REQ_OFFSET);
+	await_ok(aio);
+	zassert_equal(reap_ok(aio), sizeof(buf));
+	list[0] = aio;
+	zassert_equal(sys_aio_wait(list, 1, K_NO_WAIT), -EINVAL);
+}
+
+ZTEST_USER(sys_aio, test_sys_aio_wait)
+{
+	wait_already_complete();
+	wait_timeout();
+	wait_any_of_two();
+	wait_errors();
+}
