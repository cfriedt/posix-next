+ZTEST_USER(zvfs_fs, test_zvfs_telldir)
+{
+	struct zvfs_dirstream *d;
+	int fd;
+
+	/* the position counts the entries read; a rewind resets it */
+	d = zvfs_opendir(MNT);
+	zassert_not_null(d);
+	zassert_equal(zvfs_telldir(d->fd), 0);
+	zassert_equal(zvfs_readdir(d->fd, &d->ent), 0);
+	zassert_equal(zvfs_telldir(d->fd), 1);
+	zassert_ok(zvfs_rewinddir(d->fd));
+	zassert_equal(zvfs_telldir(d->fd), 0);
+	zassert_ok(zvfs_close(d->fd));
+
+	/* not a directory */
+	fd = zvfs_open(TFILE, ZVFS_O_RDONLY, 0);
+	zassert_true(fd >= 0);
+	errno = 0;
+	zassert_equal(zvfs_telldir(fd), -1);
+	zassert_equal(errno, ENOTDIR);
+	zassert_ok(zvfs_close(fd));
+}
+
+ZTEST_USER(zvfs_fs, test_zvfs_seekdir)
+{
+	struct zvfs_dirstream *d;
+	char first[ZVFS_NAME_MAX + 1];
+	char second[ZVFS_NAME_MAX + 1];
+
+	/* the mount root holds the fixture file and directory */
+	d = zvfs_opendir(MNT);
+	zassert_not_null(d);
+	zassert_equal(zvfs_readdir(d->fd, &d->ent), 0);
+	strcpy(first, d->ent.d_name);
+	zassert_equal(zvfs_readdir(d->fd, &d->ent), 0);
+	strcpy(second, d->ent.d_name);
+	zassert_equal(zvfs_readdir(d->fd, &d->ent), 1);
+
+	/* back to a reported position, then forward again; past the end reads nothing */
+	zassert_ok(zvfs_seekdir(d->fd, 0));
+	zassert_equal(zvfs_readdir(d->fd, &d->ent), 0);
+	zassert_str_equal(d->ent.d_name, first);
+	zassert_ok(zvfs_seekdir(d->fd, 1));
+	zassert_equal(zvfs_readdir(d->fd, &d->ent), 0);
+	zassert_str_equal(d->ent.d_name, second);
+	zassert_ok(zvfs_seekdir(d->fd, 0));
+	zassert_ok(zvfs_seekdir(d->fd, 2));
+	zassert_equal(zvfs_readdir(d->fd, &d->ent), 1);
+	zassert_equal(zvfs_telldir(d->fd), 2);
+
+	errno = 0;
+	zassert_equal(zvfs_seekdir(d->fd, -1), -1);
+	zassert_equal(errno, EINVAL);
+	zassert_ok(zvfs_close(d->fd));
+}
