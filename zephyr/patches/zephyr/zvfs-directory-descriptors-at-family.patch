+static inline struct zvfs_dirstream *zvfs_opendir(const char *path)
+{
+	int fd = zvfs_openat(ZVFS_AT_FDCWD, path, ZVFS_O_RDONLY | ZVFS_O_DIRECTORY, 0);
+	struct zvfs_dirstream *d;
