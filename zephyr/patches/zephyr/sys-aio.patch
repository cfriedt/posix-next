+static void wait_already_complete(void)
+{
+	char buf[4];
+	struct sys_aio *aio;
+	struct sys_aio *const list[] = {aio = submit_ok(SYS_AIO_OP_READ, file_fd, buf,
+							sizeof(buf), 0, SYS_AIO_REQ_OFFSET)};
+
+	/* completion is sticky: no waiting is ever needed afterwards */
+	zassert_ok(sys_aio_wait(list, 1, TIMEOUT));
+	zassert_ok(sys_aio_wait(list, 1, K_NO_WAIT));
+	zassert_equal(reap_ok(aio), sizeof(buf));
+}
+
+static void wait_timeout(void)
+{
+	zvfs_eventfd_t value;
+	struct sys_aio *aio;
+	struct sys_aio *const list[] = {aio = submit_ok(SYS_AIO_OP_READ, efd, &value,
+							sizeof(value), 0, 0)};
+
+	zassert_equal(sys_aio_wait(list, 1, K_MSEC(50)), -EAGAIN);
+
+	efd_add(efd, 1);
+	await_ok(aio);
