+		*child = tid;
+	}
+
+	if ((args->flags & SYS_CLONE_PAUSED) == 0U) {
+		k_thread_start(tid);
+	}
+
+	return 0;
+#else
+	ARG_UNUSED(args);
+	ARG_UNUSED(child);
+	return -ENOTSUP;
+#endif /* CONFIG_PROCESS_VM */
 }
 
