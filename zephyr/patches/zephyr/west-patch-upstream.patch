+        by_path = {e.path: e for e in series}
+        rows = []
+        for e in series:
+            row = {
+                "path": e.path,
+                "stem": e.stem,
+                "module": os.fspath(repo.module),
+                "deps": e.deps,
+                "pr": e.merge_pr,
+                "status": "unknown",
+                "note": "",
+            }
+            unknown_deps = [d for d in e.deps if d not in by_path]
+            if unknown_deps:
+                row["note"] = "unknown dependency " + ", ".join(unknown_deps)
+            if e.merged:
+                row["status"] = "merged"
+            elif not e.upstreamable:
+                row["status"] = "not-upstreamable"
+            elif e.ignore_reason:
+                row["status"] = "ignored"
