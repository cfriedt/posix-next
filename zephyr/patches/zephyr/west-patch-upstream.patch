+class PatchEntry:
+    """One patches.yml record, with typed accessors over the raw mapping."""
+
+    def __init__(self, data, index):
+        self.data = data
+        self.index = index
+
+    @property
+    def path(self):
+        return self.data["path"]
+
+    @property
+    def stem(self):
+        return Path(self.path).stem
+
+    @property
+    def module(self):
+        return self.data.get("module")
+
+    @property
+    def upstreamable(self):
+        return bool(self.data.get("upstreamable", True))
+
+    @property
+    def merge_pr(self):
+        return self.data.get("merge-pr")
+
+    @property
+    def merged(self):
+        return bool(self.data.get("merge-status", False))
+
+    @property
+    def author(self):
+        return self.data.get("author", "")
+
+    @property
+    def email(self):
+        return self.data.get("email", "")
+
+    @property
+    def date(self):
+        return self.data.get("date")
+
+    @property
+    def comments(self):
+        return (self.data.get("comments") or "").strip()
+
+    def custom_upstream(self, create=False):
+        from ruamel.yaml.comments import CommentedMap
+
+        custom = self.data.get("custom")
+        if not isinstance(custom, dict):
+            if not create:
+                return {}
+            custom = CommentedMap()
+            self.set("custom", custom)
+        upstream = custom.get("upstream")
+        if not isinstance(upstream, dict):
+            if not create:
+                return {}
+            upstream = CommentedMap()
+            custom["upstream"] = upstream
+        return upstream
+
+    @property
+    def ignore_reason(self):
+        value = self.custom_upstream().get("ignore")
+        if value is True:
+            return "ignored"
+        if isinstance(value, str) and value:
+            return value
+        return None
+
+    @property
+    def detected_deps(self):
+        return list(self.custom_upstream().get("depends-on") or [])
+
+    @property
+    def manual_deps(self):
+        return list(self.custom_upstream().get("manual-depends-on") or [])
+
+    @property
+    def deps(self):
+        seen = []
+        for dep in self.detected_deps + self.manual_deps:
+            if dep not in seen:
+                seen.append(dep)
+        return seen
+
+    @property
+    def title(self):
+        return self.custom_upstream().get("title")
+
+    @property
+    def branch(self):
+        return self.custom_upstream().get("branch") or (BRANCH_PREFIX + self.stem)
+
+    def set(self, key, value):
+        """Set a top-level key, inserting new keys ahead of the trailing comments block."""
+        if key in self.data:
+            self.data[key] = value
+            return
+        keys = list(self.data.keys())
+        pos = keys.index("comments") if "comments" in keys else len(keys)
+        self.data.insert(pos, key, value)
+
+    def set_custom(self, key, value):
+        upstream = self.custom_upstream(create=True)
+        if value in (None, [], ""):
+            upstream.pop(key, None)
+        else:
+            upstream[key] = value
+        if not upstream:
+            self.data["custom"].pop("upstream", None)
+        if not self.data.get("custom"):
+            self.data.pop("custom", None)
+
+
+class PatchDB:
+    """Round-trip editor for patches.yml; refuses to touch a file it cannot reproduce."""
+
+    def __init__(self, patch_yml, patch_base):
+        try:
+            from ruamel.yaml import YAML
+        except ImportError as e:
+            raise PatchError("ruamel.yaml is required (pip install ruamel.yaml)") from e
+        self.path = Path(patch_yml)
+        self.patch_base = Path(patch_base)
+        self.yaml = YAML()
+        self.yaml.preserve_quotes = True
+        self.yaml.width = 4096
+        self.yaml.indent(mapping=2, sequence=4, offset=2)
+        self.text = self.path.read_text(encoding="utf-8")
+        self.doc = self.yaml.load(self.text)
+        if self.dump() != self.text:
+            raise PatchError(f"{self.path} does not round-trip through ruamel.yaml; not editing")
+        self.entries = [PatchEntry(d, i) for i, d in enumerate(self.doc.get("patches") or [])]
+
+    def dump(self):
+        out = io.StringIO()
+        self.yaml.dump(self.doc, out)
+        return out.getvalue()
+
+    def save(self):
+        text = self.dump()
+        if text == self.text:
+            return False
+        self.path.write_text(text, encoding="utf-8")
+        self.text = text
+        return True
+
+    def patch_file(self, entry_or_path):
+        rel = entry_or_path.path if isinstance(entry_or_path, PatchEntry) else entry_or_path
+        return self.patch_base / rel
+
+    def find(self, name):
+        """Resolve a user-supplied name (path, basename or stem) to an entry."""
+        for e in self.entries:
+            if name in (e.path, Path(e.path).name, e.stem):
+                return e
+        raise PatchError(f"no patch named {name!r} in {self.path}")
+
+    def by_path(self, path):
+        for e in self.entries:
+            if e.path == path:
+                return e
+        return None
+
+
+class TmpIndex:
+    """A throwaway git index so patches can be trial-applied without a working tree."""
+
+    def __init__(self, repo):
+        self.repo = repo
+        fd, self.file = tempfile.mkstemp(prefix="west-patch-index-")
+        os.close(fd)
+        os.unlink(self.file)
+        self.env = dict(os.environ, GIT_INDEX_FILE=self.file)
+        self.tree = None
+
+    def close(self):
+        if os.path.exists(self.file):
+            os.unlink(self.file)
+
+    def reset(self, tree, paths=None):
+        """Load ``tree`` into the index; with ``paths``, only those entries (much faster)."""
+        if paths is None:
+            _git(self.repo, "read-tree", tree, env=self.env)
+        else:
+            _git(self.repo, "read-tree", "--empty", env=self.env)
+            listing = _git(self.repo, "ls-tree", "-r", "--full-tree", tree, "--", *sorted(paths))
+            _git(self.repo, "update-index", "--index-info", env=self.env, input=listing.stdout)
+        self.tree = tree
+
+    def reset_files(self, paths):
+        _git(self.repo, "reset", "-q", self.tree, "--", *sorted(paths), env=self.env)
+
+    def _apply(self, patch, *flags):
+        return _git(
+            self.repo, "apply", "--cached", *flags, os.fspath(patch), env=self.env, check=False
+        )
+
+    @staticmethod
+    def _include(only):
+        return tuple(f"--include={p}" for p in sorted(only)) if only else ()
+
+    def check(self, patch, only=None):
+        return self._apply(patch, "--check", *self._include(only)).returncode == 0
+
+    def failing_files(self, patch):
+        """Files whose hunks do not apply, or None when the patch applies cleanly."""
+        proc = self._apply(patch, "--check")
+        if proc.returncode == 0:
+            return None
+        files = set()
+        for line in proc.stderr.splitlines():
+            m = re.match(r"^error: patch failed: (.+):\d+$", line)
+            if m:
+                files.add(m.group(1))
+                continue
+            m = re.match(r"^error: (.+?): (?:does not|already|patch does not)", line)
+            if m:
+                files.add(m.group(1))
+        return files or patch_files(patch)
+
+    def reverse_check(self, patch):
+        return self._apply(patch, "--check", "--reverse").returncode == 0
+
+    def apply(self, patch, only=None):
+        return self._apply(patch, *self._include(only)).returncode == 0
+
+    def write_tree(self):
+        return _git(self.repo, "write-tree", env=self.env).stdout.strip()
+
+
+class DepAnalyzer:
+    """Find, for each patch, the minimal set of earlier patches it textually needs.
+
+    Unified diffs apply file by file, so a patch's dependencies are the union of its
+    per-file dependencies. Paths linked by renames form one unit. For each unit that fails
+    to apply on the base tree, the earlier patches touching that unit form an ordered chain;
+    the shortest applying suffix of that chain, greedily minimised, is the dependency set
+    for that unit.
+    """
+
+    def __init__(self, db, entries, index, base_tree, log=None, cache_file=None):
+        self.db = db
+        self.entries = entries
+        self.index = index
+        self.base_tree = base_tree
+        self.log = log or (lambda *a: None)
+        self.cache_file = cache_file
+        self.cache_all = {}
+        if cache_file and cache_file.exists():
+            try:
+                self.cache_all = json.loads(cache_file.read_text(encoding="utf-8"))
+            except ValueError:
+                self.cache_all = {}
+        self.cache = self.cache_all.get(base_tree, {})
+        self.files = {}
+        parent = {}
+
+        def find(x):
+            while parent.setdefault(x, x) != x:
+                x = parent[x]
+            return x
+
+        for e in entries:
+            self.files[e.path], pairs = parse_patch(db.patch_file(e))
+            for a, b in pairs:
+                parent[find(a)] = find(b)
+        self.unit = {}
+        for paths in self.files.values():
+            for f in paths:
+                self.unit.setdefault(find(f), set()).add(f)
+        self.unit = {f: frozenset(u) for u in self.unit.values() for f in u}
+        self.sha = {e.path: Patch.get_file_sha256sum(db.patch_file(e)) for e in entries}
+        self.touchers = {}
+        for e in entries:
+            for u in {self.unit[f] for f in self.files[e.path]}:
+                self.touchers.setdefault(u, []).append(e.path)
+        self.deps = {}
+        self.unapplicable = []
+        self._trials = {}
+
+    def trial(self, entry, unit, seq):
+        key = (entry.path, unit, tuple(seq))
+        if key in self._trials:
+            return self._trials[key]
+        self.index.reset_files(unit)
+        ok = all(self.index.apply(self.db.patch_file(q), only=unit) for q in seq)
+        ok = ok and self.index.check(self.db.patch_file(entry), only=unit)
+        self.index.reset_files(unit)
+        self._trials[key] = ok
+        return ok
+
+    def deps_for_unit(self, entry, unit):
+        chain = self.touchers[unit]
+        chain = chain[: chain.index(entry.path)]
+        need = None
+        for k in range(1, len(chain) + 1):
+            if self.trial(entry, unit, chain[-k:]):
