diff --git a/boards/qemu/riscv64/qemu_riscv64_defconfig b/boards/qemu/riscv64/qemu_riscv64_defconfig
index 18dbae0da77..fb65c1003af 100644
--- a/boards/qemu/riscv64/qemu_riscv64_defconfig
+++ b/boards/qemu/riscv64/qemu_riscv64_defconfig
@@ -1,9 +1,14 @@
 # SPDX-License-Identifier: Apache-2.0
 
-CONFIG_PRIVILEGED_STACK_SIZE=2048
 CONFIG_CONSOLE=y
 CONFIG_SERIAL=y
 CONFIG_UART_CONSOLE=y
 CONFIG_STACK_SENTINEL=y
 CONFIG_XIP=n
-CONFIG_RISCV_PMP=y
+CONFIG_RISCV_S_MODE=y
+CONFIG_QEMU_ICOUNT=y
+# The PLIC driver configures PLIC context 0 (M-mode) for hart 0.  In S-mode
+# Zephyr the correct context is 1 (supervisor mode), so external device
+# interrupts via the PLIC do not reach the CPU.  Disable interrupt-driven
+# UART TX so the shell backend falls back to polling, which works correctly.
+CONFIG_SHELL_BACKEND_SERIAL_INTERRUPT_DRIVEN=n
diff --git a/boards/qemu/riscv64/qemu_riscv64_qemu_virt_riscv64_mmode.dts b/boards/qemu/riscv64/qemu_riscv64_qemu_virt_riscv64_mmode.dts
new file mode 100644
index 00000000000..1ce836c16c8
--- /dev/null
+++ b/boards/qemu/riscv64/qemu_riscv64_qemu_virt_riscv64_mmode.dts
@@ -0,0 +1,45 @@
+/* Copyright (c) 2019 BayLibre SAS */
+/* SPDX-License-Identifier: Apache-2.0 */
+
+/dts-v1/;
+
+#include <qemu/virt-riscv64.dtsi>
+
+/ {
+	chosen {
+		zephyr,console = &uart0;
+		zephyr,shell-uart = &uart0;
+		zephyr,sram = &ram0;
+		zephyr,display = &ramfb0;
+	};
+
+	fwcfg0: fw-cfg@10100000 {
+		compatible = "qemu,fw-cfg-mmio";
+		reg = <0x10100000 0x18>;
+		status = "okay";
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		ramfb_mem: framebuffer@8fc00000 {
+			reg = <0x8fc00000 0x00400000>; /* 4 MiB */
+			no-map;
+		};
+	};
+
+	ramfb0: ramfb {
+		compatible = "qemu,ramfb";
+		fwcfg = <&fwcfg0>;
+		memory-region = <&ramfb_mem>;
+		width = <1024>;
+		height = <768>;
+		status = "okay";
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
