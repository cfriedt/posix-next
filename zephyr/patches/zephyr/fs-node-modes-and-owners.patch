+#if defined(CONFIG_FILE_SYSTEM_ATTRIBUTES)
+/* the node a path names, for an attribute change */
+static int attr_lookup(struct tmpfs_data *fs, struct fs_mount_t *mountp, const char *name,
+		       bool nofollow, struct tmpfs_node **node)
+{
+	const char *path = fs_impl_strip_prefix(name, mountp);
+	struct tmpfs_lookup l;
+	int rc = lookup(fs, path, nofollow, &l);
+
+	if ((rc == 0) && (l.node == NULL)) {
+		rc = -ENOENT;
+	}
+	if (rc == 0) {
+		*node = l.node;
+	}
+
+	return rc;
+}
+
+static int tmpfs_chmod(struct fs_mount_t *mountp, const char *name, uint32_t mode)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	struct tmpfs_node *node;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = attr_lookup(fs, mountp, name, false, &node);
+	if (rc == 0) {
+		node->mode = mode & FS_MODE_PERM;
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int chown_common(struct fs_mount_t *mountp, const char *name, uint32_t uid, uint32_t gid,
+			bool nofollow)
+{
+	struct tmpfs_data *fs = fs_of(mountp);
+	struct tmpfs_node *node;
+	int rc;
+
+	(void)k_mutex_lock(&fs->lock, K_FOREVER);
+	rc = attr_lookup(fs, mountp, name, nofollow, &node);
+	if (rc == 0) {
+		node->uid = uid;
+		node->gid = gid;
+	}
+	k_mutex_unlock(&fs->lock);
+
+	return rc;
+}
+
+static int tmpfs_chown(struct fs_mount_t *mountp, const char *name, uint32_t uid, uint32_t gid)
+{
+	return chown_common(mountp, name, uid, gid, false);
+}
+
+static int tmpfs_lchown(struct fs_mount_t *mountp, const char *name, uint32_t uid, uint32_t gid)
+{
+	return chown_common(mountp, name, uid, gid, true);
+}
