+int z_impl_k_msgq_put_prio(struct k_msgq *msgq, const void *data, size_t len, uint32_t prio,
+			   k_timeout_t timeout)
+{
+	__ASSERT(!arch_is_in_isr() || K_TIMEOUT_EQ(timeout, K_NO_WAIT), "");
+
+	struct z_msgq_prio_slot *slot;
+	struct k_thread *pending_thread;
+	k_timepoint_t end;
+	k_spinlock_key_t key;
+	bool resched = false;
+	bool waited = false;
+	int result;
+
+	if (!msgq_is_prio(msgq)) {
+		return -ENOTSUP;
+	}
+
+	if (len > msgq->msg_size) {
+		return -EMSGSIZE;
+	}
+
+	end = sys_timepoint_calc(timeout);
+	key = k_spin_lock(&msgq->lock);
+
+	SYS_PORT_TRACING_OBJ_FUNC_ENTER(k_msgq, put, msgq, timeout);
+
+	while (msgq->used_msgs >= msgq->max_msgs) {
+		if (K_TIMEOUT_EQ(timeout, K_NO_WAIT)) {
+			/* first pass: don't wait; later passes: deadline expired */
+			result = waited ? -EAGAIN : -ENOMSG;
+			SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_msgq, put, msgq, timeout, result);
+			k_spin_unlock(&msgq->lock, key);
+			return result;
+		}
+
+		SYS_PORT_TRACING_OBJ_FUNC_BLOCKING(k_msgq, put, msgq, timeout);
+
+		/* woken with 0 to retry when space may be available */
+		result = z_pend_curr(&msgq->lock, key, &prio_hdr(msgq)->send_q, timeout);
+		if (result != 0) {
+			SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_msgq, put, msgq, timeout, result);
+			return result;
+		}
+
+		waited = true;
+		timeout = sys_timepoint_timeout(end);
+		key = k_spin_lock(&msgq->lock);
+	}
+
+	slot = prio_slot_of(sys_slist_get_not_empty(&prio_hdr(msgq)->free_q));
+	slot->prio = prio;
+	slot->len = len;
+	(void)memcpy((void *)&slot[1], data, len);
+	prio_insert(&msgq->used_q, slot);
+	msgq->used_msgs++;
+
+	resched = handle_poll_events(msgq);
+
+	/* wake up one thread waiting to read */
+	pending_thread = z_unpend_first_thread(&msgq->wait_q);
+	if (pending_thread != NULL) {
+		arch_thread_return_value_set(pending_thread, 0);
+		z_ready_thread(pending_thread);
+		resched = true;
+	}
+
+	SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_msgq, put, msgq, timeout, 0);
+
+	if (resched) {
+		z_reschedule(&msgq->lock, key);
+	} else {
+		k_spin_unlock(&msgq->lock, key);
+	}
+
+	return 0;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_k_msgq_put_prio(struct k_msgq *msgq, const void *data, size_t len,
+					 uint32_t prio, k_timeout_t timeout)
+{
+	K_OOPS(K_SYSCALL_OBJ(msgq, K_OBJ_MSGQ));
+
+	if (len > msgq->msg_size) {
+		return -EMSGSIZE;
+	}
+	K_OOPS(K_SYSCALL_MEMORY_READ(data, len));
+
+	return z_impl_k_msgq_put_prio(msgq, data, len, prio, timeout);
+}
