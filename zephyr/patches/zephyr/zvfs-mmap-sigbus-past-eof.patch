+#ifdef CONFIG_MEM_BUS_FAULT_HOOK
+static ZTEST_BMEM jmp_buf bus_env;
+static ZTEST_BMEM struct k_sig_set bus_mask;
+static ZTEST_BMEM volatile int bus_signo;
+static ZTEST_BMEM volatile int bus_code;
+static ZTEST_BMEM void *volatile bus_addr;
+
+static void bus_handler(int sig, struct k_sig_info *info, void *ucontext)
+{
+	ARG_UNUSED(ucontext);
+
+	bus_signo = sig;
+	bus_code = info->code;
+	bus_addr = info->addr;
+	zassert_ok(k_sig_abandon(&bus_mask));
+	longjmp(bus_env, 1);
+}
+
+/* a read of @a p is a bus error at @a p */
+static bool read_faults(volatile uint8_t *p)
+{
+	bus_signo = 0;
+	if (setjmp(bus_env) == 0) {
+		(void)*p;
+		return false;
+	}
+	zassert_equal(bus_signo, K_SIG_BUS, "signal %d", bus_signo);
+	zassert_equal(bus_code, K_BUS_ADRERR, "code %d", bus_code);
+	zassert_equal(bus_addr, (void *)p, "address %p, not %p", bus_addr, p);
+
+	return true;
+}
+
+/* the pages wholly past the end of the file are a bus error to touch, and follow truncation */
+static void mmap_past_eof(int fd)
+{
+	const size_t len = FILE_SPAN + 2 * PAGE;
+	struct k_sig_action act = {.handler = bus_handler};
+	uint8_t *p;
+
+	zassert_ok(k_sig_mask(K_SIG_SETMASK, NULL, &bus_mask));
+	zassert_ok(k_sig_action(K_SIG_BUS, &act, NULL));
+
+	p = map(len, ZVFS_PROT_READ, ZVFS_MAP_SHARED, fd, 0);
+	zassert_false(read_faults(p + FILE_SPAN - 1), "the page holding the end faulted");
+	zassert_equal(p[FILE_SIZE], 0);
+	zassert_true(read_faults(p + FILE_SPAN), "the first page past the end did not fault");
+	zassert_true(read_faults(p + FILE_SPAN + PAGE + 7), "a later page did not fault");
+
+	/* shrunk: the pages past the new end fault, the rest of the page holding it reads zero */
+	zassert_ok(zvfs_ftruncate(fd, PAGE + PAGE / 2));
+	zassert_equal(p[PAGE], file_byte(PAGE));
+	zassert_equal(p[PAGE + PAGE / 2], 0);
+	zassert_true(read_faults(p + 2 * PAGE), "a page past the new end did not fault");
+
+	/* grown again: the pages are back, holding the zeros the file grew by */
+	zassert_ok(zvfs_ftruncate(fd, FILE_SIZE));
+	zassert_false(read_faults(p + 2 * PAGE), "a page within the grown file faulted");
+	zassert_equal(p[2 * PAGE], 0);
+	zassert_true(read_faults(p + FILE_SPAN), "the page past the end did not fault again");
+
+	zassert_ok(zvfs_munmap(p, len));
+	act.handler = K_SIG_DFL;
+	zassert_ok(k_sig_action(K_SIG_BUS, &act, NULL));
+}
+#endif /* CONFIG_MEM_BUS_FAULT_HOOK */
