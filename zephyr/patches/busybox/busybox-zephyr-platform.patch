 {
+#if defined(__ZEPHYR__)
+	/* The C library is shared with the base image: flushing every open
+	 * stream would touch other processes' streams (and picolibc's global
+	 * stream list is not process-aware). Flush our own streams instead.
+	 */
+	int r = fflush(stdout);
+	return fflush(stderr) | r;
+#else
 	return fflush(NULL);
+#endif
