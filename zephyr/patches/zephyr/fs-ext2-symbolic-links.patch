+static int ext2_expand_symlink(struct ext2_inode *inode, const char *rest, char *out,
+		size_t outsize)
+{
+	size_t tlen = inode->i_size;
+	size_t rlen = strlen(rest);
+
+	if (!ext2_inode_is_fast_symlink(inode)) {
+		/* only fast symbolic links are supported */
+		return -ENOTSUP;
+	}
+
+	if (tlen == 0) {
+		return -ENOENT;
+	}
