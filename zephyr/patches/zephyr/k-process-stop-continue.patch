+
+/* generation of CONT discards the pending stop signals of the process, and vice versa */
+void z_sig_process_discard(struct k_process *proc, const struct k_sig_set *set)
+{
+	K_SPINLOCK(k_sig_lock) {
+		for (size_t i = 0, N = ring_buf_size_get(&k_sig_fifo); i < N; ++i) {
+			uint8_t pos;
+			struct k_sig_fifo_element *entry;
+			struct k_process *scope;
+
+			ring_buf_get(&k_sig_fifo, &pos, 1);
+			entry = &k_sig_array[pos];
+			scope = (entry->proc != NULL) ? entry->proc : entry->tid->process;
+			if ((scope == proc) && (k_sig_ismember(set, entry->info.signo) == 1)) {
+				if (entry->proc != NULL) {
+					atomic_dec(&entry->proc->sig_pending);
+				} else {
+					atomic_dec(&entry->tid->base.sig.pending);
+				}
+				atomic_dec(&z_syscall_work_pending);
+				z_sig_slab_free_unlocked(pos);
+			} else {
+				ring_buf_put(&k_sig_fifo, &pos, 1);
+			}
+		}
+	}
+}
