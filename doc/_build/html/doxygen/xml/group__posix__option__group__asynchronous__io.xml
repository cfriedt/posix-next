</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>nent</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of entries in <computeroutput>list</computeroutput>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>sig</parametername>
</parameternamelist>
<parameterdescription>
<para>Notification on completion (only for LIO_NOWAIT), or NULL. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>0 on success, or -1 with errno set on failure. </para>
</simplesect>
