menuconfig POSIX_NON_PORTABLE
	bool "POSIX non-portable extensions"
	depends on POSIX_THREADS
	# timed waits arm absolute deadlines as absolute 64-bit kernel timeouts
	select TIMEOUT_64BIT
	select THREAD_NAME
	imply SCHED_CPU_MASK
	help
	  Select 'y' here to enable POSIX non-portable (_np) pthread extensions:
	  pthread_getaffinity_np(), pthread_getname_np(), pthread_setaffinity_np(),
	  pthread_setname_np(), pthread_timedjoin_np(), and pthread_tryjoin_np().

	  pthread_setaffinity_np() can only restrict a thread to a subset of the
	  CPUs with SCHED_CPU_MASK, which this option implies where the scheduler
	  supports it.

if POSIX_NON_PORTABLE

module = POSIX_NON_PORTABLE
module-str = POSIX non-portable pthread extensions
source "subsys/logging/Kconfig.template.log_config"

endif # POSIX_NON_PORTABLE
