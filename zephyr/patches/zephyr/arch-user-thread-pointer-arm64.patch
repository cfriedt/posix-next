diff --git a/arch/arm64/core/macro_priv.inc b/arch/arm64/core/macro_priv.inc
--- a/arch/arm64/core/macro_priv.inc
+++ b/arch/arm64/core/macro_priv.inc
@@ -52,6 +52,25 @@
 	and	\xreg0, \xreg0, #TPIDRROEL0_CURR_CPU
 .endm
 
+/*
+ * On an exception frame from EL0: user mode owns TPIDR_EL0, so keep it for
+ * the return and run on the kernel's TLS base meanwhile.
+ */
+.macro z_arm64_user_tp_save xreg0, xreg1
+#ifdef CONFIG_USER_THREAD_POINTER
+	ldr	\xreg0, [sp, ___esf_t_spsr_elr_OFFSET]
+	tst	\xreg0, #SPSR_MODE_MASK
+	b.ne	7f
+	get_cpu	\xreg0
+	ldr	\xreg0, [\xreg0, #___cpu_t_current_OFFSET]
+	mrs	\xreg1, tpidr_el0
+	str	\xreg1, [\xreg0, #_thread_offset_to_user_tp]
+	ldr	\xreg1, [\xreg0, #_thread_offset_to_tls]
+	msr	tpidr_el0, \xreg1
+7:
+#endif /* CONFIG_USER_THREAD_POINTER */
+.endm
+
 #endif /* _ASMLANGUAGE */
 
 #endif /* _MACRO_PRIV_INC_ */
diff --git a/arch/arm64/core/offsets/offsets.c b/arch/arm64/core/offsets/offsets.c
