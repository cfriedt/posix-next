+	k_msleep(100);
+	zassert_ok(k_sig_queue((k_pid_t)&noop_test_thread, K_SIG_USR1, (union k_sig_val){0}));
+	k_msleep(100);
+	zassert_ok(k_sig_queue((k_pid_t)&noop_test_thread, K_SIG_USR1, (union k_sig_val){0}));
