+static void group_notifies_once_when_drained(void)
+{
+	char b1[4];
+	char b2[4];
+	struct k_sig_info info;
+	struct sys_aio_group *grp = NULL;
+	struct sys_aio *aio1 = NULL;
+	struct sys_aio *aio2 = NULL;
+	struct sys_aio_req req = {
+		.op = SYS_AIO_OP_READ,
+		.fd = file_fd,
+		.buf = b1,
+		.len = sizeof(b1),
+		.flags = SYS_AIO_REQ_OFFSET,
+	};
+	struct sys_aio_notify notify = {
+		.target = k_current_get(),
+		.signo = K_SIG_USR1,
+		.value.sival_int = 77,
+	};
+
+	sig_block(K_SIG_USR1);
+
+	zassert_ok(sys_aio_group_create(&notify, &grp));
+	zassert_not_null(grp);
+
+	zassert_ok(sys_aio_submit(&req, NULL, grp, &aio1));
+	req.buf = b2;
+	req.len = sizeof(b2);
+	zassert_ok(sys_aio_submit(&req, NULL, grp, &aio2));
+	zassert_ok(sys_aio_group_finalize(grp));
+
+	zassert_equal(sig_accept(K_SIG_USR1, &info, TIMEOUT), K_SIG_USR1);
+	zassert_equal(info.code, K_SI_ASYNCIO);
+	zassert_equal(info.value.sival_int, 77);
+
+	/* one notification for the whole group */
+	zassert_true(sig_accept(K_SIG_USR1, NULL, K_NO_WAIT) < 0);
+
+	zassert_equal(reap_ok(aio1), sizeof(b1));
+	zassert_equal(reap_ok(aio2), sizeof(b2));
+}
