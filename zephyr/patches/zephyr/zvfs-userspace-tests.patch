index 00000000000..84d60015283
--- /dev/null
+++ b/tests/lib/zvfs_fs/testcase.yaml
@@ -0,0 +1,20 @@
+common:
+  tags:
+    - zvfs
+    - fatfs
+  modules:
+    - fatfs
+  min_ram: 128
+  platform_key:
+    - arch
+    - simulation
+tests:
+  libraries.zvfs_fs:
+    filter: not CONFIG_NATIVE_LIBC
+  libraries.zvfs_fs.userspace:
+    filter: (not CONFIG_NATIVE_LIBC) and CONFIG_ARCH_HAS_USERSPACE
+    tags: userspace
+    extra_configs:
+      - CONFIG_TEST_USERSPACE=y
+      - CONFIG_USERSPACE=y
+      - CONFIG_ZTEST_FATAL_HOOK=y
