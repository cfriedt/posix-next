+	zassert_true(K_WIFCONTINUED(waiter_history[1]), "0x%x", waiter_history[1]);
+	zassert_true(K_WIFSTOPPED(waiter_history[2]), "0x%x", waiter_history[2]);
+	zassert_true(K_WIFCONTINUED(waiter_history[3]), "0x%x", waiter_history[3]);
+	zassert_true(K_WIFEXITED(waiter_history[4]), "0x%x", waiter_history[4]);
