+#ifdef CONFIG_MSGQ_PRIO
+static void prio_insert(sys_slist_t *list, struct z_msgq_prio_slot *slot)
+{
+	struct z_msgq_prio_slot *it, *prev = NULL;
+	sys_snode_t *tail = sys_slist_peek_tail(list);
+
+	/* fast path: FIFO append among equal or lower priorities */
+	if ((tail == NULL) || (prio_slot_of(tail)->prio >= slot->prio)) {
+		sys_slist_append(list, &slot->node);
+		return;
+	}
+
+	SYS_SLIST_FOR_EACH_CONTAINER(list, it, node) {
+		if (it->prio < slot->prio) {
+			break;
+		}
+		prev = it;
+	}
+
+	if (prev == NULL) {
+		sys_slist_prepend(list, &slot->node);
+	} else {
+		sys_slist_insert(list, &prev->node, &slot->node);
+	}
