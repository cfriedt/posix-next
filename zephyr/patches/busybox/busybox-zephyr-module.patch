diff --git a/zephyr/include/sys/ioctl.h b/zephyr/include/sys/ioctl.h
new file mode 100644
index 000000000..546afdf70
--- /dev/null
+++ b/zephyr/include/sys/ioctl.h
@@ -0,0 +1,28 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * Zephyr's <sys/ioctl.h> plus the terminal window-size request busybox
+ * expects; with no terminal driver the request simply fails at runtime and
+ * busybox falls back to 80x24.
+ */
+#ifndef _BB_ZEPHYR_SYS_IOCTL_H
+#define _BB_ZEPHYR_SYS_IOCTL_H
+
+#include_next <sys/ioctl.h>
+
+struct winsize {
+	unsigned short ws_row;
+	unsigned short ws_col;
+	unsigned short ws_xpixel;
+	unsigned short ws_ypixel;
+};
+
+#ifndef TIOCGWINSZ
+#define TIOCGWINSZ 0x5413
+#endif
+#ifndef TIOCSWINSZ
+#define TIOCSWINSZ 0x5414
+#endif
+
+#endif
diff --git a/zephyr/include/sys/resource.h b/zephyr/include/sys/resource.h
new file mode 100644
index 000000000..8f97a7963
--- /dev/null
+++ b/zephyr/include/sys/resource.h
@@ -0,0 +1,43 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * The libc's <sys/resource.h> plus the rlimit surface busybox's ulimit code
+ * needs to compile. Zephyr implements no resource limits: the builtin is
+ * disabled (CONFIG_HUSH_ULIMIT unset) and its unreferenced code is dropped
+ * at the partial link, so no implementation is required.
+ */
+#ifndef _BB_ZEPHYR_SYS_RESOURCE_H
+#define _BB_ZEPHYR_SYS_RESOURCE_H
+
+#include_next <sys/resource.h>
+
+typedef unsigned long rlim_t;
+
+struct rlimit {
+	rlim_t rlim_cur;
+	rlim_t rlim_max;
+};
+
+#define RLIM_INFINITY ((rlim_t)-1)
+
+#define RLIMIT_CPU    0
+#define RLIMIT_FSIZE  1
+#define RLIMIT_DATA   2
+#define RLIMIT_STACK  3
+#define RLIMIT_CORE   4
+#define RLIMIT_NOFILE 7
+#define RLIMIT_AS     9
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int getrlimit(int resource, struct rlimit *rlp);
+int setrlimit(int resource, const struct rlimit *rlp);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/zephyr/include/sys/sysmacros.h b/zephyr/include/sys/sysmacros.h
new file mode 100644
index 000000000..fb4783b37
--- /dev/null
+++ b/zephyr/include/sys/sysmacros.h
@@ -0,0 +1,15 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * major()/minor()/makedev() for busybox on Zephyr, which has no device
+ * numbers; the traditional 8/8 split keeps ls -l output well-formed.
+ */
+#ifndef _SYS_SYSMACROS_H
+#define _SYS_SYSMACROS_H
+
+#define major(dev)        ((unsigned int)(((dev) >> 8) & 0xff))
+#define minor(dev)        ((unsigned int)((dev) & 0xff))
+#define makedev(maj, min) ((((maj) & 0xff) << 8) | ((min) & 0xff))
+
+#endif
