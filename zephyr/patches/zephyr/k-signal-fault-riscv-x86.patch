+		break;
+	case IV_BREAKPOINT:
+		signo = K_SIG_TRAP;
+		code = K_TRAP_BRKPT;
+		break;
+	case IV_X87_FPU_FP_ERROR:
+	case IV_SIMD_FP:
+		signo = K_SIG_FPE;
+		code = fp_exception_code(vector);
