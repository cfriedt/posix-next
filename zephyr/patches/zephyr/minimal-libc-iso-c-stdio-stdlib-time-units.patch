diff --git a/lib/libc/minimal/source/stdio/stream_state.c b/lib/libc/minimal/source/stdio/stream_state.c
new file mode 100644
index 00000000000..f79222d931e
--- /dev/null
+++ b/lib/libc/minimal/source/stdio/stream_state.c
@@ -0,0 +1,164 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <stdio.h>
+
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/util.h>
+#include <zephyr/toolchain.h>
+
+#include "stream_state.h"
+
+#if defined(CONFIG_ZVFS)
+#include <zephyr/sys/zvfs.h>
+#include <zephyr/sys/zvfs_libc.h>
+
+/* ZVFS_OPEN_SIZE is a global compile definition when CONFIG_ZVFS=y */
+#define MINIMAL_STDIO_NSTREAMS ZVFS_OPEN_SIZE
+
+static struct {
+	short ungetc_char; /* character + 1; 0 means none pending */
+	unsigned char flags;
+} stream_state[MINIMAL_STDIO_NSTREAMS];
+
+static bool stream_state_valid(int fd)
+{
+	return (fd >= 0) && (fd < MINIMAL_STDIO_NSTREAMS);
+}
+
+void minimal_stdio_set_flags(int fd, unsigned char flags)
+{
+	if (stream_state_valid(fd)) {
+		stream_state[fd].flags |= flags;
+	}
+}
+
+void minimal_stdio_clear_state(int fd)
+{
+	if (stream_state_valid(fd)) {
+		stream_state[fd].flags = 0;
+		stream_state[fd].ungetc_char = 0;
+	}
+}
+
+int minimal_stdio_push_ungetc(int fd, int c)
+{
+	if (!stream_state_valid(fd) || (c == EOF) || (stream_state[fd].ungetc_char != 0)) {
+		return EOF;
+	}
+
+	stream_state[fd].ungetc_char = (short)((c & 0xff) + 1);
+	stream_state[fd].flags &= (unsigned char)~MINIMAL_STDIO_EOF;
+
+	return c & 0xff;
+}
+
+int minimal_stdio_pop_ungetc(int fd)
+{
+	int c;
+
+	if (!stream_state_valid(fd) || (stream_state[fd].ungetc_char == 0)) {
+		return -1;
+	}
+
+	c = stream_state[fd].ungetc_char - 1;
+	stream_state[fd].ungetc_char = 0;
+
+	return c;
+}
+
+static int stream_state_fd(FILE *stream)
+{
+	if (stream == NULL) {
+		return -1;
+	}
+
+	return zvfs_libc_fileno(stream);
+}
+
+static int stream_state_flags(FILE *stream, unsigned char flags)
+{
+	int fd = stream_state_fd(stream);
+
+	if (!stream_state_valid(fd)) {
+		return 0;
+	}
+
+	return (stream_state[fd].flags & flags) != 0;
+}
+
+int feof(FILE *stream)
+{
+	return stream_state_flags(stream, MINIMAL_STDIO_EOF);
+}
+
+int ferror(FILE *stream)
+{
+	return stream_state_flags(stream, MINIMAL_STDIO_ERROR);
+}
+
+int ungetc(int c, FILE *stream)
+{
+	int fd = stream_state_fd(stream);
+
+	if (fd < 3) {
+		return EOF;
+	}
+
+	return minimal_stdio_push_ungetc(fd, c);
+}
+#else /* CONFIG_ZVFS */
+LOG_MODULE_REGISTER(minimal_libc_stream, CONFIG_LOG_DEFAULT_LEVEL);
+
+void minimal_stdio_set_flags(int fd, unsigned char flags)
+{
+	ARG_UNUSED(fd);
+	ARG_UNUSED(flags);
+}
+
+void minimal_stdio_clear_state(int fd)
+{
+	ARG_UNUSED(fd);
+}
+
+int minimal_stdio_push_ungetc(int fd, int c)
+{
+	ARG_UNUSED(fd);
+	ARG_UNUSED(c);
+
+	return EOF;
+}
+
+int minimal_stdio_pop_ungetc(int fd)
+{
+	ARG_UNUSED(fd);
+
+	return -1;
+}
+
+int feof(FILE *stream)
+{
+	ARG_UNUSED(stream);
+
+	return 0;
+}
+
+int ferror(FILE *stream)
+{
+	ARG_UNUSED(stream);
+
+	return 0;
+}
+
+int ungetc(int c, FILE *stream)
+{
+	ARG_UNUSED(c);
+	ARG_UNUSED(stream);
+
+	LOG_WRN_ONCE("ungetc() requires CONFIG_ZVFS");
+
+	return EOF;
+}
+#endif /* CONFIG_ZVFS */
diff --git a/lib/libc/minimal/source/stdio/stream_state.h b/lib/libc/minimal/source/stdio/stream_state.h
new file mode 100644
index 00000000000..4eefe6b6a77
--- /dev/null
+++ b/lib/libc/minimal/source/stdio/stream_state.h
@@ -0,0 +1,24 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_LIB_LIBC_MINIMAL_SOURCE_STDIO_STREAM_STATE_H_
+#define ZEPHYR_LIB_LIBC_MINIMAL_SOURCE_STDIO_STREAM_STATE_H_
+
+/*
+ * Per-stream end-of-file / error flags and single-character ungetc()
+ * push-back for the minimal libc's unbuffered, file-descriptor-backed
+ * FILE streams.
+ */
+
+#define MINIMAL_STDIO_EOF   0x01
+#define MINIMAL_STDIO_ERROR 0x02
+
+void minimal_stdio_set_flags(int fd, unsigned char flags);
+void minimal_stdio_clear_state(int fd);
+int minimal_stdio_push_ungetc(int fd, int c);
+/* returns the pushed-back character, or -1 when none is pending */
+int minimal_stdio_pop_ungetc(int fd);
+
+#endif /* ZEPHYR_LIB_LIBC_MINIMAL_SOURCE_STDIO_STREAM_STATE_H_ */
diff --git a/lib/libc/minimal/source/stdio/tmpfile.c b/lib/libc/minimal/source/stdio/tmpfile.c
new file mode 100644
index 00000000000..51f9c503b56
--- /dev/null
+++ b/lib/libc/minimal/source/stdio/tmpfile.c
@@ -0,0 +1,66 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <stdio.h>
+
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/util.h>
+#include <zephyr/toolchain.h>
+
+LOG_MODULE_REGISTER(minimal_libc_tmpfile, CONFIG_LOG_DEFAULT_LEVEL);
+
+#if defined(CONFIG_ZVFS)
+#include <zephyr/sys/fdtable.h>
+#include <zephyr/sys/zvfs.h>
+#include <zephyr/sys/zvfs_fs.h>
+#include <zephyr/sys/zvfs_libc.h>
+#endif
+
+char *tmpnam(char *s)
+{
+	static char name[L_tmpnam];
+	static unsigned int counter;
+	char *buf = (s == NULL) ? name : s;
+
+	if (counter >= TMP_MAX) {
+		return NULL;
+	}
+
+	(void)snprintf(buf, L_tmpnam, "/tmp/tmp_%04u", counter++);
+
+	return buf;
+}
+
+FILE *tmpfile(void)
+{
+#if defined(CONFIG_ZVFS)
+	char name[L_tmpnam];
+	FILE *fp;
+	int fd;
+
+	if (tmpnam(name) == NULL) {
+		return NULL;
+	}
+
+	fd = zvfs_open(name, ZVFS_O_RDWR | ZVFS_O_CREAT | ZVFS_O_TRUNC, 0600);
+	if (fd < 0) {
+		return NULL;
+	}
+
+	fp = zvfs_libc_fdopen(fd, "wb+");
+	if (fp == NULL) {
+		(void)zvfs_close(fd);
+	}
+
+	/*
+	 * Deviation from ISO C: the file is not automatically removed when
+	 * it is closed or on normal program termination.
+	 */
+	return fp;
+#else
+	LOG_WRN_ONCE("tmpfile() requires CONFIG_ZVFS");
+	return NULL;
+#endif
+}
diff --git a/lib/libc/minimal/source/stdlib/atexit.c b/lib/libc/minimal/source/stdlib/atexit.c
new file mode 100644
index 00000000000..09c8bc61654
--- /dev/null
+++ b/lib/libc/minimal/source/stdlib/atexit.c
@@ -0,0 +1,46 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <stdlib.h>
+
+#include <zephyr/spinlock.h>
+#include <zephyr/toolchain.h>
+
+/* ISO C requires support for at least 32 registrations; embedded targets
+ * rarely use more than a few, and each slot costs a function pointer.
+ */
+#define ATEXIT_MAX 8
+
+static struct k_spinlock atexit_lock;
+static void (*atexit_handlers[ATEXIT_MAX])(void);
+static int atexit_count;
+
+int atexit(void (*func)(void))
+{
+	int ret = -1;
+	k_spinlock_key_t key;
+
+	if (func == NULL) {
+		return -1;
+	}
+
+	key = k_spin_lock(&atexit_lock);
+	if (atexit_count < ATEXIT_MAX) {
+		atexit_handlers[atexit_count++] = func;
+		ret = 0;
+	}
+	k_spin_unlock(&atexit_lock, key);
+
+	return ret;
+}
+
+FUNC_NORETURN void exit(int status)
+{
+	for (int i = atexit_count - 1; i >= 0; i--) {
+		atexit_handlers[i]();
+	}
+
+	_exit(status);
+}
