+	bool "Sv39 - 39-bit Virtual Address"
+	depends on $(dt_compat_all_has_prop,riscv,$(RISCV_MMU_TYPE_PROP),$(RISCV_MMU_TYPE_SV39))
+	help
+	  Use Sv39 mode with 39-bit virtual addresses and 3-level page tables.
+	  This is the most common MMU mode for RISC-V and supports up to
+	  512GB of virtual address space.
+
+config RISCV_MMU_SV48
+	bool "Sv48 - 48-bit Virtual Address"
+	depends on $(dt_compat_all_has_prop,riscv,$(RISCV_MMU_TYPE_PROP),$(RISCV_MMU_TYPE_SV48))
+	help
