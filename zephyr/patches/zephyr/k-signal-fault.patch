+#ifdef CONFIG_SIGNAL_FAULT
+/* PSTATE.BTYPE: the resume in z_sig_fault_entry() is not a branch */
+#define SPSR_BTYPE_MASK (3ULL << 10)
+
+/* a fault taken at EL0 generates the signal Linux generates for it */
+static bool user_fault_signal(struct arch_esf *esf, uint64_t esr, uint64_t far)
+{
+	int signo = K_SIG_SEGV;
+	int code;
+	void *addr = (void *)far;
+	uint64_t fsc = esr & 0x3fULL;
+
+	switch (GET_ESR_EC(esr)) {
+	case 0x20: /* instruction abort */
+	case 0x24: /* data abort */
+		if (fsc == 0x21U) {
+			signo = K_SIG_BUS;
+			code = K_BUS_ADRALN;
+		} else if (fsc == 0x10U) {
+			signo = K_SIG_BUS;
+			code = K_BUS_OBJERR;
+		} else {
+			/* address size and translation faults: nothing mapped there */
+			code = (fsc < 0x08U) ? K_SEGV_MAPERR : K_SEGV_ACCERR;
+		}
+		break;
+	case 0x22: /* PC alignment */
+		signo = K_SIG_BUS;
+		code = K_BUS_ADRALN;
+		break;
+	case 0x26: /* SP alignment */
+		signo = K_SIG_BUS;
+		code = K_BUS_ADRALN;
+		addr = (void *)read_sp_el0();
+		break;
+	case 0x00: /* unknown reason: an undefined instruction */
+	case 0x0d: /* branch target identification */
+	case 0x18: /* trapped system register access */
+		signo = K_SIG_ILL;
+		code = K_ILL_ILLOPC;
+		addr = (void *)esf->elr;
+		break;
+	case 0x0e: /* illegal execution state */
+		signo = K_SIG_ILL;
+		code = K_ILL_ILLOPN;
+		addr = (void *)esf->elr;
+		break;
+	case 0x15: /* an SVC that is not a system call */
+		signo = K_SIG_ILL;
+		code = K_ILL_ILLTRP;
+		addr = (void *)esf->elr;
+		break;
+	case 0x2c: /* trapped floating-point exception */
+		signo = K_SIG_FPE;
+		code = K_FPE_FLTINV;
+		addr = (void *)esf->elr;
+		break;
+	case 0x3c: /* BRK */
+		signo = K_SIG_TRAP;
+		code = K_TRAP_BRKPT;
+		addr = (void *)esf->elr;
+		break;
+	default:
+		return false;
+	}
+
+	if (!z_sig_fault(signo, code, addr)) {
+		return false;
+	}
+
+	esf->elr = (uint64_t)(uintptr_t)z_sig_fault_entry;
+	esf->spsr &= ~SPSR_BTYPE_MASK;
+
+	return true;
+}
+#endif /* CONFIG_SIGNAL_FAULT */
