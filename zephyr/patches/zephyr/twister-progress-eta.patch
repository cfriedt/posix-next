diff --git a/scripts/pylib/twister/twisterlib/runmonitor.py b/scripts/pylib/twister/twisterlib/runmonitor.py
index 4611091..f840842 100644
--- a/scripts/pylib/twister/twisterlib/runmonitor.py
+++ b/scripts/pylib/twister/twisterlib/runmonitor.py
@@ -31,6 +31,27 @@ import time
 
 logger = logging.getLogger('twister')
 
+
+def format_duration(seconds) -> str:
+    """Human-friendly duration: 42s / 3m 10s / 2h 05m."""
+    if seconds is None:
+        return ''
+    seconds = max(0, int(seconds))
+    if seconds < 60:
+        return f"{seconds}s"
+    minutes, secs = divmod(seconds, 60)
+    if minutes < 60:
+        return f"{minutes}m {secs:02d}s"
+    hours, minutes = divmod(minutes, 60)
+    return f"{hours}h {minutes:02d}m"
+
+
+def estimate_remaining(done: int, total: int, elapsed: float) -> float | None:
+    """Naive remaining-time estimate from the average per-instance rate."""
+    if done <= 5 or done >= total or elapsed <= 0:
+        return None
+    return elapsed * (total - done) / done
+
