+	case ZFD_IOCTL_SEEKDIR: {
+		long pos = *va_arg(args, const long *);
+		struct fs_dirent entry;
+
+		rc = 0;
+		if (pos < ptr->dir_pos) {
+			rc = fs_rewinddir(&ptr->dir);
+			if (rc < 0) {
+				break;
+			}
+			ptr->dir_pos = 0;
+		}
+		/* a position past the end leaves the stream at the end */
+		while (ptr->dir_pos < pos) {
