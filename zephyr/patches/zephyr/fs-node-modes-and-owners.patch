+static int ext2_chmod(struct fs_mount_t *mountp, const char *path, uint32_t mode)
+{
+	int rc;
+	struct ext2_data *fs = mountp->fs_data;
+
+	path = fs_impl_strip_prefix(path, mountp);
+
+	struct ext2_lookup_args args = {
+		.path = path,
+		.inode = NULL,
+		.flags = LOOKUP_ARG_OPEN,
+	};
+
+	rc = ext2_lookup_inode(fs, &args);
+	if (rc < 0) {
+		return rc;
+	}
+
+	args.inode->i_mode = (args.inode->i_mode & EXT2_S_IFMT) | (mode & 07777);
+	args.inode->i_ctime = ext2_now();
+
+	rc = ext2_commit_inode(args.inode);
+
+	ext2_inode_drop(args.inode);
+	return rc;
+}
+
+static int chown_common(struct fs_mount_t *mountp, const char *path, uint32_t uid, uint32_t gid,
+			uint8_t lookup_flags)
+{
+	int rc;
+	struct ext2_data *fs = mountp->fs_data;
+
+	path = fs_impl_strip_prefix(path, mountp);
+
+	struct ext2_lookup_args args = {
+		.path = path,
+		.inode = NULL,
+		.flags = lookup_flags,
+	};
+
+	rc = ext2_lookup_inode(fs, &args);
+	if (rc < 0) {
+		return rc;
+	}
+
+	args.inode->i_uid = (uint16_t)uid;
+	args.inode->i_gid = (uint16_t)gid;
+	args.inode->i_ctime = ext2_now();
+
+	rc = ext2_commit_inode(args.inode);
+
+	ext2_inode_drop(args.inode);
+	return rc;
+}
+
+static int ext2_chown(struct fs_mount_t *mountp, const char *path, uint32_t uid, uint32_t gid)
+{
+	return chown_common(mountp, path, uid, gid, LOOKUP_ARG_OPEN);
+}
+
+static int ext2_lchown(struct fs_mount_t *mountp, const char *path, uint32_t uid, uint32_t gid)
+{
+	return chown_common(mountp, path, uid, gid, LOOKUP_ARG_OPEN | LOOKUP_ARG_NOFOLLOW);
