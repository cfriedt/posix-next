diff --git a/kernel/Kconfig.process b/kernel/Kconfig.process
index f94745cafb5..04eaaa73e53 100644
--- a/kernel/Kconfig.process
+++ b/kernel/Kconfig.process
@@ -22,6 +22,9 @@ if PROCESS
 config PROCESS_VM
 	bool "Per-process virtual address space duplication (experimental)"
 	depends on PROCESS && USERSPACE && ARCH_HAS_PROCESS_VM
+	# kernel-mode reads of the TLS-cached current thread would alias the
+	# parent's physical memory through the shared kernel page tables
+	depends on !CURRENT_THREAD_USE_TLS
 	select SYS_THREAD
 	help
 	  Enable address-space duplication for the fork() model: a cloned
diff --git a/lib/os/process.c b/lib/os/process.c
index aed6a9a61ca..10cf62dc33f 100644
--- a/lib/os/process.c
+++ b/lib/os/process.c
@@ -24,9 +24,6 @@
 #include <zephyr/sys/process.h>
 #include <zephyr/sys/thread.h>
 #include <kernel_internal.h>
-#ifdef CONFIG_THREAD_LOCAL_STORAGE
-#include <kernel_tls.h>
-#endif /* CONFIG_THREAD_LOCAL_STORAGE */
 #include <ksched.h>
 
 STRUCT_SECTION_START_EXTERN(k_process);
@@ -958,51 +955,16 @@ static int process_clone_vm_copy(const struct sys_clone_args *args, k_pid_t *chi
 		tid->base.user_options |= K_USER;
 #ifdef CONFIG_THREAD_LOCAL_STORAGE
 		/*
-		 * The child keeps its OWN TLS block (create-time tid->tls):
-		 * a kernel-visible identity that reads the same from kernel
-		 * page tables and the child's domain, unlike the parent's
-		 * TLS address, whose kernel-mode view would alias the
-		 * parent's physical memory. The parent's TLS contents are
-		 * inherited by copy, the cached thread identity is fixed to
-		 * the child (the TCB self-pointer fix every fork performs),
-		 * and the child's stack region joins its domain so user-mode
-		 * TLS accesses resolve. Deviation: the child's TLS occupies
-		 * a different address than its parent's.
+		 * The child's TLS is the parent's address: the clone already
+		 * copied that region (the child resumes on the parent's stack
+		 * address, and TLS lives above it), so captured TLS-variable
+		 * addresses and register-relative accesses agree, as fork
+		 * demands. Kernel mode never dereferences user TLS in this
+		 * configuration - PROCESS_VM excludes CURRENT_THREAD_USE_TLS,
+		 * whose kernel-mode reads would alias the parent's physical
+		 * memory through the shared kernel tables.
 		 */
-		{
-			size_t tsz = z_tls_data_size();
-#ifdef CONFIG_X86
-			/* variant-II TLS: data below the base pointer */
-			ptrdiff_t tls_lo = -(ptrdiff_t)tsz;
-			size_t tls_len = tsz;
-#else
-			/* variant-I TLS: two toolchain slots at the base, data above */
-			ptrdiff_t tls_lo = 0;
-			size_t tls_len = tsz + (2 * sizeof(uintptr_t));
-#endif /* CONFIG_X86 */
-
-			(void)memcpy((char *)tid->tls + tls_lo,
-				     (char *)_current->tls + tls_lo, tls_len);
-#ifdef CONFIG_CURRENT_THREAD_USE_TLS
-			extern Z_THREAD_LOCAL k_tid_t z_tls_current;
-			ptrdiff_t tls_off = (char *)&z_tls_current - (char *)_current->tls;
-
-			*(k_tid_t *)((char *)tid->tls + tls_off) = tid;
-#endif /* CONFIG_CURRENT_THREAD_USE_TLS */
-
-			struct k_mem_partition selfstack = {
-				.start = tid->stack_info.start,
-				.size = page_up(tid->stack_info.size),
-				.attr = K_MEM_PARTITION_P_RW_U_RW,
-			};
-
-			ret = k_mem_domain_add_partition(&ctx->domain, &selfstack);
-			if (ret != 0) {
-				k_thread_abort(tid);
-				(void)z_process_record_free(proc);
-				return ret;
-			}
-		}
+		tid->tls = _current->tls;
 #endif /* CONFIG_THREAD_LOCAL_STORAGE */
 	}
 #endif /* CONFIG_ARCH_HAS_FORK_RESUME */
