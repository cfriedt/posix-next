diff --git a/tests/lib/c_lib/common/src/main.c b/tests/lib/c_lib/common/src/main.c
index 7af96dcf7d0..a014ea10579 100644
--- a/tests/lib/c_lib/common/src/main.c
+++ b/tests/lib/c_lib/common/src/main.c
@@ -1238,6 +1238,25 @@ ZTEST(libc_common, test_malloc)
 	}
 
 	free(buf);
+
+	if (IS_ENABLED(CONFIG_COMMON_LIBC_MALLOC_GROW)) {
+		/* the heap grows past its arena: a block the arena cannot hold, then one more */
+		const size_t big = 2 * CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE;
+		char *grown = malloc(big);
+		char *again;
+
+		zassert_not_null(grown, "malloc beyond the arena failed");
+		memset(grown, 0x5a, big);
+		zassert_equal(grown[big - 1], 0x5a);
+		again = realloc(grown, 3 * big);
+		zassert_not_null(again, "realloc beyond the arena failed");
+		zassert_equal(again[big - 1], 0x5a, "realloc lost the data");
+		memset(again, 0xa5, 3 * big);
+		free(again);
+		grown = malloc(100);
+		zassert_not_null(grown);
+		free(grown);
+	}
 #else
 	ztest_test_skip();
 #endif /* CONFIG_COMMON_LIBC_MALLOC && CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE > 220 */
