diff --git a/doc/services/zvfs/index.rst b/doc/services/zvfs/index.rst
--- a/doc/services/zvfs/index.rst
+++ b/doc/services/zvfs/index.rst
@@ -55,3 +55,24 @@ References and lifetime
 
 ``zvfs_munmap()`` and ``zvfs_mprotect()`` operate on whole mappings; a range
 that covers part of a mapping is rejected.
+
+Shared Memory Objects
+*********************
+
+:kconfig:option:`CONFIG_ZVFS_SHM` adds ``zvfs_shm_open()`` and ``zvfs_shm_unlink()``:
+named, system-wide memory objects reached through file descriptors. An object
+is created with ``ZVFS_O_CREAT`` (``ZVFS_O_EXCL`` insists on creating it), has
+size zero until ``zvfs_ftruncate()`` sizes it, and is then read and written at
+offsets like a file. It owns its pages, pinned :c:func:`k_mem_map` pages with an
+MMU and a kernel-heap block otherwise, and answers ``ZFD_IOCTL_MMAP`` with
+their address, so ``zvfs_mmap()`` maps it in place and every mapping of it
+aliases the same memory.
+
+An object is sized once: its pages may already be mapped, so a second
+``zvfs_ftruncate()`` to another size and ``ZVFS_O_TRUNC`` on a sized object
+fail with ``EBUSY``. The name is only a lookup key: ``zvfs_shm_unlink()``
+removes it at once, a later ``zvfs_shm_open()`` with ``ZVFS_O_CREAT`` makes a
+new object under the same name, and the unlinked object is freed when its last
+descriptor and its last mapping are gone. Objects come from a pool of
+:kconfig:option:`CONFIG_ZVFS_SHM_MAX`, with names shorter than
+:kconfig:option:`CONFIG_ZVFS_SHM_NAME_MAX`.
diff --git a/include/zephyr/zvfs/shm.h b/include/zephyr/zvfs/shm.h
new file mode 100644
--- /dev/null
+++ b/include/zephyr/zvfs/shm.h
@@ -0,0 +1,56 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_ZEPHYR_ZVFS_SHM_H_
+#define ZEPHYR_INCLUDE_ZEPHYR_ZVFS_SHM_H_
+
+/**
+ * @file
+ * @brief ZVFS shared memory objects
+ *
+ * Named, system-wide memory objects reached through file descriptors: sized
+ * with zvfs_ftruncate(), read and written at offsets, and mapped in place by
+ * zvfs_mmap(), so every mapping of an object aliases the same pages.
+ */
+
+#include <zephyr/kernel.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Open, and optionally create, a shared memory object.
+ *
+ * @p flags takes the ZVFS_O_RDONLY or ZVFS_O_RDWR access mode with any of
+ * ZVFS_O_CREAT, ZVFS_O_EXCL and ZVFS_O_TRUNC. A new object has size zero until
+ * zvfs_ftruncate() sizes it. An object outlives its name: zvfs_shm_unlink()
+ * removes the name, and the object is freed once its last descriptor and its
+ * last mapping are gone.
+ *
+ * @param name Object name, at most CONFIG_ZVFS_SHM_NAME_MAX - 1 characters.
+ * @param flags Access mode and creation flags.
+ * @param mode Permission bits recorded for the object when it is created.
+ *
+ * @return A file descriptor on success, or -1 on error (errno is set).
+ */
+__syscall int zvfs_shm_open(const char *name, int flags, int mode);
+
+/**
+ * @brief Remove the name of a shared memory object.
+ *
+ * @param name Object name.
+ *
+ * @return 0 on success, or -1 on error (errno is set).
+ */
+__syscall int zvfs_shm_unlink(const char *name);
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <zephyr/syscalls/shm.h>
+
+#endif /* ZEPHYR_INCLUDE_ZEPHYR_ZVFS_SHM_H_ */
