+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * Zephyr stand-in for the stress-ng command line driver (stress-ng.c):
+ * the globals and the handful of driver functions the core and the
+ * stressors reference, plus stress_ng_run(), which runs one stressor
+ * instance in the calling thread the way stress_child_run() does in a
+ * forked child.
+ */
+#include "stress-ng.h"
+#include "core-builtin.h"
+#include "core-mmap.h"
+#include "core-shared-cache.h"
+#include "core-shared-heap.h"
+
+#include <stress_ng.h>
+
+#include <zephyr/init.h>
+#include <zephyr/sys/process.h>
+#include <zephyr/kernel.h>
+#include <pthread.h>
+#include <sys/wait.h>
+
+#define DEFAULT_CACHE_LEVEL (3)
+
+stress_list_item_t *g_item_current;
+uint64_t g_opt_timeout = TIMEOUT_NOT_SET;
+/* verify results; no forked wrapper child around the stressor (--oom-no-child) */
+uint64_t g_opt_flags = OPT_FLAGS_MMAP_MADVISE | OPT_FLAGS_VERIFY | OPT_FLAGS_NO_OOM_ADJUST |
+		       OPT_FLAGS_OOM_NO_CHILD |
+		       (IS_ENABLED(CONFIG_STRESS_NG_MINIMIZE) ? OPT_FLAGS_MINIMIZE : 0);
+uint32_t g_pr_log_flags = PR_LOG_FLAGS_ERROR | PR_LOG_FLAGS_INFO | PR_LOG_FLAGS_FAIL |
+			  PR_LOG_FLAGS_WARN | PR_LOG_FLAGS_LOCKLESS | PR_LOG_FLAGS_STDOUT |
+			  (IS_ENABLED(CONFIG_STRESS_NG_LOG_DEBUG) ? PR_LOG_FLAGS_DEBUG : 0);
+volatile bool g_stress_continue_flag = true;
+const char g_prog_name[] = "stress-ng";
+stress_shared_t *g_shared;
+jmp_buf g_error_env;
+stress_put_val_t g_put_val;
+void *g_nowt;
+
+struct stress_ng_stressor {
+	const char *name;
+	const stressor_info_t *info;
+};
+
+static const struct stress_ng_stressor stressors[] = {
+#define STRESS_NG_STRESSOR(sym, str) {str, &stress_##sym##_info},
+#include <stress_ng_stressors.h>
+#undef STRESS_NG_STRESSOR
+};
+
+static K_SEM_DEFINE(run_lock, 1, 1);
+static sigjmp_buf abort_env;
+static k_tid_t runner_tid;
+
+/*
+ * abort() in a stressor would end the calling thread. In the runner thread, report it as the
+ * driver reports a child killed by a signal; in one of the stressor's own threads, let that
+ * thread go (a jump across threads would corrupt the runner's stack).
+ */
+static void stress_ng_sigabrt_handler(int signum)
+{
+	if (k_current_get() != runner_tid) {
+		pthread_exit(NULL);
+	}
+	siglongjmp(abort_env, signum);
+}
+static bool shared_init_failed;
+static stress_stressor_t current_stressor;
+static stress_list_item_t current_item;
+static stress_stats_t *current_stats;
+static stress_metrics_info_t current_metrics;
+static stress_args_t *current_args;
+
+/* driver functions referenced by the core and the stressors */
+
+void stress_bogo_max_ops_zero(void)
+{
+	if (current_args != NULL) {
+		stress_bogo_stop(current_args);
+	}
+}
+
+stress_args_t *stress_args_pid_find(const pid_t pid)
+{
+	if ((current_args != NULL) && (current_args->pid == pid)) {
+		return current_args;
+	}
+
+	return NULL;
+}
+
+ssize_t stress_stressor_find(const char *name)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(stressors); i++) {
+		if (stress_strcmp_munged(name, stressors[i].name) == 0) {
+			return (ssize_t)i;
+		}
+	}
+
+	return -1;
+}
+
+void stress_shared_readonly(void)
+{
+}
+
+void stress_system_memory_info_log(void)
+{
+}
+
+void stress_metrics_set(stress_args_t *args, const char *description, const double value,
+			const int mean_type)
+{
+	stress_metrics_info_t *mi;
+	size_t i;
+
+	if ((args == NULL) || (args->stats == NULL) || (args->stats->item == NULL)) {
+		return;
+	}
+	mi = args->stats->item->metrics_info;
+	if ((mi == NULL) || (mi->metrics_desc == NULL)) {
+		return;
+	}
+	for (i = 0; i < mi->num_metrics_items; i++) {
+		if ((mi->metrics_desc[i].mean_type == mean_type) &&
+		    (strcmp(mi->metrics_desc[i].description, description) == 0)) {
+			break;
+		}
+	}
+	if (i == mi->num_metrics_items) {
+		if (i >= mi->max_metrics_items) {
+			mi->overflow_metrics_items = true;
+			return;
+		}
+		(void)shim_strscpy(mi->metrics_desc[i].description, description,
+				   sizeof(mi->metrics_desc[i].description));
+		mi->metrics_desc[i].mean_type = mean_type;
+		mi->num_metrics_items++;
+	}
+	args->stats->metrics_values[i] = value;
+}
+
+/* one-time shared state, as stress_shared_mmap() and main() set it up */
+
+static int stress_ng_shared_init(void)
+{
+	const size_t page_size = stress_memory_page_size_get();
+	size_t sz;
+
+	if (shared_init_failed) {
+		return -1;
+	}
+	if (g_shared != NULL) {
+		return 0;
+	}
+	shared_init_failed = true;
+
+	sz = sizeof(stress_shared_t) + sizeof(stress_stats_t);
+	sz = (sz + page_size - 1) & ~(page_size - 1);
+	g_shared = (stress_shared_t *)stress_mmap_anon_shared(sz, PROT_READ | PROT_WRITE);
+	if (g_shared == MAP_FAILED) {
+		g_shared = NULL;
+		pr_err("mmap %zu byte shared memory region failed, errno=%d (%s)\n", sz, errno,
+		       strerror(errno));
+		return -1;
+	}
+	(void)shim_memset(g_shared, 0, sz);
+	g_shared->length = sz;
+	g_shared->time_started = stress_time_now();
+#if defined(HAVE_VFORK)
+	g_shared->vfork = vfork;
+#else
+	g_shared->vfork = fork;
+#endif
+
+	if (stress_lock_mem_map() < 0) {
+		pr_err("failed to map the lock table\n");
+		return -1;
+	}
+	if (stress_shared_heap_init(page_size) == NULL) {
+		pr_err("failed to create the shared heap\n");
+		return -1;
+	}
+	g_shared->warn_once.lock = stress_lock_create("warn-once");
+	g_shared->net_port_map.lock = stress_lock_create("net-port");
+	g_shared->metrics.lock = stress_lock_create("metrics");
+	g_shared->drop_caches.lock = stress_lock_create("drop_caches");
+	if ((g_shared->warn_once.lock == NULL) || (g_shared->net_port_map.lock == NULL) ||
+	    (g_shared->metrics.lock == NULL) || (g_shared->drop_caches.lock == NULL)) {
+		pr_err("failed to create the global locks\n");
+		return -1;
+	}
+
+	g_shared->mapped.page_none = stress_mmap_anon_shared(page_size, PROT_NONE);
+	g_shared->mapped.page_ro = stress_mmap_anon_shared(page_size, PROT_READ);
+	g_shared->mapped.page_wo = stress_mmap_anon_shared(page_size, PROT_WRITE);
+
+	current_stats = &g_shared->stats[0];
+
+	(void)stress_setting_global_set("temp-path", TYPE_ID_STR, CONFIG_STRESS_NG_TEMP_PATH);
+	if (access(CONFIG_STRESS_NG_TEMP_PATH, R_OK | W_OK) < 0) {
+		pr_warn("temp-path '%s' is not accessible, errno=%d (%s): file system stressors "
+			"will fail\n", CONFIG_STRESS_NG_TEMP_PATH, errno, strerror(errno));
+	}
+	g_shared->mem_cache.level = DEFAULT_CACHE_LEVEL;
+	g_shared->mem_cache.size = CONFIG_STRESS_NG_CACHE_SIZE;
+	if (stress_shared_cache_alloc("shared cache allocate") < 0) {
+		pr_err("failed to allocate the shared cache\n");
+		return -1;
+	}
+	shared_init_failed = false;
+
+	return 0;
+}
+
+/*
+ * A stressor spinning in a compute loop never makes a system call, so a
+ * signal cannot reach it; the timer takes away its bogo-op budget directly.
+ */
+static void stress_ng_stop_expiry(struct k_timer *timer)
+{
+	ARG_UNUSED(timer);
+	stress_continue_set_flag(false);
+}
+
+static K_TIMER_DEFINE(stop_timer, stress_ng_stop_expiry, NULL);
+
+static void MLOCKED_TEXT stress_ng_sigalrm_handler(int signum)
+{
+	const int saved_errno = errno;
+
+	(void)signum;
+
+	stress_continue_set_flag(false);
+	/* keep interrupting blocking calls until the stressor notices */
+	(void)alarm(1);
+	errno = saved_errno;
+}
+
+/*
+ * A forked stressor's descriptors go with its exit. This one runs in the test
+ * process: note what is open before it starts and close what it leaves behind.
+ */
+static void stress_ng_fds_mark(unsigned long *open_fds)
+{
+	for (int fd = 0; fd < OPEN_MAX; fd++) {
+		if (fcntl(fd, F_GETFD) >= 0) {
+			open_fds[fd / BITS_PER_LONG] |= BIT(fd % BITS_PER_LONG);
+		}
+	}
+}
+
+static int stress_ng_fds_sweep(const unsigned long *open_fds)
+{
+	int n = 0;
+
+	for (int fd = 0; fd < OPEN_MAX; fd++) {
+		if (((open_fds[fd / BITS_PER_LONG] & BIT(fd % BITS_PER_LONG)) == 0) &&
+		    (fcntl(fd, F_GETFD) >= 0)) {
+			(void)close(fd);
+			n++;
+		}
+	}
+
+	return n;
+}
+
+/* numbered processes alive, zombies included */
+static int live_processes(void)
+{
+	int n = 0;
+
+	for (int id = 0; id <= CONFIG_SYS_PROCESS_IDS; id++) {
+		n += (sys_process_find(id) != NULL);
+	}
+
+	return n;
+}
+
+static int stress_ng_run_locked(const struct stress_ng_stressor *s, const struct stress_ng_opts *opts)
+{
+	const int live = live_processes();
+	const stressor_info_t *info = s->info;
+	const uint32_t timeout = (opts && opts->timeout_s) ? opts->timeout_s
+							   : CONFIG_STRESS_NG_DEFAULT_TIMEOUT;
+	const uint64_t max_ops = (opts && opts->max_ops) ? opts->max_ops : NEVER_END_OPS;
+	size_t n_metrics = info->max_metrics_items ? info->max_metrics_items
+						   : STRESS_METRICS_ITEMS_DEFAULT_SIZE;
+	stress_stats_t *stats;
+	unsigned long open_fds[DIV_ROUND_UP(OPEN_MAX, BITS_PER_LONG)] = {0};
+	int leaked;
+	stress_args_t *args;
+	struct sigaction sa, old_sa, old_abrt;
+	sigset_t set, old_set;
+	double start, finish;
+	int rc, signum;
+
+	if (info->stressor == stress_unimplemented) {
+		pr_inf_skip("%s: stressor is not implemented on this system, skipping\n", s->name);
+		return EXIT_NOT_IMPLEMENTED;
+	}
+	if ((info->supported != NULL) && (info->supported(s->name) < 0)) {
+		return EXIT_NOT_IMPLEMENTED;
+	}
+	if (stress_ng_shared_init() < 0) {
+		return EXIT_NO_RESOURCE;
+	}
+	stats = current_stats;
+	args = &stats->args;
+
+	(void)shim_memset(&current_stressor, 0, sizeof(current_stressor));
+	current_stressor.info = info;
+	(void)shim_strscpy(current_stressor.name, s->name, sizeof(current_stressor.name));
+
+	(void)shim_memset(&current_metrics, 0, sizeof(current_metrics));
+	current_metrics.metrics_desc = calloc(n_metrics, sizeof(*current_metrics.metrics_desc));
+	current_metrics.max_metrics_items = n_metrics;
+
+	(void)shim_memset(stats, 0, sizeof(*stats));
+	stats->metrics_values = calloc(n_metrics, sizeof(*stats->metrics_values));
+	if ((current_metrics.metrics_desc == NULL) || (stats->metrics_values == NULL)) {
+		free(current_metrics.metrics_desc);
+		free(stats->metrics_values);
+		pr_err("%s: cannot allocate metrics\n", s->name);
+		return EXIT_NO_RESOURCE;
+	}
+	stats->item = &current_item;
+	stats->s_pid.pid = getpid();
+
+	(void)shim_memset(&current_item, 0, sizeof(current_item));
+	current_item.stressor = &current_stressor;
+	current_item.stats = &current_stats;
+	current_item.metrics_info = &current_metrics;
+	current_item.instances = 1;
+	current_item.bogo_max_ops = (max_ops == NEVER_END_OPS) ? 0 : max_ops;
+	g_item_current = &current_item;
+
+	stress_mwc_reseed();
+	stress_clear_warn_once();
+	pr_fail_reset();
+	stress_ng_fds_mark(open_fds);
+	if (info->default_set != NULL) {
+		info->default_set();
+	}
+	if (info->init != NULL) {
+		info->init(1);
+	}
+
+	/* a forked stressor starts with nothing masked; kernel threads start with everything masked */
+	(void)sigemptyset(&set);
+	(void)pthread_sigmask(SIG_SETMASK, &set, &old_set);
+	(void)shim_memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = stress_ng_sigalrm_handler;
+	(void)sigemptyset(&sa.sa_mask);
+	(void)sigaction(SIGALRM, &sa, &old_sa);
+	sa.sa_handler = stress_ng_sigabrt_handler;
+	(void)sigaction(SIGABRT, &sa, &old_abrt);
+
+	g_stress_continue_flag = true;
+	g_opt_timeout = timeout;
+	runner_tid = k_current_get();
+
+	args->bogo.max_ops = max_ops;
+	args->bogo.count.counter = 0;
+	args->bogo.count.counter_ready = true;
+	args->bogo.possibly_oom_killed = false;
+	args->name = s->name;
+	args->instance = 0;
+	args->instances = 1;
+	args->pid = getpid();
+	args->page_size = stress_memory_page_size_get();
+	args->time_end = stress_time_now() + (double)timeout;
+	args->mapped = &g_shared->mapped;
+	args->stats = stats;
+	args->info = info;
+	current_args = args;
+
+	pr_dbg("%s: started (instance 0, %" PRIu32 " second%s)\n", s->name, timeout,
+	       timeout == 1 ? "" : "s");
+	start = stress_time_now();
+	k_timer_start(&stop_timer, K_SECONDS(timeout), K_NO_WAIT);
+	(void)alarm(timeout);
+	signum = sigsetjmp(abort_env, 1);
+	if (signum == 0) {
+		rc = info->stressor(args);
+	} else {
+		pr_err("%s: terminated by signal %d (%s)\n", s->name, signum, strsignal(signum));
+		rc = EXIT_SIGNALED;
+	}
+	(void)alarm(0);
+	k_timer_stop(&stop_timer);
+	finish = stress_time_now();
+	stress_continue_set_flag(false);
+	pr_dbg("%s: stressor returned %d\n", s->name, rc);
+	pr_fail_check(&rc);
+	if ((rc == EXIT_SUCCESS) && (args->bogo.count.counter == 0)) {
+		/* it ran its time without completing one operation: nothing was verified */
+		pr_inf("%s: did no work\n", s->name);
+		rc = EXIT_NOT_SUCCESS;
+	}
+
+	/*
+	 * A forked stressor leaves unwaited children to init. This one ran in the
+	 * test process, so wait for them here, bounded for a child that never exits.
+	 */
+	for (uint32_t t0 = k_uptime_get_32(); waitpid(-1, NULL, WNOHANG) >= 0;) {
+		if ((k_uptime_get_32() - t0) > 5000U) {
+			pr_err("%s: a child is still running\n", s->name);
+			break;
+		}
+		k_msleep(10);
+	}
+	/*
+	 * A daemonized grandchild is init's to reap, not this process's; it still
+	 * has to be gone before the next stressor's accounting starts.
+	 */
+	for (uint32_t t0 = k_uptime_get_32(); live_processes() > live;) {
+		if ((k_uptime_get_32() - t0) > 5000U) {
+			pr_err("%s: a process is still running\n", s->name);
+			break;
+		}
+		k_msleep(10);
+	}
+
+	/*
+	 * An alarm that fired after the stop but before the handler is taken down
+	 * is still queued; delivered once the default disposition is back it would
+	 * terminate this process. Block, cancel, drain, then restore.
+	 */
+	(void)sigemptyset(&set);
+	(void)sigaddset(&set, SIGALRM);
+	(void)pthread_sigmask(SIG_BLOCK, &set, NULL);
+	(void)alarm(0);
+	while (sigtimedwait(&set, NULL, &(const struct timespec){0}) == SIGALRM) {
+	}
+	(void)sigaction(SIGALRM, &old_sa, NULL);
+	(void)sigaction(SIGABRT, &old_abrt, NULL);
+	(void)pthread_sigmask(SIG_SETMASK, &old_set, NULL);
+
+	if (info->deinit != NULL) {
+		info->deinit();
+	}
+	leaked = stress_ng_fds_sweep(open_fds);
+	if (leaked > 0) {
+		pr_inf("%s: closed %d descriptor%s left open\n", s->name, leaked,
+		       (leaked == 1) ? "" : "s");
+	}
+	current_args = NULL;
+	g_item_current = NULL;
+
+	pr_inf("%s: %s, %" PRIu64 " bogo ops in %.2f secs\n", s->name, stress_ng_strexit(rc),
+	       args->bogo.count.counter, finish - start);
+
+	free(current_metrics.metrics_desc);
+	free(stats->metrics_values);
+	current_metrics.metrics_desc = NULL;
+	stats->metrics_values = NULL;
+
+	return rc;
+}
+
+/* stressors keep sizeable arrays on the stack: run them on a stack sized for that */
+static K_THREAD_STACK_DEFINE(stress_stack, CONFIG_STRESS_NG_STACK_SIZE);
+static struct k_thread stress_thread;
+static bool stress_thread_live;
+
+#ifdef CONFIG_USERSPACE
+/* stressors hand pthreads stack-resident arguments; without an MMU only a partition is shared */
+static struct k_mem_partition stress_stack_partition;
+
+/* the runner's kernel objects, for stressors run from user threads */
+static int stress_ng_grant(void)
+{
+	k_object_access_all_grant(&run_lock);
+	k_object_access_all_grant(&stop_timer);
+
+	if (IS_ENABLED(CONFIG_MMU)) {
+		return 0;
+	}
+	stress_stack_partition.start = (uintptr_t)K_THREAD_STACK_BUFFER(stress_stack);
+	stress_stack_partition.size = K_THREAD_STACK_SIZEOF(stress_stack);
+	stress_stack_partition.attr = K_MEM_PARTITION_P_RW_U_RW;
+
+	return k_mem_domain_add_partition(&k_mem_domain_default, &stress_stack_partition);
+}
+SYS_INIT(stress_ng_grant, APPLICATION, CONFIG_APPLICATION_INIT_PRIORITY);
+#endif /* CONFIG_USERSPACE */
+
+struct stress_ng_job {
+	const struct stress_ng_stressor *s;
+	struct stress_ng_opts opts;
+	int rc;
+};
+
+/* read by the stressor thread: library data is shared, the caller's stack is not */
+static struct stress_ng_job job;
+
+static void stress_ng_thread(void *p1, void *p2, void *p3)
+{
+	struct stress_ng_job *job = p1;
+
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+	job->rc = stress_ng_run_locked(job->s, &job->opts);
+}
+
+static void *stress_ng_pthread(void *arg)
+{
+	stress_ng_thread(arg, NULL, NULL);
+
+	return NULL;
+}
+
+int stress_ng_run(const char *name, const struct stress_ng_opts *opts)
+{
+	ssize_t i;
+
+	if (name == NULL) {
+		return EXIT_NOT_IMPLEMENTED;
+	}
+	i = stress_stressor_find(name);
+	if (i < 0) {
+		pr_inf_skip("%s: stressor is not built in, skipping\n", name);
+		return EXIT_NOT_IMPLEMENTED;
+	}
+
+	k_sem_take(&run_lock, K_FOREVER);
+	job.s = &stressors[i];
+	job.opts = (opts != NULL) ? *opts : (struct stress_ng_opts){0};
+	job.rc = EXIT_FAILURE;
+	if (k_is_user_context()) {
+		pthread_t th;
+		pthread_attr_t attr;
+		sigset_t all, old;
+
+		/* process-directed signals must stay pending on the stressor, not land on its waiting creator */
+		(void)sigfillset(&all);
+		(void)pthread_sigmask(SIG_SETMASK, &all, &old);
+		(void)pthread_attr_init(&attr);
+		(void)pthread_attr_setstack(&attr, stress_stack, K_THREAD_STACK_SIZEOF(stress_stack));
+		if (pthread_create(&th, &attr, stress_ng_pthread, &job) == 0) {
+			(void)pthread_join(th, NULL);
+		}
+		(void)pthread_attr_destroy(&attr);
+		(void)pthread_sigmask(SIG_SETMASK, &old, NULL);
+	} else {
+		stress_thread_live = true;
+		(void)k_thread_create(&stress_thread, stress_stack, K_THREAD_STACK_SIZEOF(stress_stack),
+				      stress_ng_thread, &job, NULL, NULL,
+				      k_thread_priority_get(k_current_get()), 0, K_NO_WAIT);
+		(void)k_thread_name_set(&stress_thread, "stress-ng");
+		(void)k_thread_join(&stress_thread, K_FOREVER);
+		stress_thread_live = false;
+	}
+	k_sem_give(&run_lock);
+
+	return job.rc;
+}
+
+void stress_ng_reset(void)
+{
+	if (stress_thread_live) {
+		k_thread_abort(&stress_thread);
+		stress_thread_live = false;
+	}
+	k_timer_stop(&stop_timer);
+	stress_continue_set_flag(false);
+	(void)alarm(0);
+	current_args = NULL;
+	g_item_current = NULL;
+	k_sem_reset(&run_lock);
+	k_sem_give(&run_lock);
+}
+
+const char *stress_ng_strexit(int status)
+{
+	switch (status) {
+	case EXIT_SUCCESS:
+		return "passed";
+	case EXIT_FAILURE:
+		return "failed";
+	case EXIT_NOT_SUCCESS:
+		return "not successful";
+	case EXIT_NO_RESOURCE:
+		return "no resource";
+	case EXIT_NOT_IMPLEMENTED:
+		return "not implemented";
+	case EXIT_SIGNALED:
+		return "signaled";
+	case EXIT_BY_SYS_EXIT:
+		return "exited";
+	case EXIT_METRICS_UNTRUSTWORTHY:
+		return "metrics untrustworthy";
+	default:
+		return "unknown";
+	}
+}
+
+size_t stress_ng_stressor_count(void)
+{
+	return ARRAY_SIZE(stressors);
+}
+
+const char *stress_ng_stressor_name(size_t i)
+{
+	return (i < ARRAY_SIZE(stressors)) ? stressors[i].name : NULL;
+}
diff --git a/zephyr/scripts/gen_glue.py b/zephyr/scripts/gen_glue.py
new file mode 100644
--- /dev/null
+++ b/zephyr/scripts/gen_glue.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Generate the per-stressor Zephyr glue for stress-ng.
+
+usage: gen_glue.py <stress-ng dir> [requirements.json]
+
+requirements.json: { "<stressor>": {"select": [KCONFIG...], "depends": "expr", "why": "comment", "exclude": "reason"} }
+"""
+import json, os, re, sys
+
+sng = sys.argv[1]
+req = json.load(open(sys.argv[2])) if len(sys.argv) > 2 else {}
+hdr = open(os.path.join(sng, 'core-stressors.h')).read()
+body = hdr[hdr.index('#define STRESSORS(MACRO)'):]
+syms = re.findall(r'MACRO\((\w+)\)', body)
+
+def name_of(sym):
+    return sym.replace('_', '-')
+
+# the file defining stress_<sym>_info (a few files carry two stressors)
+import glob
+FILE = {}
+for f in sorted(glob.glob(os.path.join(sng, 'stress-*.c'))):
+    for m in re.finditer(r'const stressor_info_t stress_(\w+)_info\b', open(f, errors='replace').read()):
+        FILE.setdefault(m.group(1), os.path.basename(f))
+
+def help_of(sym):
+    src = os.path.join(sng, FILE.get(sym, f'stress-{name_of(sym)}.c'))
+    try:
+        s = open(src, errors='replace').read()
+    except OSError:
+        return None
+    m = re.search(r'stress_help_t [a-z_]*help\[\] = \{\s*\{\s*NULL,\s*"' + name_of(sym) + r' N",\s*"([^"]*)"', s)
+    return m.group(1) if m else None
+
+LIC = "# SPDX-License-Identifier: GPL-2.0-or-later\n# Copyright (c) 2026, Friedt Professional Engineering Services, Inc.\n"
+GEN = "# Generated by zephyr/scripts/gen_glue.py from core-stressors.h; do not edit.\n"
+
+kc = [LIC, "#\n# One Kconfig symbol per stressor. Enabling a stressor pulls in the POSIX\n# Option Groups it exercises (see the STRESS_NG_NEEDS_* symbols at the end).\n", GEN, "\nmenu \"Stressors\"\n"]
+cm = [LIC, GEN]
+tb = ["/*\n * SPDX-License-Identifier: GPL-2.0-or-later\n * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.\n *\n * Generated by zephyr/scripts/gen_glue.py from core-stressors.h; do not edit.\n * The includer defines STRESS_NG_STRESSOR(symbol, name).\n */\n"]
+files = {}
+needs = {}
+n = 0
+for sym in syms:
+    name = name_of(sym)
+    r = req.get(name, {})
+    if r.get('exclude'):
+        continue
+    K = f"STRESS_NG_STRESSOR_{sym.upper()}"
+    if r.get('fork'):
+        kc.append(f"\n# forks: needs CONFIG_PROCESS_VM at run time")
+    kc.append(f"\nconfig {K}\n\tbool \"{name}\"\n")
+    if r.get('depends'):
+        if r.get('why'):
+            kc.append(f"\t# {r['why']}\n")
+        kc.append(f"\tdepends on {r['depends']}\n")
+    for s in r.get('select', []):
+        needs.setdefault(s, []).append(K)
+    h = help_of(sym)
+    if h:
+        h = h[0].upper() + h[1:]
+        kc.append(f"\thelp\n\t  {h}.\n")
+    files.setdefault(FILE.get(sym, f'stress-{name}.c'), []).append(K)
+    tb.append(f"#ifdef CONFIG_{K}\nSTRESS_NG_STRESSOR({sym}, \"{name}\")\n#endif\n")
+    n += 1
+excluded = sorted((name_of(s), req[name_of(s)]['exclude']) for s in syms if req.get(name_of(s), {}).get('exclude'))
+if excluded:
+    kc.append("\n# Not enabled on Zephyr, and why (zephyr/scripts/requirements.json):\n")
+    for name, why in excluded:
+        kc.append(f"#   {name}: {why}\n")
+kc.append("\nendmenu # Stressors\n")
+kc.append("""
+# The POSIX Option Groups the enabled stressors exercise, one hidden symbol per
+# group: hundreds of per-stressor selects would make the reverse dependencies
+# of the POSIX symbols too large for Kconfig to process.
+""")
+for s in sorted(needs):
+    extra = "\tselect NETWORKING\n" if s == 'POSIX_NETWORKING' else ""
+    # mirror the selected symbol's own dependencies so the select never fires unmet
+    cond = {"POSIX_SIGNAL_JUMP": " if !NATIVE_BUILD || NATIVE_LIBC"}.get(s, "")
+    kc.append(f"\nconfig STRESS_NG_NEEDS_{s}\n\tbool\n\tdefault y if {' || '.join(needs[s])}\n\tselect {s}{cond}\n{extra}")
+for f, ks in files.items():
+    if len(ks) == 1:
+        cm.append(f"zephyr_library_sources_ifdef(CONFIG_{ks[0]} ${{sng_dir}}/{f})\n")
+    else:
+        cm.append(f"if({' OR '.join('CONFIG_' + k for k in ks)})\n  zephyr_library_sources(${{sng_dir}}/{f})\nendif()\n")
+open(os.path.join(sng, 'zephyr/Kconfig.stressors'), 'w').write(''.join(kc))
+open(os.path.join(sng, 'zephyr/stressors.cmake'), 'w').write(''.join(cm))
+open(os.path.join(sng, 'zephyr/include/stress_ng_stressors.h'), 'w').write(''.join(tb))
+print(f"{n} stressors of {len(syms)}")
