+#ifdef CONFIG_SIGNAL_FAULT
+/* a fault's default action ends the faulting thread's process: without processes, the thread */
+static inline FUNC_NORETURN void z_process_exit_signaled(int sig)
+{
+	ARG_UNUSED(sig);
+	k_thread_abort(_current);
+	CODE_UNREACHABLE;
+}
+
+/* the calling thread belongs to one of the kernel-reserved processes */
+static inline bool z_process_self_is_reserved(void)
+{
+	return true;
