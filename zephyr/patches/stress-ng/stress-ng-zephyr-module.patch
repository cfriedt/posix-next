diff --git a/zephyr/CMakeLists.txt b/zephyr/CMakeLists.txt
--- a/zephyr/CMakeLists.txt
+++ b/zephyr/CMakeLists.txt
@@ -1,2 +1,120 @@
 # SPDX-License-Identifier: GPL-2.0-or-later
 # Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+#
+# Build the stress-ng core and the selected stressors as a Zephyr library.
+#
+# config.h is the hand-maintained zephyr/config/config.h rather than the
+# output of Makefile.config's compile probes: it maps Zephyr's Kconfig
+# symbols onto stress-ng's HAVE_* feature macros, so a stressor whose
+# interfaces are not configured in collapses to stress_unimplemented()
+# exactly as it does on any other platform that lacks them.
+
+if(CONFIG_STRESS_NG)
+
+set(sng_dir ${ZEPHYR_CURRENT_MODULE_DIR})
+
+file(STRINGS ${sng_dir}/Makefile sng_ver_line REGEX "^VERSION=")
+string(REGEX REPLACE "^VERSION=" "" sng_ver "${sng_ver_line}")
+
+zephyr_library_named(stress_ng)
+# a stressor is user code: its state lives with the C library's, readable from user mode
+zephyr_library_app_memory(z_libc_partition)
+zephyr_include_directories(${sng_dir}/zephyr/include)
+
+# the headers the Makefile generates: the commit id, and the PER_*,
+# IORING_OP_* and PERF_COUNT_* lists it extracts from the Linux headers,
+# which are empty here
+set(sng_gen_dir ${CMAKE_CURRENT_BINARY_DIR}/generated)
+execute_process(
+  COMMAND git -C ${sng_dir} rev-parse HEAD
+  OUTPUT_VARIABLE sng_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
+)
+file(CONFIGURE OUTPUT ${sng_gen_dir}/git-commit-id.h
+  CONTENT "#define STRESS_GIT_COMMIT_ID \"${sng_commit}\"\n" @ONLY)
+foreach(sng_h io-uring.h personality.h core-perf-event.h)
+  file(CONFIGURE OUTPUT ${sng_gen_dir}/${sng_h} CONTENT "" @ONLY)
+endforeach()
+
+zephyr_library_include_directories(${sng_dir}/zephyr/config ${sng_gen_dir} ${sng_dir})
+
+# the core, less the command line driver (stress-ng.c), the job file
+# parser (core-job.c) and Linux resctrl (core-resctrl.c); zephyr.c stands
+# in for the driver
+zephyr_library_sources(
+  ${sng_dir}/core-affinity.c
+  ${sng_dir}/core-arch.c
+  ${sng_dir}/core-asm-ret.c
+  ${sng_dir}/core-capabilities.c
+  ${sng_dir}/core-clocksource.c
+  ${sng_dir}/core-config-check.c
+  ${sng_dir}/core-cpu.c
+  ${sng_dir}/core-cpu-cache.c
+  ${sng_dir}/core-cpu-freq.c
+  ${sng_dir}/core-cpuidle.c
+  ${sng_dir}/core-filesystem.c
+  ${sng_dir}/core-ftrace.c
+  ${sng_dir}/core-hash.c
+  ${sng_dir}/core-helper.c
+  ${sng_dir}/core-ignite-cpu.c
+  ${sng_dir}/core-interrupts.c
+  ${sng_dir}/core-io-priority.c
+  ${sng_dir}/core-io-uring.c
+  ${sng_dir}/core-ioctl.c
+  ${sng_dir}/core-killpid.c
+  ${sng_dir}/core-klog.c
+  ${sng_dir}/core-limit.c
+  ${sng_dir}/core-lock.c
+  ${sng_dir}/core-log.c
+  ${sng_dir}/core-madvise.c
+  ${sng_dir}/core-memory.c
+  ${sng_dir}/core-mincore.c
+  ${sng_dir}/core-mlock.c
+  ${sng_dir}/core-mmap.c
+  ${sng_dir}/core-module.c
+  ${sng_dir}/core-mounts.c
+  ${sng_dir}/core-mwc.c
+  ${sng_dir}/core-net.c
+  ${sng_dir}/core-numa.c
+  ${sng_dir}/core-opts.c
+  ${sng_dir}/core-out-of-memory.c
+  ${sng_dir}/core-parse-opts.c
+  ${sng_dir}/core-perf.c
+  ${sng_dir}/core-prime.c
+  ${sng_dir}/core-processes.c
+  ${sng_dir}/core-rapl.c
+  ${sng_dir}/core-resources.c
+  ${sng_dir}/core-sched.c
+  ${sng_dir}/core-setting.c
+  ${sng_dir}/core-shared-cache.c
+  ${sng_dir}/core-shared-heap.c
+  ${sng_dir}/core-shim.c
+  ${sng_dir}/core-signal.c
+  ${sng_dir}/core-smart.c
+  ${sng_dir}/core-sort.c
+  ${sng_dir}/core-stack.c
+  ${sng_dir}/core-sync.c
+  ${sng_dir}/core-thermal-zone.c
+  ${sng_dir}/core-thrash.c
+  ${sng_dir}/core-time.c
+  ${sng_dir}/core-try-open.c
+  ${sng_dir}/core-vmstat.c
+  ${sng_dir}/core-workload.c
+  ${sng_dir}/zephyr/zephyr.c
+)
+include(${sng_dir}/zephyr/stressors.cmake)
+
+zephyr_library_compile_definitions(
+  VERSION="${sng_ver}"
+  STRESS_PROCS_MAX=${CONFIG_STRESS_NG_PROCS_MAX}
+)
+zephyr_library_compile_options(
+  -std=gnu99
+  -U_POSIX_C_SOURCE -D_POSIX_C_SOURCE=200809L
+  -U_XOPEN_SOURCE -D_XOPEN_SOURCE=700
+  # upstream builds without -Werror; these fire on paths its platforms never take
+  -Wno-format-truncation
+  -Wno-unused-variable
+  -Wno-unused-const-variable
+)
+
+endif()
diff --git a/zephyr/Kconfig b/zephyr/Kconfig
--- a/zephyr/Kconfig
+++ b/zephyr/Kconfig
@@ -1,2 +1,120 @@
 # SPDX-License-Identifier: GPL-2.0-or-later
 # Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+
+menuconfig STRESS_NG
+	bool "stress-ng stressors"
+	select POSIX_SYSTEM_INTERFACES
+	select POSIX_TIMERS
+	select POSIX_SIGNALS
+	select POSIX_SIGNALS_EXT
+	select POSIX_SIGNAL_JUMP if !NATIVE_BUILD || NATIVE_LIBC
+	select POSIX_DEVICE_IO
+	select POSIX_FILE_SYSTEM
+	select POSIX_FILE_SYSTEM_EXT
+	select POSIX_PIPE
+	select POSIX_THREADS
+	select POSIX_C_LIB_EXT
+	select POSIX_FD_MGMT
+	select POSIX_MAPPED_FILES
+	select POSIX_SINGLE_PROCESS
+	select POSIX_MULTI_PROCESS
+	select POSIX_USER_GROUPS
+	# the pthread headers claim _POSIX_THREAD_PRIORITY_SCHEDULING with POSIX_THREADS
+	select POSIX_THREAD_PRIORITY_SCHEDULING if POSIX_THREADS
+	select XSI
+	select XSI_SINGLE_PROCESS
+	# long double on 32-bit x86 needs the x87 unit (soft-float libgcc has no XFmode
+	# helpers) and picolibc's hard-float libm touches the SSE control register
+	select FPU if X86 && CPU_HAS_FPU
+	select FPU_SHARING if X86 && CPU_HAS_FPU
+	# soft-float math on an emulated RISC-V core takes minutes per bogo op
+	select FPU if RISCV && CPU_HAS_FPU
+	select FPU_SHARING if RISCV && CPU_HAS_FPU
+	select X86_SSE if X86 && CPU_HAS_FPU && X86_CPU_HAS_SSE
+	help
+	  Build the stress-ng core and the stressors selected below as a
+	  library. A stressor runs in the calling thread through
+	  stress_ng_run() instead of as a forked child of the stress-ng
+	  command line driver; each one selects the POSIX Option Groups it
+	  exercises.
+
+if STRESS_NG
+
+config STRESS_NG_PROCS_MAX
+	int "Maximum instances per stressor"
+	range 1 8192
+	default 8
+	help
+	  Sizes the shared futex and lock tables (STRESS_PROCS_MAX). The
+	  upstream default of 8192 costs about 100 KiB of shared memory.
+
+config ZVFS_OPEN_ADD_SIZE_STRESS_NG
+	int
+	default 56
+	help
+	  File descriptors the stressors open at once on top of the descriptors
+	  the other subsystems request: files, pipes, duplicated descriptors.
+
+config ZVFS_EVENTFD_ADD_SIZE_STRESS_NG
+	int
+	default 2 if STRESS_NG_STRESSOR_EVENTFD
+	default 0
+	help
+	  Event file descriptors the eventfd stressor holds at once.
+
+config STRESS_NG_STACK_SIZE
+	int "Stack size of the thread a stressor runs on"
+	default 131072
+	help
+	  stress_ng_run() runs the stressor on a dedicated thread with this much
+	  stack. Stressors keep sizeable arrays on the stack (upstream runs them
+	  as processes with an 8 MiB stack), so the caller's stack is not used.
+
+config STRESS_NG_SHARED_ARENA_SIZE
+	int "Static arena for the shared state on boards without an MMU"
+	default 196608
+	depends on !MMU
+	help
+	  Without an MMU every anonymous mapping granted to a user thread costs a
+	  memory-protection region, so the shared state of a run (the shared
+	  structure, lock table, shared heap, cache buffers and probe pages) comes
+	  from this static arena instead. The shared structure alone is about 66 KiB
+	  and the cache buffer is STRESS_NG_CACHE_SIZE.
+
+config STRESS_NG_CACHE_SIZE
+	int "Shared cache buffer size in bytes"
+	default 65536
+	help
+	  Size of the shared buffer the cache stressors thrash (--cache-size).
+	  The command line driver sizes it from the CPU's largest cache, which
+	  is 2 MiB when it cannot be determined.
+
+config STRESS_NG_DEFAULT_TIMEOUT
+	int "Default stressor run time in seconds"
+	default 5
+	help
+	  Run time used by stress_ng_run() when the caller passes none, as
+	  --timeout does for the command line driver.
+
+config STRESS_NG_TEMP_PATH
+	string "Directory for temporary files"
+	default "/tmp"
+	help
+	  Where stressors create their temporary files and directories (the
+	  --temp-path of the command line driver). It must be a writable
+	  mount point; tests mount a tmpfs there.
+
+config STRESS_NG_MINIMIZE
+	bool "Minimize stressor resource usage"
+	default y
+	help
+	  Run every stressor with its smallest parameters (the --minimize of
+	  the command line driver): fewest threads, smallest buffers and
+	  files. Suits targets with megabytes rather than gigabytes of RAM.
+
+config STRESS_NG_LOG_DEBUG
+	bool "Print stress-ng debug messages"
+
+rsource "Kconfig.stressors"
+
+endif # STRESS_NG
