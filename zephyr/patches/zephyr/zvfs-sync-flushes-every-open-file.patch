diff --git a/lib/os/zvfs/zvfs_sync.c b/lib/os/zvfs/zvfs_sync.c
new file mode 100644
--- /dev/null
+++ b/lib/os/zvfs/zvfs_sync.c
@@ -0,0 +1,37 @@
+/*
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <errno.h>
+
+#include <zephyr/sys/fdtable.h>
+#include <zephyr/sys/internal/fdtable_priv.h>
+#include <zephyr/internal/syscall_handler.h>
+
+static void sync_description(struct fd_entry *entry, void *arg)
+{
+	int prev_errno = errno;
+
+	ARG_UNUSED(arg);
+
+	/* a file object without a sync answers EOPNOTSUPP */
+	(void)zvfs_fdtable_call_ioctl(entry->vtable, entry->obj, ZFD_IOCTL_FSYNC);
+	errno = prev_errno;
+}
+
+void z_impl_zvfs_sync(void)
+{
+	/* only a regular file has a backing store; a pipe or socket read holds its lock through the wait */
+	zvfs_fd_entry_foreach(ZVFS_MODE_IFREG, sync_description, NULL);
+}
+
+#ifdef CONFIG_USERSPACE
+static void z_vrfy_zvfs_sync(void)
+{
+	z_impl_zvfs_sync();
+}
+
+#include <zephyr/syscalls/zvfs_sync_mrsh.c>
+#endif /* CONFIG_USERSPACE */
diff --git a/tests/lib/zvfs_fs/src/main.c b/tests/lib/zvfs_fs/src/main.c
--- a/tests/lib/zvfs_fs/src/main.c
+++ b/tests/lib/zvfs_fs/src/main.c
@@ -820,6 +820,28 @@ ZTEST_USER(zvfs_fs, test_zvfs_fchown)
 	zassert_equal(errno, EBADF);
 }
 
+ZTEST_USER(zvfs_fs, test_zvfs_sync)
+{
+	struct zvfs_stat st;
+	int fd;
+	int dfd;
+
+	/* a buffered write reaches the file; a directory description is not visited */
+	fd = zvfs_open(TNOENT, ZVFS_O_RDWR | ZVFS_O_CREAT | ZVFS_O_EXCL, 0600);
+	zassert_true(fd >= 0);
+	dfd = zvfs_open(TDIR, ZVFS_O_RDONLY | ZVFS_O_DIRECTORY, 0);
+	zassert_true(dfd >= 0);
+	zassert_equal(zvfs_write(fd, TCONTENT, strlen(TCONTENT)), strlen(TCONTENT));
+	errno = 0;
+	zvfs_sync();
+	zassert_equal(errno, 0);
+	zassert_ok(zvfs_stat(TNOENT, &st));
+	zassert_equal(st.size, (off_t)strlen(TCONTENT));
+	zassert_ok(zvfs_close(dfd));
+	zassert_ok(zvfs_close(fd));
+	zassert_ok(zvfs_unlink(TNOENT));
+}
