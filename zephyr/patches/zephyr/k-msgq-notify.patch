diff --git a/tests/kernel/msgq/msgq_api/src/test_msgq_notify.c b/tests/kernel/msgq/msgq_api/src/test_msgq_notify.c
new file mode 100644
index 00000000000..e3695548814
--- /dev/null
+++ b/tests/kernel/msgq/msgq_api/src/test_msgq_notify.c
@@ -0,0 +1,201 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "test_msgq.h"
+
+#ifdef CONFIG_MSGQ_NOTIFY
+
+#define NOTIFY_MSG_SIZE 16
+#define NOTIFY_SIGNO    K_SIG_USR1
+#define NOTIFY_VAL      42
+
+extern struct k_msgq prio_msgq;
+
+static void notify_sig_block(void)
+{
+	struct k_sig_set set;
+
+	zassert_ok(k_sig_emptyset(&set));
+	zassert_ok(k_sig_addset(&set, NOTIFY_SIGNO));
+	zassert_ok(k_sig_mask(K_SIG_BLOCK, &set, NULL));
+}
+
+static int notify_sig_accept(struct k_sig_info *info, k_timeout_t timeout)
+{
+	struct k_sig_set set;
+
+	zassert_ok(k_sig_emptyset(&set));
+	zassert_ok(k_sig_addset(&set, NOTIFY_SIGNO));
+
+	return k_sig_timedwait(&set, info, timeout);
+}
+
+static void section_reset(void)
+{
+	k_msgq_purge(&prio_msgq);
+	(void)k_msgq_notify_disarm(&prio_msgq);
+	while (notify_sig_accept(NULL, K_NO_WAIT) >= 0) {
+	}
+}
+
+static void notify_put(uint32_t prio)
+{
+	char msg[NOTIFY_MSG_SIZE] = "notify";
+
+	zassert_ok(k_msgq_put_prio(&prio_msgq, msg, sizeof(msg), prio, K_NO_WAIT));
+}
+
+static void notify_drain(void)
+{
+	char buf[NOTIFY_MSG_SIZE];
+
+	while (k_msgq_get_prio(&prio_msgq, buf, sizeof(buf), NULL, K_NO_WAIT) >= 0) {
+	}
+}
+
+static void notify_isr_put_entry(const void *param)
+{
+	char msg[NOTIFY_MSG_SIZE] = "from isr";
+
+	zassert_ok(k_msgq_put_prio((struct k_msgq *)param, msg, sizeof(msg), 0, K_NO_WAIT));
+}
+
+/* sections of test_k_msgq_notify_arm */
+
+static void notify_arm_fires_once(void)
+{
+	struct k_sig_info info;
+
+	zassert_ok(k_msgq_notify_arm(&prio_msgq, k_current_get(), NOTIFY_SIGNO,
+				     (union k_sig_val){.sival_int = NOTIFY_VAL}));
+
+	/* the empty -> non-empty transition generates the signal... */
+	notify_put(0);
+	zassert_equal(notify_sig_accept(&info, TIMEOUT), NOTIFY_SIGNO);
+	zassert_equal(info.signo, NOTIFY_SIGNO);
+	zassert_equal(info.code, K_SI_MSGQ);
+	zassert_equal(info.value.sival_int, NOTIFY_VAL);
+
+	/* ...consuming the registration: further sends do not fire */
+	notify_put(0);
+	zassert_true(notify_sig_accept(NULL, K_NO_WAIT) < 0);
+	notify_drain();
+	notify_put(0);
+	zassert_true(notify_sig_accept(NULL, K_NO_WAIT) < 0);
+
+	/* consumed means re-arming is accepted */
+	notify_drain();
+	zassert_ok(k_msgq_notify_arm(&prio_msgq, k_current_get(), NOTIFY_SIGNO,
+				     (union k_sig_val){.sival_int = NOTIFY_VAL}));
+	zassert_ok(k_msgq_notify_disarm(&prio_msgq));
+}
+
+static void notify_arm_non_empty_no_fire(void)
+{
+	struct k_sig_info info;
+
+	/* arming on a non-empty queue is accepted but does not fire on sends */
+	notify_put(0);
+	zassert_ok(k_msgq_notify_arm(&prio_msgq, k_current_get(), NOTIFY_SIGNO,
+				     (union k_sig_val){.sival_int = NOTIFY_VAL}));
+	notify_put(0);
+	zassert_true(notify_sig_accept(NULL, K_NO_WAIT) < 0);
+
+	/* it fires on the next empty -> non-empty transition */
+	notify_drain();
+	notify_put(0);
+	zassert_equal(notify_sig_accept(&info, TIMEOUT), NOTIFY_SIGNO);
+	zassert_equal(info.code, K_SI_MSGQ);
+}
+
+static void notify_arm_signo_zero(void)
+{
+	/* signo 0: no signal is ever generated, but the transition consumes it */
+	zassert_ok(k_msgq_notify_arm(&prio_msgq, NULL, 0, (union k_sig_val){0}));
+	notify_put(0);
+	zassert_true(notify_sig_accept(NULL, K_NO_WAIT) < 0);
+	zassert_ok(k_msgq_notify_arm(&prio_msgq, NULL, 0, (union k_sig_val){0}));
+	zassert_ok(k_msgq_notify_disarm(&prio_msgq));
+}
+
+static void notify_arm_errors(void)
+{
+	static char classic_buf[MSG_SIZE * MSGQ_LEN];
+	struct k_msgq classic;
+
+	zassert_ok(k_msgq_notify_arm(&prio_msgq, k_current_get(), NOTIFY_SIGNO,
+				     (union k_sig_val){.sival_int = NOTIFY_VAL}));
+	zassert_equal(k_msgq_notify_arm(&prio_msgq, k_current_get(), NOTIFY_SIGNO,
+					(union k_sig_val){.sival_int = NOTIFY_VAL}),
+		      -EBUSY);
+	zassert_ok(k_msgq_notify_disarm(&prio_msgq));
+
+	k_msgq_init(&classic, classic_buf, MSG_SIZE, MSGQ_LEN);
+	zassert_equal(k_msgq_notify_arm(&classic, k_current_get(), NOTIFY_SIGNO,
+					(union k_sig_val){.sival_int = NOTIFY_VAL}),
+		      -ENOTSUP);
+}
+
+static void notify_arm_isr_fire(void)
+{
+	struct k_sig_info info;
+
+	zassert_ok(k_msgq_notify_arm(&prio_msgq, k_current_get(), NOTIFY_SIGNO,
+				     (union k_sig_val){.sival_int = NOTIFY_VAL}));
+	irq_offload(notify_isr_put_entry, &prio_msgq);
+	zassert_equal(notify_sig_accept(&info, TIMEOUT), NOTIFY_SIGNO);
+	zassert_equal(info.code, K_SI_MSGQ);
+}
+
+ZTEST(msgq_api, test_k_msgq_notify_arm)
+{
+	notify_sig_block();
+	section_reset();
+	notify_arm_fires_once();
+	section_reset();
+	notify_arm_non_empty_no_fire();
+	section_reset();
+	notify_arm_signo_zero();
+	section_reset();
+	notify_arm_errors();
+	section_reset();
+	notify_arm_isr_fire();
+	section_reset();
+}
+
+/* sections of test_k_msgq_notify_disarm */
+
+static void notify_disarm_removes(void)
+{
+	zassert_ok(k_msgq_notify_arm(&prio_msgq, k_current_get(), NOTIFY_SIGNO,
+				     (union k_sig_val){.sival_int = NOTIFY_VAL}));
+	zassert_ok(k_msgq_notify_disarm(&prio_msgq));
+	notify_put(0);
+	zassert_true(notify_sig_accept(NULL, K_NO_WAIT) < 0);
+}
+
+static void notify_disarm_errors(void)
+{
+	static char classic_buf[MSG_SIZE * MSGQ_LEN];
+	struct k_msgq classic;
+
+	zassert_equal(k_msgq_notify_disarm(&prio_msgq), -EINVAL);
+
+	k_msgq_init(&classic, classic_buf, MSG_SIZE, MSGQ_LEN);
+	zassert_equal(k_msgq_notify_disarm(&classic), -ENOTSUP);
+}
+
+ZTEST(msgq_api, test_k_msgq_notify_disarm)
+{
+	notify_sig_block();
+	section_reset();
+	notify_disarm_removes();
+	section_reset();
+	notify_disarm_errors();
+	section_reset();
+}
+
+#endif /* CONFIG_MSGQ_NOTIFY */
