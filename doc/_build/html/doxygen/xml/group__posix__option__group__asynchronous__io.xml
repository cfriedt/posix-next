        <name>lio_listio</name>
        <param>
          <type>int</type>
          <declname>mode</declname>
        </param>
        <param>
          <type>struct <ref refid="structaiocb" kindref="compound">aiocb</ref> *const</type>
          <declname>list</declname>
          <array>[ZRESTRICT]</array>
        </param>
