diff --git a/zephyr/zephyr.c b/zephyr/zephyr.c
new file mode 100644
index 0000000..7d24a11
--- /dev/null
+++ b/zephyr/zephyr.c
@@ -0,0 +1,215 @@
+/*
+ * SPDX-License-Identifier: 0BSD
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * Functions toybox relies on that the Zephyr libc and POSIX layer lack.
+ */
+
+#include <errno.h>
+#include <stdarg.h>
+
+/* errno may be thread-local in the base image (see lib/portability.h) */
+extern int *__errno_location(void);
+#undef errno
+#define errno (*__errno_location())
+#include <grp.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mount.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/syscall.h>
+#include <sys/uio.h>
+#include <termios.h>
+#include <unistd.h>
+
+/* lib/env.c: the image's own environment store */
+char *xsetenv(char *name, char *val);
+
+/* per image, not the base image's shared one; main() sets it from envp */
+char **environ;
+
+/* the C library's environment functions consult the base image's store: these read ours */
+char *getenv(const char *name)
+{
+	size_t len = strlen(name);
+
+	for (char **ev = environ; (ev != NULL) && (*ev != NULL); ev++) {
+		if ((strncmp(*ev, name, len) == 0) && ((*ev)[len] == '=')) {
+			return *ev + len + 1;
+		}
+	}
+
+	return NULL;
+}
+
+int setenv(const char *name, const char *value, int overwrite)
+{
+	if ((name == NULL) || (*name == '\0') || (strchr(name, '=') != NULL) || (value == NULL)) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (!overwrite && (getenv(name) != NULL)) {
+		return 0;
+	}
+	xsetenv((char *)name, (char *)value);
+
+	return 0;
+}
+
+int unsetenv(const char *name)
+{
+	if ((name == NULL) || (*name == '\0') || (strchr(name, '=') != NULL)) {
+		errno = EINVAL;
+		return -1;
+	}
+	xsetenv((char *)name, NULL);
+
+	return 0;
+}
+
+int putenv(char *string)
+{
+	if (strchr(string, '=') == NULL) {
+		return unsetenv(string);
+	}
+	xsetenv(string, NULL);
+
+	return 0;
+}
+
+int dprintf(int fd, const char *format, ...)
+{
+	char buf[256];
+	va_list ap;
+	int len;
+
+	va_start(ap, format);
+	len = vsnprintf(buf, sizeof(buf), format, ap);
+	va_end(ap);
+	if (len < 0) {
+		return len;
+	}
+	if ((size_t)len >= sizeof(buf)) {
+		len = sizeof(buf) - 1;
+	}
+
+	return (int)write(fd, buf, len);
+}
+
+void cfmakeraw(struct termios *t)
+{
+	t->c_iflag &= ~(IGNBRK | BRKINT | PARMRK | ISTRIP | INLCR | IGNCR | ICRNL | IXON);
+	t->c_oflag &= ~OPOST;
+	t->c_lflag &= ~(ECHO | ECHONL | ICANON | ISIG | IEXTEN);
+	t->c_cflag &= ~(CSIZE | PARENB);
+	t->c_cflag |= CS8;
+	t->c_cc[VMIN] = 1;
+	t->c_cc[VTIME] = 0;
+}
+
+int cfsetspeed(struct termios *t, speed_t speed)
+{
+	int ret = cfsetispeed(t, speed);
+
+	return ret ? ret : cfsetospeed(t, speed);
+}
