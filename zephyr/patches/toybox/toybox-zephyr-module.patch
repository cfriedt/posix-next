+/*
+ * SPDX-License-Identifier: 0BSD
+ * Copyright (c) 2026, Friedt Professional Engineering Services, Inc.
+ *
+ * Linux <sys/mount.h> and <sys/statfs.h> shapes for toybox's portability
+ * layer; Zephyr has no mount table or statfs, so these only declare.
+ */
+#ifndef _TOYBOX_ZEPHYR_SYS_MOUNT_H
+#define _TOYBOX_ZEPHYR_SYS_MOUNT_H
+
+#include <sys/types.h>
+
+struct statfs {
+	long f_type;
+	long f_bsize;
+	long f_frsize;
+	unsigned long f_blocks;
+	unsigned long f_bfree;
+	unsigned long f_bavail;
+	unsigned long f_files;
+	unsigned long f_ffree;
+	int f_fsid[2];
+	long f_namelen;
+	long f_flags;
+};
+
+#define MS_RDONLY      1
+#define MS_NOSUID      2
+#define MS_NODEV       4
+#define MS_NOEXEC      8
+#define MS_SYNCHRONOUS 16
+#define MS_REMOUNT     32
+#define MS_BIND        4096
+#define MS_MOVE        8192
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int statfs(const char *path, struct statfs *buf);
+int fstatfs(int fd, struct statfs *buf);
+int mount(const char *source, const char *target, const char *fstype,
+	  unsigned long flags, const void *data);
+int umount(const char *target);
+int umount2(const char *target, int flags);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _TOYBOX_ZEPHYR_SYS_MOUNT_H */
