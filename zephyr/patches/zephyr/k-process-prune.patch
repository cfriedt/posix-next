diff --git a/include/zephyr/kernel.h b/include/zephyr/kernel.h
index 5fb31117683..c19831ea49b 100644
--- a/include/zephyr/kernel.h
+++ b/include/zephyr/kernel.h
@@ -8268,6 +8268,17 @@ __syscall int k_waitpid_pgrp(k_pgrp_t pgrp, k_pid_t *reaped, int *wstatus, uint3
 __syscall int k_process_init(struct k_process *proc, const k_tid_t *threads,
 			     size_t num_threads);
 
+/**
+ * @brief Reduce the calling process to the calling thread
+ *
+ * Aborts every other member thread of the calling process. The process, its
+ * identity, and its group and session membership are unchanged; the calling
+ * thread becomes the sole member.
+ *
+ * @retval 0 on success
+ */
+__syscall int k_process_prune(void);
+
 /**
  * @brief Initialize a process group from caller-provided memory
  *
diff --git a/kernel/process.c b/kernel/process.c
index 6964fb73819..1a3b4f7ae8a 100644
--- a/kernel/process.c
+++ b/kernel/process.c
@@ -1189,6 +1189,41 @@ static inline int z_vrfy_k_process_init(struct k_process *proc, const k_tid_t *t
 #include <zephyr/syscalls/k_process_init_mrsh.c>
 #endif /* CONFIG_USERSPACE */
 
+int z_impl_k_process_prune(void)
+{
+	k_tid_t victim;
+
+	/* k_thread_abort() cannot run under process_lock: drop and retake */
+	while (true) {
+		victim = NULL;
+		K_SPINLOCK(&process_lock) {
+			struct k_thread *t;
+			struct k_process *proc = process_self();
+
+			SYS_DLIST_FOR_EACH_CONTAINER(&proc->threads, t, process_node) {
+				if (t != _current) {
+					victim = t;
+					break;
+				}
+			}
+		}
+		if (victim == NULL) {
+			break;
+		}
+		k_thread_abort(victim);
+	}
+
+	return 0;
+}
+
+#ifdef CONFIG_USERSPACE
+static inline int z_vrfy_k_process_prune(void)
+{
+	return z_impl_k_process_prune();
+}
+#include <zephyr/syscalls/k_process_prune_mrsh.c>
+#endif /* CONFIG_USERSPACE */
+
