+/* the mount of a path that names a node below a mount point, writable */
+static int fs_attr_mount(const char *abs_path, struct fs_mount_t **mp)
+{
+	int rc;
+
+	if ((abs_path == NULL) || (abs_path[0] != '/') || (abs_path[1] == '\0')) {
+		LOG_ERR("invalid file or dir name!!");
+		return -EINVAL;
+	}
+
+	rc = fs_get_mnt_point(mp, abs_path, NULL);
+	if (rc < 0) {
+		LOG_ERR("mount point not found!!");
+		return rc;
+	}
+
+	if ((*mp)->flags & FS_MOUNT_FLAG_READ_ONLY) {
+		return -EROFS;
+	}
+
+	return 0;
+}
+
+/* a file system without the operation: a missing node is still missing */
+static int fs_attr_unsupported(struct fs_mount_t *mp, const char *abs_path)
+{
+	struct fs_dirent entry;
+	int rc = mp->fs->stat(mp, abs_path, &entry);
+
+	return (rc < 0) ? rc : -ENOTSUP;
+}
+
+int fs_chmod(const char *abs_path, uint32_t mode)
+{
+	struct fs_mount_t *mp;
+	int rc = fs_attr_mount(abs_path, &mp);
+
+	if (rc < 0) {
+		return rc;
+	}
+
+	CHECKIF(mp->fs->chmod == NULL) {
+		return fs_attr_unsupported(mp, abs_path);
+	}
+
+	rc = mp->fs->chmod(mp, abs_path, mode & FS_MODE_PERM);
+	if (rc < 0) {
+		LOG_ERR("failed to set file or dir mode (%d)", rc);
+	}
+
+	return rc;
+}
