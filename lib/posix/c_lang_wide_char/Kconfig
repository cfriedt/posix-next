config POSIX_C_LANG_WIDE_CHAR
	bool "Wide-Character ISO C Library"
	depends on !MINIMAL_LIBC
	help
	  Select 'y' here and Zephyr will provide the POSIX_C_LANG_WIDE_CHAR
	  Option Group: the wide-character functions of <wchar.h> and
	  <wctype.h> come from the C library, and the wcstold() the Zephyr
	  SDK's Picolibc omits is provided here.
