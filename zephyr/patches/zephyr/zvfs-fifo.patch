+static void zvfs_pipe_init(struct zvfs_pipe *p)
+{
+	ring_buf_init(&p->rb, sizeof(p->buf), p->buf);
+	p->opens[0] = 0;
+	p->opens[1] = 0;
+	k_poll_signal_init(&p->read_sig);
+	k_poll_signal_init(&p->write_sig);
+	k_poll_signal_raise(&p->write_sig, 0);
+}
+
+#ifdef CONFIG_ZVFS_FIFO
+/*
+ * A FIFO node names a pipe for as long as any description of it is open: the
+ * path is kept beside the pipe, and openers of the same path share it. The
+ * descriptions come from their own pool, since each open() has its own
+ * status flags. Opening waits for the other side under the lock.
+ */
+static char fifo_paths[CONFIG_ZVFS_PIPE_MAX][CONFIG_ZVFS_PATH_MAX];
+static struct zvfs_pipe_end fifo_ends[CONFIG_ZVFS_FIFO_OPEN_MAX];
+SYS_BITARRAY_DEFINE_STATIC(fifo_ends_bitarray, CONFIG_ZVFS_FIFO_OPEN_MAX);
+static K_MUTEX_DEFINE(fifo_lock);
+static K_CONDVAR_DEFINE(fifo_cond);
+
+static bool zvfs_pipe_is_fifo(const struct zvfs_pipe *p)
+{
+	return fifo_paths[p - pipes][0] != '\0';
+}
+
+static void zvfs_fifo_wake_side(struct zvfs_pipe *p, uint8_t side)
+{
+	ARRAY_FOR_EACH_PTR(fifo_ends, end) {
+		if (end->pipe == p && end->side == side && zvfs_pipe_end_is_open(end)) {
+			zvfs_pipe_wake(end);
+		}
+	}
+}
+
+static void zvfs_fifo_closed(struct zvfs_pipe_end *end)
+{
+	k_spinlock_key_t key;
+	struct zvfs_pipe *p = end->pipe;
+
+	if (end < fifo_ends || end >= &fifo_ends[CONFIG_ZVFS_FIFO_OPEN_MAX]) {
+		return;
+	}
+
+	(void)k_mutex_lock(&fifo_lock, K_FOREVER);
+	(void)sys_bitarray_free(&fifo_ends_bitarray, 1, end - fifo_ends);
+	/* an opener may have joined since the closer counted: release only a deserted pipe */
+	key = k_spin_lock(&p->lock);
+	if (p->opens[0] == 0 && p->opens[1] == 0) {
+		fifo_paths[p - pipes][0] = '\0';
+		(void)sys_bitarray_free(&pipes_bitarray, 1, p - pipes);
+	}
+	k_spin_unlock(&p->lock, key);
+	k_condvar_broadcast(&fifo_cond);
+	k_mutex_unlock(&fifo_lock);
+}
+
+int zvfs_fifo_open(const char *path, int flags)
+{
+	int fd;
+	int ret;
+	size_t offset;
+	int side;
+	k_spinlock_key_t key;
+	struct zvfs_pipe *p = NULL;
+	struct zvfs_pipe_end *end;
+
+	switch (flags & ZVFS_O_ACCMODE) {
+	case ZVFS_O_RDONLY:
+		side = 0;
+		break;
+	case ZVFS_O_WRONLY:
+		side = 1;
+		break;
+	default:
+		/* undefined by POSIX; a description that can do neither is refused */
+		errno = EINVAL;
+		return -1;
+	}
+
+	if (k_is_in_isr()) {
+		errno = EWOULDBLOCK;
+		return -1;
+	}
+
+	fd = zvfs_reserve_fd();
