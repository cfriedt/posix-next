+
+	k_tid_t tid = k_thread_create(&child_a, child_stack_a, STATIC_PROC_STACK_SIZE,
+				      child_thread_entry, &seen, NULL, NULL,
+				      K_LOWEST_APPLICATION_THREAD_PRIO, 0, K_NO_WAIT);
