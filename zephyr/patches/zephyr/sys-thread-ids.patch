+int z_impl_sys_thread_id(k_tid_t tid)
+{
+	int ret = -ESRCH;
+
+	if (tid == NULL) {
+		return -ESRCH;
+	}
+
+#if CONFIG_SYS_THREAD_IDS > 0
+	K_SPINLOCK(&id_lock) {
+		for (size_t i = 0; i < ARRAY_SIZE(thread_ids); i++) {
+			if (thread_ids[i].thread == tid) {
+				ret = thread_ids[i].id;
+				break;
+			}
+		}
+	}
+	if (ret != -ESRCH) {
+		return ret;
+	}
+#endif /* CONFIG_SYS_THREAD_IDS > 0 */
+
+	/* a leader's tid is its pid; the number outlives the thread until reap */
+	K_SPINLOCK(&id_lock) {
+		for (size_t i = 0; i < ARRAY_SIZE(process_ids); i++) {
+			if (process_entry_live(&process_ids[i]) &&
+			    (process_ids[i].proc->leader == tid)) {
+				ret = process_ids[i].id;
+				break;
+			}
+		}
+	}
+
+	return ret;
+}
