        <type>int</type>
        <definition>int pthread_tryjoin_np</definition>
        <argsstring>(pthread_t thread, void **status)</argsstring>
        <name>pthread_tryjoin_np</name>
        <param>
          <type>pthread_t</type>
          <declname>thread</declname>
        </param>
        <param>
          <type>void **</type>
          <declname>status</declname>
        </param>
        <briefdescription>
<para>Try to join a thread without blocking (GNU extension). </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>thread</parametername>
</parameternamelist>
<parameterdescription>
<para>Thread to try to join. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>status</parametername>
</parameternamelist>
<parameterdescription>
<para>Output: exit value if joined, or unchanged if not yet terminated. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>0 if joined, <computeroutput>EBUSY</computeroutput> if the thread has not yet terminated, or a positive error number on failure. </para>
</simplesect>
<simplesect kind="see"><para><ulink url="https://pubs.opengroup.org/onlinepubs/9699919799/functions/pthread_tryjoin_np.html">https://pubs.opengroup.org/onlinepubs/9699919799/functions/pthread_tryjoin_np.html</ulink> </para>
</simplesect>
</para>
