--- a/lib/os/zvfs/zvfs_path.c
+++ b/lib/os/zvfs/zvfs_path.c
@@ -425,12 +425,12 @@ int z_impl_zvfs_statvfs(const char *path, struct zvfs_statvfs *buf)
 		errno = -rrc;
 		return -1;
 	}
-	if (r[1] == '\0') {
+	res = fs_statvfs(r, &vfs);
+	if ((res < 0) && (r[1] == '\0')) {
